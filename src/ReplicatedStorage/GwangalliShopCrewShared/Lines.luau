Lines.BANK = BANK
Lines.TYPE = TYPE
Lines.KEYS = {}
for k in BANK do
	table.insert(Lines.KEYS, k)
end
table.sort(Lines.KEYS)

Lines.VARS = { "item", "n", "name", "fav", "shop", "price", "desc", "table", "place", "dir", "dist", "mins", "level", "title", "total", "count", "stamps", "amount", "menu" }

local function listOf(entry: any, dialect: string): { string }?
	if type(entry) ~= "table" then
		return nil
	end
	if entry[1] ~= nil then
		return entry
	end
	local l = entry[dialect]
	if type(l) == "table" and #l > 0 then
		return l
	end
	return nil
end

function Lines.has(key: string): boolean
	return BANK[key] ~= nil
end

function Lines.list(key: string, dialect: string?, shopType: string?): { string }?
	local d = dialect or "std"
	local t = shopType and TYPE[shopType]
	local e = t and t[key]
	local l = listOf(e, d)
	if not l and e and d ~= "std" then
		-- a type override in standard Korean only: an owner speaking 사투리 still uses the bank's own lines
		l = nil
	end
	if not l then
		l = listOf(BANK[key], d) or listOf(BANK[key], "std")
	end
	return l
end

-- key -> one line (seeded pick, placeholders filled); nil when the key has nothing
function Lines.get(key: string, ctx: any?): string?
	local c = ctx or {}
	local l = Lines.list(key, c.dialect, c.type)
	if not l or #l == 0 then
		return nil
	end
	local i: number
	if type(c.seed) == "number" then
		i = (math.floor(math.abs(c.seed)) % #l) + 1
	else
		i = math.random(1, #l)
	end
	local text = l[i]
	-- a line whose placeholders cannot be filled is skipped for another one of the same key
	local out = Util.fill(text, c.vars)
	if string.find(out, "{", 1, true) then
		for j = 1, #l do
			local alt = Util.fill(l[j], c.vars)
			if not string.find(alt, "{", 1, true) then
				return alt
			end
		end
		return nil
	end
	return out
end

return Lines
