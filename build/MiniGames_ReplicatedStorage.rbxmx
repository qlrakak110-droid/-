		id = "seoyeon",
		name = "서연",
		role = "퀴즈 동아리 대학생",
		difficulty = "hard",
		look = { body = "f", age = 21, style = "campus" },
		seed = 9107,
		lines = {
			invite = { "퀴즈 대결 하실래요? 저 퀴즈 동아리예요!", "상식 퀴즈 한 판 어때요?" },
			start = { "버저 빨리 누르는 사람이 이겨요!", "준비되셨죠?" },
			think = { "어... 이거 아는 건데!", "잠깐만요..." },
			good = { "와, 그걸 아세요?", "빠르시다!" },
			win = { "퀴즈 동아리의 자존심!", "다음 문제도 기대하세요~" },
			lose = { "와... 졌어요. 대단하세요!", "동아리 선배한테 혼나겠다 ㅠ" },
			draw = { "동점이네요!" },
			wait = { "오늘의 퀴즈 상대 구합니다~" },
		},
	},
} :: { [string]: NpcHost }

function MS.line(npc: NpcHost?, kind: string, seed: number?): string?
	if not npc then
		return nil
	end
	local list = npc.lines[kind]
	if not list or #list == 0 then
		return nil
	end
	local i = if seed then (math.floor(seed) % #list) + 1 else math.random(1, #list)
	return list[i]
end

-------------------------------------------------------------------------------------------------
-- Stations along the promenade (광안해변로 seaside band). x = position along the beach (studs, the
-- MapData coast frame: z = baseline(x) + n, the sea is -Z), n = distance from the seawall coping
-- (the seaside paving band is n 1..11; benches sit at n 7, the furniture strip at n 12..16). The
-- builder slides a station up to MS.SLIDE studs along the promenade to find a clear spot, so a
-- planter or a bench is never cut through. Stations sit in the gaps between bench groups so the
-- tables mix with the benches instead of forming one game hall.
-------------------------------------------------------------------------------------------------
export type StationSeed = { id: string, game: string, x: number, n: number, npc: string?, label: string }
MS.SLIDE = 26
MS.STATIONS = {
	{ id = "wordchain_west", game = "wordchain", x = -1590, n = 5, npc = "hajun", label = "민락 쪽 벤치" },
	{ id = "omok_west", game = "omok", x = -1290, n = 5, npc = nil, label = "민락 쪽 산책로" },
	{ id = "numberguess_west", game = "numberguess", x = -990, n = 5, npc = "deokbae", label = "축제의 광장 서쪽" },
	{ id = "timing_plaza", game = "timing", x = -420, n = 5, npc = "jiho", label = "만남의 광장 옆" },
	{ id = "omok_plaza", game = "omok", x = -330, n = 5, npc = "parkssi", label = "만남의 광장 앞" },
	{ id = "rps_center", game = "rps", x = -150, n = 5, npc = "haeun", label = "광안리 중앙" },
	{ id = "reaction_center", game = "reaction", x = -60, n = 5, npc = "taeho", label = "해변 중앙 데크 옆" },
	{ id = "wordchain_center", game = "wordchain", x = 210, n = 5, npc = "minjun", label = "관광안내소 앞" },
	{ id = "memory_east", game = "memory", x = 510, n = 5, npc = "sunja", label = "호메르스호텔 앞" },
	{ id = "omok_east", game = "omok", x = 780, n = 5, npc = "kimsabeom", label = "해변 동쪽 벤치" },
	{ id = "quiz_east", game = "quiz", x = 1200, n = 5, npc = "seoyeon", label = "해맞이광장 옆" },
	{ id = "rps_east", game = "rps", x = 1410, n = 5, npc = "dongsu", label = "남천 쪽 산책로" },
} :: { StationSeed }

-- MapData coast baseline (GwangalliPhone/MapData): the promenade's seawall coping follows this.
MS.COAST_A = 0.0000324
function MS.baseline(x: number): number
	return -MS.COAST_A * x * x
end

return MS
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000001"><Properties><string name="Name">OmokConfig</string><ProtectedString name="Source"><![CDATA[--!strict
-- OmokConfig: rules, timers and the pure board logic of 오목 (shared: the server judges, the client
-- previews forbidden points and draws the board from the station attributes).
--
-- Board: SIZE x SIZE cells, index i = (y - 1) * SIZE + x (x, y in 1..SIZE). Encoded as a SIZE*SIZE
-- character string: "0" empty, "1" black (흑, moves first), "2" white (백).
-- Rules (OmokConfig.RULE):
--   "free"   : five or more in a row wins for both colours (자유룰).
--   "korean" : white wins with five or more; black wins only with exactly five, and black may not
--              make an overline (장목), a double three (쌍삼 / 3-3) or a double four (4-4).
-- Forbidden-point detection is the usual practical approximation (no recursive forbidden checks of
-- the follow-up points), which is what casual 오목 apps use.

local OC = {}

OC.SIZE = 15
OC.RULE = "korean" -- "free" | "korean"
OC.MOVE_TIME = 30 -- seconds per move
OC.TIMEOUT_STRIKES = 2 -- the first timeout plays a random move for you, the second loses the game
OC.CELL = 0.22 -- studs between two lines on the 3D board (15 lines -> a 3.1-stud grid on the 4-stud table)
OC.BOARD_Y = 0.12 -- board slab thickness above the table top

local SIZE = OC.SIZE
local DIRS = { { 1, 0 }, { 0, 1 }, { 1, 1 }, { 1, -1 } }

function OC.idx(x: number, y: number): number
	return (y - 1) * SIZE + x
end

function OC.xy(i: number): (number, number)
	local x = (i - 1) % SIZE + 1
	local y = (i - 1) // SIZE + 1
	return x, y
end

function OC.inside(x: number, y: number): boolean
	return x >= 1 and x <= SIZE and y >= 1 and y <= SIZE
end

function OC.empty(): { number }
	local b = table.create(SIZE * SIZE, 0)
	return b
end

function OC.encode(b: { number }): string
	local parts = table.create(#b)
	for i, v in b do
		parts[i] = if v == 1 then "1" elseif v == 2 then "2" else "0"
	end
	return table.concat(parts)
end

function OC.decode(s: any): { number }
	local b = OC.empty()
	if type(s) ~= "string" then
		return b
	end
	for i = 1, math.min(#s, SIZE * SIZE) do
		local c = string.byte(s, i)
		b[i] = if c == 49 then 1 elseif c == 50 then 2 else 0
	end
	return b
end

local function at(b: { number }, x: number, y: number): number
	if not OC.inside(x, y) then
		return -1
	end
	return b[(y - 1) * SIZE + x]
end
OC.at = at

-- Length of the run of `color` through (x, y) along (dx, dy), and the cells of the run.
local function run(b: { number }, x: number, y: number, dx: number, dy: number, color: number): (number, { number })
	local cells = { OC.idx(x, y) }
	local n = 1
	local cx, cy = x + dx, y + dy
	while at(b, cx, cy) == color do
		n += 1
		table.insert(cells, OC.idx(cx, cy))
		cx += dx
		cy += dy
	end
	cx, cy = x - dx, y - dy
	while at(b, cx, cy) == color do
		n += 1
		table.insert(cells, 1, OC.idx(cx, cy))
		cx -= dx
		cy -= dy
	end
	return n, cells
end

-- After `color` played (x, y) (already on the board): the winning line (5 cells) or nil.
function OC.winLine(b: { number }, x: number, y: number, color: number, rule: string?): { number }?
	local r = rule or OC.RULE
	for _, d in DIRS do
		local n, cells = run(b, x, y, d[1], d[2], color)
		local ok = if r == "korean" and color == 1 then n == 5 else n >= 5
		if ok then
			-- the five cells nearest to the played stone (an overline shows its first five)
			local out = {}
			for i = 1, math.min(5, #cells) do
				out[i] = cells[i]
			end
			return out
		end
	end
	return nil
end

-- Would `color` at (x, y) make exactly five (a win) for black under the korean rule / five+ else?
local function makesFive(b: { number }, x: number, y: number, color: number, rule: string): boolean
	if at(b, x, y) ~= 0 then
		return false
	end
	b[OC.idx(x, y)] = color
	local w = OC.winLine(b, x, y, color, rule) ~= nil
	b[OC.idx(x, y)] = 0
	return w
end

-- Count the directions where placing black at (x, y) makes a four (a line that one more stone
-- completes to exactly five) and an open three (a line that one more stone turns into an open
-- four: four in a row with both ends empty, the four itself not an overline).
local function fourAndThrees(b: { number }, x: number, y: number): (number, number)
	local fours, threes = 0, 0
	local i0 = OC.idx(x, y)
	b[i0] = 1
	for _, d in DIRS do
		local dx, dy = d[1], d[2]
		-- four: some empty cell on this line within 4 steps completes exactly five through (x, y)
		local isFour = false
		for k = -4, 4 do
			if k ~= 0 then
				local cx, cy = x + dx * k, y + dy * k
				if at(b, cx, cy) == 0 then
					b[OC.idx(cx, cy)] = 1
					local n = run(b, x, y, dx, dy, 1)
					b[OC.idx(cx, cy)] = 0
					if n == 5 then
						isFour = true
						break
					end
				end
			end
		end
		if isFour then
			fours += 1
		else
			-- open three: some empty cell makes an open (straight) four through (x, y)
			local isThree = false
			for k = -3, 3 do
				if k ~= 0 then
					local cx, cy = x + dx * k, y + dy * k
					if at(b, cx, cy) == 0 then
						b[OC.idx(cx, cy)] = 1
						local n, cells = run(b, x, y, dx, dy, 1)
						if n == 4 then
							local fx, fy = OC.xy(cells[1])
							local lx, ly = OC.xy(cells[#cells])
							local bx, by = fx - dx, fy - dy
							local ax, ay = lx + dx, ly + dy
							if at(b, bx, by) == 0 and at(b, ax, ay) == 0 then
								-- both completions must give exactly five (not an overline)
								if makesFive(b, bx, by, 1, "korean") and makesFive(b, ax, ay, 1, "korean") then
									isThree = true
								end
							end
						end
						b[OC.idx(cx, cy)] = 0
						if isThree then
							break
						end
					end
				end
			end
			if isThree then
				threes += 1
			end
		end
	end
	b[i0] = 0
	return fours, threes
end

-- Is (x, y) a forbidden point for `color`? Returns the reason ("33" | "44" | "6") or nil.
-- A move that makes exactly five is never forbidden (the win comes first).
function OC.forbidden(b: { number }, x: number, y: number, color: number, rule: string?): string?
	local r = rule or OC.RULE
	if r ~= "korean" or color ~= 1 or at(b, x, y) ~= 0 then
		return nil
	end
	local i0 = OC.idx(x, y)
	b[i0] = 1
	local five, over = false, false
	for _, d in DIRS do
		local n = run(b, x, y, d[1], d[2], 1)
		if n == 5 then
			five = true
		elseif n > 5 then
			over = true
		end
	end
	b[i0] = 0
	if five then
		return nil
	end
	if over then
		return "6"
	end
	local fours, threes = fourAndThrees(b, x, y)
	if fours >= 2 then
		return "44"
	end
	if threes >= 2 then
		return "33"
	end
	return nil
end

OC.FORBIDDEN_TEXT = { ["33"] = "쌍삼(3-3) 금지", ["44"] = "4-4 금지", ["6"] = "장목 금지" }

function OC.full(b: { number }): boolean
	for _, v in b do
		if v == 0 then
			return false
		end
	end
	return true
end

-- Board coordinates as players read them: columns A..O (left to right from black's side), rows 1..15.
local COLS = "ABCDEFGHJKLMNOP" -- no I, like Go boards
function OC.label(i: number): string
	local x, y = OC.xy(i)
	return string.sub(COLS, x, x) .. tostring(y)
end

return OC
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">WordRules</string><ProtectedString name="Source"><![CDATA[--!strict
-- WordRules: the pure rules of 끝말잇기 (shared: the server judges, the client shows the "차___" hint
-- and rejects obviously bad input before sending it).
--   WR.normalize(text) -> string        trims and removes every space ("자 동 차" -> "자동차")
--   WR.syllables(word) -> {codepoint}?  nil unless every character is a Hangul syllable (가..힣)
--   WR.shape(word) -> ok, reason?      2..MAX syllables of Hangul
--   WR.starts(prevWord) -> {string}     syllables the next word may start with (last syllable and its
--                                        두음법칙 form: 력 -> 역, 료 -> 요, 라 -> 나, 녀 -> 여 ...)
--   WR.follows(prev, nextWord) -> bool
--   WR.first(word) / WR.last(word) -> string

local WR = {}

WR.MIN = 2
WR.MAX = 8
WR.TURN_TIME = 10 -- seconds per answer

local BASE = 0xAC00
local LAST = 0xD7A3

local function decompose(cp: number): (number, number, number)
	local s = cp - BASE
	local jong = s % 28
	local jung = (s // 28) % 21
	local cho = s // (28 * 21)
	return cho, jung, jong
end

local function compose(cho: number, jung: number, jong: number): number
	return BASE + (cho * 21 + jung) * 28 + jong
end

local CHO_N, CHO_R, CHO_O = 2, 5, 11
-- ㄹ before ㅑ ㅒ ㅕ ㅖ ㅛ ㅠ ㅣ -> ㅇ ; ㄹ before ㅏ ㅐ ㅗ ㅚ ㅜ ㅡ -> ㄴ ; ㄴ before ㅕ ㅖ ㅛ ㅠ ㅣ -> ㅇ
local R_TO_O = { [2] = true, [3] = true, [6] = true, [7] = true, [12] = true, [17] = true, [20] = true }
local R_TO_N = { [0] = true, [1] = true, [8] = true, [11] = true, [13] = true, [18] = true }
local N_TO_O = { [6] = true, [7] = true, [12] = true, [17] = true, [20] = true }

-- 두음법칙 form of a syllable, or nil when the rule does not change it.
function WR.dueum(cp: number): number?
	if cp < BASE or cp > LAST then
		return nil
	end
	local cho, jung, jong = decompose(cp)
	if cho == CHO_R then
		if R_TO_O[jung] then
			return compose(CHO_O, jung, jong)
		elseif R_TO_N[jung] then
			return compose(CHO_N, jung, jong)
		end
	elseif cho == CHO_N and N_TO_O[jung] then
		return compose(CHO_O, jung, jong)
	end
	return nil
end

function WR.normalize(text: any): string
	if type(text) ~= "string" then
		return ""
	end
	local s = string.gsub(text, "%s+", "")
	return s
end

function WR.syllables(word: string): { number }?
	if type(word) ~= "string" or word == "" or #word > 64 then
		return nil
	end
	local ok, list = pcall(function()
		local out = {}
		for _, cp in utf8.codes(word) do
			if cp < BASE or cp > LAST then
				error("not hangul")
			end
			table.insert(out, cp)
		end
		return out
	end)
	if not ok then
		return nil
	end
	return list
end

function WR.shape(word: string): (boolean, string?)
	local s = WR.syllables(word)
	if not s then
		return false, "한글 단어만 쓸 수 있어요"
	end
	if #s < WR.MIN then
		return false, "두 글자 이상 단어만 돼요"
	end
	if #s > WR.MAX then
		return false, "너무 긴 단어예요"
	end
	return true, nil
end

function WR.first(word: string): string
	local s = WR.syllables(word)
	return if s and #s > 0 then utf8.char(s[1]) else ""
end

function WR.last(word: string): string
	local s = WR.syllables(word)
	return if s and #s > 0 then utf8.char(s[#s]) else ""
end

function WR.starts(prev: string): { string }
	local s = WR.syllables(prev)
	if not s or #s == 0 then
		return {}
	end
	local lastCp = s[#s]
	local out = { utf8.char(lastCp) }
	local alt = WR.dueum(lastCp)
	if alt then
		table.insert(out, utf8.char(alt))
	end
	return out
end

function WR.follows(prev: string, nextWord: string): boolean
	local f = WR.first(nextWord)
	if f == "" then
		return false
	end
	for _, st in WR.starts(prev) do
		if st == f then
			return true
		end
	end
	return false
end

-- "차" or "력(역)" for the hint line.
function WR.hint(prev: string): string
	local st = WR.starts(prev)
	if #st == 0 then
		return ""
	elseif #st == 1 then
		return st[1]
	end
	return st[1] .. "(" .. st[2] .. ")"
end

return WR
]]></ProtectedString></Properties></Item></Item></roblox>