			good = { "오, 좁혀오는구먼!", "감이 좋네!" },
			win = { "허허, 내가 맞혔다!", "숫자는 반으로 나누는 게 비결이야." },
			lose = { "아이고 맞혔네!", "대단하구먼!" },
			draw = { "허허, 무승부네." },
