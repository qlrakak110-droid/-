			win = { "할미가 아직 안 죽었다!", "호호, 또 오너라~" },
			lose = { "아이고 졌다, 똑똑하네!", "요새 젊은이들 머리 좋다~" },
			draw = { "둘 다 잘했네~" },
			wait = { "바다 보면서 숫자 외우면 머리가 맑아진다이~" },
