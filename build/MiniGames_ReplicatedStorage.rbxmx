		name = "순자 할머니",
		role = "광안리 토박이",
		difficulty = "normal",
		look = { body = "f", age = 74, style = "classic" },
		seed = 8101,
		lines = {
			invite = { "기억력 내기 한번 할래? 할미 아직 정정하다~", "젊은이, 숫자 외우기 해볼래?" },
			start = { "잘 보고 외우거래이~", "할미 따라올 수 있겠나?" },
			think = { "어디 보자...", "아이고 이게 뭐였더라..." },
