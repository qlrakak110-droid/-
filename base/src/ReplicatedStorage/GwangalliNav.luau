-- Runtime helpers ------------------------------------------------------------------------------------
local cache = nil
local CELL = 64
local function gkey(x, z)
	return (math.floor(x / CELL) + 512) * 2048 + (math.floor(z / CELL) + 512)
end

function Nav.decode()
	if cache then
		return cache
	end
	local P = Nav.ped
	local pos = table.create(P.n)
	local adj = table.create(P.n)
	local grid = {}
	for i = 1, P.n do
		local k = (i - 1) * 3
		local p = Vector3.new(P.pos[k + 1], P.pos[k + 2], P.pos[k + 3])
		pos[i] = p
		adj[i] = {}
		local key = gkey(p.X, p.Z)
		local cell = grid[key]
		if not cell then
			cell = {}
			grid[key] = cell
		end
		table.insert(cell, i)
	end
	local E = P.edges
	for e = 1, #E // 4 do
		local k = (e - 1) * 4
		local a, b = E[k + 1], E[k + 2]
		local la, lb = adj[a], adj[b]
		la[#la + 1] = b
		la[#la + 1] = e
		lb[#lb + 1] = a
		lb[#lb + 1] = e
	end
	local xw = {}
	for i = 1, #P.xwalk // 3 do
		local k = (i - 1) * 3
		xw[P.xwalk[k + 1]] = { P.xwalk[k + 2], P.xwalk[k + 3] }
	end
	local Ln = Nav.lanes
	local lanePos = table.create(Ln.n)
	local laneOut = table.create(Ln.n)
	local laneGrid = {}
	for i = 1, Ln.n do
		local p = Vector3.new(Ln.pos[(i - 1) * 2 + 1], 6, Ln.pos[(i - 1) * 2 + 2])
		lanePos[i] = p
		laneOut[i] = {}
		local key = gkey(p.X, p.Z)
		local cell = laneGrid[key]
		if not cell then
			cell = {}
			laneGrid[key] = cell
		end
		table.insert(cell, i)
	end
	local LE = Ln.edges
	for e = 1, #LE // 4 do
		local k = (e - 1) * 4
		local o = laneOut[LE[k + 1]]
		o[#o + 1] = LE[k + 2]
		o[#o + 1] = e
	end
	local laneStop = {}
	for i = 1, #Ln.stops // 3 do
		local k = (i - 1) * 3
		laneStop[Ln.stops[k + 1]] = { Ln.stops[k + 2], Ln.stops[k + 3] }
	end
	cache = { pos = pos, adj = adj, grid = grid, xwalk = xw, lanePos = lanePos, laneOut = laneOut, laneGrid = laneGrid, laneStop = laneStop }
	return cache
end

function Nav.pedEdge(e)
	local E = Nav.ped.edges
	local k = (e - 1) * 4
	return E[k + 1], E[k + 2], E[k + 3], E[k + 4]
end

function Nav.laneEdge(e)
	local E = Nav.lanes.edges
	local k = (e - 1) * 4
	return E[k + 1], E[k + 2], E[k + 3], E[k + 4]
end

function Nav.crossing(e)
	local c = Nav.decode().xwalk[e]
	if not c then
		return false, nil, nil
	end
	if c[1] == 0 then
		return true, nil, nil
	end
	return true, Nav.signals[c[1]], c[2]
end

local function nearestIn(grid, pos, list, p, maxDist, filter)
	local r = maxDist or 64
	local best, bestD = nil, r * r
	local c0x, c0z = math.floor((p.X - r) / CELL), math.floor((p.Z - r) / CELL)
	local c1x, c1z = math.floor((p.X + r) / CELL), math.floor((p.Z + r) / CELL)
	for cx = c0x, c1x do
		for cz = c0z, c1z do
			local cell = grid[(cx + 512) * 2048 + (cz + 512)]
			if cell then
				for _, i in cell do
					if not filter or filter(i) then
						local q = pos[i]
						local dx, dy, dz = q.X - p.X, (q.Y - p.Y) * 2, q.Z - p.Z
						local d = dx * dx + dy * dy + dz * dz
						if d < bestD then
							best, bestD = i, d
						end
					end
				end
			end
		end
	end
	return best
end

function Nav.nearest(p, maxDist, areaFilter)
	local c = Nav.decode()
	local filter = nil
	if areaFilter then
		local A = Nav.ped.area
		filter = function(i)
			return areaFilter[Nav.AREA[A[i]]] == true
		end
	end
	return nearestIn(c.grid, c.pos, nil, p, maxDist, filter)
end

function Nav.nearestLane(p, maxDist)
	local c = Nav.decode()
	return nearestIn(c.laneGrid, c.lanePos, nil, p, maxDist, nil)
end

-- A* over the pedestrian graph. Cost = length x kind factor (sand / alleys / crossings cost more).
local COST = nil
function Nav.route(a, b, allowQueue)
	local c = Nav.decode()
	if not COST then
		COST = {}
		for name, code in Nav.KIND do
			COST[code] = Nav.KIND_COST[name] or 1
		end
	end
	local pos, adj, E = c.pos, c.adj, Nav.ped.edges
	local queueKind = Nav.KIND.queue
	local goal = pos[b]
	local g = { [a] = 0 }
	local from = {}
	local heap = { { (pos[a] - goal).Magnitude, a } }
	local closed = {}
	local expanded = 0
	while #heap > 0 do
		local top = heap[1]
		local last = table.remove(heap)
		if #heap > 0 then
			heap[1] = last
			local i = 1
			while true do
				local l, r = i * 2, i * 2 + 1
				local s = i
				if l <= #heap and heap[l][1] < heap[s][1] then
					s = l
				end
				if r <= #heap and heap[r][1] < heap[s][1] then
					s = r
				end
				if s == i then
					break
				end
				heap[s], heap[i] = heap[i], heap[s]
				i = s
			end
		end
		local v = top[2]
		if v == b then
			local path = { b }
			while from[v] do
				v = from[v]
				table.insert(path, 1, v)
			end
			return path
		end
		if not closed[v] then
			closed[v] = true
			expanded += 1
			if expanded > 30000 then
				return nil
			end
			local list = adj[v]
			for k = 1, #list, 2 do
				local w, e = list[k], list[k + 1]
				local kind = E[(e - 1) * 4 + 4]
				if (kind ~= queueKind or allowQueue) and not closed[w] then
					local ng = g[v] + (pos[w] - pos[v]).Magnitude * COST[kind]
					if ng < (g[w] or math.huge) then
						g[w] = ng
						from[w] = v
						local f = ng + (pos[w] - goal).Magnitude
						table.insert(heap, { f, w })
						local i = #heap
						while i > 1 do
							local p = i // 2
							if heap[p][1] <= heap[i][1] then
								break
							end
							heap[p], heap[i] = heap[i], heap[p]
							i = p
						end
					end
				end
			end
		end
	end
	return nil
end

return Nav
