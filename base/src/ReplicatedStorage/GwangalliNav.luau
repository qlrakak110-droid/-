-- AUTO-GENERATED by build/districts/npcnav.luau (npcnav_*.luau). Do not edit by hand: rebuild.
--
-- GwangalliNav: navigation data for the client-side ambient life (pedestrians, cars) and the server
-- NPCs of 광안리 GTA. True scale: 1 stud = 0.3 m. Coordinates are WORLD studs, quantised to 0.1.
-- All arrays are FLAT (stride noted) and 1-based node / edge indices.
--
-- ped (undirected pedestrian graph)
--   ped.n                   node count
--   ped.pos    stride 3     x, y, z of node i at (i-1)*3 + 1..3; y = the walking surface (sidewalks,
--                           promenade 6.5, crosswalk ends on the kerb, sand = terrain height, metro
--                           landing -2.3, quay 4.0)
--   ped.area   stride 1     AREA index of node i (AREA[k] = id, AREA_NAME[k] = Korean name)
--   ped.edges  stride 4     a, b, width (studs, clear walking width: offset laterally within +-w/2 to
--                           keep right / pass), kind (KIND code, see below)
--   ped.xwalk  stride 3     edge, signal, phase: crossing edges (KIND xwalk / xing). signal = index
--                           into `signals` (0 = unsignalised zebra: yield to cars), phase 0/1 = the
--                           SignalPhase the walk light follows. Walk when
--                           GwangalliShared.pedState(signals[signal], phase, workspace:GetServerTimeNow())
--                           == "walk" (don't start on "flash"). Wait at the end node you arrive at.
--                           The carriageway under xwalk / xing edges is y = 6.0 (0.5 below the kerb
--                           end nodes) except within ~1 stud of either end.
--   ped.toClub stride 1     next node from node i toward the CLUB OCEAN queue tail (0 = the tail /
--                           unreachable). Night steering: follow toClub[i] repeatedly.
--   KIND: walk (sidewalk), prom (promenade), plaza, sand (beach), park, alley (back-lane strip, shared
--         with cars), xwalk (signalised crosswalk), xing (unsignalised crossing: back lane, zebra
--         without lights), stairs, forecourt (club front), queue (club queue lane: only for queuing
--         guests), link (short connector: metro top, ramps), deck (timber beach decks), quay (민락항)
--
-- lanes (directed traffic graph; y of every lane node = 6.0, the asphalt)
--   lanes.n                 node count
--   lanes.pos  stride 2     x, z (quantised to 1 stud)
--   lanes.edges stride 4    from, to, speed (km/h posted; studs/s = kmh / 1.08), kind (LANE_KIND:
--                           lane, bus (bus-only lane), straight (through a junction), turn, change
--                           (lane change), uturn (road end loop)). Turn / change / uturn connectors are
--                           coarse (one Bezier midpoint): lerp the heading along them.
--   lanes.stops stride 3    node, signal, phase: a car whose next edge leaves `node` must stop there
--                           unless GwangalliShared.vehicleState(signals[signal], phase, now) ==
--                           "green" (amber: stop if it can). signal 0 = unsignalised: yield (slow,
--                           give way to crossing pedestrians / cars on the other road).
--   lanes.portals stride 2  node, PORTAL code (bridge_east / bridge_west = 광안대교 ramps, grid_* =
--                           map ends, hills = street ends toward 금련산): natural spawn / despawn points
--   lanes.busStops stride 2 lane node where a bus stops, poi index of the shelter
--
-- poi stride 9              x, y, z, yaw, kind, tags, node, cap, name
--   (x, y, z) the spot (seat surface for sit spots), yaw in degrees: face the direction
--   CFrame.new(x, y, z) * CFrame.Angles(0, math.rad(yaw), 0). kind = POI_KIND index, tags = TAG bit
--   mask (bit32.btest(tags, TAG.sit)), node = pedestrian node from which a straight walk reaches the
--   spot, cap = how many NPCs fit (bench seats 1.8 studs apart along the bench), name = index into
--   `names` (0 = none).
-- places[key] = { node, x, y, z, name }   named anchors: every quick-travel Destination DisplayName
--   (venues, hotels, metro exits ...), plazas / beach / parks by area id, club_ocean (queue tail),
--   club_door, taxi_stand, metro_<역>_<출구>. Use them for citizen schedules ("go to the cafe street").
-- club (CLUB OCEAN 광안, the night content)
--   door, rope, guard, podium, hangCenter, drop  {x, y, z}
--   queue      stride 3  spots from the head (at the rope, spot 1) to the tail; guests face queueFace
--   staticQueue          the first N spots are already drawn by the club's own static queue rigs
--   hang       stride 3  smoking / hang-out ring spots (face hangCenter)
--   taxiLane             lane node where a taxi drops guests (seaward-bound 광안로, in front of the
--                        entrance); drop = the kerb spot / drop node where they get out
--   nodes      door / carpet / rope / head / tail / hang / drop pedestrian node indices
--   routes     { name, nodes = { ... } } main walking routes to the club (beach, 만남의 광장,
--              광안해변로, metro exits, bus stops): spawn club-bound groups along them at night
-- taxiStand  { poi, curb = {x,y,z}, head = {x,y,z} } 택시승강장 on 광안해변로 by 만남의 광장
--
-- Helpers (lazy decode on first use, then no allocation per call except route()):
--   Nav.decode() -> { pos = {Vector3}, adj = { {nbr, edge, nbr, edge, ...} }, lanePos = {Vector3},
--                     laneOut = { {to, edge, ...} }, laneStop = { [node] = {signal, phase} } }
--   Nav.pedEdge(e) -> a, b, width, kind         Nav.laneEdge(e) -> from, to, speed, kind
--   Nav.crossing(e) -> isCrossing, signalName?, phase?
--   Nav.nearest(pos, maxDist?, areaFilter?) -> node?     Nav.nearestLane(pos, maxDist?) -> node?
--   Nav.route(a, b, allowQueue?) -> { nodes }? (A* over the pedestrian graph, prefers sidewalks)
--
