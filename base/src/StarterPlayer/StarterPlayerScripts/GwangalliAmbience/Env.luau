-- GwangalliAmbience/Env (client): shared state and helpers for the sea / beach ambience modules.
--
--   * quality tier (ReplicatedStorage.GwangalliQuality, pcall'd, touch fallback): Env.tier(),
--     Env.pick({ low =, mid =, high =, saver = }) (saver: the weak-phone sub-level of low,
--     GwangalliQuality.isSaver()), Env.onTier(fn) (also called when the saver switches)
--   * sea geometry: ReplicatedStorage.GwangalliSeaData (generated by build/districts/coast_seadata)
--     with an analytic fallback of the same beach profile: Env.shoreZ(x) (0.3 contour),
--     Env.edgeZ(x) (y = 0 water edge), Env.sandHeight(x, z), Env.shoreFrame(x) (tangent, inland
--     normal, slope), Env.planPoint(x, n, y), Env.groundY(x, z, fallback) (terrain raycast, cached,
--     once the terrain fill is complete)
--   * time: Env.now() (server time), Env.clock() (Lighting.ClockTime, written locally by
--     GwangalliWorld/DayNight), Env.isNight(), Env.daylight() (0 night .. 1 day), Env.hourIn(a, b)
--   * wind: Env.wind (Vector3, studs/s, = Workspace.GlobalWind), Env.windDir (unit, horizontal),
--     Env.windSpeed, Env.gust(t, x, z) (0.55 .. 1.45, slow travelling gusts)
--   * the swell: Env.wavePhase(t, x) (0..1, oblique crests running along the beach, T ~ 8.4 s),
--     Env.waveSet(t, x) (0.7 .. 1.3 set grouping). Surf, spray and bobbing all use it, so the foam
--     edge, the spray on the rocks and the buoys move to the same swell.
--   * camera: Env.focus() (camera position; the sound listener is the camera too),
--     Env.behind(pos, radius?) (true when a sphere is well behind the camera: more than ~100 deg
--     off the view direction; jobs then advance their state but skip the writes)
--   * parts: Env.folder (client-only Folder in Workspace), Env.part(parent, size, color, material,
--     transparency, name, shape?) -> anchored, non-colliding, non-queryable, shadowless part
--   * scheduler: Env.every(name, hz, fn) runs fn(now, dt) at `hz` (a number or a function of the
--     tier) from ONE Heartbeat connection, each call pcall'd (a job that errors 5 times is dropped
--     with one warning); at most JOBS_PER_FRAME jobs run in one frame (low 2), the others the next
--     frame (their dt covers the wait), so the jobs never pile up in the same frame; Env.stats[name] = { ms = EMA cost per call, frameMs = EMA cost per frame,
--     calls, errors }. Env.report() -> one-line summary.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Env = {}

Env.TAG = {
	StaticFoam = "SeaStaticFoam",
	Bob = "SeaBob",
	Sway = "SeaSway",
	Flag = "SeaFlag",
}

local function log(...)
	print("[GwangalliAmbience]", ...)
end
local function warnf(...)
	warn("[GwangalliAmbience]", ...)
end
Env.log, Env.warn = log, warnf

---------------------------------------------------------------------------------------------------
-- Quality tier
---------------------------------------------------------------------------------------------------
local Quality: any = nil
do
	local mod = ReplicatedStorage:FindFirstChild("GwangalliQuality") or ReplicatedStorage:WaitForChild("GwangalliQuality", 10)
	if mod and mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok and type(res) == "table" and type(res.get) == "function" then
			Quality = res
		end
	end
end
local fallbackTier = "high"
do
	local ok, touchOnly = pcall(function()
		return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end)
	if ok and touchOnly then
		fallbackTier = "low"
	end
end

function Env.tier(): string
	if Quality then
		local ok, t = pcall(Quality.get)
		if ok and (t == "low" or t == "mid" or t == "high") then
			return t
		end
	end
	return fallbackTier
end

function Env.isSaver(): boolean
	if Quality and type(Quality.isSaver) == "function" then
		local ok, on = pcall(Quality.isSaver)
		return ok and on == true
	end
	return false
end

function Env.pick(map: { [string]: any }): any
	local t = Env.tier()
	if t == "low" and map.saver ~= nil and Env.isSaver() then
		return map.saver
	end
	local v = map[t]
	if v == nil then
		if t == "low" then
			v = if map.mid ~= nil then map.mid else map.high
		else
			v = if map.mid ~= nil then map.mid else if map.high ~= nil then map.high else map.low
		end
	end
	return v
end

local tierListeners: { (string) -> () } = {}
function Env.onTier(fn: (string) -> ())
	table.insert(tierListeners, fn)
end
local function tierChanged()
	local t = Env.tier()
	for _, fn in tierListeners do
		task.spawn(function()
			local ok, err = pcall(fn, t)
			if not ok then
				warnf("tier change:", err)
			end
		end)
	end
end
if Quality and Quality.changed then
	pcall(function()
		Quality.changed:Connect(tierChanged)
		if Quality.saverChanged then
			Quality.saverChanged:Connect(tierChanged)
		end
	end)
end

---------------------------------------------------------------------------------------------------
-- Sea data (+ analytic fallback identical to build/districts/coast_geo.luau)
---------------------------------------------------------------------------------------------------
local D: any = nil
do
	local mod = ReplicatedStorage:FindFirstChild("GwangalliSeaData") or ReplicatedStorage:WaitForChild("GwangalliSeaData", 10)
	if mod and mod:IsA("ModuleScript") then
		local ok, res = pcall(require, mod)
		if ok and type(res) == "table" then
			D = res
		else
			warnf("GwangalliSeaData failed to load:", res)
		end
	end
end
Env.hasData = D ~= nil
D = D or {}
local function num(v: any, d: number): number
	return if type(v) == "number" and v == v then v else d
end
local A = num(D.A, 0.0000324)
local W0, WK, WH = num(D.W0, 280), num(D.WK, 170), num(D.WH, 2380)
local SY, TY = num(D.SY, 0.3), num(D.TY, 3.5)
local FD, FY = num(D.FD, 150), num(D.FY, -5)
local OD, OY = num(D.OD, 500), num(D.OY, -30)
Env.D = D
Env.SY, Env.TY = SY, TY
Env.beachX0, Env.beachX1 = num(D.beachX0, -2380), num(D.beachX1, 2380)
Env.WALK = num(D.walk, 6.5)
local FORE_K = (SY - FY) / FD -- foreshore slope (y per stud seaward, along world Z)
local EDGE_OFF = SY / FORE_K -- the y = 0 edge lies this far seaward of the 0.3 contour
Env.FORE_K = FORE_K

local function P(x: number): number
	return -A * x * x
end
local function sandWidth(x: number): number
	local t = math.clamp(x / WH, -1, 1)
	return W0 - WK * t * t
end
function Env.shoreZ(x: number): number
	return P(x) - sandWidth(x)
end
function Env.edgeZ(x: number): number
	return Env.shoreZ(x) - EDGE_OFF
end
-- d shoreZ / dX
local function shoreSlope(x: number): number
	local s = -2 * A * x
	if math.abs(x) < WH then
		s += 2 * WK * x / (WH * WH)
	end
	return s
end
-- Beach / sea-bed height at world (x, z): the profile of coast_geo.heightAtWorld.
function Env.sandHeight(x: number, z: number): number
	local zs = Env.shoreZ(x)
	if z >= zs then
		return SY + (TY - SY) * (z - zs) / sandWidth(x)
	end
	local d = zs - z
	if d <= FD then
		return SY + (FY - SY) * d / FD
	end
	if d <= OD then
		return FY + (OY - FY) * (d - FD) / (OD - FD)
	end
	return OY
end
-- Unit tangent (+X-ish), inland unit normal, and the foreshore slope along that normal.
function Env.shoreFrame(x: number): (Vector3, Vector3, number)
	local s = shoreSlope(x)
	local k = math.sqrt(1 + s * s)
	return Vector3.new(1 / k, 0, s / k), Vector3.new(-s / k, 0, 1 / k), FORE_K * k
end
-- Plan.point (masterplan curvilinear coordinates): station x, inland offset n.
function Env.planPoint(x: number, n: number, y: number?): Vector3
	local s = -2 * A * x
	local k = math.sqrt(1 + s * s)
	return Vector3.new(x - s / k * n, y or Env.WALK, P(x) + n / k)
end

-- Nearest point on a polyline given as { {x, z, w?}, ... }: returns x, z, distance, weight.
function Env.nearestOn(list: { any }, px: number, pz: number): (number, number, number, number)
	local bx, bz, bd, bw = px, pz, math.huge, 0
	local n = #list
	for i = 1, n - 1 do
		local a, b = list[i], list[i + 1]
		local ax, az, cx, cz = a[1], a[2], b[1], b[2]
		local dx, dz = cx - ax, cz - az
		local len2 = dx * dx + dz * dz
		-- skip jumps between separate coast pieces (long gaps)
		if len2 < 250 * 250 then
			local t = if len2 > 0 then math.clamp(((px - ax) * dx + (pz - az) * dz) / len2, 0, 1) else 0
			local qx, qz = ax + dx * t, az + dz * t
			local ex, ez = px - qx, pz - qz
			local d = ex * ex + ez * ez
			if d < bd then
				bd = d
				bx, bz = qx, qz
				bw = (a[3] or 1) + ((b[3] or 1) - (a[3] or 1)) * t
			end
		end
	end
	if n == 1 then
		local a = list[1]
		local ex, ez = px - a[1], pz - a[2]
		return a[1], a[2], math.sqrt(ex * ex + ez * ez), a[3] or 1
	end
	return bx, bz, math.sqrt(bd), bw
end

-- Terrain surface height (sand, ignoring water) by raycast, cached on a 2-stud grid once the
-- terrain fill has finished (workspace.GwangalliTerrainReady). Falls back to `fallback`. At most
-- Env.RAYS_PER_FRAME new raycasts per frame (a teleport must not stall a frame): the second return
-- value is false when the height is only the fallback and the caller may ask again later.
local groundCache: { [number]: number } = {}
local rayParams: RaycastParams? = nil
local rayBudget = 0
local RAYS = { low = 4, mid = 8, high = 12 }
local function terrainReady(): boolean
	return workspace:GetAttribute("GwangalliTerrainReady") == true
end
function Env.groundY(x: number, z: number, fallback: number): (number, boolean)
	if not terrainReady() then
		return fallback, false
	end
	local key = math.floor(x / 2 + 0.5) * 131072 + math.floor(z / 2 + 0.5)
	local c = groundCache[key]
	if c then
		return c, true
	end
	if rayBudget <= 0 then
		return fallback, false
	end
	rayBudget -= 1
	local terrain = workspace.Terrain
	if not rayParams then
		local ok, rp = pcall(function()
			local p = RaycastParams.new()
			p.FilterType = Enum.RaycastFilterType.Include
			p.FilterDescendantsInstances = { terrain }
			p.IgnoreWater = true
			return p
		end)
		if not ok then
			return fallback, false
		end
		rayParams = rp
	end
	local okRay, hit = pcall(function()
		return workspace:Raycast(Vector3.new(x, fallback + 12, z), Vector3.new(0, -30, 0), rayParams)
	end)
	local y = fallback
	if okRay and hit and hit.Instance == terrain and math.abs(hit.Position.Y - fallback) < 6 then
		y = hit.Position.Y
	end
	groundCache[key] = y
	return y, true
end

---------------------------------------------------------------------------------------------------
-- Time
---------------------------------------------------------------------------------------------------
function Env.now(): number
	local ok, t = pcall(workspace.GetServerTimeNow, workspace)
	return if ok and type(t) == "number" then t else os.clock()
end
function Env.clock(): number
	local c = Lighting.ClockTime
	return if type(c) == "number" then c else 12
end
function Env.isNight(): boolean
	local a = workspace:GetAttribute("GwangalliIsNight")
	if type(a) == "boolean" then
		return a
	end
	local c = Env.clock()
	return c >= 17.8 or c < 6.2
end
-- 0 at night, 1 in full day, smooth through dawn (5-7) and dusk (17.3-19.3).
function Env.daylight(): number
	local c = Env.clock()
	if c < 5 or c >= 19.3 then
		return 0
	elseif c < 7 then
		local f = (c - 5) / 2
		return f * f * (3 - 2 * f)
	elseif c < 17.3 then
		return 1
	end
	local f = 1 - (c - 17.3) / 2
	return f * f * (3 - 2 * f)
end
function Env.hourIn(a: number, b: number): boolean
	local c = Env.clock()
	if a <= b then
		return c >= a and c < b
	end
	return c >= a or c < b
end

-- Deterministic hash -> 0..1
function Env.hash(a: number, b: number?): number
	local h = math.sin(a * 12.9898 + (b or 0) * 78.233) * 43758.5453
	return h - math.floor(h)
end

---------------------------------------------------------------------------------------------------
-- Swell (shared by surf, spray and bobbing)
---------------------------------------------------------------------------------------------------
Env.WAVE_T = 8.4 -- seconds between breakers (gentle bay swell)
Env.WAVE_L = 950 -- along-shore crest spacing: crests sweep along the beach at ~110 studs/s
function Env.wavePhase(t: number, x: number): number
	local p = t / Env.WAVE_T - x / Env.WAVE_L
	return p - math.floor(p)
end
-- The index of the wave (integer), so a caller can tell a new breaker arrived.
function Env.waveIndex(t: number, x: number): number
	return math.floor(t / Env.WAVE_T - x / Env.WAVE_L)
end
-- Set grouping: every ~3rd wave is bigger (0.7 .. 1.3).
function Env.waveSet(t: number, x: number): number
	local i = Env.waveIndex(t, x)
	return 1 + 0.22 * math.sin(i * 2.09 + 0.6) + 0.08 * math.sin(i * 5.3)
end

---------------------------------------------------------------------------------------------------
-- Wind (Workspace.GlobalWind; NightSea writes the day / night breeze)
---------------------------------------------------------------------------------------------------
Env.wind = Vector3.new(-3, 0, 10)
Env.windDir = Env.wind.Unit
Env.windSpeed = Env.wind.Magnitude
function Env.readWind()
	local ok, w = pcall(function()
		return workspace.GlobalWind
	end)
	if ok and typeof(w) == "Vector3" then
		local h = Vector3.new(w.X, 0, w.Z)
		if h.Magnitude > 0.05 then
			Env.wind = w
			Env.windDir = h.Unit
			Env.windSpeed = h.Magnitude
		end
	end
end
Env.readWind()
function Env.gust(t: number, x: number, z: number): number
	-- gusts travel downwind at ~12 studs/s; two octaves
	local s = (x * Env.windDir.X + z * Env.windDir.Z) / 12
	return 1 + 0.3 * math.sin((t - s) * 0.45) + 0.15 * math.sin((t - s) * 1.37 + 1.3)
end

---------------------------------------------------------------------------------------------------
-- Camera
---------------------------------------------------------------------------------------------------
function Env.camera(): Camera?
	return workspace.CurrentCamera
end
function Env.focus(): Vector3
	local cam = workspace.CurrentCamera
	if cam then
		return cam.CFrame.Position
	end
	return Vector3.new(0, 10, -200)
end

-- camera position / look, read once per frame (Env.behind is called per subject)
local frameNo = 0
local viewFrame = -1
local viewPos, viewLook = Vector3.zero, Vector3.zero
function Env.behind(pos: Vector3, radius: number?): boolean
	if viewFrame ~= frameNo then
		viewFrame = frameNo
		local cam = workspace.CurrentCamera
		if cam then
			local cf = cam.CFrame
			viewPos, viewLook = cf.Position, cf.LookVector
		else
			viewLook = Vector3.zero
		end
	end
	local v = pos - viewPos
	return v:Dot(viewLook) < -0.2 * v.Magnitude - (radius or 0)
end

---------------------------------------------------------------------------------------------------
-- Client-only container + part factory
---------------------------------------------------------------------------------------------------
local folder = Instance.new("Folder")
folder.Name = "GwangalliAmbienceClient"
folder.Parent = workspace
Env.folder = folder

function Env.sub(name: string): Folder
	local f = folder:FindFirstChild(name)
	if f and f:IsA("Folder") then
		return f
	end
	local nf = Instance.new("Folder")
	nf.Name = name
	nf.Parent = folder
	return nf
end

local HIDDEN_CF = CFrame.new(0, -500, 0)
Env.HIDDEN_CF = HIDDEN_CF

function Env.part(parent: Instance?, size: Vector3, color: Color3, material: Enum.Material?, transparency: number?, name: string?, shape: string?): BasePart
	local p = Instance.new("Part")
	p.Name = name or "Ambience"
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Locked = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Transparency = transparency or 0
	if shape == "Ball" then
		p.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		p.Shape = Enum.PartType.Cylinder
	elseif shape == "Wedge" then
		p.Shape = Enum.PartType.Wedge
	end
	p.Size = size
	p.CFrame = HIDDEN_CF
	if shape == "Ellipsoid" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.Parent = parent
	return p
end

-- workspace:BulkMoveTo with a pcall'd fallback to per-part CFrame writes.
local bulkOk = true
function Env.move(parts: { BasePart }, cframes: { CFrame })
	if #parts == 0 then
		return
	end
	if bulkOk then
		local ok = pcall(function()
			workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
		end)
		if ok then
			return
		end
		bulkOk = false
	end
	for i, p in parts do
		p.CFrame = cframes[i]
	end
end

-- Set a property only when it changed by more than eps (numbers) / at all (others).
function Env.setNum(inst: any, prop: string, value: number, cache: { [any]: number }, eps: number?)
	local last = cache[inst]
	if last == nil or math.abs(last - value) > (eps or 0.015) then
		cache[inst] = value
		inst[prop] = value
	end
end

-- CollectionService tag watch restricted to the Workspace (streaming-safe): onAdded for present and
-- future instances, onRemoved when one streams out / loses the tag.
function Env.watchTag(tag: string, onAdded: (Instance) -> (), onRemoved: (Instance) -> ())
	local function add(inst: Instance)
		if inst:IsDescendantOf(workspace) then
			local ok, err = pcall(onAdded, inst)
			if not ok then
				warnf("tag", tag, err)
			end
		end
	end
	CollectionService:GetInstanceAddedSignal(tag):Connect(add)
	CollectionService:GetInstanceRemovedSignal(tag):Connect(function(inst)
		local ok, err = pcall(onRemoved, inst)
		if not ok then
			warnf("tag", tag, err)
		end
	end)
	task.spawn(function()
		local list = CollectionService:GetTagged(tag)
		for i, inst in list do
			add(inst)
			if i % 200 == 0 then
				task.wait()
			end
		end
	end)
end

---------------------------------------------------------------------------------------------------
-- Scheduler + cost accounting
---------------------------------------------------------------------------------------------------
type Job = { name: string, hz: any, fn: (number, number) -> (), acc: number, errors: number, dead: boolean }
local jobs: { Job } = {}
Env.stats = {} :: { [string]: { ms: number, frameMs: number, calls: number, errors: number } }

function Env.every(name: string, hz: any, fn: (number, number) -> ())
	local job: Job = { name = name, hz = hz, fn = fn, acc = math.random() * 0.05, errors = 0, dead = false }
	table.insert(jobs, job)
	Env.stats[name] = { ms = 0, frameMs = 0, calls = 0, errors = 0 }
	return job
end

local function rateOf(job: Job): number
	local hz = job.hz
	if type(hz) == "function" then
		local ok, v = pcall(hz)
		hz = if ok then v else 10
	end
	return math.clamp(tonumber(hz) or 10, 0.2, 60)
end

local clock = os.clock
local rayTier = RAYS[Env.tier()] or 8
local JOBS_PER_FRAME = { low = 2, saver = 2, mid = 3, high = 4 }
local jobCap = Env.pick(JOBS_PER_FRAME)
Env.onTier(function(t)
	rayTier = RAYS[t] or 8
	jobCap = Env.pick(JOBS_PER_FRAME)
end)
local jobStart = 1 -- round robin: the first job skipped for the cap goes first next frame
RunService.Heartbeat:Connect(function(dt: number)
	rayBudget = rayTier
	frameNo += 1
	local now = Env.now()
	local ran = 0
	local n = #jobs
	local nextStart = jobStart
	for k = 0, n - 1 do
		local idx = (jobStart + k - 1) % n + 1
		local job = jobs[idx]
		if not job.dead then
			local st = Env.stats[job.name]
			job.acc += dt
			local period = 1 / rateOf(job)
			local spent = 0
			if job.acc >= period and ran >= jobCap then
				if nextStart == jobStart then
					nextStart = idx -- due but over the cap: first in line next frame
				end
			elseif job.acc >= period then
				ran += 1
				local elapsed = job.acc
				job.acc = if job.acc > period * 3 then 0 else job.acc - period
				local t0 = clock()
				local ok, err = pcall(job.fn, now, elapsed)
				spent = (clock() - t0) * 1000
				st.calls += 1
				st.ms = st.ms * 0.95 + spent * 0.05
				if not ok then
					job.errors += 1
					st.errors += 1
					if job.errors >= 5 then
						job.dead = true
						warnf(job.name, "disabled after repeated errors:", err)
					elseif job.errors == 1 then
						warnf(job.name, err)
					end
				end
			end
			st.frameMs = st.frameMs * 0.98 + spent * 0.02
		end
	end
	jobStart = if nextStart ~= jobStart then nextStart else (jobStart % math.max(1, n)) + 1
end)

function Env.report(): string
	local parts = {}
	local total = 0
	local names = {}
	for name in Env.stats do
		table.insert(names, name)
	end
	table.sort(names)
	for _, name in names do
		local st = Env.stats[name]
		total += st.frameMs
		table.insert(parts, string.format("%s %.3f", name, st.frameMs))
	end
	return string.format("per-frame ms (EMA): total %.3f | %s", total, table.concat(parts, ", "))
end

return Env
