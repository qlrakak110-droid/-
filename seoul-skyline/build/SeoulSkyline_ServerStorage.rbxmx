<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="4"><Item class="ModuleScript" referent="RBX00000000000000000000000000000010"><Properties><string name="Name">SeoulSkyline</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline — 한강 잠실 야경 맵 빌더 (롯데월드타워 모티브)
--
-- 사용법
--   * Studio 커맨드 바(편집 모드에 맵을 굽기, 권장):
--       require(game.ServerStorage.SeoulSkyline).Build()
--     → Workspace.SeoulSkyline + Terrain + Lighting 이 생성됩니다. 그대로 저장(Ctrl+S)하세요.
--   * 실행 중 자동 생성: ServerScriptService.SeoulSkylineBoot 가 Workspace 에 맵이 없으면 Build() 를 호출합니다.
--   * SeoulSkyline.Clear()  : 맵 모델 + 맵이 만든 지형 영역 제거
--   * SeoulSkyline.SetNight(true/false) : 창문/가로등 발광 전환 (DayNightCycle 용)
--
-- 모듈 규약: 각 모듈은 build(ctx) 를 가진 ModuleScript.
--   ctx = { Config, Kit, Facade, root: Model, model: Model(모듈 전용 그룹), rng: Random(모듈별 시드) }

local CollectionService = game:GetService("CollectionService")
local Config = require(script.Config)
local Kit = require(script.Kit)
local Facade = require(script.Facade)

local SeoulSkyline = {}
local nightState: boolean? = nil -- SetNight 의 마지막 상태(중복 적용 방지)
SeoulSkyline.Config = Config
SeoulSkyline.Kit = Kit
SeoulSkyline.Facade = Facade

-- 빌드 순서 = 발자국 예약 우선순위 (랜드마크/히어로가 먼저 자리를 잡고, 도시가 빈 곳을 채움)
SeoulSkyline.MODULES = {
	"Atmosphere",
	"TerrainPlan",
	"Landmark",
	"LandmarkInterior", -- 타워 로비 + 서울스카이 전망대 + 몰 아트리움 (실내)
	"Skyline",
	"Bridge",
	"Riverside",
	"Park",
	"ShowHome", -- 한강뷰 아파트 1동: 로비 + 엘리베이터 + 가구가 갖춰진 세대 (실내) — Apartments 보다 먼저 자리 예약
	"Apartments",
	"CityCarpet",
	"WaterFx",
}

local function hash(s: string): number
	local h = 0
	for i = 1, #s do
		h = (h * 31 + string.byte(s, i)) % 2147483647
	end
	return h
end

export type BuildOpts = {
	only: { [string]: boolean }?, -- 일부 모듈만 (미리보기/디버그)
	applyTerrain: boolean?, -- false: 지형은 기록만
	parent: Instance?,
	quiet: boolean?,
}

function SeoulSkyline.Build(opts: BuildOpts?): Model
	local o: BuildOpts = opts or {}
	local t0 = os.clock()
	local old = workspace:FindFirstChild(Config.ROOT_NAME)
	if old then
		old:Destroy()
	end
	local root = Instance.new("Model")
	root.Name = Config.ROOT_NAME
	pcall(function()
		root.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	root:SetAttribute("Version", Config.VERSION)
	root:SetAttribute("HeroCamPos", Config.Viewpoint.HeroCamPos)
	root:SetAttribute("HeroCamLook", Config.Viewpoint.HeroCamLook)
	root:SetAttribute("HeroFov", Config.Viewpoint.HeroFov)
	root:SetAttribute("IntroCinematic", Config.Client.IntroCinematic)
	root:SetAttribute("Traffic", Config.Client.Traffic)
	root:SetAttribute("TrafficDensity", Config.Client.TrafficDensity)
	root:SetAttribute("Beacons", Config.Client.Beacons)
	root:SetAttribute("Boats", Config.Client.Boats)
	Kit.reset(root)
	Kit.applyTerrain = o.applyTerrain ~= false
	local report = {}
	for _, name in SeoulSkyline.MODULES do
		if o.only and not o.only[name] then
			continue
		end
		local mod = script:FindFirstChild(name)
		if not mod then
			continue
		end
		local p0, tm = Kit.stats.parts, os.clock()
		local ok, err = pcall(function()
			local M = require(mod :: ModuleScript) :: any
			local model = Kit.group(root, name)
			M.build({ Config = Config, Kit = Kit, Facade = Facade, root = root, model = model, rng = Random.new(Config.SEED + hash(name)) })
			if #model:GetChildren() == 0 then
				model:Destroy()
			end
		end)
		if not ok then
			warn(string.format("[SeoulSkyline] %s 빌드 실패: %s", name, tostring(err)))
		end
		table.insert(report, string.format("%s %d parts %.1fs", name, Kit.stats.parts - p0, os.clock() - tm))
		task.wait()
	end
	root.Parent = o.parent or workspace
	-- 새 파트는 모두 밤 상태로 만들어지므로 캐시를 비우고 현재 하늘 시각으로 다시 맞춤(재빌드 시 낮인데 불이 켜진 채 남는 문제 방지)
	nightState = nil
	SeoulSkyline.SetNight(SeoulSkyline.IsNightClock(game:GetService("Lighting").ClockTime))
	if not o.quiet then
		print(string.format("[SeoulSkyline] 완료: 파트 %d · 광원 %d · 항공등 %d · 지형 %d · %.1f초\n  %s", Kit.stats.parts, Kit.stats.lights, Kit.stats.beacons, Kit.stats.terrainOps, os.clock() - t0, table.concat(report, "\n  ")))
	end
	return root
end

function SeoulSkyline.ApplyLighting()
	require(script.Atmosphere).apply()
end

function SeoulSkyline.Clear()
	local old = workspace:FindFirstChild(Config.ROOT_NAME)
	if old then
		old:Destroy()
	end
	local R, F, N, L = Config.River, Config.FarBank, Config.NearBank, Config.Level
	local zMin, zMax = F.SlopeTo - 40, N.SlopeTo + 40
	workspace.Terrain:FillBlock(CFrame.new((R.XMin + R.XMax) / 2, (L.RiverBed - 20 + L.Levee + 20) / 2, (zMin + zMax) / 2), Vector3.new(R.XMax - R.XMin, L.Levee - L.RiverBed + 40, zMax - zMin), Enum.Material.Air)
end

function SeoulSkyline.IsNightClock(t: number): boolean
	local L = Config.Lighting
	return t >= L.NightFrom or t < L.NightTo
end

function SeoulSkyline.SetNight(on: boolean)
	if nightState == on then
		return
	end
	nightState = on
	for _, inst in CollectionService:GetTagged(Kit.GLOW_TAG) do
		if inst:IsA("BasePart") then
			local key = if on then "Night" else "Day"
			local mat = inst:GetAttribute(key .. "Material")
			local col = inst:GetAttribute(key .. "Color")
			if typeof(mat) == "string" then
				local ok, m = pcall(function()
					return (Enum.Material :: any)[mat]
				end)
				if ok and m then
					inst.Material = m
				end
			end
			if typeof(col) == "Color3" then
				inst.Color = col
			end
		elseif inst:IsA("Light") then
			inst.Enabled = on
		end
	end
end

return SeoulSkyline
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000000000000000000000000000001"><Properties><string name="Name">Apartments</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Apartments
-- 한국형 아파트 단지 — 먼 쪽 잠실 강변 띠(ApartmentsFar) + 관람자 뒤 강북 띠(ApartmentsNear). 실제 스케일(1 stud = 0.3 m).
--   * 판상 동: 길이 40~70 m(137~227 stud) × 깊이 12~15 m(40~50 stud), 15~35층, 층고 2.9 m(Config.Real.HomeFloor)
--     + 필로티 3.5 m → 높이 = 필로티 + 층수 × 2.9 m + 옥상 파라펫 1.2 m (15층 ≈ 48 m, 35층 ≈ 106 m).
--   * 신축 타워형 단지: 35~49층(층고 3.0 m, 높이 110~153 m), 평면 26~36 m, 원형/커튼월 + 왕관 프레임.
--   * 단지 = 같은 벽색 + 측벽 슈퍼그래픽 강조색 + 동 번호("101동", 대단지 "1201동" — 글자 높이 3 m)를 공유하는 4~10동.
--     동 간격: 앞뒤 30~50 m(인동 거리, 높이에 비례), 좌우 10~22 m. 단지(로트) 사이 도로 = 4차로(3.5 m) + 보도 3 m × 2.
--   * 모든 동/잔디/상가/나무는 Kit.isFreeRect 검사 후 Kit.reserveRect (앞서 빌드된 랜드마크·고층·도로를 피함).
--   * LOD: 히어로 카메라/전망대에서 가까운 단지부터 "full"(Facade apartment: 층 슬래브·세대 벽·동 번호) →
--     "lite"(벽색 몸체 + 층 묶음 불빛 + 발코니 띠) → "min"(몸체 + 불빛 면 하나 + 꺼진 세대 몇 개). 파트 예산 안에서 계획.
--   * 강변 앞줄은 밀도를 낮추고(몇 개 대단지만), 히어로 구도에서 롯데타워·몰 앞을 가리는 동은 배치하지 않음.
--   * 실제 광원 0개 — 불빛은 모두 Neon(glow 태그로 낮/밤 전환).

local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)
local Facade = require(script.Parent.Facade)

local Apartments = {}

local rgb = Color3.fromRGB
local P = Config.Palette
local ZN = Config.Zones
local R = Config.Real
local M = Config.m
local CITY_Y = Config.Level.City
local BLACK = Color3.new(0, 0, 0)
local MAT = Enum.Material

------------------------------------------------------------------------------------------------------
-- 상수 (실측 m → stud)
------------------------------------------------------------------------------------------------------
local BUDGET_TOTAL = 9000 -- 모듈 전체 파트 상한(하드 캡)
local BUDGET_FAR = 7050 -- 먼 쪽 띠 계획 예산(추정치는 실제보다 ~10% 큼)
local BUDGET_NEAR = 2700 -- 가까운 쪽 띠
local FULL_FAR = 3300 -- 먼 쪽 정밀 모델 예산
local FULL_NEAR = 1250
local FULL_RANGE_FAR = 4700 -- 히어로 카메라 가중 거리 이내 단지만 정밀
local FULL_RANGE_NEAR = 1900 -- 전망대 거리
local LITE_RANGE_FAR = 7800 -- 이보다 멀면 min LOD
local LITE_RANGE_NEAR = 3200

local FLOOR_H = R.HomeFloor -- 아파트 층고 2.9 m (Facade apartment 기본값과 동일)
local PILOTIS = FLOOR_H * 1.2 -- 필로티 3.5 m (Facade 와 동일)
local PARAPET = FLOOR_H * 0.4 -- 옥상 파라펫 슬래브 1.2 m
local TOWER_FLOOR_H = M(3.0) -- 신축 타워형 층고 3.0 m
local TOWER_LOBBY = 20 -- Facade curtain/round 로비 높이(6 m) — 타워 높이 계산용
local UNIT = 15 -- Facade apartment 세대 벽 간격(4.5 m) 기본값
local PAD = M(3) -- 동 둘레 보도 여유(예약)
local STREET = R.Lane * 4 + M(3) * 2 -- 로트 사이 도로: 4차로 + 양쪽 보도 = 20 m
local LAWN_T = 0.5 -- 단지 잔디 두께(도시 지면 위)
local LAWN_MX, LAWN_MZ = M(10), M(12) -- 동 배열 둘레 잔디/산책로 여유
local SHOP_ROOM = M(18) -- 단지 상가 자리(로트 안에서 비워 둠)
local SHOP_GAP = M(4)
local END_W = M(0.6) -- 경량 모델 측벽 두께
local LABEL_H = M(3) -- 동 번호 글자 높이 3 m

local HERO = Config.Viewpoint.HeroCamPos
local HERO_LOOK = Config.Viewpoint.HeroCamLook
local DECK = Config.Viewpoint.DeckCenter

-- 단지 벽색(크림·베이지·연회색·아이보리) / 슈퍼그래픽 강조색
local WALLS = {
	rgb(224, 218, 206),
	rgb(208, 198, 182),
	rgb(214, 212, 206),
	rgb(228, 216, 196),
	rgb(198, 192, 186),
	rgb(212, 200, 190),
	rgb(190, 196, 200),
	rgb(220, 206, 186),
}
local ACCENTS = {
	rgb(58, 104, 158),
	rgb(36, 58, 96),
	rgb(166, 90, 62),
	rgb(82, 122, 80),
	rgb(210, 136, 56),
	rgb(112, 82, 136),
	rgb(64, 142, 152),
	rgb(146, 48, 54),
}
-- 신축 타워 유리/프레임
local TOWER_GLASS = { P.GlassSilver, P.GlassBlue, P.GlassTeal, rgb(118, 112, 104), P.GlassDeep }
local TOWER_FRAME = { P.MullionLight, rgb(204, 198, 186), P.Mullion, rgb(150, 132, 104) }
-- 옥상 LED 는 블룸 대비 어둡게(멀리서 지붕 전체가 번쩍이지 않게)
local CROWN_LED = { rgb(150, 110, 52), rgb(52, 120, 140), rgb(44, 86, 150), rgb(160, 120, 70), rgb(120, 130, 150) }
-- 단지 상가 간판
local SIGNS = { rgb(90, 200, 230), rgb(220, 96, 180), rgb(236, 236, 224), rgb(240, 190, 90), rgb(110, 220, 140), rgb(250, 120, 90) }
local LEAVES = { P.Leaf1, P.Leaf2, rgb(40, 70, 46), rgb(52, 80, 46) }

-- 창 조명: Facade.LIT_HOME 을 블룸 대비 한 톤 낮춤(넓은 Neon 면 → 은은하게) + 일부 단지는 LED 흰빛 섞음
local function dim(c: Color3, k: number): Color3
	return c:Lerp(BLACK, k)
end
local function dimList(t: { Color3 }, k: number): { Color3 }
	local out = {}
	for i, c in t do
		out[i] = dim(c, k)
	end
	return out
end
local LIT_WARM = dimList(Facade.LIT_HOME, 0.36)
local LIT_MIXED = dimList({ P.WindowWarm, P.WindowGold, P.WindowCoolDim, P.WindowCool, P.WindowWarmDim }, 0.38)
local LIT_LITE = dimList(Facade.LIT_HOME, 0.3) -- 경량 모델 세대 줄(면적이 작아 조금 밝게)

------------------------------------------------------------------------------------------------------
-- 타입
------------------------------------------------------------------------------------------------------
type Zone = { XMin: number, XMax: number, ZMin: number, ZMax: number }

type Slab = {
	x: number,
	z: number,
	w: number,
	d: number,
	h: number,
	floors: number,
	yaw: number,
	style: string, -- "apartment" | "curtain" | "round"
	label: string,
}

type Extra = { kind: string, x: number, z: number, w: number, d: number, h: number, yaw: number, color: Color3 }

type Complex = {
	name: string,
	kind: string, -- "slab" | "tower"
	lod: string, -- "full" | "lite" | "min"
	wall: Color3,
	accent: Color3,
	dark: Color3,
	glass: Color3,
	frame: Color3,
	led: Color3,
	crown: string?,
	lit: { Color3 },
	litChance: number,
	slabs: { Slab },
	extras: { Extra },
	lawn: { number }?, -- cx, cz, w, d, yaw
	cost: number,
}

type Lot = { x0: number, z0: number, x1: number, z1: number, prio: number, idx: number }

type ZoneOpts = {
	key: string,
	zone: Zone,
	pitchX: number,
	pitchZ: number,
	viewer: Vector3, -- 우선순위 기준점(히어로 카메라 / 전망대)
	frustum: boolean, -- true: 히어로 화면 밖 로트는 우선순위 낮춤
	budget: number,
	fullBudget: number,
	fullRange: number,
	liteRange: number,
	towerChance: number,
	waterZ: number, -- 강변 앞줄 경계(이보다 강 쪽 = 앞줄)
	waterSign: number, -- 강 방향(+1 = +Z)
	labelFace: number, -- 동 번호 면이 향할 Z 방향(+1 = +Z)
	guard: boolean,
}

------------------------------------------------------------------------------------------------------
-- 보조
------------------------------------------------------------------------------------------------------
local function pick<T>(rng: Random, t: { T }): T
	return t[rng:NextInteger(1, #t)]
end

local function jitter(rng: Random, c: Color3, amt: number): Color3
	local k = 1 + (rng:NextNumber() * 2 - 1) * amt
	return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
end

-- 히어로 카메라 기준 수평 방위각(도): 오른쪽(+X) = +
local function bearing(x: number, z: number): number
	return math.deg(math.atan2(x - HERO.X, HERO.Z - z))
end
local LOOK_BEARING = bearing(HERO_LOOK.X, HERO_LOOK.Z)

-- 타워 시야 보호: 히어로 카메라에서 롯데타워 + 몰을 덮는 방위각 구간 (타워보다 카메라 쪽에 있는 동만 거부)
local GUARD_B0, GUARD_B1 = math.huge, -math.huge
do
	local T, Mall = Config.Landmark.Tower, Config.Landmark.Mall
	local r = T.BaseWidth * 0.75
	for _, c in { { T.Center.X - r, T.Center.Z - r }, { T.Center.X + r, T.Center.Z - r }, { T.Center.X - r, T.Center.Z + r }, { T.Center.X + r, T.Center.Z + r }, { Mall.Min.X, Mall.Min.Y }, { Mall.Max.X, Mall.Min.Y }, { Mall.Min.X, Mall.Max.Y }, { Mall.Max.X, Mall.Max.Y } } do
		local b = bearing(c[1], c[2])
		GUARD_B0 = math.min(GUARD_B0, b - 1.2)
		GUARD_B1 = math.max(GUARD_B1, b + 1.2)
	end
end
local GUARD_Z = Config.Landmark.Tower.Center.Z

local function blocksLandmark(x0: number, z0: number, x1: number, z1: number): boolean
	if math.max(z0, z1) < GUARD_Z then
		return false
	end
	local bmin, bmax = math.huge, -math.huge
	for _, c in { { x0, z0 }, { x1, z0 }, { x0, z1 }, { x1, z1 } } do
		local b = bearing(c[1], c[2])
		bmin = math.min(bmin, b)
		bmax = math.max(bmax, b)
	end
	return bmax > GUARD_B0 and bmin < GUARD_B1
end

-- 회전된 사각형이 구역 안에 완전히 들어가는가
local function insideZone(zone: Zone, x: number, z: number, w: number, d: number, yaw: number): boolean
	local x0, z0, x1, z1 = Kit.rotatedAABB(x, z, w, d, yaw)
	return x0 >= zone.XMin and x1 <= zone.XMax and z0 >= zone.ZMin and z1 <= zone.ZMax
end

local function placeable(o: ZoneOpts, x: number, z: number, w: number, d: number, yaw: number): boolean
	if not insideZone(o.zone, x, z, w, d, yaw) then
		return false
	end
	if not Kit.isFreeRect(x, z, w, d, yaw) then
		return false
	end
	if o.guard then
		local x0, z0, x1, z1 = Kit.rotatedAABB(x, z, w, d, yaw)
		if blocksLandmark(x0, z0, x1, z1) then
			return false
		end
	end
	return true
end

-- 판상 동 높이: 필로티 + 층수 × 층고 + 옥상 파라펫(Facade 의 마지막 슬래브가 딱 맞게)
local function slabHeight(floors: number): number
	return PILOTIS + floors * FLOOR_H + PARAPET
end
local function towerHeight(floors: number): number
	return TOWER_LOBBY + 1.6 + floors * TOWER_FLOOR_H
end

-- 정밀 모델 파트 수 추정(계획 단계 예산용; 실제 수는 빌드 때 측정)
local function estFull(s: Slab, lc: number, crown: string?): number
	if s.style == "apartment" then
		local nu = math.max(2, math.floor(s.w / UNIT))
		local n = s.floors
		return 14 + n + math.ceil(n / 4.5) + nu + math.min(30, math.floor(n * nu * (1 - lc) / 3)) + (if crown then 7 else 0)
	end
	local n = s.floors
	if s.style == "round" then
		return 12 + n + math.ceil(n / 4.5)
	end
	local bay = if s.w > 90 then 12 else 10
	local nx = math.max(1, math.floor(s.w / bay))
	local nz = math.max(1, math.floor(s.d / bay))
	return 18 + n + math.ceil(n / 4.5) + nx + nz + math.min(26, math.floor(n * (nx + nz) * (1 - lc) / 9))
end

-- 경량 동 구성: 발코니 띠 간격(층) / 꺼진 세대 패치 수
local function bandStep(floors: number): number
	return if floors <= 18 then 2 else 3
end
local function nOff(s: Slab, lc: number): number
	local nu = math.max(2, math.floor((s.w - 2 * END_W) / UNIT))
	return math.clamp(math.floor(s.floors * nu * (1 - lc) / 16), 2, 7)
end

local function estLite(s: Slab, lc: number, crown: string?): number
	if s.style ~= "apartment" then
		return 3 + math.clamp(math.floor(s.h / 36), 1, 6)
	end
	return 6 + math.floor(s.floors / bandStep(s.floors)) + nOff(s, lc) + (if crown then 1 else 0)
end

local function estMin(s: Slab): number
	if s.style ~= "apartment" then
		return 3
	end
	return 6
end

------------------------------------------------------------------------------------------------------
-- 계획: 로트 하나에 단지 하나
------------------------------------------------------------------------------------------------------
local function planComplex(o: ZoneOpts, lot: Lot, rng: Random, serial: number, lod: string, big: boolean, waterfront: boolean): Complex?
	local lx, lz = (lot.x0 + lot.x1) / 2, (lot.z0 + lot.z1) / 2
	local LW, LD = lot.x1 - lot.x0, lot.z1 - lot.z0
	local isTower = (not big) and rng:NextNumber() < o.towerChance
	-- 단지 방향: 0(긴 면이 강/카메라 쪽) / 90(측벽 동 번호가 카메라 쪽) / 15~30 비스듬
	local r = rng:NextNumber()
	local orient = if r < 0.6 then 0 elseif r < 0.82 then 90 else 1
	local frameYaw = 0
	local ex, ez = LW, LD -- 단지 로컬 X(동 긴 축) / Z 범위
	if orient == 90 then
		frameYaw = 90
		ex, ez = LD, LW
	elseif orient == 1 then
		frameYaw = rng:NextNumber(15, 30) * (if rng:NextNumber() < 0.5 then -1 else 1)
		ex, ez = LW * 0.8, LD * 0.8
	end
	-- 잔디 둘레 + 상가 자리
	ex -= 2 * LAWN_MX + SHOP_ROOM * 0.5
	ez -= 2 * LAWN_MZ + SHOP_ROOM * 0.5

	local cx: Complex = {
		name = string.format("Danji_%s%02d", o.key, serial),
		kind = if isTower then "tower" else "slab",
		lod = lod,
		wall = pick(rng, WALLS),
		accent = pick(rng, ACCENTS),
		dark = rgb(40, 42, 50),
		glass = pick(rng, TOWER_GLASS),
		frame = pick(rng, TOWER_FRAME),
		led = pick(rng, CROWN_LED),
		crown = nil,
		lit = if rng:NextNumber() < 0.7 then LIT_WARM else LIT_MIXED,
		litChance = rng:NextNumber(0.5, 0.7),
		slabs = {},
		extras = {},
		lawn = nil,
		cost = 0,
	}
	cx.dark = cx.wall:Lerp(rgb(30, 32, 40), 0.72)

	-- 동 치수 / 간격 (실측)
	local w, d, floors, colGap, rowGap
	local stagger = false
	if isTower then
		w = M(rng:NextNumber(26, 36)) -- 평면 26~36 m
		d = w * rng:NextNumber(0.82, 1.0)
		floors = rng:NextInteger(36, 49)
		colGap = M(rng:NextNumber(20, 34))
		rowGap = M(rng:NextNumber(32, 50))
		stagger = true
		cx.crown = "frame"
	else
		w = UNIT * rng:NextInteger(9, 15) + 2 -- 137~227 stud = 41~68 m
		d = M(rng:NextNumber(12, 15)) -- 깊이 12~15 m
		if big then
			floors = rng:NextInteger(27, 35)
		elseif waterfront or rng:NextNumber() < 0.15 then
			floors = rng:NextInteger(15, 21) -- 강변 앞줄 / 오래된 단지
		else
			floors = rng:NextInteger(18, 32)
		end
		colGap = M(rng:NextNumber(10, 22))
		rowGap = math.clamp(slabHeight(floors) * 0.48, M(30), M(50)) -- 인동 거리 30~50 m
		stagger = rng:NextNumber() < 0.4
		if floors >= 22 and rng:NextNumber() < 0.24 then
			cx.crown = if rng:NextNumber() < 0.5 then "frame" else "led" -- 신축 브랜드 아파트 옥상 왕관/LED
		end
	end

	local maxCols = math.clamp(math.floor((ex + colGap) / (w + colGap)), 0, if isTower then 3 else 4)
	local maxRows = math.clamp(math.floor((ez + rowGap) / (d + rowGap)), 0, 4)
	if maxCols < 1 or maxRows < 1 then
		return nil
	end
	local cols = math.clamp(rng:NextInteger(2, 4), 1, maxCols)
	local rows = math.clamp(rng:NextInteger(2, 4), 1, maxRows)
	if big then
		cols, rows = maxCols, maxRows
	end
	while cols * rows > 10 do
		rows -= 1
	end
	if isTower then
		while cols * rows > 6 do
			rows -= 1
		end
	end
	if cols * rows < (if isTower then 3 else 4) then
		-- 로트가 작으면 가능한 만큼 채움
		cols, rows = maxCols, math.min(maxRows, if isTower then 2 else 3)
		while cols * rows > 10 do
			rows -= 1
		end
		if cols * rows < 3 then
			return nil
		end
	end

	-- 블록(동 배열) 로컬 크기 → 로트 안에서 무작위 위치
	local blockW = cols * w + (cols - 1) * colGap + (if stagger then (w + colGap) * 0.5 else 0)
	local blockD = rows * d + (rows - 1) * rowGap
	if blockW > ex then
		stagger = false
		blockW = cols * w + (cols - 1) * colGap
	end
	local ox = rng:NextNumber(-0.5, 0.5) * math.max(0, ex - blockW)
	local oz = rng:NextNumber(-0.5, 0.5) * math.max(0, ez - blockD)
	local frame = CFrame.new(lx, 0, lz) * CFrame.Angles(0, math.rad(frameYaw), 0) * CFrame.new(ox, 0, oz)

	-- 동 번호면(+X 측벽)이 관람자 쪽을 향하도록 개별 yaw (판상: 0/180 또는 ±90)
	local function slabYaw(x: number): number
		if orient == 90 then
			return if o.labelFace > 0 then -90 else 90
		elseif orient == 0 then
			return if x > o.viewer.X then 180 else 0
		end
		return frameYaw
	end

	-- 잔디(단지 전체): 블록 + 여유 → 비어 있으면 통째로 예약
	local lawnW, lawnD = blockW + 2 * LAWN_MX, blockD + 2 * LAWN_MZ
	local lawnPos = frame.Position
	local useLawn = placeable(o, lawnPos.X, lawnPos.Z, lawnW, lawnD, frameYaw)
	if useLawn then
		cx.lawn = { lawnPos.X, lawnPos.Z, lawnW, lawnD, frameYaw }
	end

	-- 동 번호: 101.. (대단지 = 1201..)
	local labelBase = if big or rng:NextNumber() < 0.15 then rng:NextInteger(10, 13) * 100 else 100
	local n = 0
	for ri = 0, rows - 1 do
		local shift = if stagger and ri % 2 == 1 then (w + colGap) * 0.5 else 0
		for ci = 0, cols - 1 do
			local lxp = -blockW / 2 + w / 2 + ci * (w + colGap) + shift
			local lzp = -blockD / 2 + d / 2 + ri * (d + rowGap)
			local wp = frame * CFrame.new(lxp, 0, lzp)
			local x, z = wp.Position.X, wp.Position.Z
			local fl = floors + rng:NextInteger(-2, 2)
			-- 앞줄(강 쪽) 동은 조금 낮게 (뒤 동이 앞 동 위로 보이도록)
			local zFront = (if o.waterSign > 0 then lzp else -lzp) / math.max(1, blockD)
			if not isTower and orient ~= 90 then
				fl -= math.floor(math.max(0, zFront) * 5)
			end
			fl = math.max(if isTower then 35 else 15, fl)
			local h = if isTower then towerHeight(fl) else slabHeight(fl)
			local yaw = slabYaw(x)
			local fw, fd = w + 2 * PAD, d + 2 * PAD
			local ok = if useLawn then insideZone(o.zone, x, z, fw, fd, yaw) else placeable(o, x, z, fw, fd, yaw)
			if ok then
				n += 1
				table.insert(cx.slabs, {
					x = x,
					z = z,
					w = w,
					d = d,
					h = h,
					floors = fl,
					yaw = yaw,
					style = if isTower then (if rng:NextNumber() < 0.5 then "round" else "curtain") else "apartment",
					label = tostring(labelBase + n),
				})
				if not useLawn then
					Kit.reserveRect(x, z, fw, fd, yaw, cx.name)
				end
			end
		end
	end
	if #cx.slabs == 0 then
		return nil
	end
	if useLawn then
		Kit.reserveRect(lawnPos.X, lawnPos.Z, lawnW, lawnD, frameYaw, cx.name)
	end

	-- 단지 상가(2층 근린생활시설, 관람자/강 쪽 잔디 가장자리 밖)
	local shopW, shopD = M(rng:NextNumber(25, 40)), M(rng:NextNumber(12, 16))
	local toward = frame:VectorToObjectSpace(Vector3.new(0, 0, o.waterSign))
	local shopLocal: Vector3
	local shopYaw = frameYaw
	local edgeW: number = (if useLawn then lawnW else blockW)
	local edgeD: number = (if useLawn then lawnD else blockD)
	if math.abs(toward.Z) >= math.abs(toward.X) then
		local sgn = if toward.Z > 0 then 1 else -1
		shopLocal = Vector3.new(rng:NextNumber(-0.3, 0.3) * blockW, 0, sgn * (edgeD / 2 + SHOP_GAP + shopD / 2))
	else
		local sgn = if toward.X > 0 then 1 else -1
		shopLocal = Vector3.new(sgn * (edgeW / 2 + SHOP_GAP + shopD / 2), 0, rng:NextNumber(-0.3, 0.3) * blockD)
		shopYaw = frameYaw + 90
	end
	local sp = (frame * CFrame.new(shopLocal)).Position
	if placeable(o, sp.X, sp.Z, shopW + 8, shopD + 8, shopYaw) then
		table.insert(cx.extras, { kind = "shop", x = sp.X, z = sp.Z, w = shopW, d = shopD, h = M(rng:NextNumber(7.5, 9)), yaw = shopYaw, color = pick(rng, SIGNS) })
		Kit.reserveRect(sp.X, sp.Z, shopW + 8, shopD + 8, shopYaw, cx.name)
	end

	-- 나무(동 사이 줄 = 인동 공간의 조경): full = 키 8~13 m 가로수(수관 6~9 m), lite/min = 나무 덩어리
	if useLawn then
		local nt = if lod == "full" then rng:NextInteger(7, 11) elseif lod == "lite" then rng:NextInteger(3, 5) else rng:NextInteger(1, 2)
		for _ = 1, nt do
			local gi = rng:NextInteger(0, math.max(0, rows - 1))
			local lzp = -blockD / 2 + d + gi * (d + rowGap) + rowGap * 0.5 + rng:NextNumber(-0.18, 0.18) * rowGap
			if rows <= 1 or gi >= rows - 1 then
				lzp = (if rng:NextNumber() < 0.5 then -1 else 1) * (blockD / 2 + LAWN_MZ * 0.5)
			end
			local lxp = rng:NextNumber(-0.5, 0.5) * blockW
			local tp = (frame * CFrame.new(lxp, 0, lzp)).Position
			if lod == "full" then
				local cw = M(rng:NextNumber(6, 9))
				table.insert(cx.extras, { kind = "tree", x = tp.X, z = tp.Z, w = cw, d = cw * rng:NextNumber(0.85, 1.1), h = M(rng:NextNumber(8, 13)), yaw = 0, color = pick(rng, LEAVES) })
			else
				local cw = M(rng:NextNumber(10, 18))
				table.insert(cx.extras, { kind = "clump", x = tp.X, z = tp.Z, w = cw, d = cw * rng:NextNumber(0.6, 0.9), h = M(rng:NextNumber(8, 11)), yaw = 0, color = pick(rng, LEAVES) })
			end
		end
	end

	-- 비용 추정
	local cost = (if cx.lawn then 1 else 0)
	for _, s in cx.slabs do
		cost += if lod == "full" then estFull(s, cx.litChance, cx.crown) elseif lod == "lite" then estLite(s, cx.litChance, cx.crown) else estMin(s)
	end
	for _, e in cx.extras do
		cost += if e.kind == "shop" then (if lod == "min" then 2 else 3) elseif e.kind == "tree" then 2 else 1
	end
	cx.cost = cost
	return cx
end

------------------------------------------------------------------------------------------------------
-- 빌드: 정밀 / 경량 / 최소 동, 상가, 나무, 잔디
------------------------------------------------------------------------------------------------------
local function deco(name: string): Kit.PartOpts
	return { name = name, collide = false, query = false, shadow = false }
end

local function glowOpts(name: string, dayColor: Color3): Kit.PartOpts
	return { name = name, material = MAT.Neon, collide = false, query = false, shadow = false, glow = true, dayMaterial = MAT.Glass, dayColor = dayColor }
end

local function slabCF(s: Slab): CFrame
	return CFrame.new(s.x, CITY_Y, s.z) * CFrame.Angles(0, math.rad(s.yaw), 0)
end

-- 측벽(+X) 동 번호 "101동": 글자 높이 3 m, 꼭대기 두 층 아래. 투명 판 + SurfaceGui(자체 발광).
local function dongLabel(m: Model, s: Slab, cf: CFrame)
	local pw = math.min(s.d * 0.72, LABEL_H * 3.6)
	local plate = Kit.box(m, cf * CFrame.new(s.w / 2 + 1.6, s.h - FLOOR_H * 2, -s.d * 0.06), Vector3.new(0.2, LABEL_H, pw), P.ConcreteLight, MAT.SmoothPlastic, {
		name = "NumberPlate",
		collide = false,
		query = false,
		shadow = false,
		transparency = 1,
	})
	Kit.label(plate, Enum.NormalId.Right, s.label .. "동", { color = rgb(250, 244, 230), glow = true, pixelsPerStud = 8, maxDistance = 3000 })
end

-- 경량 판상 동(Facade "apartment" 의 저해상도판, 약 1/4 파트):
--   벽색 몸체(측벽·지붕·필로티) → 조명 코어 2~3 덩어리(Neon, 창 면 0.3 돌출) → 꺼진 세대 패치(0.6) → 발코니 띠(0.9, 2~3층마다)
local function liteSlab(parent: Instance, s: Slab, cx: Complex, rng: Random)
	local cf = slabCF(s)
	local m = Instance.new("Model")
	m.Name = "Dong" .. s.label
	local w, d, h = s.w, s.d, s.h
	local fl = s.floors
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(w, h, d), cx.wall, MAT.Concrete, { name = "Body" })
	local fw = w - 2 * END_W
	-- 조명 코어: 층 묶음 2~3 덩어리(켜짐 = 따뜻한 Neon / 꺼짐 = 어두운 면)
	local f = 0
	while f < fl do
		local nf = math.min(fl - f, rng:NextInteger(math.max(3, math.floor(fl / 3)), math.max(4, math.ceil(fl / 2))))
		local y0 = PILOTIS + f * FLOOR_H
		local hh = nf * FLOOR_H
		local on = rng:NextNumber() < cx.litChance + 0.2
		local c = if on then jitter(rng, pick(rng, cx.lit), 0.08) else cx.dark
		Kit.box(m, cf * CFrame.new(0, y0 + hh / 2, 0), Vector3.new(fw, hh, d + 0.6), c, if on then MAT.Neon else MAT.SmoothPlastic, if on then glowOpts("Core", cx.dark) else deco("CoreOff"))
		f += nf
	end
	-- 꺼진 세대(1~3세대 x 1~3층)
	local nu = math.max(2, math.floor(fw / UNIT))
	local uw = fw / nu
	for _ = 1, nOff(s, cx.litChance) do
		local len = rng:NextInteger(1, math.min(3, nu))
		local u0 = rng:NextInteger(0, nu - len)
		local nf = rng:NextInteger(1, 3)
		local f0 = rng:NextInteger(0, math.max(0, fl - nf))
		local y0 = PILOTIS + f0 * FLOOR_H
		Kit.box(m, cf * CFrame.new(-fw / 2 + (u0 + len / 2) * uw, y0 + nf * FLOOR_H / 2, 0), Vector3.new(len * uw - 0.8, nf * FLOOR_H, d + 1.2), cx.dark, MAT.SmoothPlastic, deco("Off"))
	end
	-- 발코니 띠(벽색, 1.2 m): 2~3층마다 → 멀리서 층 리듬
	local step = bandStep(fl)
	local bandH = FLOOR_H * 0.42
	for k = step, fl, step do
		local y = PILOTIS + k * FLOOR_H - bandH / 2
		Kit.box(m, cf * CFrame.new(0, y, 0), Vector3.new(fw, bandH, d + 1.8), cx.wall, MAT.Concrete, deco("Band"))
	end
	-- 1층(필로티) 로비 불빛
	Kit.box(m, cf * CFrame.new(rng:NextNumber(-0.25, 0.25) * w, PILOTIS * 0.45, 0), Vector3.new(w * 0.22, PILOTIS * 0.7, d + 0.6), dim(P.WindowWarm, 0.25), MAT.Neon, glowOpts("Lobby", cx.dark))
	-- 측벽 슈퍼그래픽(+X 측벽 = 관람자 쪽)
	Kit.box(m, cf * CFrame.new(w / 2 + 0.3, h * 0.55, d * 0.18), Vector3.new(0.6, h * 0.55, d * 0.26), cx.accent, MAT.SmoothPlastic, deco("Accent"))
	-- 옥상: 엘리베이터 기계실(4 x 3.5 m) / LED 띠(지붕 면보다 아래 → 위에서 보면 가는 테두리만 빛남)
	Kit.box(m, cf * CFrame.new(rng:NextNumber(-0.25, 0.25) * w, h + M(1.75), 0), Vector3.new(M(4), M(3.5), d * 0.6), cx.wall, MAT.Concrete, { name = "ElevatorHouse" })
	if cx.crown then
		Kit.box(m, cf * CFrame.new(0, h - 0.7, 0), Vector3.new(w + 0.6, 1, d + 0.6), cx.led, MAT.Neon, glowOpts("Led", cx.wall))
	end
	m.Parent = parent
end

-- 최소 판상 동(원경): 몸체 + 불빛 면 하나(어둡게) + 꺼진 세대 3개 + 기계실
local function minSlab(parent: Instance, s: Slab, cx: Complex, rng: Random)
	local cf = slabCF(s)
	local m = Instance.new("Model")
	m.Name = "Dong" .. s.label
	local w, d, h = s.w, s.d, s.h
	local fl = s.floors
	Kit.box(m, cf * CFrame.new(0, h / 2, 0), Vector3.new(w, h, d), cx.wall, MAT.Concrete, { name = "Body", shadow = false })
	local fw = w - 2 * END_W
	local y0, y1 = PILOTIS, h - PARAPET
	Kit.box(m, cf * CFrame.new(0, (y0 + y1) / 2, 0), Vector3.new(fw, y1 - y0, d + 0.6), dim(jitter(rng, pick(rng, cx.lit), 0.08), 0.32), MAT.Neon, glowOpts("Core", cx.dark))
	local nu = math.max(2, math.floor(fw / UNIT))
	local uw = fw / nu
	for _ = 1, 3 do
		local len = rng:NextInteger(1, math.min(4, nu))
		local u0 = rng:NextInteger(0, nu - len)
		local nf = rng:NextInteger(2, math.max(2, math.floor(fl / 3)))
		local f0 = rng:NextInteger(0, math.max(0, fl - nf))
		Kit.box(m, cf * CFrame.new(-fw / 2 + (u0 + len / 2) * uw, PILOTIS + (f0 + nf / 2) * FLOOR_H, 0), Vector3.new(len * uw - 0.8, nf * FLOOR_H, d + 1.2), cx.dark, MAT.SmoothPlastic, deco("Off"))
	end
	Kit.box(m, cf * CFrame.new(rng:NextNumber(-0.25, 0.25) * w, h + M(1.75), 0), Vector3.new(M(4), M(3.5), d * 0.6), cx.wall, MAT.Concrete, deco("ElevatorHouse"))
	m.Parent = parent
end

local function buildSlab(parent: Instance, s: Slab, cx: Complex, rng: Random)
	local cf = slabCF(s)
	if s.style == "apartment" then
		if cx.lod == "full" then
			-- Facade 기본 층고 2.9 m / 세대 벽 4.5 m / 필로티 3.5 m
			local mdl = Facade.tower(parent, {
				name = "Dong" .. s.label,
				cf = cf,
				w = s.w,
				d = s.d,
				h = s.h,
				style = "apartment",
				rng = rng,
				glass = cx.wall,
				lit = cx.lit,
				litChance = cx.litChance,
				accent = cx.accent,
				crown = cx.crown,
				ledColor = cx.led,
				lobbyColor = dim(P.WindowWarm, 0.3),
			})
			dongLabel(mdl, s, cf)
		elseif cx.lod == "lite" then
			liteSlab(parent, s, cx, rng)
		else
			minSlab(parent, s, cx, rng)
		end
		return
	end
	-- 신축 타워형
	if cx.lod == "full" then
		Facade.tower(parent, {
			name = "Dong" .. s.label,
			cf = cf,
			w = s.w,
			d = s.d,
			h = s.h,
			style = s.style,
			rng = rng,
			floorH = TOWER_FLOOR_H,
			glass = cx.glass,
			frame = cx.frame,
			lit = cx.lit,
			litChance = cx.litChance,
			crown = "frame",
			ledColor = cx.led,
			lobbyColor = dim(P.WindowWarm, 0.3),
		})
	else
		Facade.tower(parent, {
			name = "Dong" .. s.label,
			cf = cf,
			w = s.w,
			d = s.d,
			h = s.h,
			style = if cx.lod == "lite" then "mid" else "far",
			rng = rng,
			glass = cx.glass,
			lit = LIT_LITE,
			litChance = 0.8,
			crown = "led",
			ledColor = cx.led,
			beacon = true, -- 35층 이상(> 100 m) 항공장애등
		})
	end
end

local function buildExtra(parent: Instance, e: Extra, cx: Complex)
	local cf = CFrame.new(e.x, CITY_Y, e.z) * CFrame.Angles(0, math.rad(e.yaw), 0)
	if e.kind == "shop" then
		-- 단지 상가: 2층 몸체 + 1층 쇼윈도 불빛(3 m) + 간판 띠(1.2 m)
		local body = cx.wall:Lerp(rgb(70, 70, 76), 0.45)
		Kit.box(parent, cf * CFrame.new(0, e.h / 2, 0), Vector3.new(e.w, e.h, e.d), body, MAT.Concrete, { name = "Shop" })
		Kit.box(parent, cf * CFrame.new(0, M(1.6), 0), Vector3.new(e.w - 2, M(3), e.d + 0.6), dim(P.WindowCool, 0.3), MAT.Neon, glowOpts("ShopFront", body))
		if cx.lod ~= "min" then
			Kit.box(parent, cf * CFrame.new(0, e.h - M(0.9), 0), Vector3.new(e.w - 3, M(1.2), e.d + 0.6), dim(e.color, 0.2), MAT.Neon, glowOpts("ShopSign", body))
		end
	elseif e.kind == "tree" then
		-- 조경수: 줄기(지름 0.4 m) + 수관(지면 2.5 m 위부터)
		local trunkH = M(3.2)
		local base = CITY_Y + LAWN_T
		Kit.vcyl(parent, Vector3.new(e.x, base + trunkH / 2, e.z), trunkH, M(0.4), P.Bark, MAT.Wood, deco("Trunk"))
		local ch = e.h - M(2.5)
		Kit.ellipsoid(parent, CFrame.new(e.x, base + M(2.5) + ch / 2, e.z), Vector3.new(e.w, ch, e.d), e.color, MAT.Grass, { name = "Tree", shadow = false, query = false })
	else
		-- 나무 덩어리(원경): 지면에서 1 m 띄운 수관 묶음
		Kit.ellipsoid(parent, CFrame.new(e.x, CITY_Y + LAWN_T + M(1) + e.h / 2, e.z), Vector3.new(e.w, e.h, e.d), e.color, MAT.Grass, { name = "Trees", shadow = false, query = false })
	end
end

local function buildComplex(parent: Instance, cx: Complex, rng: Random)
	local g = Kit.group(parent, cx.name)
	g:SetAttribute("Lod", cx.lod)
	if cx.lawn then
		local l = cx.lawn
		Kit.box(g, CFrame.new(l[1], CITY_Y + LAWN_T / 2, l[2]) * CFrame.Angles(0, math.rad(l[5]), 0), Vector3.new(l[3], LAWN_T, l[4]), P.GrassDark, MAT.Grass, { name = "Lawn", shadow = false })
	end
	for _, s in cx.slabs do
		buildSlab(g, s, cx, rng)
	end
	for _, e in cx.extras do
		buildExtra(g, e, cx)
	end
end

------------------------------------------------------------------------------------------------------
-- 구역
------------------------------------------------------------------------------------------------------
local function lotsOf(o: ZoneOpts): { Lot }
	local zone = o.zone
	local nx = math.max(1, math.floor((zone.XMax - zone.XMin) / o.pitchX + 0.5))
	local nz = math.max(1, math.floor((zone.ZMax - zone.ZMin) / o.pitchZ + 0.5))
	local px, pz = (zone.XMax - zone.XMin) / nx, (zone.ZMax - zone.ZMin) / nz
	local out: { Lot } = {}
	for i = 0, nx - 1 do
		for j = 0, nz - 1 do
			local x0, z0 = zone.XMin + i * px + STREET / 2, zone.ZMin + j * pz + STREET / 2
			local x1, z1 = x0 + px - STREET, z0 + pz - STREET
			local cxp, czp = (x0 + x1) / 2, (z0 + z1) / 2
			local dist = (Vector2.new(cxp, czp) - Vector2.new(o.viewer.X, o.viewer.Z)).Magnitude
			if o.frustum and math.abs(bearing(cxp, czp) - LOOK_BEARING) > 48 then
				dist *= 1.7
			end
			table.insert(out, { x0 = x0, z0 = z0, x1 = x1, z1 = z1, prio = dist, idx = #out + 1 })
		end
	end
	table.sort(out, function(a: Lot, b: Lot): boolean
		if a.prio ~= b.prio then
			return a.prio < b.prio
		end
		return a.idx < b.idx
	end)
	return out
end

local function planZone(o: ZoneOpts, rng: Random): { Complex }
	local density = Config.Quality.Density
	local budget = o.budget * density
	local fullBudget = o.fullBudget * density
	local used, fullUsed = 0, 0
	local out: { Complex } = {}
	local serial = 0
	local bigLeft = 3
	for _, lot in lotsOf(o) do
		if used >= budget then
			break
		end
		local czp = (lot.z0 + lot.z1) / 2
		local waterfront = (czp - o.waterZ) * o.waterSign > 0
		local big = false
		if waterfront then
			-- 강변 앞줄: 밀도 낮춤(일부 비움) + 대부분 낮은 단지, 몇 개만 대단지
			if bigLeft > 0 and rng:NextNumber() < 0.3 then
				big = true
				bigLeft -= 1
			elseif rng:NextNumber() < 0.35 then
				continue
			end
		elseif rng:NextNumber() < 0.1 then
			continue -- 학교/공원/저층 블록 자리(도시 카펫이 채움)
		end
		local lod = "min"
		if lot.prio < o.fullRange and fullUsed < fullBudget then
			lod = "full"
		elseif lot.prio < o.liteRange then
			lod = "lite"
		end
		serial += 1
		local cx = planComplex(o, lot, rng, serial, lod, big, waterfront)
		if cx then
			table.insert(out, cx)
			used += cx.cost
			if lod == "full" then
				fullUsed += cx.cost
			end
		end
	end
	return out
end

------------------------------------------------------------------------------------------------------
-- 진입점
------------------------------------------------------------------------------------------------------
function Apartments.build(ctx: any)
	local model: Model = ctx.model
	local rng: Random = ctx.rng
	local start = Kit.stats.parts
	local B = Config.Bridge
	local N, F = Config.NearBank, Config.FarBank

	-- 다리 축 연장(가까운 쪽 도시로 들어가는 길)은 비워 둠
	Kit.reserve(B.X - B.Width / 2 - M(6), N.CityFrom, B.X + B.Width / 2 + M(6), ZN.ApartmentsNear.ZMax, "BridgeAxisNear")

	local far: ZoneOpts = {
		key = "F",
		zone = ZN.ApartmentsFar,
		pitchX = M(270), -- 단지 블록 약 270 x 230 m (도로 중심 간격)
		pitchZ = M(230),
		viewer = HERO,
		frustum = true,
		budget = BUDGET_FAR,
		fullBudget = FULL_FAR,
		fullRange = FULL_RANGE_FAR,
		liteRange = LITE_RANGE_FAR,
		towerChance = 0.16,
		waterZ = F.CityFrom - M(140), -- 도시 앞 140 m 안쪽 = 강변 앞줄
		waterSign = 1,
		labelFace = 1,
		guard = true,
	}
	local near: ZoneOpts = {
		key = "N",
		zone = ZN.ApartmentsNear,
		pitchX = M(265),
		pitchZ = M(255),
		viewer = Vector3.new(DECK.X, Config.Viewpoint.DeckHeight, DECK.Z),
		frustum = false,
		budget = BUDGET_NEAR,
		fullBudget = FULL_NEAR,
		fullRange = FULL_RANGE_NEAR,
		liteRange = LITE_RANGE_NEAR,
		towerChance = 0.14,
		waterZ = N.CityFrom + M(150),
		waterSign = -1,
		labelFace = -1,
		guard = false,
	}

	local plans: { { any } } = {}
	for _, o in { far, near } do
		local list = planZone(o, rng)
		local g = Kit.group(model, if o.key == "F" then "Far" else "Near")
		table.insert(plans, { g, list })
	end
	local nSlabs, nFull = 0, 0
	for _, pr in plans do
		local g = pr[1] :: Model
		for _, cx in pr[2] :: { Complex } do
			if Kit.stats.parts - start + cx.cost > BUDGET_TOTAL - 40 then -- 추정 오차 여유
				continue
			end
			buildComplex(g, cx, rng)
			nSlabs += #cx.slabs
			if cx.lod == "full" then
				nFull += #cx.slabs
			end
		end
	end
	model:SetAttribute("Slabs", nSlabs)
	model:SetAttribute("FullSlabs", nFull)
	model:SetAttribute("Parts", Kit.stats.parts - start)
	print(string.format("[Apartments] 동 %d (정밀 %d) · 파트 %d", nSlabs, nFull, Kit.stats.parts - start))
end

return Apartments
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000002"><Properties><string name="Name">Atmosphere</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Atmosphere
-- 해질녘(블루아워 직전) 조명·대기·하늘·구름·후처리·수면 색. 맵의 "룩"을 결정하는 모듈.
--   * Lighting.Technology = Future 는 Studio(커맨드 바/설정)에서만 바꿀 수 있어 pcall 로 시도합니다.
--   * 기존 Sky/Atmosphere/Clouds/후처리 효과는 이 맵의 값으로 교체됩니다.

local Lighting = game:GetService("Lighting")
local Config = require(script.Parent.Config)

local Atmosphere = {}
local rgb = Color3.fromRGB

local function replace(parent: Instance, className: string, name: string): Instance
	for _, c in parent:GetChildren() do
		if c:IsA(className) then
			c:Destroy()
		end
	end
	local inst = Instance.new(className)
	inst.Name = name
	return inst
end

function Atmosphere.apply()
	local L = Config.Lighting
	pcall(function()
		(Lighting :: any).Technology = Enum.Technology.Future
	end)
	Lighting.ClockTime = L.ClockTime
	Lighting.GeographicLatitude = L.GeographicLatitude
	Lighting.Brightness = 2.4
	Lighting.ExposureCompensation = 0.15
	Lighting.Ambient = rgb(38, 42, 58)
	Lighting.OutdoorAmbient = rgb(104, 100, 124)
	Lighting.ColorShift_Top = rgb(255, 178, 116)
	Lighting.ColorShift_Bottom = rgb(78, 92, 140)
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 1
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.3
	Lighting.FogEnd = 100000

	local atm = replace(Lighting, "Atmosphere", "DuskAtmosphere") :: Atmosphere
	atm.Density = 0.11 -- 실제 스케일(거리 ×1.67)에 맞춘 값
	atm.Offset = 0.25
	atm.Color = rgb(214, 146, 118)
	atm.Decay = rgb(40, 88, 178)
	atm.Glare = 0.9
	atm.Haze = 1.0
	atm.Parent = Lighting

	local sky = replace(Lighting, "Sky", "DuskSky") :: Sky
	sky.StarCount = 400
	sky.SunAngularSize = 14
	sky.MoonAngularSize = 9
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting

	local bloom = replace(Lighting, "BloomEffect", "Bloom") :: BloomEffect
	bloom.Intensity = 0.9
	bloom.Size = 40
	bloom.Threshold = 1.25
	bloom.Parent = Lighting

	local cc = replace(Lighting, "ColorCorrectionEffect", "Grade") :: ColorCorrectionEffect
	cc.Brightness = 0.02
	cc.Contrast = 0.14
	cc.Saturation = 0.12
	cc.TintColor = rgb(246, 246, 255)
	cc.Parent = Lighting

	local rays = replace(Lighting, "SunRaysEffect", "SunRays") :: SunRaysEffect
	rays.Intensity = 0.045
	rays.Spread = 0.55
	rays.Parent = Lighting

	local dof = replace(Lighting, "DepthOfFieldEffect", "DepthOfField") :: DepthOfFieldEffect
	dof.Enabled = false -- 포토 스팟/인트로에서만 클라이언트가 켬
	dof.FarIntensity = 0.08
	dof.FocusDistance = 200 -- Roblox 최대값
	dof.InFocusRadius = 50 -- Roblox 최대값
	dof.NearIntensity = 0
	dof.Parent = Lighting

	local terrain = workspace.Terrain
	local clouds = replace(terrain, "Clouds", "DuskClouds") :: Clouds
	clouds.Cover = 0.5
	clouds.Density = 0.45
	clouds.Color = rgb(255, 214, 200)
	clouds.Parent = terrain

	terrain.WaterColor = rgb(26, 50, 70)
	terrain.WaterTransparency = 0.12
	terrain.WaterReflectance = 1
	terrain.WaterWaveSize = 0.1
	terrain.WaterWaveSpeed = 7
	pcall(function()
		(terrain :: any).Decoration = true -- 잔디 블레이드 (일부 환경에서 스크립트 설정 불가 → pcall)
	end)
	pcall(function()
		terrain:SetMaterialColor(Enum.Material.Grass, rgb(70, 102, 54))
		terrain:SetMaterialColor(Enum.Material.LeafyGrass, rgb(62, 96, 48))
		terrain:SetMaterialColor(Enum.Material.Mud, rgb(64, 56, 48))
		terrain:SetMaterialColor(Enum.Material.Rock, rgb(110, 108, 104))
		terrain:SetMaterialColor(Enum.Material.Slate, rgb(96, 98, 102))
		terrain:SetMaterialColor(Enum.Material.Sand, rgb(160, 146, 120))
		terrain:SetMaterialColor(Enum.Material.Ground, rgb(92, 82, 66))
	end)
end

function Atmosphere.build(_ctx: any)
	Atmosphere.apply()
end

return Atmosphere
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000003"><Properties><string name="Name">Bridge</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Bridge
-- 잠실대교 모티브 다경간 도로교 (실측 스케일, 1 stud = 0.3 m): 강을 Z 방향으로 가로질러 양쪽 둔치·제방을 넘어
-- 제방 도로(올림픽대로/강변북로, L.Levee)와 평면 교차로로 만나고, 그 바깥 도시 도로(ZFrom/ZTo)까지 이어짐.
--
--   * 종단 선형: 양끝(제방 도로 가장자리 F.SlopeTo / N.SlopeTo)은 도시 도로 높이(L.City + 0.4), 강 중앙 ±FLAT_HALF
--     (75 m)는 DeckTop(17 m). 사이는 smoothstep 완경사(최대 ≈ 7 %). 상판은 지점(교각/교대) 사이 직선 세그먼트
--     (기울어진 파트)로 이어지고, 같은 기울기의 연속 세그먼트는 하나로 합침.
--   * 단면(폭 36 m, 중심선 기준 반폭 18 m): 중앙분리대 2 m(콘크리트 방호벽 0.6 x 0.85 m) + 방향별 4차로 x 3.5 m
--     + 보도 2.5 m(연석 0.25 m) + 난간 기초 0.5 m. 난간 높이 1.1 m(보도 기준). 박스거더 높이 3.5 m(사다리꼴 웹).
--     가로등 10 m(난간 위) · 암 2 m · 간격 32 m, 따뜻한 나트륨 등기구.
--   * 교각: 수중 기초(둥근 코, 폭 18 m) + 쌍기둥(지름 3.5 m, 중심 간격 12 m) + 해머헤드 캡(19 x 3.5 x 2.2 m)
--     + 받침. 기둥은 반투명 Neon 외피로 따뜻한 업라이트 세척광, 캡 앞면 빛막, 기초의 등기구 + SpotLight(위로).
--     낮은 교각(둔치 끝)은 벽식. 교대: 사면 발치에 콘크리트 블록.
--   * 수면 반사: 수중 교각마다 긴 주황 스트릭, 수면 위 가로등 쌍마다 짧은 스트릭(Kit.reflection).
--   * 차선: 방향별 4차로 Kit.lane, 전조등 높이(노면 + 0.75 m), 60~70 km/h(55~65 stud/s).
--     우측통행: +Z 로 오는 차 = -X 쪽 "head", -Z 로 가는 차 = +X 쪽 "tail".
--   * 예약: 양끝 도시 도로 토막 + 둔치/수면 구간 (제방 도로 띠는 Riverside 가 깔도록 비워 둠 → 입구에 가로막는 것 없음).

local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)

local Bridge = {}

type PartOpts = Kit.PartOpts

local P = Config.Palette
local B = Config.Bridge
local L = Config.Level
local F, N = Config.FarBank, Config.NearBank
local R = Config.Real
local m = Config.m
local rgb = Color3.fromRGB

------------------------------------------------------------------------------------------------------
-- 상수 (모두 실측 m → stud)
------------------------------------------------------------------------------------------------------
local BX = B.X
local HALF_W = B.Width / 2 -- 18 m
-- 종단
local Y_END = L.City + 0.4 -- 양끝 노면 = 제방/도시 도로 포장 윗면(Riverside 와 동일)
local FLAT_HALF = m(75) -- 강 중앙 수평 구간 반폭
local Z_A, Z_B = F.SlopeTo, N.SlopeTo -- 교량 본체 시작/끝(제방 도로 가장자리)
-- 단면 (상판 윗면 = 로컬 y 0)
local FASCIA_W = m(0.5) -- 난간 기초(가장자리보) 폭
local EDGE_X = HALF_W - FASCIA_W / 2 -- 가장자리보 중심(난간·가로등 기초)
local SLAB_HALF = HALF_W - FASCIA_W + 0.3 -- 슬래브는 가장자리보 속으로 0.3 들어감
local SLAB_T = m(0.45) -- 캔틸레버 슬래브(포장 포함)
local GIRDER_D = m(3.5) -- 노면 → 박스거더 바닥
local GIRDER_HALF = m(8.5) -- 거더 하부 플랜지 반폭
local WEB_TOP_HALF = m(10.5) -- 경사 웹 상단 반폭
local MEDIAN_HALF = m(1.0) -- 중앙분리대 구역 반폭(2 m)
local BARRIER_HALF, BARRIER_H = m(0.3), m(0.85) -- 콘크리트 방호벽
local LANE_W = R.Lane -- 3.5 m
local LANE_X0 = MEDIAN_HALF -- 1차로 안쪽 경계
local CURB_X = LANE_X0 + 4 * LANE_W -- 4차로 바깥 경계 = 연석
local WALK_TOP = m(0.25) -- 보도 연석 높이
local FASCIA_TOP = WALK_TOP + m(0.4) -- 난간 콘크리트 기초 윗면
local FASCIA_BOT = -m(1.3) -- 가장자리보 아래 끝
local MARK_T = 0.3 -- 노면표시 윗면이 아스팔트보다 높은 양(동일 평면 회피)
local LINE_W = m(0.15)
local DASH_LEN, DASH_PITCH, DASH_OFF = m(6), m(18), m(2)
local RAIL_TOP = WALK_TOP + R.Railing -- 보도 기준 1.1 m
local RAIL_MID = WALK_TOP + m(0.75)
local POST_PITCH = m(6)
local CAR_UP = m(0.75) -- 전조등 높이
-- 가로등
local LAMP_PITCH = m(32)
local LAMP_H = R.StreetLamp -- 10 m (난간 기초 위)
local LAMP_ARM = m(2.0)
local LAMP_LIGHTS = 14 -- 가로등 SpotLight 수(가까운 쪽 위주)
-- 교각
local COL_X, COL_D = m(6), m(3.5)
local CAP_W, CAP_D, CAP_H = m(19), m(3.5), m(2.2)
local FOOT_D = m(6)
local FOOT_TOP_W = L.Water + m(0.6)
local BEARING_GAP = m(0.15)
local PIER_LIGHTS = 9
-- 색
local CONC = rgb(176, 172, 166)
local ASPHALT = P.Asphalt:Lerp(P.AsphaltLight, 0.35)
local PAINT_W = P.LaneWhite:Lerp(ASPHALT, 0.22) -- 야간 노면 도색(원경에서 점선이 너무 튀지 않게)
local PAINT_Y = P.LaneYellow:Lerp(ASPHALT, 0.15)
local CONC_FASCIA = rgb(198, 192, 182)
local CONC_GIRDER = rgb(118, 118, 122)
local CONC_PIER = rgb(160, 154, 146)
local WALK_C = rgb(132, 122, 112)
local METAL = rgb(78, 84, 92)
local POLE_C = rgb(64, 68, 74)
local EDGE_LED = rgb(226, 164, 100) -- 가장자리 빛띠(길어서 중간 밝기)
local LAMP_LENS = P.LampWarm
local LAMP_GLARE = rgb(255, 190, 118)
local UPLIGHT = rgb(255, 172, 92)
local SHEATH_C = rgb(178, 110, 54) -- 기둥 세척광 외피(반투명, 아래쪽)
local SHEATH_TOP = rgb(150, 100, 64) -- 위쪽(빛이 옅어짐)
local WASH_C = rgb(150, 96, 52)
local PIER_REF = rgb(255, 156, 78)
local LAMP_REF = rgb(255, 168, 96)

------------------------------------------------------------------------------------------------------
-- 종단 선형
------------------------------------------------------------------------------------------------------
local function smooth(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

local function deckY(z: number): number
	local rise = B.DeckTop - Y_END
	if z < -FLAT_HALF then
		return Y_END + rise * smooth((z - Z_A) / (-FLAT_HALF - Z_A))
	elseif z > FLAT_HALF then
		return Y_END + rise * smooth((Z_B - z) / (Z_B - FLAT_HALF))
	end
	return B.DeckTop
end

-- 지점: 교대(양끝) + PierSpacing 격자 교각(둔치 사면에는 두지 않음)
local function supports(): ({ number }, { number })
	local zs = { Z_A }
	local piers = {}
	local sp = B.PierSpacing
	local pad = m(4)
	for k = math.ceil((F.ParkTo + pad) / sp), math.floor((N.ParkTo - pad) / sp) do
		local z = k * sp
		table.insert(zs, z)
		table.insert(piers, z)
	end
	table.insert(zs, Z_B)
	return zs, piers
end

type Seg = { z0: number, y0: number, z1: number, y1: number, len: number, s0: number, cf: CFrame }

local function makeSegs(zs: { number }): ({ Seg }, number)
	-- 같은 기울기의 연속 구간은 합침
	local pts: { Vector2 } = {}
	for _, z in zs do
		table.insert(pts, Vector2.new(z, deckY(z)))
	end
	local keep: { Vector2 } = { pts[1] }
	for i = 2, #pts - 1 do
		local a, b, c = keep[#keep], pts[i], pts[i + 1]
		local s1 = (b.Y - a.Y) / (b.X - a.X)
		local s2 = (c.Y - b.Y) / (c.X - b.X)
		if math.abs(s1 - s2) > 1e-5 then
			table.insert(keep, b)
		end
	end
	table.insert(keep, pts[#pts])
	local segs: { Seg } = {}
	local s = 0
	for i = 1, #keep - 1 do
		local a, b = keep[i], keep[i + 1]
		local p0 = Vector3.new(BX, a.Y, a.X)
		local p1 = Vector3.new(BX, b.Y, b.X)
		local d = p1 - p0
		local mid = (p0 + p1) / 2
		-- LookVector = -d → 로컬 +Z = 진행(+Z) 방향, 로컬 +X = 월드 +X
		local cf = CFrame.lookAt(mid, mid - d)
		table.insert(segs, { z0 = a.X, y0 = a.Y, z1 = b.X, y1 = b.Y, len = d.Magnitude, s0 = s, cf = cf })
		s += d.Magnitude
	end
	return segs, s
end

------------------------------------------------------------------------------------------------------
-- 파트 옵션
------------------------------------------------------------------------------------------------------
local function solid(name: string, color: Color3, mat: Enum.Material): PartOpts
	return { name = name, color = color, material = mat, collide = true }
end

local function decor(name: string, color: Color3, mat: Enum.Material): PartOpts
	return { name = name, color = color, material = mat, collide = false, query = false }
end

local function neon(name: string, color: Color3, dayMat: Enum.Material, dayColor: Color3, tr: number?): PartOpts
	return {
		name = name,
		color = color,
		material = Enum.Material.Neon,
		transparency = tr,
		collide = false,
		query = false,
		shadow = false,
		glow = true,
		dayMaterial = dayMat,
		dayColor = dayColor,
	}
end

-- 세그먼트 로컬 좌표(x, y0..y1, 진행 l0..l1)의 상자
local function along(parent: Instance, seg: Seg, x: number, y0: number, y1: number, w: number, l0: number, l1: number, o: PartOpts): BasePart
	local zc = (l0 + l1) / 2 - seg.len / 2
	return Kit.part(parent, seg.cf * CFrame.new(x, (y0 + y1) / 2, zc), Vector3.new(w, y1 - y0, l1 - l0), o)
end

local function worldAt(seg: Seg, x: number, y: number, l: number): Vector3
	return seg.cf:PointToWorldSpace(Vector3.new(x, y, l - seg.len / 2))
end

-- 전역 호길이 s → (세그먼트, 로컬 l)
local function locate(segs: { Seg }, s: number): (Seg, number)
	for _, seg in segs do
		if s <= seg.s0 + seg.len then
			return seg, math.max(0, s - seg.s0)
		end
	end
	local last = segs[#segs]
	return last, last.len
end

------------------------------------------------------------------------------------------------------
-- 상판 (세그먼트별 단면)
------------------------------------------------------------------------------------------------------
local function buildDeck(parent: Instance, segs: { Seg })
	local webY0, webY1 = -GIRDER_D, -SLAB_T + 0.2
	local webW = WEB_TOP_HALF - GIRDER_HALF + 0.3
	for _, seg in segs do
		local len = seg.len
		-- 슬래브(아스팔트 노면) + 박스거더(하부) + 경사 웹(웨지: 윗면 전체, 안쪽 수직면, 바깥으로 얇아짐)
		along(parent, seg, 0, -SLAB_T, 0, SLAB_HALF * 2, 0, len, solid("DeckSlab", ASPHALT, Enum.Material.Asphalt))
		along(parent, seg, 0, webY0, webY1, GIRDER_HALF * 2, 0, len, solid("BoxGirder", CONC_GIRDER, Enum.Material.Concrete))
		-- 중앙분리대 방호벽
		along(parent, seg, 0, -0.2, BARRIER_H, BARRIER_HALF * 2, 0, len, solid("MedianBarrier", CONC, Enum.Material.Concrete))
		for _, side in { -1, 1 } do
			local wx = side * (GIRDER_HALF - 0.3 + webW / 2)
			local cf = seg.cf * CFrame.new(wx, (webY0 + webY1) / 2, 0) * CFrame.Angles(0, -side * math.pi / 2, 0) * CFrame.Angles(0, 0, math.pi)
			Kit.wedge(parent, cf, Vector3.new(len, webY1 - webY0, webW), CONC_GIRDER, Enum.Material.Concrete, { name = "GirderWeb" })
			-- 가장자리보(난간 기초) + 빛띠
			along(parent, seg, side * EDGE_X, FASCIA_BOT, FASCIA_TOP, FASCIA_W, 0, len, solid("Fascia", CONC_FASCIA, Enum.Material.Concrete))
			along(parent, seg, side * (HALF_W + 0.15), FASCIA_BOT + 0.6, FASCIA_BOT + 0.6 + m(0.3), 0.3, 0, len, neon("EdgeLight", EDGE_LED, Enum.Material.Concrete, CONC_FASCIA))
			-- 보도(연석 높이 WALK_TOP, 가장자리보 속으로 0.3 겹침)
			local w0, w1 = CURB_X, SLAB_HALF
			along(parent, seg, side * (w0 + w1) / 2, -0.4, WALK_TOP, w1 - w0, 0, len, solid("Sidewalk", WALK_C, Enum.Material.Pavement))
			-- 노면표시: 바깥 실선(흰색), 안쪽 실선(노랑)
			along(parent, seg, side * (CURB_X - 0.5 - LINE_W / 2), MARK_T - 0.5, MARK_T, LINE_W, 0, len, decor("EdgeLine", PAINT_W, Enum.Material.SmoothPlastic))
			along(parent, seg, side * (LANE_X0 + LINE_W / 2), MARK_T - 0.5, MARK_T, LINE_W, 0, len, decor("CenterLine", PAINT_Y, Enum.Material.SmoothPlastic))
			-- 난간 레일(상/중간) — 상단 레일은 충돌(추락 방지)
			along(parent, seg, side * EDGE_X, RAIL_TOP - m(0.05), RAIL_TOP + m(0.05), m(0.1), 0, len, solid("RailTop", METAL, Enum.Material.Metal))
			along(parent, seg, side * EDGE_X, RAIL_MID - m(0.03), RAIL_MID + m(0.03), m(0.06), 0, len, decor("RailMid", METAL, Enum.Material.Metal))
			-- 차선 점선(전역 위상으로 세그먼트를 넘어 이어짐)
			for k = 1, 3 do
				local x = side * (LANE_X0 + k * LANE_W)
				local mm = math.floor((seg.s0 - DASH_OFF) / DASH_PITCH)
				while mm * DASH_PITCH + DASH_OFF < seg.s0 + len do
					local a = math.max(mm * DASH_PITCH + DASH_OFF, seg.s0)
					local b = math.min(mm * DASH_PITCH + DASH_OFF + DASH_LEN, seg.s0 + len)
					if b - a > 2 then
						along(parent, seg, x, MARK_T - 0.5, MARK_T, LINE_W, a - seg.s0, b - seg.s0, decor("LaneDash", PAINT_W, Enum.Material.SmoothPlastic))
					end
					mm += 1
				end
			end
		end
	end
end

-- 난간 지주 + 가로등 (월드 수직)
local function buildLampsAndPosts(parent: Instance, segs: { Seg }, total: number, rng: Random, reflParent: Instance)
	local s = POST_PITCH / 2
	local postW = m(0.08)
	while s < total do
		local seg, l = locate(segs, s)
		for _, side in { -1, 1 } do
			local base = worldAt(seg, side * EDGE_X, FASCIA_TOP, l)
			local h = RAIL_TOP - FASCIA_TOP
			Kit.box(parent, CFrame.new(base + Vector3.new(0, h / 2, 0)), Vector3.new(postW, h, postW), METAL, Enum.Material.Metal, { name = "RailPost", collide = false, query = false })
		end
		s += POST_PITCH
	end

	local lights = 0
	local idx = 0
	local headL, headH, headD = m(0.75), m(0.18), m(0.32)
	s = LAMP_PITCH / 2
	while s < total do
		idx += 1
		local seg, l = locate(segs, s)
		local zLamp = 0
		for _, side in { -1, 1 } do
			local base = worldAt(seg, side * EDGE_X, FASCIA_TOP, l)
			zLamp = base.Z
			Kit.vcyl(parent, base + Vector3.new(0, (LAMP_H + 0.2) / 2 - 0.2, 0), LAMP_H + 0.2, m(0.2), POLE_C, Enum.Material.Metal, { name = "LampPole", collide = true })
			-- 암: 기둥 꼭대기에서 차도 쪽으로
			Kit.box(parent, CFrame.new(base + Vector3.new(-side * LAMP_ARM / 2, LAMP_H, 0)), Vector3.new(LAMP_ARM + m(0.1), m(0.1), m(0.12)), POLE_C, Enum.Material.Metal, { name = "LampArm", collide = false, query = false })
			-- 등기구 머리(암 끝) + 아래 발광 렌즈
			local hx = -side * (LAMP_ARM - headL / 2 + m(0.1))
			Kit.box(parent, CFrame.new(base + Vector3.new(hx, LAMP_H + headH / 2 - m(0.03), 0)), Vector3.new(headL, headH, headD), POLE_C, Enum.Material.Metal, { name = "LampHead", collide = false, query = false })
			local lensPos = base + Vector3.new(hx, LAMP_H - m(0.08), 0)
			local lens = Kit.box(
				parent,
				CFrame.new(lensPos),
				Vector3.new(headL - m(0.08), m(0.12), headD - m(0.05)),
				LAMP_LENS,
				Enum.Material.Neon,
				neon("LampLens", LAMP_LENS, Enum.Material.Glass, rgb(200, 200, 192))
			)
			-- 글레어(눈부심 번짐): 실물 아님. 원경에서 등 머리가 사진처럼 빛점으로 읽히도록 하는 반투명 Neon 구
			Kit.ball(parent, lensPos - Vector3.new(0, m(0.1), 0), m(1.1), LAMP_GLARE, Enum.Material.Neon, neon("LampGlare", LAMP_GLARE, Enum.Material.Glass, rgb(200, 200, 192), 0.62))
			-- 실제 광원: 가까운 쪽에서 쌍마다 한쪽씩(번갈아)
			if lights < LAMP_LIGHTS and zLamp > -m(120) and (idx % 2 == 0) == (side < 0) then
				if Kit.light(lens, "SpotLight", { color = P.LampSodium, brightness = 2.6, range = 50, angle = 115, face = Enum.NormalId.Bottom }) then
					lights += 1
				end
			end
		end
		-- 수면 위 가로등 쌍 → 짧은 반사 스트릭(카메라 쪽 서측 가장자리 앞)
		if zLamp > F.WaterEdge + m(4) and zLamp < N.WaterEdge - m(10) then
			Kit.reflection(reflParent, BX - EDGE_X + LAMP_ARM - m(1), zLamp + m(1), m(1.3), rng:NextNumber(m(35), m(58)), LAMP_REF, 0.8)
		end
		s += LAMP_PITCH
	end
end

------------------------------------------------------------------------------------------------------
-- 교각 / 교대
------------------------------------------------------------------------------------------------------
local pierLights = 0

local function uplightFixture(parent: Instance, pos: Vector3, withLight: boolean)
	local fix = Kit.box(parent, CFrame.new(pos), Vector3.new(m(0.5), m(0.18), m(0.3)), UPLIGHT, Enum.Material.Neon, neon("Uplight", UPLIGHT, Enum.Material.Metal, METAL))
	if withLight and pierLights < PIER_LIGHTS then
		if Kit.light(fix, "SpotLight", { color = UPLIGHT, brightness = 5, range = 50, angle = 45, face = Enum.NormalId.Top }) then
			pierLights += 1
		end
	end
end

local function buildPier(parent: Instance, reflParent: Instance, z: number, rng: Random)
	local isWater = z > F.WaterEdge and z < N.WaterEdge
	local gb = deckY(z) - GIRDER_D -- 거더 바닥
	local ground = if isWater then L.Water else Kit.groundY(BX, z)
	local footTop = if isWater then FOOT_TOP_W else ground + m(0.3)
	local capTop = gb - BEARING_GAP
	-- 기초
	if isWater then
		local yb = L.Water - m(4)
		Kit.box(parent, CFrame.new(BX, (yb + footTop) / 2, z), Vector3.new(COL_X * 2, footTop - yb, FOOT_D), CONC_PIER, Enum.Material.Concrete, { name = "Footing" })
		for _, side in { -1, 1 } do
			-- 둥근 코(흐름 방향 = X). 윗면은 상자보다 0.3 낮게(동일 평면 회피)
			local top = footTop - 0.3
			Kit.vcyl(parent, Vector3.new(BX + side * COL_X, (yb + top) / 2, z), top - yb, FOOT_D, CONC_PIER, Enum.Material.Concrete, { name = "FootingNose" })
		end
	else
		local yb = ground - m(1)
		Kit.box(parent, CFrame.new(BX, (yb + footTop) / 2, z), Vector3.new(COL_X * 2 + COL_D + m(2), footTop - yb, COL_D + m(1.5)), CONC_PIER, Enum.Material.Concrete, { name = "Footing" })
	end

	if capTop - CAP_H - footTop < m(2) then
		-- 낮은 지점: 벽식 교각
		local wallTop = capTop - m(0.1)
		local h = wallTop - (footTop - 0.2)
		Kit.box(parent, CFrame.new(BX, (footTop - 0.2 + wallTop) / 2, z), Vector3.new(GIRDER_HALF * 2 - m(1), h, m(1.5)), CONC_PIER, Enum.Material.Concrete, { name = "PierWall" })
		Kit.box(parent, CFrame.new(BX, (wallTop + gb) / 2 + 0.1, z), Vector3.new(GIRDER_HALF * 2 - m(2.5), gb - wallTop + 0.2, m(0.8)), CONC_GIRDER, Enum.Material.Concrete, { name = "Bearing", collide = false, query = false })
		uplightFixture(parent, Vector3.new(BX - COL_X, footTop + m(0.1), z + m(1.5)), false)
		return
	end

	local capBot = capTop - CAP_H
	-- 쌍기둥 + 세척광 외피 + 등기구
	for _, side in { -1, 1 } do
		local cx = BX + side * COL_X
		local y0, y1 = footTop - 0.2, capBot + 0.2
		Kit.vcyl(parent, Vector3.new(cx, (y0 + y1) / 2, z), y1 - y0, COL_D, CONC_PIER, Enum.Material.Concrete, { name = "Column" })
		-- 업라이트 감쇠: 아래(밝음) 55 % + 위(옅음) 45 %
		local s0, s1 = footTop + 0.3, capBot - 0.3
		local sm = s0 + (s1 - s0) * 0.55
		Kit.vcyl(parent, Vector3.new(cx, (s0 + sm) / 2, z), sm - s0, COL_D + 0.8, SHEATH_C, Enum.Material.Neon, neon("ColumnWash", SHEATH_C, Enum.Material.Glass, CONC_PIER, 0.56))
		Kit.vcyl(parent, Vector3.new(cx, (sm + 0.1 + s1) / 2, z), s1 - sm - 0.1, COL_D + 0.8, SHEATH_TOP, Enum.Material.Neon, neon("ColumnWashTop", SHEATH_TOP, Enum.Material.Glass, CONC_PIER, 0.74))
		uplightFixture(parent, Vector3.new(cx, footTop + m(0.09), z + COL_D / 2 + m(0.6)), isWater and side < 0)
	end
	-- 해머헤드 캡 + 아래쪽 테이퍼(웨지: 평면이 위, 두꺼운 쪽이 기둥)
	Kit.box(parent, CFrame.new(BX, capBot + CAP_H / 2, z), Vector3.new(CAP_W, CAP_H, CAP_D), CONC_PIER, Enum.Material.Concrete, { name = "PierCap" })
	local wl = CAP_W / 2 - COL_X - COL_D / 2 + 0.3
	local wh = m(1.2)
	for _, side in { -1, 1 } do
		local pos = Vector3.new(BX + side * (CAP_W / 2 - wl / 2), capBot - wh / 2, z)
		local cf = CFrame.lookAt(pos, pos + Vector3.new(side, 0, 0)) * CFrame.Angles(0, 0, math.pi)
		Kit.wedge(parent, cf, Vector3.new(CAP_D - 0.3, wh, wl), CONC_PIER, Enum.Material.Concrete, { name = "CapTaper" })
		-- 받침(캡 윗면 → 거더 바닥, 양끝 0.1 묻힘)
		Kit.box(parent, CFrame.new(BX + side * COL_X, (capTop + gb) / 2, z), Vector3.new(m(1.0), gb - capTop + 0.2, m(1.0)), CONC_GIRDER, Enum.Material.Concrete, { name = "Bearing", collide = false, query = false })
	end
	-- 캡 앞뒤면 세척광 막
	for _, dz in { 1, -1 } do
		Kit.box(parent, CFrame.new(BX, capBot + CAP_H / 2, z + dz * (CAP_D / 2 + 0.4)), Vector3.new(CAP_W - m(1), CAP_H - m(0.3), 0.2), WASH_C, Enum.Material.Neon, neon("CapWash", WASH_C, Enum.Material.Glass, CONC_PIER, 0.55))
	end

	if isWater then
		Kit.reflection(reflParent, BX - COL_X, z + FOOT_D / 2 + m(1), m(3.5), rng:NextNumber(m(65), m(100)), PIER_REF, 0.74)
	end
end

local function buildAbutment(parent: Instance, zToe: number, zCrest: number)
	-- 사면 발치(둔치 쪽)에서 제방 마루 안쪽까지 묻힌 콘크리트 블록. 윗면 = 거더 바닥 아래 0.3
	local dir = if zCrest > zToe then 1 else -1
	local zFront = zToe - dir * m(0.3)
	local zBack = zCrest + dir * m(0.6)
	local top = deckY(zToe) - GIRDER_D - 0.3
	local bot = L.Promenade - m(0.3)
	Kit.box(parent, CFrame.new(BX, (bot + top) / 2, (zFront + zBack) / 2), Vector3.new(B.Width, top - bot, math.abs(zBack - zFront)), CONC_PIER, Enum.Material.Concrete, { name = "Abutment" })
end

------------------------------------------------------------------------------------------------------
-- 양끝 도시 도로 토막 (제방 도로 바깥 ~ ZFrom/ZTo, 평탄 Y_END)
------------------------------------------------------------------------------------------------------
local function buildStub(parent: Instance, z0: number, z1: number)
	local len = math.abs(z1 - z0)
	if len < 1 then
		return
	end
	local zc = (z0 + z1) / 2
	local cf = CFrame.new(BX, Y_END, zc)
	local function box(x: number, y0: number, y1: number, w: number, o: PartOpts, l: number?)
		local ll = l or len
		Kit.part(parent, cf * CFrame.new(x, (y0 + y1) / 2, 0), Vector3.new(w, y1 - y0, ll), o)
	end
	-- 도시 지면이 아직 없어도 떠 보이지 않도록 깊게(윗면만 지면 위 0.4)
	box(0, -m(3), 0, B.Width, solid("RoadSlab", ASPHALT, Enum.Material.Asphalt))
	box(0, -0.2, BARRIER_H, BARRIER_HALF * 2, solid("MedianBarrier", CONC, Enum.Material.Concrete), len - m(3))
	for _, side in { -1, 1 } do
		box(side * (CURB_X + HALF_W) / 2, -0.4, WALK_TOP, HALF_W - CURB_X, solid("Sidewalk", WALK_C, Enum.Material.Pavement))
		box(side * (CURB_X - 0.5 - LINE_W / 2), MARK_T - 0.5, MARK_T, LINE_W, decor("EdgeLine", PAINT_W, Enum.Material.SmoothPlastic))
		box(side * (LANE_X0 + LINE_W / 2), MARK_T - 0.5, MARK_T, LINE_W, decor("CenterLine", PAINT_Y, Enum.Material.SmoothPlastic))
		for k = 1, 3 do
			box(side * (LANE_X0 + k * LANE_W), MARK_T - 0.5, MARK_T, LINE_W, decor("LaneDash", PAINT_W, Enum.Material.SmoothPlastic), math.min(DASH_LEN, len - m(2)))
		end
	end
end

------------------------------------------------------------------------------------------------------
-- 차선 (차량 불빛)
------------------------------------------------------------------------------------------------------
local LANE_SPEED = { 65, 62, 58, 55 } -- stud/s: 1차로(중앙, ≈ 70 km/h) → 4차로(바깥, ≈ 60 km/h)

local function registerLanes(zs: { number })
	local pts: { Vector2 } = { Vector2.new(B.ZFrom, Y_END) }
	for _, z in zs do
		table.insert(pts, Vector2.new(z, deckY(z)))
	end
	table.insert(pts, Vector2.new(B.ZTo, Y_END))
	for k = 1, 4 do
		local off = LANE_X0 + (k - 0.5) * LANE_W
		-- +Z(관람자 쪽)로 오는 차: 우측통행 → -X 쪽, 전조등
		local head: { Vector3 } = {}
		for _, p in pts do
			table.insert(head, Vector3.new(BX - off, p.Y + CAR_UP, p.X))
		end
		Kit.lane("Bridge_N" .. k, head, { speed = LANE_SPEED[k], kind = "head", density = 0.9, spacing = m(1.5) })
		-- -Z(잠실 쪽)로 가는 차: +X 쪽, 후미등
		local tail: { Vector3 } = {}
		for i = #pts, 1, -1 do
			local p = pts[i]
			table.insert(tail, Vector3.new(BX + off, p.Y + CAR_UP, p.X))
		end
		Kit.lane("Bridge_S" .. k, tail, { speed = LANE_SPEED[k] - 2, kind = "tail", density = 0.9, spacing = m(1.5) })
	end
end

------------------------------------------------------------------------------------------------------
function Bridge.build(ctx: any)
	local model: Instance = ctx.model
	local rng: Random = ctx.rng
	pierLights = 0

	local function folder(name: string): Folder
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = model
		return f
	end
	local deckF, pierF, lampF, reflF, endF = folder("Deck"), folder("Piers"), folder("Lamps"), folder("Reflections"), folder("Ends")

	local zs, piers = supports()
	local segs, total = makeSegs(zs)

	buildDeck(deckF, segs)
	buildLampsAndPosts(lampF, segs, total, rng, reflF)
	-- 교각: 가까운(관람자) 쪽부터 → 업라이트 SpotLight 예산이 보이는 교각에 먼저 쓰이도록
	table.sort(piers, function(a: number, b: number)
		return a > b
	end)
	for _, z in piers do
		buildPier(pierF, reflF, z, rng)
	end
	buildAbutment(endF, F.ParkTo, Z_A)
	buildAbutment(endF, N.ParkTo, Z_B)
	buildStub(endF, B.ZFrom, F.RoadTo)
	buildStub(endF, N.RoadTo, B.ZTo)

	registerLanes(zs)

	-- 발자국 예약: 도시 도로 토막 + 둔치/사면/수면 구간(제방 도로 띠는 비워 둠)
	local hw = HALF_W + m(1.2)
	Kit.reserve(BX - hw, B.ZFrom, BX + hw, F.RoadTo, "BridgeRoadFar")
	Kit.reserve(BX - hw, Z_A, BX + hw, Z_B, "Bridge")
	Kit.reserve(BX - hw, N.RoadTo, BX + hw, B.ZTo, "BridgeRoadNear")
end

return Bridge
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000004"><Properties><string name="Name">CityCarpet</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / CityCarpet
-- 지평선까지 이어지는 LOD 도시 카펫 + 원경 산 능선. 실제 스케일(1 stud = 0.3 m).
--   * CarpetFarMid  : Facade "mid"(몸체 + 층 불빛 띠) 8~30층(25~90 m), 다운타운 클러스터에서 40~60층(160~240 m) 고층 몇 개
--   * CarpetFarFar  : Facade "far"(몸체 + 불빛 띠 1) 5~25층(16~80 m), 클러스터에서 가끔 높은 원경 타워(항공등)
--   * CarpetNear    : 관람자 뒤쪽 도시 — 가까운 줄은 "mid", 먼 줄은 "far"
--   * Infill        : 아파트 띠의 빈 블록 + 아파트 띠 바깥 옆 구간을 저층 상가/빌라(2~10층, 8~30 m)로 메움
--   * 높이는 몇 개의 "다운타운" 클러스터(가우시안)에서 솟아 원경 스카이라인이 평평한 벽이 되지 않게 함
--   * 배치: 지터 격자 후보 → 우선순위(관람자 거리 × 화면 밖 가중 × 잡음) 순으로 예산까지 → 멀수록 자연스럽게 성기게
--   * 모든 발자국 Kit.isFreeRect 검사 + Kit.reserveRect (Skyline/Landmark/Bridge/Riverside/Apartments 예약을 피함). 광원 0개.
--   * 산: 서울 외곽 산(높이 300~600 m = 1000~2000 stud, 산괴 폭 3~8 km)을 Kit.ellipsoid 로 — 넓고 낮은 산자락 1개 +
--     봉우리 2~4개를 땅에 묻어 겹침. 먼 겹일수록 밝은 청회색(대기 원근), 무광(Fabric) 재질. 먼 쪽 3겹 / 가까운 쪽 2겹.
--   * 도시 지면(Riverside CityGround) 바깥까지 이어지는 카펫 구간은 도시 지면보다 0.6 낮은 바닥 판으로 받침(겹쳐도 z-fighting 없음).

local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)
local Facade = require(script.Parent.Facade)

local CityCarpet = {}

local rgb = Color3.fromRGB
local P = Config.Palette
local ZN = Config.Zones
local R = Config.Real
local M = Config.m
local CITY_Y = Config.Level.City
local MAT = Enum.Material

------------------------------------------------------------------------------------------------------
-- 상수
------------------------------------------------------------------------------------------------------
local BUDGET_TOTAL = 5500 -- 모듈 하드 캡
local BUDGET = { FarMid = 2000, FarFar = 650, Near = 1050, InfillFar = 830, InfillNear = 650 } -- 구역별(밀도 배율 적용 전)
local RESERVE_TAIL = 320 -- 산(~250) + 바닥 판(64) 몫
local GAP = M(4) -- 건물 사이 최소 간격(예약 여유) 4 m

-- 층고(실측): 오피스 4.0 m, 주거/상가 혼합 3.3 m
local OFFICE_F = R.OfficeFloor
local MIXED_F = M(3.3)

local HERO = Config.Viewpoint.HeroCamPos
local HERO_LOOK = Config.Viewpoint.HeroCamLook
local DECK = Config.Viewpoint.DeckCenter

type Cluster = { x: number, z: number, r: number, k: number }

-- 다운타운 클러스터(히어로 화면에서 고층 군 사이 빈틈 뒤쪽에 오도록) — 구역 좌표 기준(실제 스케일)
local CLUSTERS_FAR: { Cluster } = {
	{ x = -2500, z = -5400, r = 1030, k = 1.15 }, -- 왼쪽 군과 타워 사이 뒤
	{ x = 4830, z = -5250, r = 1200, k = 1.3 }, -- 오른쪽 군 오른편 뒤
	{ x = -7500, z = -5000, r = 1170, k = 1.2 }, -- 화면 왼쪽 끝
	{ x = 9330, z = -4830, r = 870, k = 0.9 },
	{ x = -4500, z = -9000, r = 1500, k = 1.1 },
	{ x = 7830, z = -9830, r = 1500, k = 1.0 },
	{ x = 2170, z = -8330, r = 1170, k = 0.8 },
	{ x = -11330, z = -9330, r = 1270, k = 0.9 },
	{ x = 13330, z = -8330, r = 1070, k = 0.8 },
}
local CLUSTERS_NEAR: { Cluster } = {
	{ x = -4500, z = 5500, r = 1170, k = 1.2 },
	{ x = 4830, z = 5000, r = 1080, k = 1.0 },
	{ x = 330, z = 7670, r = 1500, k = 0.9 },
	{ x = -8330, z = 7000, r = 1000, k = 0.7 },
}

-- 몸체 색(콘크리트·유리 톤)과 창 불빛(따뜻/차가운 혼합; Facade 가 무작위로 어둡게 함)
-- 해질녘 원경 건물은 어두운 실루엣 + 불빛: 몸체는 어둡게(대기 산란이 밝혀 줌)
local BODY = { rgb(52, 56, 66), P.GlassDeep, rgb(70, 72, 78), rgb(40, 62, 70), rgb(72, 62, 54), rgb(60, 64, 74), rgb(80, 78, 76), rgb(46, 54, 68) }
local LOW_BODY = { rgb(96, 90, 84), rgb(78, 76, 76), rgb(104, 98, 90), rgb(68, 70, 76), rgb(88, 80, 74) }
local LIT_CITY = { P.WindowWarm, P.WindowWarm, P.WindowWarmDim, P.WindowGold, P.WindowCool, P.WindowCoolDim }
local LIT_LOW = { P.WindowWarm, P.WindowWarmDim, P.WindowGold, P.WindowCoolDim, P.WindowWarm, rgb(200, 120, 150) }

------------------------------------------------------------------------------------------------------
-- 보조
------------------------------------------------------------------------------------------------------
local function pick<T>(rng: Random, t: { T }): T
	return t[rng:NextInteger(1, #t)]
end

local function bearing(x: number, z: number): number
	return math.deg(math.atan2(x - HERO.X, HERO.Z - z))
end
local LOOK_BEARING = bearing(HERO_LOOK.X, HERO_LOOK.Z)

-- 롯데타워 + 몰 시야 보호(타워보다 카메라 쪽 저층 채움만 해당)
local GUARD_B0, GUARD_B1 = math.huge, -math.huge
do
	local T, Mall = Config.Landmark.Tower, Config.Landmark.Mall
	local r = T.BaseWidth * 0.75
	for _, c in { { T.Center.X - r, T.Center.Z - r }, { T.Center.X + r, T.Center.Z - r }, { T.Center.X - r, T.Center.Z + r }, { T.Center.X + r, T.Center.Z + r }, { Mall.Min.X, Mall.Min.Y }, { Mall.Max.X, Mall.Min.Y }, { Mall.Min.X, Mall.Max.Y }, { Mall.Max.X, Mall.Max.Y } } do
		local b = bearing(c[1], c[2])
		GUARD_B0 = math.min(GUARD_B0, b - 1.2)
		GUARD_B1 = math.max(GUARD_B1, b + 1.2)
	end
end
local function blocksLandmark(x: number, z: number, r: number): boolean
	if z + r < Config.Landmark.Tower.Center.Z or z > 0 then
		return false
	end
	local b = bearing(x, z)
	local db = math.deg(math.atan2(r, math.max(1, HERO.Z - z)))
	return b + db > GUARD_B0 and b - db < GUARD_B1
end

local function boost(clusters: { Cluster }, x: number, z: number): number
	local b = 0
	for _, c in clusters do
		local dx, dz = (x - c.x) / c.r, (z - c.z) / c.r
		b = math.max(b, c.k * math.exp(-(dx * dx + dz * dz)))
	end
	return b
end

-- 층 단위로 스냅(실제 층수 × 층고 + 옥탑 1.2 m)
local function snapFloors(h: number, floorH: number): number
	return math.max(2, math.floor(h / floorH + 0.5)) * floorH + M(1.2)
end

------------------------------------------------------------------------------------------------------
-- 건물 후보 생성 + 예산 내 배치
------------------------------------------------------------------------------------------------------
type Rect = { XMin: number, XMax: number, ZMin: number, ZMax: number }

type FillOpts = {
	name: string,
	rects: { Rect },
	pitch: number,
	keep: number, -- 셀 사용 확률
	viewer: Vector3,
	frustum: boolean,
	budget: number,
	style: (z: number, h: number, rng: Random) -> string,
	wMin: number,
	wMax: number,
	hMin: number,
	hMax: number,
	hPow: number, -- 높이 분포 지수(클수록 낮은 건물 위주)
	floorH: number,
	clusters: { Cluster }?,
	towerChance: number, -- 클러스터 중심부의 고층 확률
	towerH: { number }, -- {min, max}
	maxTall: number, -- 고층 개수 상한("몇 개만")
	beaconFar: boolean, -- far 스타일 고층에 항공등
	guard: boolean,
	low: boolean, -- 저층 채움(상가/빌라 색)
	maxDist: number?, -- 관람자에서 이보다 먼 후보는 버림(산자락 안/뒤 = 보이지 않음)
}

type Cand = { x: number, z: number, w: number, d: number, h: number, yaw: number, prio: number, idx: number, tall: boolean }

local function fill(parent: Instance, o: FillOpts, rng: Random, hardLeft: number): number
	local density = Config.Quality.Density
	local budget = math.min(o.budget * density, hardLeft)
	local cands: { Cand } = {}
	local pitch = o.pitch / math.sqrt(math.max(0.3, density))
	local hCap = o.hMax * 1.35 -- 클러스터 가산 후 일반 건물 상한
	for _, r in o.rects do
		if r.XMax - r.XMin < pitch * 0.5 or r.ZMax - r.ZMin < pitch * 0.5 then
			continue
		end
		local nx = math.max(1, math.floor((r.XMax - r.XMin) / pitch))
		local nz = math.max(1, math.floor((r.ZMax - r.ZMin) / pitch))
		local px, pz = (r.XMax - r.XMin) / nx, (r.ZMax - r.ZMin) / nz
		for i = 0, nx - 1 do
			for j = 0, nz - 1 do
				if rng:NextNumber() > o.keep then
					continue
				end
				local x = r.XMin + (i + 0.5) * px + rng:NextNumber(-0.22, 0.22) * px
				local z = r.ZMin + (j + 0.5) * pz + rng:NextNumber(-0.22, 0.22) * pz
				if o.maxDist and (Vector2.new(x, z) - Vector2.new(o.viewer.X, o.viewer.Z)).Magnitude > o.maxDist then
					continue
				end
				local b = if o.clusters then boost(o.clusters, x, z) else 0
				local w = rng:NextNumber(o.wMin, o.wMax)
				local d = math.clamp(w * rng:NextNumber(0.6, 1.25), o.wMin * 0.7, o.wMax)
				local h = o.hMin + (o.hMax - o.hMin) * (rng:NextNumber() ^ o.hPow)
				h = math.min(h * (1 + b * rng:NextNumber(0.4, 0.8)), hCap)
				local tall = false
				if b > 0.5 and rng:NextNumber() < o.towerChance * b then
					h = rng:NextNumber(o.towerH[1], o.towerH[2])
					w = math.min(w, M(rng:NextNumber(30, 45))) -- 고층 평면 30~45 m
					d = math.min(d, w * rng:NextNumber(0.8, 1.0))
					tall = true
				end
				-- 셀보다 크면 줄임
				w = math.min(w, px - GAP * 2)
				d = math.min(d, pz - GAP * 2)
				local yaw = 0
				local ry = rng:NextNumber()
				if ry < 0.12 then
					yaw = rng:NextNumber(-35, 35)
				elseif ry < 0.3 then
					yaw = 90 -- 정사각에 가까운 평면을 돌려 리듬 변화
				end
				local dist = (Vector2.new(x, z) - Vector2.new(o.viewer.X, o.viewer.Z)).Magnitude
				local prio = dist * rng:NextNumber(0.85, 1.2)
				if o.frustum and math.abs(bearing(x, z) - LOOK_BEARING) > 50 then
					prio *= 1.6
				end
				if tall then
					prio *= 0.7 -- 다운타운 고층 우선
				end
				table.insert(cands, { x = x, z = z, w = w, d = d, h = snapFloors(h, if tall then OFFICE_F else o.floorH), yaw = yaw, prio = prio, idx = #cands + 1, tall = tall })
			end
		end
	end
	table.sort(cands, function(a: Cand, b: Cand): boolean
		if a.prio ~= b.prio then
			return a.prio < b.prio
		end
		return a.idx < b.idx
	end)
	local g = Kit.group(parent, o.name)
	local start = Kit.stats.parts
	local n, nTall = 0, 0
	for _, c in cands do
		if Kit.stats.parts - start >= budget then
			break
		end
		local h = c.h
		local tall = c.tall
		if tall and nTall >= o.maxTall then
			tall = false
			h = snapFloors(math.min(h, hCap), o.floorH)
		end
		if not Kit.isFreeRect(c.x, c.z, c.w, c.d, c.yaw, GAP) then
			continue
		end
		if o.guard and blocksLandmark(c.x, c.z, math.max(c.w, c.d) * 0.7) then
			continue
		end
		local style = o.style(c.z, h, rng)
		local body = if o.low then pick(rng, LOW_BODY) else pick(rng, BODY)
		local lit = if o.low then LIT_LOW else LIT_CITY
		local beacon: boolean? = nil
		if style == "far" then
			beacon = tall and o.beaconFar
		end
		local crown: string? = nil
		if tall and rng:NextNumber() < 0.6 then
			crown = "led"
		end
		Facade.tower(g, {
			name = if tall then "Tower" else "Block",
			cf = CFrame.new(c.x, CITY_Y, c.z) * CFrame.Angles(0, math.rad(c.yaw), 0),
			w = c.w,
			d = c.d,
			h = h,
			style = style,
			rng = rng,
			glass = body,
			lit = lit,
			litChance = if style == "far" then 0.72 else 0.8,
			crown = crown,
			ledColor = pick(rng, { P.LedGold, P.LedCyan, P.LedBlue, P.WindowCool }),
			beacon = beacon,
			collide = style ~= "far",
		})
		Kit.reserveRect(c.x, c.z, c.w, c.d, c.yaw, o.name)
		n += 1
		if tall then
			nTall += 1
		end
	end
	g:SetAttribute("Buildings", n)
	g:SetAttribute("Towers", nTall)
	g:SetAttribute("Parts", Kit.stats.parts - start)
	return Kit.stats.parts - start
end

------------------------------------------------------------------------------------------------------
-- 카펫 바닥 판: 도시 지면(Riverside) 밖으로 이어지는 카펫 구간 받침. 도시 지면보다 0.6 낮게 → 겹쳐도 가려짐.
------------------------------------------------------------------------------------------------------
local GROUND_C = rgb(52, 54, 60)
local function groundPad(parent: Instance, x0: number, x1: number, z0: number, z1: number)
	local MAXP = 2000
	local za, zb = math.min(z0, z1), math.max(z0, z1)
	local nx = math.max(1, math.ceil((x1 - x0) / MAXP))
	local nz = math.max(1, math.ceil((zb - za) / MAXP))
	local dx, dz = (x1 - x0) / nx, (zb - za) / nz
	local T = 4
	for i = 0, nx - 1 do
		for j = 0, nz - 1 do
			Kit.box(parent, CFrame.new(x0 + dx * (i + 0.5), CITY_Y - 0.6 - T / 2, za + dz * (j + 0.5)), Vector3.new(dx, T, dz), GROUND_C, MAT.Concrete, { name = "CarpetGround", shadow = false })
		end
	end
end

------------------------------------------------------------------------------------------------------
-- 산 능선 — 대표 시점(히어로 카메라 / 전망대)을 중심으로 한 호(arc)를 따라 배치.
--   서울은 산으로 둘러싸인 분지: 정면에서는 도시 끝 뒤로, 화면 양 끝에서는 조금 더 가까이 감싸 들어옴.
--   호 배치 덕분에 모든 산괴 중심이 시점에서 ~15 km(대략 1만 5천 stud) 안 → Roblox/미리보기 원거리 컬링에 걸리지 않음.
------------------------------------------------------------------------------------------------------
type ArcOpts = {
	origin: Vector3, -- 호 중심(대표 시점)
	out: number, -- 바깥(시점 반대) 방향 Z 부호: 먼 쪽 -1 / 가까운 쪽 +1
	b0: number, -- 방위각 범위(도, 시점 기준 정면 = 0)
	b1: number,
	radius: number, -- 산자락 앞 가장자리 반지름
	hMin: number, -- 주봉 높이(지면 위)
	hMax: number,
	wMin: number, -- 산괴 폭(3~8 km)
	wMax: number,
	depthMax: number, -- 산괴 깊이 상한(원거리 컬링 반경 안에 중심을 두기 위함)
	color: Color3,
	phase: number,
	freq: number, -- 방위각(도)당 높이 물결
}

local MOUNTAIN_MAT = MAT.Fabric -- 무광(스페큘러 없음): 노을빛에 모래 언덕처럼 번들거리지 않게

-- 호 위 방위각 bdeg 의 산괴 프레임: 위치 = 산자락 앞 가장자리, local X = 접선, local Z * out = 바깥
local function arcFrame(o: ArcOpts, bdeg: number): CFrame
	local t = math.rad(bdeg)
	if o.out < 0 then
		return CFrame.new(o.origin.X + o.radius * math.sin(t), 0, o.origin.Z - o.radius * math.cos(t)) * CFrame.Angles(0, -t, 0)
	end
	return CFrame.new(o.origin.X + o.radius * math.sin(t), 0, o.origin.Z + o.radius * math.cos(t)) * CFrame.Angles(0, t, 0)
end

-- 땅에 묻힌 타원체: 지면 위 높이 H, sink = 반높이 중 땅 아래 비율, foot = 프레임 기준 앞 가장자리에서 바깥으로 민 거리,
-- tilt = 접선 방향 기울기(도) → 한쪽은 가파르고 한쪽은 완만한 비대칭 봉우리
local function dome(parent: Instance, F: CFrame, out: number, lx: number, foot: number, w: number, H: number, d: number, sink: number, tilt: number, c: Color3)
	local halfY = H / (1 - sink)
	local cy = CITY_Y + H - halfY
	local lz = out * (foot + (d / 2) * math.sqrt(1 - sink * sink))
	local cf = F * CFrame.new(lx, cy, lz) * CFrame.Angles(0, 0, math.rad(tilt))
	Kit.ellipsoid(parent, cf, Vector3.new(w, halfY * 2, d), c, MOUNTAIN_MAT, { name = "Ridge", shadow = false, query = false, collide = false })
end

local function arcRange(parent: Instance, o: ArcOpts, rng: Random): number
	local n = 0
	local b = o.b0 - math.deg(o.wMax * 0.3 / o.radius)
	while b < o.b1 do
		local W = rng:NextNumber(o.wMin, o.wMax)
		local bc = b + math.deg(W * 0.5 / o.radius)
		local F = arcFrame(o, bc)
		local wave = 0.5 + 0.5 * math.sin(bc * o.freq + o.phase) * math.cos(bc * o.freq * 0.43 + o.phase * 1.7)
		local Hp = (o.hMin + (o.hMax - o.hMin) * wave) * rng:NextNumber(0.88, 1.08)
		local D = math.min(W * rng:NextNumber(0.32, 0.42), o.depthMax)
		local tone = o.color:Lerp(rgb(20, 26, 36), rng:NextNumber(0, 0.15))
		-- 산자락(넓고 낮게, 주봉의 38~46%)
		dome(parent, F, o.out, 0, 0, W, Hp * rng:NextNumber(0.38, 0.46), D, 0.3, rng:NextNumber(-3, 3), tone)
		n += 1
		-- 봉우리 4~6개(주봉 1 + 보조봉): 폭/높이 2.0~3.2, 기울기 ±6~20도 → 둥근 모래 언덕이 아니라 굴곡진 능선
		local np = rng:NextInteger(4, 6)
		for i = 1, np do
			local ph = Hp * (if i == 1 then 1 else rng:NextNumber(0.58, 0.9))
			local pw = ph * rng:NextNumber(2.0, 3.2)
			local pd = math.min(pw * rng:NextNumber(0.5, 0.7), D)
			local lx = rng:NextNumber(-0.42, 0.42) * W
			local tilt = rng:NextNumber(6, 20) * (if rng:NextNumber() < 0.5 then -1 else 1)
			dome(parent, F, o.out, lx, D * rng:NextNumber(0.04, 0.16), pw, ph, pd, 0.14, tilt, tone:Lerp(o.color, 0.5))
			n += 1
		end
		b += math.deg(W * rng:NextNumber(0.5, 0.7) / o.radius)
	end
	return n
end

-- 산자락 반지름(시점 기준) — 카펫이 산 속에 묻히지 않도록 fill 의 maxDist 로도 사용
--   REACH: 산괴 중심이 시점에서 이 거리 안(원거리 컬링 ~16000 stud). 뒤 겹 = Config 산 능선 Z 와 REACH 중 가까운 쪽.
local REACH = 15600
local FAR_FOOT = {} :: { front: number, mid: number, back: number }
FAR_FOOT.back = math.min(HERO.Z - ZN.MountainsFar.Z, REACH - 2700) -- 12900
FAR_FOOT.mid = FAR_FOOT.back - 900 -- 12000
FAR_FOOT.front = math.min(HERO.Z - Config.FarBank.CityTo - 1700, FAR_FOOT.mid - 1000) -- 11000 (도시 끝 뒤)
local NEAR_FOOT = {} :: { front: number, back: number }
NEAR_FOOT.back = math.min(ZN.MountainsNear.Z - DECK.Z + 400, REACH - 2700) -- 9900
NEAR_FOOT.front = NEAR_FOOT.back - 1300 -- 8600 (가까운 쪽 도시 끝 뒤)

local function mountains(parent: Instance, rng: Random, deckView: Vector3)
	-- 대기 원근: 먼 겹일수록 밝고 푸른 회색. 기준 팔레트 Mountain / MountainFar 보다 어둡게 → 주황 대기 산란을 받아도 청회색.
	local back = P.MountainFar:Lerp(rgb(24, 32, 50), 0.35) -- ≈ (54, 64, 84)
	local mid = P.Mountain:Lerp(rgb(18, 24, 38), 0.3) -- ≈ (36, 46, 58)
	local front = P.Mountain:Lerp(rgb(12, 16, 26), 0.45) -- ≈ (30, 38, 48)
	local far = Kit.group(parent, "MountainsFar")
	-- 높이 200~540 m(호 배치로 실제보다 가까우므로 300~600 m 범위의 중하단), 산괴 폭 3~8 km
	arcRange(far, { origin = HERO, out = -1, b0 = -76, b1 = 70, radius = FAR_FOOT.back, hMin = M(380), hMax = M(540), wMin = M(4500), wMax = M(8000), depthMax = 4400, color = back, phase = 1.3, freq = 9 }, rng)
	arcRange(far, { origin = HERO, out = -1, b0 = -74, b1 = 66, radius = FAR_FOOT.mid, hMin = M(300), hMax = M(440), wMin = M(3500), wMax = M(6000), depthMax = 4000, color = mid, phase = 4.1, freq = 12 }, rng)
	arcRange(far, { origin = HERO, out = -1, b0 = -70, b1 = 62, radius = FAR_FOOT.front, hMin = M(200), hMax = M(320), wMin = M(3000), wMax = M(5000), depthMax = 3600, color = front, phase = 2.6, freq = 15 }, rng)
	local near = Kit.group(parent, "MountainsNear")
	arcRange(near, { origin = deckView, out = 1, b0 = -82, b1 = 82, radius = NEAR_FOOT.back, hMin = M(400), hMax = M(580), wMin = M(4000), wMax = M(7000), depthMax = 4400, color = mid, phase = 0.4, freq = 10 }, rng)
	arcRange(near, { origin = deckView, out = 1, b0 = -78, b1 = 78, radius = NEAR_FOOT.front, hMin = M(250), hMax = M(400), wMin = M(3000), wMax = M(5000), depthMax = 3600, color = front, phase = 3.3, freq = 14 }, rng)
end

------------------------------------------------------------------------------------------------------
-- 진입점
------------------------------------------------------------------------------------------------------
function CityCarpet.build(ctx: any)
	local model: Model = ctx.model
	local rng: Random = ctx.rng
	local start = Kit.stats.parts
	local function left(): number
		return BUDGET_TOTAL - RESERVE_TAIL - (Kit.stats.parts - start)
	end
	local deckView = Vector3.new(DECK.X, Config.Viewpoint.DeckHeight, DECK.Z)
	local AF, AN = ZN.ApartmentsFar, ZN.ApartmentsNear
	local CFM, CFF, CN = ZN.CarpetFarMid, ZN.CarpetFarFar, ZN.CarpetNear
	local F, N = Config.FarBank, Config.NearBank

	-- 1) 중경(먼 쪽): mid — 8~30층(25~90 m), 클러스터 중심에 40~60층(160~240 m) 몇 개
	fill(model, {
		name = "FarMid",
		rects = { CFM },
		pitch = M(75),
		keep = 0.92,
		viewer = HERO,
		frustum = true,
		budget = BUDGET.FarMid,
		style = function(_z: number, _h: number, _r: Random): string
			return "mid"
		end,
		wMin = M(18),
		wMax = M(45),
		hMin = M(25),
		hMax = M(90),
		hPow = 1.7,
		floorH = MIXED_F,
		clusters = CLUSTERS_FAR,
		towerChance = 0.45,
		towerH = { M(160), M(240) },
		maxTall = 7,
		beaconFar = true,
		guard = false,
		low = false,
		maxDist = FAR_FOOT.front - 150,
	}, rng, left())

	-- 2) 원경(먼 쪽): far — 5~25층(16~80 m), 블록 단위로 크게
	fill(model, {
		name = "FarFar",
		rects = { CFF },
		pitch = M(88),
		keep = 0.9,
		viewer = HERO,
		frustum = true,
		budget = BUDGET.FarFar,
		style = function(_z: number, _h: number, _r: Random): string
			return "far"
		end,
		wMin = M(22),
		wMax = M(60),
		hMin = M(16),
		hMax = M(80),
		hPow = 1.5,
		floorH = MIXED_F,
		clusters = CLUSTERS_FAR,
		towerChance = 0.35,
		towerH = { M(140), M(220) },
		maxTall = 6,
		beaconFar = true,
		guard = false,
		low = false,
		maxDist = FAR_FOOT.front - 150,
	}, rng, left())

	-- 3) 관람자 뒤쪽 도시: 가까운 줄 mid, 먼 줄 far
	local midUntil = CN.ZMin + (CN.ZMax - CN.ZMin) * 0.33
	fill(model, {
		name = "Near",
		rects = { CN },
		pitch = M(88),
		keep = 0.88,
		viewer = deckView,
		frustum = false,
		budget = BUDGET.Near,
		style = function(z: number, h: number, r: Random): string
			if z < midUntil or (h > M(120) and r:NextNumber() < 0.5) then
				return "mid"
			end
			return "far"
		end,
		wMin = M(18),
		wMax = M(55),
		hMin = M(16),
		hMax = M(80),
		hPow = 1.6,
		floorH = MIXED_F,
		clusters = CLUSTERS_NEAR,
		towerChance = 0.4,
		towerH = { M(150), M(220) },
		maxTall = 4,
		beaconFar = true,
		guard = false,
		low = false,
		maxDist = NEAR_FOOT.front - 150,
	}, rng, left())

	-- 4) 저층 채움: 아파트 띠의 빈 블록 + 아파트 띠 바깥 옆 구간 (먼 쪽 / 가까운 쪽) — 2~10층 상가/빌라
	local function lowStyle(_z: number, _h: number, _r: Random): string
		return "mid"
	end
	local function infill(name: string, rects: { Rect }, viewer: Vector3, frustum: boolean, budget: number, maxDist: number)
		fill(model, {
			name = name,
			rects = rects,
			pitch = M(60),
			keep = 0.8,
			viewer = viewer,
			frustum = frustum,
			budget = budget,
			style = lowStyle,
			wMin = M(13),
			wMax = M(32),
			hMin = M(8),
			hMax = M(30),
			hPow = 1.3,
			floorH = MIXED_F,
			clusters = nil,
			towerChance = 0,
			towerH = { M(30), M(30) },
			maxTall = 0,
			beaconFar = false,
			guard = frustum,
			low = true,
			maxDist = maxDist,
		}, rng, left())
	end
	infill("InfillFar", {
		AF,
		{ XMin = CFM.XMin, XMax = AF.XMin, ZMin = AF.ZMin, ZMax = F.CityFrom },
		{ XMin = AF.XMax, XMax = CFM.XMax, ZMin = AF.ZMin, ZMax = F.CityFrom },
	}, HERO, true, BUDGET.InfillFar, FAR_FOOT.front - 150)
	infill("InfillNear", {
		AN,
		{ XMin = CN.XMin, XMax = AN.XMin, ZMin = N.CityFrom, ZMax = CN.ZMin },
		{ XMin = AN.XMax, XMax = CN.XMax, ZMin = N.CityFrom, ZMax = CN.ZMin },
	}, deckView, false, BUDGET.InfillNear, NEAR_FOOT.front - 150)

	-- 5) 카펫 바닥 판(도시 지면 바깥 좌우 구간): 먼 쪽 |X| 8800 ~ CarpetFarFar 끝, 가까운 쪽 |X| 6300 ~ CarpetNear 끝
	local pads = Kit.group(model, "CarpetGround")
	local farX = math.max(CFF.XMax, CFM.XMax)
	groundPad(pads, -farX, -8800, F.CityFrom, F.CityTo)
	groundPad(pads, 8800, farX, F.CityFrom, F.CityTo)
	groundPad(pads, CN.XMin, -6300, N.CityFrom, N.CityTo)
	groundPad(pads, 6300, CN.XMax, N.CityFrom, N.CityTo)

	-- 6) 원경 산 능선
	mountains(Kit.group(model, "Mountains"), rng, deckView)

	model:SetAttribute("Parts", Kit.stats.parts - start)
	print(string.format("[CityCarpet] 파트 %d", Kit.stats.parts - start))
end

return CityCarpet
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000005"><Properties><string name="Name">Config</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Config
-- 한강 잠실 야경 맵(롯데월드타워 모티브) 공용 설정: 좌표계, 레이아웃, 팔레트, 품질 옵션.
--
-- ── 좌표계 (studs) ───────────────────────────────────────────────────────────────────────────────
--   * 수면(Terrain Water 윗면) = Y 0.  강은 X 축을 따라 흐르고 강 중심선 = Z 0.
--   * 먼 쪽 강변(잠실, 도시/타워 쪽) = -Z.  가까운 쪽 강변(전망대·공원, 플레이어 스폰) = +Z.
--   * 대표 구도(히어로 카메라)는 +Z 강변에서 -Z 를 바라봄 → 화면 오른쪽 = +X, 왼쪽 = -X.
--   * 해는 -X 쪽으로 진다(Roblox 태양 모델): 화면 왼쪽 지평선이 노을빛.
--   * 실제 스케일: 1 stud = 0.3 m (Roblox 아바타 키 ≈ 5.5 stud ≈ 1.7 m 기준). 건물 높이·층고·도로 폭은 실측 기준.
--     롯데월드타워 555 m = 1850 stud, 오피스 층고 4.0 m, 아파트 층고 2.9 m(15~35층), 차로 폭 3.5 m.
--     강폭만 실제(≈1 km)보다 좁은 420 m(1400 stud)로 압축 — 사진 구도(망원 압축감)와 걸어서 건너는 플레이를 위해.
--
-- 모듈은 숫자를 하드코딩하지 말고 여기 값을 읽어 주세요(레이아웃이 바뀌어도 전체가 맞물리도록).

local Config = {}

Config.VERSION = "1.1.0"

-- 실제 스케일 환산 (모듈은 실측 m 값을 Config.m(미터) 로 stud 로 바꿔 쓰세요)
Config.METERS_PER_STUD = 0.3
function Config.m(meters: number): number
	return meters / 0.3
end
-- 실측 기준 (stud)
Config.Real = {
	OfficeFloor = 4.0 / 0.3, -- 오피스 층고 4.0 m  = 13.3
	HomeFloor = 2.9 / 0.3, -- 아파트 층고 2.9 m  = 9.7
	Lane = 3.5 / 0.3, -- 차로 폭 3.5 m     = 11.7
	StreetLamp = 10 / 0.3, -- 도로 가로등 10 m  = 33
	ParkLamp = 4.5 / 0.3, -- 공원 보안등 4.5 m = 15
	Railing = 1.1 / 0.3, -- 난간 1.1 m        = 3.7
	Tree = 11 / 0.3, -- 가로수/공원 나무 8~14 m (평균 11 m = 37)
	-- 실내 실측
	Door = 2.1 / 0.3, -- 문 높이 2.1 m (폭 0.9 m)
	HomeCeiling = 2.3 / 0.3, -- 아파트 천장고 2.3 m
	OfficeCeiling = 2.8 / 0.3, -- 오피스 천장고 2.8 m
	Counter = 0.9 / 0.3, -- 주방/계산대 0.9 m
	Table = 0.75 / 0.3, -- 식탁/책상 0.75 m
	Seat = 0.43 / 0.3, -- 의자/소파 좌면 0.43 m
}
-- 실내 모델은 StreamingEnabled 일 때 가까이 가야 로드되도록 Atomic 스트리밍 (Kit.group(parent, name, Config.InteriorStreaming))
Config.InteriorStreaming = Enum.ModelStreamingMode.Atomic
Config.ROOT_NAME = "SeoulSkyline" -- Workspace 아래 맵 모델 이름
Config.SEED = 20260507 -- 결정적 생성: 같은 시드 → 항상 같은 맵

------------------------------------------------------------------------------------------------------
-- 품질 / 성능
------------------------------------------------------------------------------------------------------
Config.Quality = {
	-- 0.5 ~ 1.5 : 아파트·도시 카펫 밀도 배율 (모바일 대상이면 0.7 권장)
	Density = 1.0,
	-- 실제 광원(PointLight/SpotLight/SurfaceLight) 상한. 나머지 조명은 Neon 발광으로만 표현.
	MaxLights = 240, -- 실내(로비·전망대·편의점·모델하우스) 조명 포함. Future 조명은 카메라 근처 광원만 계산
	-- 작은 장식 파트는 그림자를 끔(이 크기 미만의 최대 변 길이)
	ShadowMinSize = 20,
	-- 빌드 중 task.wait() 간격(파트 수). 서버/커맨드 바 타임아웃 방지.
	YieldEvery = 600,
}

------------------------------------------------------------------------------------------------------
-- 레벨(높이) — 모든 모듈 공통
------------------------------------------------------------------------------------------------------
Config.Level = {
	Water = 0, -- 수면
	RiverBed = -40, -- 강바닥 12 m (지형 복셀 4 stud 격자에 맞춤)
	Promenade = 5, -- 한강공원 둔치(산책로·잔디) 높이 1.5 m
	Levee = 24, -- 제방 위 도로(강변북로/올림픽대로)와 도시 지면 7 m
	City = 24, -- 도시 블록 지면
}

------------------------------------------------------------------------------------------------------
-- 강 / 강변 띠 (Z 범위, 작은 값 → 큰 값)
------------------------------------------------------------------------------------------------------
Config.River = {
	HalfWidth = 700, -- 수면: Z -700 ~ +700 (강폭 420 m)
	XMin = -11600, -- 강물이 이어지는 X 범위(지평선까지 보이도록 넉넉히)
	XMax = 11600,
}

-- 먼 쪽(잠실) 강변: 수면 끝 → 둔치 공원 → 제방 사면 → 올림픽대로 → 도시
Config.FarBank = {
	WaterEdge = -700, -- 수면 경계 (계단식 호안)
	ParkFrom = -700, -- 둔치 공원 Z (Promenade 높이)
	ParkTo = -867,
	SlopeTo = -910, -- 제방 사면 끝(Levee 높이)
	RoadFrom = -910, -- 올림픽대로(왕복 8차로)
	RoadTo = -1000,
	CityFrom = -1035, -- 도시 시작
	CityTo = -11300, -- 지평선 도시 끝
}

-- 가까운 쪽(관람자) 강변: 수면 끝 → 산책로/잔디/숲 → 제방 사면 → 강변북로 → 도시(배경)
Config.NearBank = {
	WaterEdge = 700,
	ParkFrom = 700,
	ParkTo = 1267, -- 넓은 한강공원(숲·잔디·전망대)
	SlopeTo = 1317,
	RoadFrom = 1317, -- 강변북로
	RoadTo = 1408,
	CityFrom = 1450,
	CityTo = 8700,
}

------------------------------------------------------------------------------------------------------
-- 주요 랜드마크 배치
------------------------------------------------------------------------------------------------------
Config.Landmark = {
	-- 롯데월드타워 모티브 초고층 (정사각 평면, 위로 갈수록 곡선으로 가늘어짐)
	Tower = {
		Center = Vector3.new(-717, 24, -1967),
		BaseWidth = 290, -- 지상부 한 변 87 m
		TopWidth = 107, -- 크라운 시작부 한 변 32 m
		Height = 1500, -- 본체(크라운 시작) 높이 450 m, 지면 기준
		CrownHeight = 260, -- 랜턴 크라운 78 m
		SpireHeight = 90, -- 첨탑 → 총 1850 stud = 555 m (실제 롯데월드타워)
		Yaw = 34, -- 평면 회전(도) — 모서리가 카메라 쪽을 향하는 다이아몬드 실루엣 (45 이면 노을 해가 면에 정반사되어 번짐)
	},
	-- 저층부 몰(타워 앞 오른쪽): 곡면 지붕 파란 조명 건물 포함
	Mall = {
		Min = Vector2.new(-600, -1767), -- (X, Z)
		Max = Vector2.new(100, -1367),
	},
}

-- 다리(잠실대교 모티브): 강을 수직(Z 방향)으로 가로지름
Config.Bridge = {
	X = 417, -- 중심선 X (대표 구도에서 다리가 오른쪽 아래 → 타워 발치 쪽으로 대각선으로 보이도록)
	ZFrom = -1067, -- 먼 쪽 도시 도로와 연결
	ZTo = 1500, -- 가까운 쪽 도시 도로와 연결
	DeckTop = 57, -- 상판 윗면 높이 17 m (수면 위)
	Width = 120, -- 36 m: 차도 8차로(3.5 m) + 중앙분리대 + 보도
	PierSpacing = 160, -- 경간 48 m
}

-- 관람 전망대(스폰) — 사진 구도를 재현하는 위치
Config.Viewpoint = {
	-- 전망대 바닥(플레이어가 서는 곳)
	DeckCenter = Vector3.new(-67, 0, 1167), -- Y 는 Park 모듈이 DeckHeight 로 결정
	DeckHeight = 200, -- 60 m 전망대
	-- 히어로 카메라(사진 구도). 포토 스팟/인트로에서 사용.
	HeroCamPos = Vector3.new(240, 342, 1433),
	HeroCamLook = Vector3.new(-170, 250, -1667),
	-- 수면 반사 스트릭이 향하는 "눈" 위치(XZ): 대표 구도와 전망대(스폰) 시점의 중간 → 두 시점 모두에서 거의 세로로 보임
	ReflectionEye = Vector3.new(90, 0, 1300),
	HeroFov = 62,
}

------------------------------------------------------------------------------------------------------
-- 구역 분할 (도시 생성기들이 겹치지 않도록 Kit.reserve 로 발자국을 예약)
--   Landmark → Skyline → Bridge/Riverside/Park → Apartments → CityCarpet 순서로 빌드됨.
------------------------------------------------------------------------------------------------------
Config.Zones = {
	-- 먼 쪽 강변의 "히어로" 고층 클러스터 (Skyline 모듈)
	SkylineLeft = { XMin = -2833, XMax = -1267, ZMin = -2500, ZMax = -1267 },
	SkylineMid = { XMin = -417, XMax = 233, ZMin = -2917, ZMax = -1967 },
	SkylineRight = { XMin = 300, XMax = 1750, ZMin = -2250, ZMax = -1200 },
	-- 아파트 단지 띠 (Apartments 모듈) — 먼 쪽 / 가까운 쪽
	ApartmentsFar = { XMin = -7000, XMax = 7000, ZMin = -3833, ZMax = -1067 },
	ApartmentsNear = { XMin = -5333, XMax = 5333, ZMin = 1467, ZMax = 3167 },
	-- LOD 도시 카펫 (CityCarpet 모듈)
	CarpetFarMid = { XMin = -10833, XMax = 10833, ZMin = -6667, ZMax = -3833 },
	CarpetFarFar = { XMin = -15000, XMax = 15000, ZMin = -11333, ZMax = -6667 },
	CarpetNear = { XMin = -10000, XMax = 10000, ZMin = 3167, ZMax = 8667 },
	-- 원경 산 능선
	MountainsFar = { XMin = -18333, XMax = 18333, Z = -13667 },
	MountainsNear = { XMin = -15000, XMax = 15000, Z = 10667 },
}

------------------------------------------------------------------------------------------------------
-- 팔레트 (해질녘 블루아워). Neon 색은 밝기 = 발광 세기이므로 어두운 Neon 색 = 은은한 불빛.
------------------------------------------------------------------------------------------------------
local rgb = Color3.fromRGB
Config.Palette = {
	-- 실내 조명(창문) — Neon
	WindowWarm = rgb(255, 196, 120),
	WindowWarmDim = rgb(178, 128, 74),
	WindowCool = rgb(214, 228, 255),
	WindowCoolDim = rgb(128, 146, 178),
	WindowGold = rgb(255, 214, 140),
	WindowOff = rgb(28, 34, 46), -- 꺼진 창 (Glass)
	-- 유리 커튼월
	GlassDeep = rgb(38, 56, 82),
	GlassBlue = rgb(70, 104, 140),
	GlassSilver = rgb(150, 172, 196),
	GlassTeal = rgb(52, 88, 96),
	GlassBronze = rgb(92, 76, 62),
	Mullion = rgb(52, 58, 68),
	MullionLight = rgb(176, 184, 194),
	-- 콘크리트 / 아파트
	ConcreteLight = rgb(214, 208, 198),
	ConcreteWarm = rgb(196, 184, 168),
	ConcreteGrey = rgb(150, 150, 152),
	ConcreteDark = rgb(92, 94, 100),
	Asphalt = rgb(46, 48, 52),
	AsphaltLight = rgb(70, 72, 76),
	LaneWhite = rgb(214, 214, 206),
	LaneYellow = rgb(232, 184, 64),
	-- 자연
	Grass = rgb(66, 98, 52),
	GrassDark = rgb(46, 74, 40),
	Leaf1 = rgb(48, 84, 44),
	Leaf2 = rgb(64, 102, 50),
	Leaf3 = rgb(86, 116, 58),
	LeafAutumn = rgb(150, 112, 58),
	Bark = rgb(74, 58, 46),
	Soil = rgb(92, 80, 66),
	Mountain = rgb(44, 56, 66),
	MountainFar = rgb(70, 82, 102),
	-- 조명 / 포인트
	LampWarm = rgb(255, 206, 140),
	LampSodium = rgb(255, 170, 84),
	LampWhite = rgb(236, 242, 255),
	Headlight = rgb(255, 246, 226),
	Taillight = rgb(255, 46, 36),
	Beacon = rgb(255, 30, 24),
	LedBlue = rgb(70, 150, 255),
	LedCyan = rgb(80, 220, 255),
	LedMagenta = rgb(220, 90, 255),
	LedGold = rgb(255, 196, 92),
}

------------------------------------------------------------------------------------------------------
-- 조명 / 대기 (해질녘 직후). Atmosphere 모듈이 적용.
------------------------------------------------------------------------------------------------------
Config.Lighting = {
	ClockTime = 18.08,
	-- 실제 서울 위도는 37.5 이지만 Roblox 태양 모델에서 노을을 화면 왼쪽-앞(서쪽, -X/-Z)에 두기 위해 조정
	GeographicLatitude = 8,
	DayNightCycle = false, -- true: 하루가 흐름(MinutesPerDay), 밤/낮에 맞춰 창문 조명 자동 전환
	MinutesPerDay = 24,
	NightFrom = 17.6, -- 이 시각부터 창문/가로등 점등
	NightTo = 6.4,
}

Config.Client = {
	IntroCinematic = true, -- 접속 시 7초 시네마틱(스킵 가능)
	Traffic = true, -- 다리·강변도로 차량 불빛 흐름
	TrafficDensity = 1.0,
	Beacons = true, -- 고층 항공장애등 깜빡임
	Boats = true, -- 유람선
}

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000006"><Properties><string name="Name">Facade</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Facade
-- 건물 파사드 생성기 — 모든 고층/아파트/원경 건물이 같은 "야경 언어"를 쓰도록 하는 공용 모듈.
--
-- 핵심 기법 (z-fighting 0, 파트 수 최소):
--   * 안쪽 "조명 코어"(Neon, 층 묶음마다 다른 색/밝기 = 켜진 사무실/집)를 외벽보다 inset 만큼 들여서 놓고
--   * 층마다 코어를 감싸는 "층 슬래브"(유리/콘크리트 띠)가 바깥으로 튀어나와 가로 띠를 만들고
--   * 건물을 관통하는 "멀리언/벽 핀" 하나가 마주 보는 두 면의 세로선을 동시에 만들어 창 격자를 완성
--   * 관통하는 어두운 "꺼진 창" 패치가 불 꺼진 집/사무실을 랜덤하게 표현
--   모든 표면은 서로 최소 0.3 stud 이상 떨어져 있어 원거리에서도 깜빡임이 없음.
--
--   Facade.tower(parent, spec) -> Model     (style = "curtain" | "round" | "apartment" | "mid" | "far")
--   spec: TowerSpec (아래)
--   반환 모델의 Attribute: Height, Style
--   실제 스케일(1 stud = 0.3 m): 오피스 층고 4.0 m, 아파트 층고 2.9 m — Config.Real 참조.

local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)

local P = Config.Palette
local Facade = {}

export type TowerSpec = {
	name: string?,
	cf: CFrame, -- 건물 바닥 중심(지면 높이) + 방향(yaw)
	w: number, -- 로컬 X 폭
	d: number, -- 로컬 Z 깊이
	h: number, -- 높이(지면 → 지붕)
	style: string,
	rng: Random,
	floorH: number?,
	bay: number?, -- 멀리언/세대 벽 간격
	glass: Color3?, -- 층 슬래브(외피) 색
	frame: Color3?, -- 멀리언 색
	lit: { Color3 }?, -- 켜진 층 색 후보
	litChance: number?, -- 0..1 켜진 비율
	crown: string?, -- "flat" | "led" | "spire" | "helipad" | "box" | "frame" | "slant" | "none"
	ledColor: Color3?,
	tiers: number?, -- curtain: 1~3 단 셋백
	label: string?, -- apartment: 측벽 동 번호
	accent: Color3?, -- apartment: 측벽 슈퍼그래픽 색
	collide: boolean?, -- 기본 true
	beacon: boolean?, -- 기본: h >= 200 이면 true
	glint: boolean?, -- true: 수면 반사 스트릭 생성 (강변 건물)
	lobbyColor: Color3?, -- 로비(1~2층) 발광 색. 기본: 따뜻한 은은한 빛
	terraceLed: boolean?, -- 셋백 테라스 LED 띠 (기본 true)
}

local LIT_OFFICE = { P.WindowCool, P.WindowCool, P.WindowCoolDim, P.WindowWarm, P.WindowWarmDim }
local LIT_HOME = { P.WindowWarm, P.WindowWarm, P.WindowWarmDim, P.WindowGold, P.WindowCoolDim }

Facade.LIT_OFFICE = LIT_OFFICE
Facade.LIT_HOME = LIT_HOME

local function pick<T>(rng: Random, t: { T }): T
	return t[rng:NextInteger(1, #t)]
end

local function jitter(rng: Random, c: Color3, amt: number): Color3
	local k = 1 + (rng:NextNumber() * 2 - 1) * amt
	return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
end

------------------------------------------------------------------------------------------------------
-- 공통: 조명 코어 (층 묶음으로 나눈 Neon 블록)
------------------------------------------------------------------------------------------------------
local function litCore(m: Model, base: CFrame, cw: number, cd: number, y0: number, y1: number, floorH: number, rng: Random, lit: { Color3 }, litChance: number, round: boolean, offColor: Color3)
	local y = y0
	while y < y1 - 0.01 do
		local floors = rng:NextInteger(2, 7)
		local hgt = math.min(floors * floorH, y1 - y)
		local on = rng:NextNumber() < math.clamp(litChance + 0.15, 0, 1)
		local c = if on then jitter(rng, pick(rng, lit), 0.08) else offColor
		local cf = base * CFrame.new(0, y + hgt / 2, 0)
		local opts = {
			name = "Core",
			material = if on then Enum.Material.Neon else Enum.Material.Glass,
			color = c,
			collide = false,
			query = false,
			shadow = false,
			glow = on,
			dayMaterial = Enum.Material.Glass,
			dayColor = P.GlassDeep,
		}
		if round then
			Kit.cylAlongY(m, cf, hgt, cw, c, nil, opts)
		else
			Kit.part(m, cf, Vector3.new(cw, hgt, cd), opts)
		end
		y += hgt
	end
end

------------------------------------------------------------------------------------------------------
-- 크라운 / 옥상
------------------------------------------------------------------------------------------------------
local function crown(m: Model, base: CFrame, w: number, d: number, top: number, spec: TowerSpec, rng: Random, round: boolean)
	local kind = spec.crown or "flat"
	local frame = spec.frame or P.Mullion
	local led = spec.ledColor or P.LedGold
	local roofC = P.ConcreteDark
	-- 지붕 슬래브
	if round then
		Kit.cylAlongY(m, base * CFrame.new(0, top + 1, 0), 2, w, roofC, Enum.Material.Concrete, { name = "Roof" })
	else
		Kit.box(m, base * CFrame.new(0, top + 1, 0), Vector3.new(w, 2, d), roofC, Enum.Material.Concrete, { name = "Roof" })
	end
	local crownTop = top + 2
	if kind == "led" or kind == "frame" then
		-- 꼭대기 LED 띠(건물 외곽을 따라 빛나는 링) + 파라펫
		local ph = math.clamp(spec.h * 0.03, 7, 27)
		if round then
			Kit.cylAlongY(m, base * CFrame.new(0, top + ph / 2, 0), ph, w + 0.6, frame, Enum.Material.Glass, { name = "Parapet", reflectance = 0.15 })
			Kit.cylAlongY(m, base * CFrame.new(0, top + ph + 0.8, 0), 1.6, w + 2, led, Enum.Material.Neon, { name = "Led", glow = true, collide = false })
		else
			Kit.box(m, base * CFrame.new(0, top + ph / 2, 0), Vector3.new(w + 0.6, ph, d + 0.6), frame, Enum.Material.Glass, { name = "Parapet", reflectance = 0.15 })
			Kit.box(m, base * CFrame.new(0, top + ph + 0.8, 0), Vector3.new(w + 2, 1.6, d + 2), led, Enum.Material.Neon, { name = "Led", glow = true, collide = false })
			if kind == "frame" then
				-- 옥상 장식 프레임(한국 고층 아파트/오피스 특유의 왕관 프레임)
				local fh = math.clamp(spec.h * 0.07, 17, 56)
				for _, sx in { -1, 1 } do
					Kit.box(m, base * CFrame.new(sx * (w / 2 - 1.6), top + ph + fh / 2, 0), Vector3.new(3.2, fh, d * 0.9), frame, Enum.Material.Metal, { name = "CrownFrame" })
				end
				Kit.box(m, base * CFrame.new(0, top + ph + fh, 0), Vector3.new(w, 3.2, d * 0.9), frame, Enum.Material.Metal, { name = "CrownFrame" })
				Kit.box(m, base * CFrame.new(0, top + ph + fh + 2.2, 0), Vector3.new(w + 0.6, 1.3, d * 0.9 + 0.6), led, Enum.Material.Neon, { name = "Led", glow = true, collide = false })
				crownTop = top + ph + fh + 3
			else
				crownTop = top + ph + 1.6
			end
		end
	elseif kind == "spire" then
		local sh = math.clamp(spec.h * 0.16, 40, 150)
		Kit.box(m, base * CFrame.new(0, top + 10, 0), Vector3.new(w * 0.45, 20, d * 0.45), frame, Enum.Material.Metal, { name = "SpireBase" })
		Kit.cylAlongY(m, base * CFrame.new(0, top + 20 + sh / 2, 0), sh, 3.6, P.MullionLight, Enum.Material.Metal, { name = "Spire" })
		Kit.box(m, base * CFrame.new(0, top + 20.8, 0), Vector3.new(w * 0.45 + 1, 1.6, d * 0.45 + 1), led, Enum.Material.Neon, { name = "Led", glow = true, collide = false })
		crownTop = top + 20 + sh
	elseif kind == "helipad" then
		local r = math.min(w, d) * 0.8
		Kit.cylAlongY(m, base * CFrame.new(0, top + 7, 0), 2, r, P.ConcreteGrey, Enum.Material.Concrete, { name = "Helipad" })
		Kit.cylAlongY(m, base * CFrame.new(0, top + 8.2, 0), 0.4, r * 0.6, P.LaneYellow, Enum.Material.Neon, { name = "HeliRing", glow = true, collide = false, transparency = 0.35 })
		Kit.box(m, base * CFrame.new(0, top + 3.4, 0), Vector3.new(w * 0.5, 6.8, d * 0.5), P.ConcreteDark, Enum.Material.Concrete, { name = "HeliBase" })
		crownTop = top + 8.5
	elseif kind == "slant" then
		-- 비스듬히 잘린 지붕(웨지) + 엣지 LED
		local sh = math.clamp(spec.h * 0.1, 20, 100)
		local wd = Kit.wedge(m, base * CFrame.new(0, top + sh / 2, 0) * CFrame.Angles(0, if rng:NextNumber() < 0.5 then 0 else math.pi, 0), Vector3.new(w, sh, d), spec.glass or P.GlassBlue, Enum.Material.Glass, { name = "SlantRoof", reflectance = 0.2 })
		wd.CastShadow = true
		Kit.box(m, base * CFrame.new(0, top + 1.4, 0), Vector3.new(w + 1.2, 1.3, d + 1.2), led, Enum.Material.Neon, { name = "Led", glow = true, collide = false })
		crownTop = top + sh
	elseif kind == "box" then
		-- 기계실 + 물탱크
		local bw, bd = w * rng:NextNumber(0.35, 0.6), d * rng:NextNumber(0.35, 0.6)
		local bh = rng:NextNumber(9, 16)
		Kit.box(m, base * CFrame.new(rng:NextNumber(-0.15, 0.15) * w, top + 2 + bh / 2, rng:NextNumber(-0.15, 0.15) * d), Vector3.new(bw, bh, bd), P.ConcreteGrey, Enum.Material.Concrete, { name = "Mech" })
		crownTop = top + 2 + bh
	end
	-- 항공장애등
	local wantBeacon = if spec.beacon == nil then spec.h >= 330 else spec.beacon -- 항공장애등: 높이 100 m 이상
	if wantBeacon then
		Kit.beacon(m, (base * CFrame.new(0, crownTop + 2.6, 0)).Position, 4.2)
		if not round and spec.h >= 540 then
			for _, s in { { -1, -1 }, { 1, 1 } } do
				Kit.beacon(m, (base * CFrame.new(s[1] * (w / 2 - 1.6), top + 4, s[2] * (d / 2 - 1.6))).Position, 3.4)
			end
		end
	end
	return crownTop
end

------------------------------------------------------------------------------------------------------
-- 커튼월 오피스 (사각)
------------------------------------------------------------------------------------------------------
local function curtainBlock(m: Model, base: CFrame, w: number, d: number, y0: number, y1: number, spec: TowerSpec, rng: Random)
	local floorH = spec.floorH or Config.Real.OfficeFloor
	local bay = spec.bay or (if w > 90 then 12 else 10)
	local glass = spec.glass or P.GlassDeep
	local frame = spec.frame or P.Mullion
	local lit = spec.lit or LIT_OFFICE
	local litChance = spec.litChance or 0.7
	local inset = 1.4
	local slabRatio = 0.4
	local h = y1 - y0
	-- 1) 조명 코어
	litCore(m, base, w - inset * 2, d - inset * 2, y0, y1, floorH, rng, lit, litChance, false, P.WindowOff)
	-- 2) 층 슬래브 (반사 유리 띠)
	local slabH = floorH * slabRatio
	local nFloors = math.floor(h / floorH)
	for i = 0, nFloors - 1 do
		local yb = y0 + i * floorH
		Kit.box(m, base * CFrame.new(0, yb + slabH / 2, 0), Vector3.new(w, slabH, d), glass, Enum.Material.Glass, {
			name = "Slab",
			reflectance = 0.18,
			collide = (spec.collide ~= false) and i == 0,
			shadow = false,
		})
	end
	-- 상단 마감 슬래브
	Kit.box(m, base * CFrame.new(0, y1 - slabH / 2, 0), Vector3.new(w + 0.4, slabH, d + 0.4), glass, Enum.Material.Glass, { name = "SlabTop", reflectance = 0.18, shadow = false })
	-- 3) 멀리언 (관통 핀 → 마주 보는 두 면에 동시에 세로선)
	local finW, out = 1.1, 0.5
	local nx = math.max(1, math.floor(w / bay))
	for i = 1, nx - 1 do
		local x = -w / 2 + i * (w / nx)
		Kit.box(m, base * CFrame.new(x, y0 + h / 2, 0), Vector3.new(finW, h, d + out * 2), frame, Enum.Material.Metal, { name = "Fin", collide = false, query = false, shadow = false })
	end
	local nz = math.max(1, math.floor(d / bay))
	for i = 1, nz - 1 do
		local z = -d / 2 + i * (d / nz)
		Kit.box(m, base * CFrame.new(0, y0 + h / 2, z), Vector3.new(w + out * 2, h, finW), frame, Enum.Material.Metal, { name = "Fin", collide = false, query = false, shadow = false })
	end
	-- 모서리 기둥
	for _, s in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
		Kit.box(m, base * CFrame.new(s[1] * (w / 2), y0 + h / 2, s[2] * (d / 2)), Vector3.new(2.2, h, 2.2), frame, Enum.Material.Metal, { name = "Corner", collide = false, shadow = false })
	end
	-- 4) 꺼진 창 패치 (관통)
	local cells = nFloors * (nx + nz)
	local nPatch = math.clamp(math.floor(cells * (1 - litChance) / 9), 0, 26)
	for _ = 1, nPatch do
		local alongX = rng:NextNumber() < (w / (w + d))
		local fl = rng:NextInteger(1, math.max(1, nFloors - 2))
		local nfl = rng:NextInteger(1, 3)
		local hh = math.min(nfl, nFloors - fl) * floorH - slabH
		if hh > 0.5 then
			local yc = y0 + fl * floorH + slabH + hh / 2
			if alongX then
				local nb = rng:NextInteger(1, 3)
				local i0 = rng:NextInteger(0, math.max(0, nx - nb))
				local bw = nb * (w / nx) - finW
				local x = -w / 2 + (i0 + nb / 2) * (w / nx)
				Kit.box(m, base * CFrame.new(x, yc, 0), Vector3.new(bw, hh, d - inset * 2 + 1.6), P.WindowOff, Enum.Material.Glass, { name = "Off", collide = false, query = false, shadow = false, reflectance = 0.1 })
			else
				local nb = rng:NextInteger(1, 3)
				local i0 = rng:NextInteger(0, math.max(0, nz - nb))
				local bd = nb * (d / nz) - finW
				local z = -d / 2 + (i0 + nb / 2) * (d / nz)
				Kit.box(m, base * CFrame.new(0, yc, z), Vector3.new(w - inset * 2 + 1.6, hh, bd), P.WindowOff, Enum.Material.Glass, { name = "Off", collide = false, query = false, shadow = false, reflectance = 0.1 })
			end
		end
	end
	-- 충돌용 보이지 않는 몸체 (가벼운 단일 박스)
	if spec.collide ~= false then
		Kit.box(m, base * CFrame.new(0, y0 + h / 2, 0), Vector3.new(w - inset * 2, h, d - inset * 2), P.WindowOff, Enum.Material.SmoothPlastic, { name = "Collision", transparency = 1, shadow = false })
	end
end

local function curtain(m: Model, spec: TowerSpec, rng: Random): number
	local base = spec.cf
	local tiers = math.clamp(spec.tiers or 1, 1, 3)
	local w, d = spec.w, spec.d
	local y = 0
	local h = spec.h
	-- 로비 (밝은 1~2층 + 캐노피)
	local lobbyH = math.min(20, h * 0.06) -- 로비 6 m
	Kit.box(m, base * CFrame.new(0, lobbyH / 2, 0), Vector3.new(w - 4, lobbyH, d - 4), spec.lobbyColor or P.WindowWarmDim, Enum.Material.Neon, { name = "Lobby", glow = true })
	Kit.box(m, base * CFrame.new(0, lobbyH + 0.8, 0), Vector3.new(w + 6, 1.6, d + 6), P.ConcreteDark, Enum.Material.Concrete, { name = "Canopy", shadow = false })
	y = lobbyH + 1.6
	local remaining = h - y
	for t = 1, tiers do
		local frac = if t == tiers then 1 else (if tiers == 2 then 0.62 else (if t == 1 then 0.5 else 0.6))
		local th = if t == tiers then h - y else math.floor(remaining * frac)
		curtainBlock(m, base, w, d, y, y + th, spec, rng)
		y += th
		remaining = h - y
		if t < tiers then
			-- 셋백 테라스 (LED 테두리)
			if spec.terraceLed ~= false then
				Kit.box(m, base * CFrame.new(0, y + 0.7, 0), Vector3.new(w + 1, 1.3, d + 1), spec.ledColor or P.LedGold, Enum.Material.Neon, { name = "Led", glow = true, collide = false })
			end
			w *= 0.78
			d *= 0.78
		end
	end
	return crown(m, base, w, d, h, spec, rng, false)
end

------------------------------------------------------------------------------------------------------
-- 원형 타워
------------------------------------------------------------------------------------------------------
local function roundTower(m: Model, spec: TowerSpec, rng: Random): number
	local base = spec.cf
	local dia = math.min(spec.w, spec.d)
	local h = spec.h
	local floorH = spec.floorH or Config.Real.OfficeFloor
	local glass = spec.glass or P.GlassBlue
	local lit = spec.lit or LIT_OFFICE
	local inset = 1.6
	local lobbyH = math.min(20, h * 0.06)
	Kit.cylAlongY(m, base * CFrame.new(0, lobbyH / 2, 0), lobbyH, dia - 4, spec.lobbyColor or P.WindowWarmDim, Enum.Material.Neon, { name = "Lobby", glow = true })
	litCore(m, base, dia - inset * 2, dia - inset * 2, lobbyH, h, floorH, rng, lit, spec.litChance or 0.7, true, P.WindowOff)
	local slabH = floorH * 0.42
	local n = math.floor((h - lobbyH) / floorH)
	for i = 0, n - 1 do
		Kit.cylAlongY(m, base * CFrame.new(0, lobbyH + i * floorH + slabH / 2, 0), slabH, dia, glass, Enum.Material.Glass, { name = "Slab", reflectance = 0.2, shadow = false, collide = i == 0 })
	end
	-- 세로 핀 4개(관통): 원형에서도 리듬감
	local frame = spec.frame or P.Mullion
	for k = 0, 3 do
		local a = k * math.pi / 4
		Kit.box(m, base * CFrame.Angles(0, a, 0) * CFrame.new(0, lobbyH + (h - lobbyH) / 2, 0), Vector3.new(1.3, h - lobbyH, dia + 1), frame, Enum.Material.Metal, { name = "Fin", collide = false, query = false, shadow = false })
	end
	Kit.cylAlongY(m, base * CFrame.new(0, (h + lobbyH) / 2, 0), h - lobbyH, dia - inset * 2, P.WindowOff, Enum.Material.SmoothPlastic, { name = "Collision", transparency = 1, shadow = false })
	return crown(m, base, dia, dia, h, spec, rng, true)
end

------------------------------------------------------------------------------------------------------
-- 한국형 판상 아파트 (발코니 격자 + 측벽 동 번호)
------------------------------------------------------------------------------------------------------
local function apartment(m: Model, spec: TowerSpec, rng: Random): number
	local base = spec.cf
	local w, d, h = spec.w, spec.d, spec.h
	local floorH = spec.floorH or Config.Real.HomeFloor
	local unit = spec.bay or 15 -- 세대 폭 4.5 m
	local wall = spec.glass or P.ConcreteLight
	local lit = spec.lit or LIT_HOME
	local litChance = spec.litChance or 0.55
	local inset = 1.8
	local pilotis = floorH * 1.2 -- 필로티(1층 비움)
	-- 필로티 기둥 + 1층 로비 불빛
	Kit.box(m, base * CFrame.new(0, pilotis / 2, 0), Vector3.new(w * 0.3, pilotis, d - 6), spec.lobbyColor or P.WindowWarmDim, Enum.Material.Neon, { name = "Lobby", glow = true })
	for _, sx in { -0.42, -0.14, 0.14, 0.42 } do
		Kit.box(m, base * CFrame.new(sx * w, pilotis / 2, 0), Vector3.new(3.4, pilotis, d - 3), wall, Enum.Material.Concrete, { name = "Pilotis" })
	end
	-- 조명 코어 (긴 면만 보이도록 끝벽이 덮음)
	litCore(m, base, w - 4, d - inset * 2, pilotis, h, floorH, rng, lit, litChance, false, Color3.fromRGB(44, 46, 54))
	-- 층 슬래브 (발코니 난간 띠: 콘크리트)
	local slabH = floorH * 0.38
	local n = math.floor((h - pilotis) / floorH)
	for i = 0, n do
		local yb = pilotis + i * floorH
		if yb + slabH > h + 0.01 then
			break
		end
		Kit.box(m, base * CFrame.new(0, yb + slabH / 2, 0), Vector3.new(w, slabH, d), wall, Enum.Material.Concrete, { name = "Slab", shadow = false, collide = i == 0 })
	end
	-- 세대 벽(관통 핀)
	local nu = math.max(2, math.floor(w / unit))
	for i = 1, nu - 1 do
		local x = -w / 2 + i * (w / nu)
		Kit.box(m, base * CFrame.new(x, pilotis + (h - pilotis) / 2, 0), Vector3.new(1.5, h - pilotis, d + 1), wall, Enum.Material.Concrete, { name = "Wall", collide = false, query = false, shadow = false })
	end
	-- 측벽(끝벽): 두꺼운 콘크리트 + 슈퍼그래픽 띠 + 동 번호
	local endW = 2.6
	for _, sx in { -1, 1 } do
		local e = Kit.box(m, base * CFrame.new(sx * (w / 2 - endW / 2 + 0.5), (h + pilotis) / 2, 0), Vector3.new(endW, h - pilotis, d + 0.7), wall, Enum.Material.Concrete, { name = "EndWall" })
		if spec.accent then
			Kit.box(m, base * CFrame.new(sx * (w / 2 + 0.95), h * 0.55, d * 0.18), Vector3.new(0.5, h * 0.6, d * 0.22), spec.accent, Enum.Material.SmoothPlastic, { name = "Accent", collide = false, shadow = false })
		end
		if spec.label and sx == 1 then
			local sign = Kit.box(m, base * CFrame.new(w / 2 + 0.95, h - floorH * 2.2, -d * 0.1), Vector3.new(0.3, floorH * 2.2, d * 0.62), wall, Enum.Material.SmoothPlastic, { name = "NumberPlate", collide = false, shadow = false, transparency = 1 })
			Kit.label(sign, Enum.NormalId.Right, spec.label, { color = Color3.fromRGB(250, 244, 230), glow = true, pixelsPerStud = 6, maxDistance = 3000 })
		end
		local _ = e
	end
	-- 꺼진 세대 패치(관통)
	local cells = n * nu
	local nPatch = math.clamp(math.floor(cells * (1 - litChance) / 3), 0, 30)
	for _ = 1, nPatch do
		local fl = rng:NextInteger(0, math.max(0, n - 1))
		local nb = rng:NextInteger(1, 2)
		local i0 = rng:NextInteger(0, math.max(0, nu - nb))
		local bw = nb * (w / nu) - 1.5
		local x = -w / 2 + (i0 + nb / 2) * (w / nu)
		local hh = floorH - slabH
		local yc = pilotis + fl * floorH + slabH + hh / 2
		if yc + hh / 2 <= h then
			Kit.box(m, base * CFrame.new(x, yc, 0), Vector3.new(bw, hh, d - inset * 2 + 2), Color3.fromRGB(46, 48, 56), Enum.Material.SmoothPlastic, { name = "Off", collide = false, query = false, shadow = false })
		end
	end
	-- 충돌 몸체
	Kit.box(m, base * CFrame.new(0, (h + pilotis) / 2, 0), Vector3.new(w - 4, h - pilotis, d - inset * 2), wall, Enum.Material.SmoothPlastic, { name = "Collision", transparency = 1, shadow = false })
	-- 옥상: 엘리베이터 탑 + (선택) 왕관 프레임
	if spec.crown == "frame" or spec.crown == "led" then
		return crown(m, base, w, d, h, spec, rng, false)
	end
	Kit.box(m, base * CFrame.new(0, h + 0.8, 0), Vector3.new(w, 1.6, d), P.ConcreteGrey, Enum.Material.Concrete, { name = "Roof" })
	Kit.box(m, base * CFrame.new(rng:NextNumber(-0.25, 0.25) * w, h + 7, 0), Vector3.new(14, 12, d * 0.7), wall, Enum.Material.Concrete, { name = "ElevatorHouse" })
	return h + 13
end

------------------------------------------------------------------------------------------------------
-- 중경 LOD: 몸체 + 링 밴드 몇 개 (3~8 파트)
------------------------------------------------------------------------------------------------------
local BODY_MID = { P.ConcreteDark, P.GlassDeep, P.ConcreteGrey, P.GlassTeal, P.GlassBronze, Color3.fromRGB(70, 74, 84) }

local function mid(m: Model, spec: TowerSpec, rng: Random): number
	local base = spec.cf
	local w, d, h = spec.w, spec.d, spec.h
	local body = spec.glass or pick(rng, BODY_MID)
	Kit.box(m, base * CFrame.new(0, h / 2, 0), Vector3.new(w, h, d), body, if rng:NextNumber() < 0.5 then Enum.Material.Concrete else Enum.Material.Glass, { name = "Body", collide = spec.collide ~= false, reflectance = 0.05 })
	local lit = spec.lit or LIT_HOME
	local nb = math.clamp(math.floor(h / 36), 1, 6)
	for _ = 1, nb do
		if rng:NextNumber() < (spec.litChance or 0.75) then
			local bh = rng:NextNumber(2.6, 7.5)
			local y = rng:NextNumber(7, math.max(8, h - 7))
			local c = jitter(rng, pick(rng, lit), 0.12) :: Color3
			c = c:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.45))
			Kit.box(m, base * CFrame.new(0, y, 0), Vector3.new(w + 1, bh, d + 1), c, Enum.Material.Neon, { name = "Band", glow = true, collide = false, query = false, dayColor = body })
		end
	end
	if spec.crown == "led" then
		Kit.box(m, base * CFrame.new(0, h + 0.7, 0), Vector3.new(w + 1.3, 1.3, d + 1.3), spec.ledColor or P.LedGold, Enum.Material.Neon, { name = "Led", glow = true, collide = false })
	end
	if (spec.beacon == nil and h >= 330) or spec.beacon then
		Kit.beacon(m, (base * CFrame.new(0, h + 3.4, 0)).Position, 4)
	end
	return h
end

------------------------------------------------------------------------------------------------------
-- 원경 LOD: 몸체 1개 + (확률) 밴드 1개
------------------------------------------------------------------------------------------------------
local function far(m: Model, spec: TowerSpec, rng: Random): number
	local base = spec.cf
	local w, d, h = spec.w, spec.d, spec.h
	local body = spec.glass or pick(rng, BODY_MID)
	Kit.box(m, base * CFrame.new(0, h / 2, 0), Vector3.new(w, h, d), body, Enum.Material.Concrete, { name = "Body", collide = false, shadow = false })
	if rng:NextNumber() < (spec.litChance or 0.6) then
		local c = jitter(rng, pick(rng, spec.lit or LIT_HOME), 0.15):Lerp(Color3.new(0, 0, 0), rng:NextNumber(0.35, 0.7))
		local bh = math.max(3.4, h * rng:NextNumber(0.1, 0.3))
		Kit.box(m, base * CFrame.new(0, rng:NextNumber(bh / 2 + 3, math.max(bh / 2 + 3, h - bh / 2 - 3)), 0), Vector3.new(w + 1.3, bh, d + 1.3), c, Enum.Material.Neon, { name = "Band", glow = true, collide = false, query = false, dayColor = body, transparency = 0.15 })
	end
	if spec.beacon then
		Kit.beacon(m, (base * CFrame.new(0, h + 3.4, 0)).Position, 5)
	end
	return h
end

------------------------------------------------------------------------------------------------------
-- 진입점
------------------------------------------------------------------------------------------------------
function Facade.tower(parent: Instance, spec: TowerSpec): Model
	local m = Instance.new("Model")
	m.Name = spec.name or ("Bldg_" .. spec.style)
	local rng = spec.rng
	local top
	if spec.style == "curtain" then
		top = curtain(m, spec, rng)
	elseif spec.style == "round" then
		top = roundTower(m, spec, rng)
	elseif spec.style == "apartment" then
		top = apartment(m, spec, rng)
	elseif spec.style == "mid" then
		top = mid(m, spec, rng)
	else
		top = far(m, spec, rng)
	end
	m:SetAttribute("Height", top)
	m:SetAttribute("Style", spec.style)
	-- 강변 건물: 수면 반사 스트릭
	if spec.glint then
		local p = spec.cf.Position
		local lits = spec.lit or LIT_OFFICE
		local c = lits[(math.floor(math.abs(p.X * 3 + p.Z * 7)) % #lits) + 1] -- rng 를 쓰지 않음(글린트 유무가 배치를 바꾸지 않게)
		Kit.reflection(m, p.X, Config.FarBank.WaterEdge + 10, math.min(spec.w, spec.d) * 0.35, math.min(630, spec.h * 0.8), c, 0.72)
	end
	m.Parent = parent
	return m
end

return Facade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000007"><Properties><string name="Name">Kit</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Kit
-- 모든 모듈이 공유하는 파트 팩토리 + 예약(발자국) + 조명 예산 + 야간 조명 태그 + 지형/차선 기록.
--
--   Kit.part(parent, cf, size, opts)         -> BasePart  (opts: PartOpts)
--   Kit.box(parent, cf, size, color, material, opts?)
--   Kit.vcyl(parent, centerPos, height, diameter, color, material, opts?)   세로 원기둥
--   Kit.hcyl(parent, cf, length, diameter, color, material, opts?)          cf 의 X 축 방향 원기둥
--   Kit.ball(parent, pos, diameter, color, material, opts?)
--   Kit.wedge(parent, cf, size, color, material, opts?)                      WedgePart
--   Kit.ellipsoid(parent, cf, size, color, material, opts?)                  SpecialMesh 구(타원체), 크기 제한 없음
--   Kit.glow(part, dayMaterial?, dayColor?)    야간 발광 파트로 등록(태그 SeoulNight) — 낮/밤 전환용
--   Kit.light(part, "PointLight"|"SpotLight"|"SurfaceLight", props) -> Light?   예산 초과 시 nil
--   Kit.beacon(parent, pos, diameter?)        빨간 항공장애등(클라이언트가 깜빡임)
--   Kit.label(part, face, text, opts?)        SurfaceGui 글자(아파트 동 번호, 표지판)
--   Kit.reflection(parent, x, z, width, length, color, transparency?)       수면 위 빛 번짐(세로 스트릭)
--   Kit.reserve(x0, z0, x1, z1, tag?) / Kit.isFree(x0, z0, x1, z1, margin?)  도시 생성 충돌 방지
--   Kit.terrain(kind, cf, size, material)     지형 채우기 기록(+실제 적용)
--   Kit.lane(name, points, opts)              차량 불빛 차선(클라이언트 Traffic 이 사용)
--   Kit.group(parent, name, streaming?)       Model (기본 Persistent: 원경도 항상 보이게)
--   Kit.groundY(x, z)                          레이아웃 기준 지면 높이
--   Kit.yield()                                주기적 task.wait (Kit.part 가 자동 호출)

local CollectionService = game:GetService("CollectionService")
local Config = require(script.Parent.Config)

local Kit = {}

export type PartOpts = {
	name: string?,
	shape: string?, -- "Block" | "Cylinder" | "Ball" | "Wedge" | "Corner"
	material: Enum.Material?,
	color: Color3?,
	transparency: number?,
	reflectance: number?,
	collide: boolean?, -- 기본 true (걷는 곳/건물). 장식은 false 권장
	shadow: boolean?, -- 기본: 크기 기준 자동, Neon/투명은 항상 false
	query: boolean?, -- 기본 = collide
	glow: boolean?, -- true: Kit.glow 등록 (Neon 야간 발광)
	dayMaterial: Enum.Material?,
	dayColor: Color3?,
}

Kit.stats = { parts = 0, lights = 0, beacons = 0, labels = 0, terrainOps = 0 }
Kit.terrainOps = {} :: { any } -- { kind, cf, size, material } (미리보기/디버그용 기록)
Kit.applyTerrain = true -- false: 기록만 (미리보기 하네스가 사용)
Kit.root = nil :: Model?
Kit.lanesFolder = nil :: Instance?

local reservations: { { number } } = {}
local sinceYield = 0

function Kit.reset(root: Model)
	Kit.stats = { parts = 0, lights = 0, beacons = 0, labels = 0, terrainOps = 0 }
	Kit.terrainOps = {}
	Kit.root = root
	Kit.lanesFolder = nil
	reservations = {}
	sinceYield = 0
end

function Kit.yield()
	sinceYield += 1
	if sinceYield >= Config.Quality.YieldEvery then
		sinceYield = 0
		task.wait()
	end
end

------------------------------------------------------------------------------------------------------
-- 그룹
------------------------------------------------------------------------------------------------------
function Kit.group(parent: Instance, name: string, streaming: Enum.ModelStreamingMode?): Model
	local m = Instance.new("Model")
	m.Name = name
	pcall(function()
		m.ModelStreamingMode = streaming or Enum.ModelStreamingMode.Persistent
	end)
	m.Parent = parent
	return m
end

------------------------------------------------------------------------------------------------------
-- 파트
------------------------------------------------------------------------------------------------------
local MAX_SIZE = 2048
local SHAPES = {
	Cylinder = Enum.PartType.Cylinder,
	Ball = Enum.PartType.Ball,
}

local function clampSize(s: Vector3): Vector3
	if s.X > MAX_SIZE or s.Y > MAX_SIZE or s.Z > MAX_SIZE then
		warn(string.format("[SeoulSkyline] part size %s clamped to %d", tostring(s), MAX_SIZE))
		return Vector3.new(math.min(s.X, MAX_SIZE), math.min(s.Y, MAX_SIZE), math.min(s.Z, MAX_SIZE))
	end
	return Vector3.new(math.max(s.X, 0.05), math.max(s.Y, 0.05), math.max(s.Z, 0.05))
end

function Kit.part(parent: Instance, cf: CFrame, size: Vector3, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	local shape = o.shape or "Block"
	local p: BasePart
	if shape == "Wedge" then
		p = Instance.new("WedgePart")
	elseif shape == "Corner" then
		p = Instance.new("CornerWedgePart")
	else
		local part = Instance.new("Part")
		local st = SHAPES[shape]
		if st then
			part.Shape = st
		end
		p = part
	end
	local mat = o.material or Enum.Material.SmoothPlastic
	p.Name = o.name or "Part"
	p.Anchored = true
	p.Size = clampSize(size)
	p.CFrame = cf
	p.Material = mat
	p.Color = o.color or Color3.fromRGB(163, 162, 165)
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local tr = o.transparency or 0
	if tr ~= 0 then
		p.Transparency = tr
	end
	if o.reflectance then
		p.Reflectance = o.reflectance
	end
	local collide = if o.collide == nil then true else o.collide
	p.CanCollide = collide
	p.CanQuery = if o.query == nil then collide else o.query
	p.CanTouch = false
	local shadow = o.shadow
	if shadow == nil then
		shadow = math.max(size.X, size.Y, size.Z) >= Config.Quality.ShadowMinSize
	end
	if mat == Enum.Material.Neon or tr >= 0.5 then
		shadow = false
	end
	p.CastShadow = shadow
	if o.glow then
		Kit.glow(p, o.dayMaterial, o.dayColor)
	end
	p.Parent = parent
	Kit.stats.parts += 1
	Kit.yield()
	return p
end

function Kit.box(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	o.color = color
	o.material = material or o.material
	return Kit.part(parent, cf, size, o)
end

-- 세로 원기둥: center = 중심점, 축 = 월드 Y
local CYL_UP = CFrame.Angles(0, 0, math.rad(90))
function Kit.vcyl(parent: Instance, center: Vector3, height: number, diameter: number, color: Color3, material: Enum.Material?, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	o.shape = "Cylinder"
	o.color = color
	o.material = material or o.material
	return Kit.part(parent, CFrame.new(center) * CYL_UP, Vector3.new(height, diameter, diameter), o)
end

-- 회전된 세로 원기둥(기울어진 기둥 등): cf 의 Y 축 방향
function Kit.cylAlongY(parent: Instance, cf: CFrame, height: number, diameter: number, color: Color3, material: Enum.Material?, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	o.shape = "Cylinder"
	o.color = color
	o.material = material or o.material
	return Kit.part(parent, cf * CYL_UP, Vector3.new(height, diameter, diameter), o)
end

-- 가로 원기둥: cf 의 X 축 방향
function Kit.hcyl(parent: Instance, cf: CFrame, length: number, diameter: number, color: Color3, material: Enum.Material?, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	o.shape = "Cylinder"
	o.color = color
	o.material = material or o.material
	return Kit.part(parent, cf, Vector3.new(length, diameter, diameter), o)
end

function Kit.ball(parent: Instance, pos: Vector3, diameter: number, color: Color3, material: Enum.Material?, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	o.shape = "Ball"
	o.color = color
	o.material = material or o.material
	return Kit.part(parent, CFrame.new(pos), Vector3.new(diameter, diameter, diameter), o)
end

function Kit.wedge(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	o.shape = "Wedge"
	o.color = color
	o.material = material or o.material
	return Kit.part(parent, cf, size, o)
end

-- 타원체(나무 수관, 원경 산, 구름 덩어리). 2048 을 넘는 크기는 메시 스케일로 키움.
function Kit.ellipsoid(parent: Instance, cf: CFrame, size: Vector3, color: Color3, material: Enum.Material?, opts: PartOpts?): BasePart
	local o: PartOpts = opts or {}
	o.color = color
	o.material = material or o.material
	if o.collide == nil then
		o.collide = false
	end
	local k = math.max(1, math.max(size.X, size.Y, size.Z) / MAX_SIZE)
	local p = Kit.part(parent, cf, size / k, o)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(k, k, k)
	mesh.Parent = p
	return p
end

------------------------------------------------------------------------------------------------------
-- 야간 발광 / 광원 / 항공장애등 / 글자
------------------------------------------------------------------------------------------------------
Kit.GLOW_TAG = "SeoulNight"
Kit.BEACON_TAG = "SeoulBeacon"

-- 밤에는 현재(Neon) 상태, 낮에는 dayMaterial/dayColor 로 전환되도록 기록
function Kit.glow(p: BasePart, dayMaterial: Enum.Material?, dayColor: Color3?)
	p:SetAttribute("NightMaterial", p.Material.Name)
	p:SetAttribute("NightColor", p.Color)
	p:SetAttribute("DayMaterial", (dayMaterial or Enum.Material.Glass).Name)
	p:SetAttribute("DayColor", dayColor or Config.Palette.GlassDeep)
	CollectionService:AddTag(p, Kit.GLOW_TAG)
end

export type LightProps = {
	color: Color3?,
	brightness: number?,
	range: number?,
	angle: number?,
	face: Enum.NormalId?,
	shadows: boolean?,
	force: boolean?, -- 예산 무시(중요 광원)
}

function Kit.light(p: BasePart, className: string, props: LightProps?): Light?
	local o: LightProps = props or {}
	if not o.force and Kit.stats.lights >= Config.Quality.MaxLights then
		return nil
	end
	local L = Instance.new(className) :: any
	L.Color = o.color or Config.Palette.LampWarm
	L.Brightness = o.brightness or 1
	L.Range = o.range or 16
	L.Shadows = o.shadows == true
	if className == "SpotLight" or className == "SurfaceLight" then
		L.Angle = o.angle or 90
		L.Face = o.face or Enum.NormalId.Bottom
	end
	L.Parent = p
	Kit.stats.lights += 1
	CollectionService:AddTag(L, Kit.GLOW_TAG)
	return L :: Light
end

function Kit.beacon(parent: Instance, pos: Vector3, diameter: number?): BasePart
	local d = diameter or 5
	local b = Kit.ball(parent, pos, d, Config.Palette.Beacon, Enum.Material.Neon, { name = "Beacon", collide = false })
	CollectionService:AddTag(b, Kit.BEACON_TAG)
	Kit.stats.beacons += 1
	return b
end

export type LabelOpts = {
	color: Color3?,
	font: Enum.Font?,
	glow: boolean?, -- true: 빛 영향 0(밤에도 밝게)
	pixelsPerStud: number?,
	maxDistance: number?,
	stroke: boolean?,
}

function Kit.label(p: BasePart, face: Enum.NormalId, text: string, opts: LabelOpts?): SurfaceGui
	local o: LabelOpts = opts or {}
	local g = Instance.new("SurfaceGui")
	g.Name = "Label"
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = o.pixelsPerStud or 12
	g.LightInfluence = if o.glow then 0 else 1
	g.MaxDistance = o.maxDistance or 2600
	g.AlwaysOnTop = false
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Text = text
	t.TextScaled = true
	t.Font = o.font or Enum.Font.GothamBold
	t.TextColor3 = o.color or Color3.fromRGB(240, 240, 240)
	if o.stroke then
		t.TextStrokeTransparency = 0.6
	end
	t.Parent = g
	g.Parent = p
	Kit.stats.labels += 1
	return g
end

-- 수면 위 빛 번짐: 광원 바로 앞에서 "대표 구도 카메라" 쪽으로 늘어진 끊어진 반투명 Neon 조각들.
-- 실제 반사는 화면에서 항상 세로로 서므로, 스트릭을 광원 → 카메라 발밑(HeroCamPos 의 XZ) 방향으로 눕힙니다.
-- 조각마다 폭·위치가 조금씩 달라 물결처럼 흔들려 보이고, 광원에서 멀어질수록 옅어집니다. 수면 밖으로는 나가지 않음.
-- 반환: 첫 조각(가장 밝은 것). 결정적(위치 기반 해시)이라 rng 를 받지 않습니다.
function Kit.reflection(parent: Instance, x: number, z: number, width: number, length: number, color: Color3, transparency: number?): BasePart?
	local y = Config.Level.Water + 0.3
	local base = math.clamp(transparency or 0.62, 0, 0.95)
	local zMin, zMax = Config.FarBank.WaterEdge + 3, Config.NearBank.WaterEdge - 6
	z = math.clamp(z, zMin, zMax)
	local cam = Config.Viewpoint.ReflectionEye
	local dir = Vector3.new(cam.X - x, 0, cam.Z - z)
	if dir.Magnitude < 1 then
		dir = Vector3.new(0, 0, 1)
	end
	dir = dir.Unit
	local n = math.clamp(math.floor(length / 36), 3, 12)
	local step = length / n
	local rnd = Random.new(math.floor(x * 7.31 + z * 3.17) % 2147483647)
	local first: BasePart? = nil
	local rot = CFrame.lookAt(Vector3.zero, dir) -- 로컬 -Z = 카메라 쪽
	local side = rot.RightVector
	for i = 0, n - 1 do
		local t = i / math.max(1, n - 1)
		local segL = step * rnd:NextNumber(0.7, 1.05)
		local w = math.max(2, width * rnd:NextNumber(0.6, 1.2) * (1 - 0.3 * t))
		local along = step * (i + 0.5) + rnd:NextNumber(-0.15, 0.15) * step
		local c = Vector3.new(x, y, z) + dir * along + side * (rnd:NextNumber(-0.22, 0.22) * width)
		if c.Z < zMin or c.Z > zMax then
			break
		end
		local p = Kit.part(parent, CFrame.new(c) * rot, Vector3.new(w, 0.12, segL), {
			name = "WaterGlint",
			material = Enum.Material.Neon,
			color = color:Lerp(Color3.new(0, 0, 0), 0.25 * t),
			transparency = base + (0.95 - base) * t * 0.85,
			collide = false,
			query = false,
			shadow = false,
			glow = true,
			dayMaterial = Enum.Material.Glass,
			dayColor = Color3.fromRGB(40, 60, 80),
		})
		first = first or p
	end
	return first
end

------------------------------------------------------------------------------------------------------
-- 발자국 예약 (AABB, X/Z)
------------------------------------------------------------------------------------------------------
function Kit.reserve(x0: number, z0: number, x1: number, z1: number, _tag: string?)
	table.insert(reservations, { math.min(x0, x1), math.min(z0, z1), math.max(x0, x1), math.max(z0, z1) })
end

function Kit.isFree(x0: number, z0: number, x1: number, z1: number, margin: number?): boolean
	local m = margin or 0
	local ax0, az0, ax1, az1 = math.min(x0, x1) - m, math.min(z0, z1) - m, math.max(x0, x1) + m, math.max(z0, z1) + m
	for _, r in reservations do
		if ax0 < r[3] and ax1 > r[1] and az0 < r[4] and az1 > r[2] then
			return false
		end
	end
	return true
end

-- 회전된 사각형(중심, 폭, 깊이, yaw 도)의 AABB 예약/검사
local function rotatedAABB(cx: number, cz: number, w: number, d: number, yawDeg: number): (number, number, number, number)
	local a = math.rad(yawDeg)
	local hx = (math.abs(math.cos(a)) * w + math.abs(math.sin(a)) * d) / 2
	local hz = (math.abs(math.sin(a)) * w + math.abs(math.cos(a)) * d) / 2
	return cx - hx, cz - hz, cx + hx, cz + hz
end
Kit.rotatedAABB = rotatedAABB

function Kit.reserveRect(cx: number, cz: number, w: number, d: number, yawDeg: number?, tag: string?)
	local x0, z0, x1, z1 = rotatedAABB(cx, cz, w, d, yawDeg or 0)
	Kit.reserve(x0, z0, x1, z1, tag)
end

function Kit.isFreeRect(cx: number, cz: number, w: number, d: number, yawDeg: number?, margin: number?): boolean
	local x0, z0, x1, z1 = rotatedAABB(cx, cz, w, d, yawDeg or 0)
	return Kit.isFree(x0, z0, x1, z1, margin)
end

------------------------------------------------------------------------------------------------------
-- 지면 높이 (Config 레이아웃 기준; 실제 지형/바닥 파트도 이 단면을 따름)
------------------------------------------------------------------------------------------------------
local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * math.clamp(t, 0, 1)
end

function Kit.groundY(_x: number, z: number): number
	local L, F, N = Config.Level, Config.FarBank, Config.NearBank
	if z > F.WaterEdge and z < N.WaterEdge then
		return L.Water
	end
	if z <= F.WaterEdge then
		if z > F.ParkTo then
			return L.Promenade
		elseif z > F.SlopeTo then
			return lerp(L.Promenade, L.Levee, (F.ParkTo - z) / (F.ParkTo - F.SlopeTo))
		end
		return L.City
	end
	if z < N.ParkTo then
		return L.Promenade
	elseif z < N.SlopeTo then
		return lerp(L.Promenade, L.Levee, (z - N.ParkTo) / (N.SlopeTo - N.ParkTo))
	end
	return L.City
end

------------------------------------------------------------------------------------------------------
-- 지형
------------------------------------------------------------------------------------------------------
-- kind: "Block" | "Ball" | "Cylinder" | "Wedge".  Ball: size.X = 지름.  Cylinder: size.Y = 높이, size.X = 지름
function Kit.terrain(kind: string, cf: CFrame, size: Vector3, material: Enum.Material)
	table.insert(Kit.terrainOps, { kind = kind, cf = cf, size = size, material = material })
	Kit.stats.terrainOps += 1
	if not Kit.applyTerrain then
		return
	end
	local T = workspace.Terrain
	if kind == "Block" then
		T:FillBlock(cf, size, material)
	elseif kind == "Ball" then
		T:FillBall(cf.Position, size.X / 2, material)
	elseif kind == "Cylinder" then
		T:FillCylinder(cf, size.Y, size.X / 2, material)
	elseif kind == "Wedge" then
		T:FillWedge(cf, size, material)
	end
	sinceYield += 40
	Kit.yield()
end

------------------------------------------------------------------------------------------------------
-- 차선 (클라이언트 Traffic 이 불빛 차량을 흘려보냄)
--   points: 월드 좌표 경로(차량 불빛 높이 포함). opts.speed(studs/s), opts.density(대/100stud),
--   opts.kind "head"(흰 전조등, 카메라 쪽으로 옴) | "tail"(붉은 후미등) — 방향은 points 순서.
------------------------------------------------------------------------------------------------------
export type LaneOpts = { speed: number?, density: number?, kind: string?, spacing: number? }

function Kit.lane(name: string, points: { Vector3 }, opts: LaneOpts?)
	local o: LaneOpts = opts or {}
	local root = Kit.root
	if not root then
		return
	end
	if not Kit.lanesFolder then
		local f = Instance.new("Folder")
		f.Name = "TrafficLanes"
		f.Parent = root
		Kit.lanesFolder = f
	end
	local lane = Instance.new("Configuration")
	lane.Name = name
	lane:SetAttribute("Count", #points)
	for i, p in points do
		lane:SetAttribute("P" .. i, p)
	end
	lane:SetAttribute("Speed", o.speed or 60)
	lane:SetAttribute("Density", o.density or 1)
	lane:SetAttribute("Kind", o.kind or "head")
	lane:SetAttribute("Spacing", o.spacing or Config.m(1.5)) -- 전조등 두 개 간격 1.5 m
	lane.Parent = Kit.lanesFolder
end

return Kit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000008"><Properties><string name="Name">Landmark</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Landmark
-- 롯데월드타워 모티브 초고층 + 저층 몰(파란 곡면 지붕 홀) + 타워 광장 + 수면 반사.
-- 실제 스케일(1 stud = 0.3 m): 모든 치수는 Config.m(미터) / Config.Real 로 계산하고, 위치는 Config 에서 유도.
--
-- 타워 (Config.Landmark.Tower: 지상부 87 m → 크라운 32 m, 본체 450 m + 크라운 78 m + 첨탑 27 m = 555 m):
--   * 로비 13.5 m(유리 상자 + 3 m 간격 멀리언 + 메자닌 띠) → 그 위 오피스/호텔 층 ≈ 105개(층고 ≈ 4.2 m).
--   * 3개 층 = 1 세그먼트: 안쪽 Neon 조명 코어 1개 + 층마다 바깥 반사 유리 슬래브 링(층 줄무늬).
--     단면은 "십자 블록 2 + 모서리 원기둥 4" 로 만든 정확한 둥근 정사각형(보이는 면끼리 겹침 없음).
--     코어는 바로 위 슬래브보다 CORE_INSET 만큼 들어가 있어 금빛 실내 + 은청색 유리의 가는 층 줄무늬가 됨.
--     9 세그먼트마다 어두운 피난/기계층 띠.
--   * 면 중앙 금빛 솔기: 건물을 관통하는 얇은 Neon 핀 1개가 마주 보는 두 면에 동시에 세로선을 그림.
--   * 랜턴 크라운: 계속 가늘어지는 4면 위 다이아몬드 격자 리브(Neon) + 안쪽 등불 + 첨탑 + 항공장애등.
--   폭 곡선 w(t) = Top + (Base - Top)(1 - t^p): 중간이 살짝 불룩하고 꼭대기로 갈수록 빠르게 가늘어짐.
-- 몰 (Config.Landmark.Mall): 8~12층(35~50 m) Facade 커튼월 블록들 + 높이 27 m 의 파란 곡면 지붕 홀.
-- 광장: 도시 지면 포장 + 타워 둘레 돌띠/빛띠 + 7 m 가로등 + 화단 + 8~12 m 나무 + 5.5 m 캐노피.
-- 모든 발자국은 Kit.reserve 로 예약.

local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)
local Facade = require(script.Parent.Facade)

local Landmark = {}

local P = Config.Palette
local T = Config.Landmark.Tower
local M = Config.Landmark.Mall
local CITY_Y = Config.Level.City
local m2s = Config.m -- 미터 → stud
local rgb = Color3.fromRGB

------------------------------------------------------------------------------------------------------
-- 상수 (실측 m → stud)
------------------------------------------------------------------------------------------------------
-- 타워 본체
local FLOOR_TARGET = m2s(4.2) -- 초고층 오피스/호텔 층고
local FLOORS_PER_SEG = 3 -- 조명 코어 하나가 묶는 층 수 (파트 예산)
local LOBBY_H = m2s(13.5) -- 지면 → 첫 오피스 층 슬래브 (로비 2개 층 높이)
local PLINTH_H = m2s(0.36) -- 화강석 기단 (포장보다 0.8 stud 높은 낮은 단)
local TAPER_POW = 1.4 -- >1 : 중간이 불룩, 꼭대기 쪽에서 빠르게 가늘어짐
local CORNER_R = 0.12 -- 모서리 반경 / 폭
local SLAB_RATIO = 0.46 -- 층 높이 중 유리 슬래브(스팬드럴) 비율 → 1.9 m 띠 + 2.3 m 창
local CORE_INSET = m2s(0.3) -- 코어가 바로 위 슬래브보다 들어간 깊이
local SEAM_W = m2s(2.0) -- 면 중앙 솔기 폭
local SEAM_FROM = 0.1 -- 솔기가 시작하는 높이(비율)
local REFUGE_EVERY = 9 -- 이 세그먼트마다 어두운 피난/기계층
-- 크라운
local CROWN_BASE_RATIO = 0.92 -- 크라운 시작 폭 / TopWidth (둥근 모서리 안쪽에 리브가 앉도록)
local CROWN_TOP_RATIO = 0.32 -- 크라운 꼭대기 폭 / TopWidth (뾰족한 실루엣)
local CROWN_TIERS = 5
local RIB_W, RIB_D = m2s(0.8), m2s(0.6)
-- 사람 스케일
local PAVE_UP = 0.4 -- 포장 윗면 = 도시 지면 + 0.4 (겹치는 면 없음)
local CANOPY_CLEAR = m2s(5.5) -- 출입구 캐노피 하부 높이
local CANOPY_T = m2s(0.5)
local LAMP_H = m2s(7) -- 광장 가로등
local PLANTER_H = m2s(0.55) -- 앉을 수 있는 화단 턱
-- 색
local GLASS = P.GlassBlue:Lerp(P.GlassSilver, 0.25) -- 은청색 반사 유리(하늘을 비춰 밝아 보이므로 조금 어둡게)
local SEAM_C = rgb(236, 188, 114)
local RIB_C = rgb(178, 160, 128) -- 블룸이 켜져 있으므로 격자는 중간 밝기
local RIB_CORNER_C = rgb(214, 196, 158)
local LANTERN_C = rgb(92, 78, 60)
local LOBBY_C = rgb(214, 160, 92)
local CORE_PAL = { P.WindowWarm, P.WindowWarm, P.WindowGold, P.WindowGold, P.WindowWarmDim, P.WindowWarmDim, rgb(255, 178, 92), P.WindowCoolDim, P.WindowCool }
local MALL_LIT = { rgb(156, 112, 66), rgb(140, 100, 60), rgb(168, 128, 80), rgb(120, 96, 70), rgb(104, 118, 142) }
local DOME_C = rgb(52, 98, 178)
local DOME_RIB_C = rgb(120, 182, 255)
local PAVE_C = rgb(118, 116, 112)

-- 실내 연결부 (LandmarkInterior 가 Landmark.layout 으로 받아 실내를 채움)
--   로비 홀: 정면(+Z 로컬 면 = 강/히어로 쪽) 가운데 32 × 25 m, 천장 13.5 m. 뒷벽 가운데 엘리베이터 알코브 8.4 × 10 m, 천장 4.2 m.
local LOBBY_HALL_W = m2s(32)
local LOBBY_HALL_D = m2s(25)
local LOBBY_ALCOVE_W = m2s(8.4)
local LOBBY_ALCOVE_D = m2s(10)
local LOBBY_FLOOR = PLINTH_H + 0.3 -- 로비 바닥 마감 윗면 (기단 + 0.3)
local LOBBY_ALCOVE_TOP = LOBBY_FLOOR + m2s(4.2) + 2.2 -- 알코브 천장고 4.2 m + 천장 마감 공간
local DOOR_W, DOOR_H = m2s(2.4), m2s(2.7) -- 자동 미닫이문 유효 폭 2.4 m, 높이 2.7 m
--   서울스카이 전망대: 본체 꼭대기 2 세그먼트(≈ 25 m)를 유리 커튼월 2개 층(118F 전망대 / 123F 라운지)으로
local OBS_SEGS = 2
local OBS_SLAB_MID = m2s(2.4) -- 두 층 사이 슬래브(라운지 바닥)
local OBS_SLAB_TOP = m2s(3.3) -- 라운지 위 슬래브(크라운 데크 아래)
local OBS_GLASS_IN = 0.6 -- 유리면이 바로 위 슬래브보다 들어간 깊이
local OBS_GLASS_T = 0.4
local OBS_GLASS_C = rgb(168, 190, 210)
local OBS_PIT_W, OBS_PIT_D, OBS_PIT_GAP = m2s(7.2), m2s(3.6), m2s(1.0) -- 스카이데크 유리 바닥 7.2 × 3.6 m, 창에서 1 m
--   몰 홀(파란 곡면 지붕): 가운데 2개 층 갤러리아(아트리움) 66 × 21.6 m + 양쪽 상점 + 정면 입구 통로
local HALL_GX = m2s(33) -- 갤러리아 반길이(X)
local HALL_GZ = m2s(10.8) -- 갤러리아 반폭(상점 전면선)
local HALL_VZ = m2s(6.6) -- 보이드 반폭(메자닌 난간선)
local HALL_SD = m2s(18.6) -- 상점 뒷벽
local HALL_SHOPS = 7 -- 한 줄 상점 수 (가운데 칸 = 정면 입구 통로)
local HALL_FY1 = PAVE_UP + 0.3 -- 1층 바닥 마감 윗면
local HALL_FY2 = HALL_FY1 + m2s(6) -- 2층(메자닌) 바닥 윗면, 층고 6 m
local HALL_ET = HALL_FY2 - 3 -- 입구 통로 천장 구조 하단
local HALL_ST = HALL_FY2 + m2s(4.5) + 0.8 -- 2층 상점 천장 위

local CYL_UP = CFrame.Angles(0, 0, math.rad(90))
local CORNERS = { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }

type PartOpts = Kit.PartOpts
type OptFn = (c: Color3, cyl: boolean) -> PartOpts

local function scale(c: Color3, k: number): Color3
	return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
end

local function widthAt(y: number): number
	local t = math.clamp(y / T.Height, 0, 1.05)
	return T.TopWidth + (T.BaseWidth - T.TopWidth) * (1 - t ^ TAPER_POW)
end

------------------------------------------------------------------------------------------------------
-- 파트 옵션
------------------------------------------------------------------------------------------------------
local function slabOpts(collide: boolean): OptFn
	return function(c: Color3, cyl: boolean): PartOpts
		return {
			name = "Slab",
			shape = if cyl then "Cylinder" else "Block",
			material = Enum.Material.Glass,
			color = c,
			-- 둥근 모서리(원기둥)는 어떤 태양 각도에서도 정반사 점이 생겨 블룸이 번지므로 반사율을 낮춤
			reflectance = if cyl then 0.06 else 0.2,
			collide = collide,
			query = collide,
			shadow = false,
		}
	end
end

local function neonOpts(name: string, dayMat: Enum.Material, dayColor: Color3, collide: boolean?): OptFn
	local col = collide == true
	return function(c: Color3, cyl: boolean): PartOpts
		return {
			name = name,
			shape = if cyl then "Cylinder" else "Block",
			material = Enum.Material.Neon,
			color = c,
			collide = col,
			query = col,
			shadow = false,
			glow = true,
			dayMaterial = dayMat,
			dayColor = dayColor,
		}
	end
end

-- 둥근 모서리 정사각 단면 프리즘: 십자 블록 2 + 모서리 원기둥 4 (cf = 중심, 로컬 Y = 높이)
-- cA: ±X 면, cB: ±Z 면, cC: 모서리
local function rsquare(parent: Instance, cf: CFrame, w: number, h: number, r: number, cA: Color3, cB: Color3, cC: Color3, mk: OptFn)
	local rr = math.clamp(r, 0.4, w * 0.45)
	Kit.part(parent, cf, Vector3.new(w, h, w - 2 * rr), mk(cA, false))
	Kit.part(parent, cf, Vector3.new(w - 2 * rr, h, w), mk(cB, false))
	local o = w / 2 - rr
	for _, s in CORNERS do
		Kit.part(parent, cf * CFrame.new(s[1] * o, 0, s[2] * o) * CYL_UP, Vector3.new(h, 2 * rr, 2 * rr), mk(cC, true))
	end
end

-- 둥근 정사각 프리즘에서 축 정렬 직사각형 구멍(로컬 x0..x1, z0..z1; |x| <= w/2 - r 안쪽, z 는 면까지 가능)을 뺀 조각들.
-- 조각끼리는 맞닿기만 하고(같은 색) 보이는 면이 겹치지 않음.
local function rsquareCut(parent: Instance, cf: CFrame, w: number, h: number, r: number, hole: { number }, c: Color3, mk: OptFn)
	local rr = math.clamp(r, 0.4, w * 0.45)
	local W = w / 2
	local o = W - rr
	local hx0, hx1, hz0, hz1 = hole[1], hole[2], hole[3], hole[4]
	local function blk(x0: number, x1: number, z0: number, z1: number)
		if x1 - x0 > 0.05 and z1 - z0 > 0.05 then
			Kit.part(parent, cf * CFrame.new((x0 + x1) / 2, 0, (z0 + z1) / 2), Vector3.new(x1 - x0, h, z1 - z0), mk(c, false))
		end
	end
	blk(-W, -o, -o, o)
	blk(o, W, -o, o)
	blk(-o, hx0, -W, W)
	blk(hx1, o, -W, W)
	blk(hx0, hx1, -W, hz0)
	blk(hx0, hx1, hz1, W)
	for _, s in CORNERS do
		Kit.part(parent, cf * CFrame.new(s[1] * o, 0, s[2] * o) * CYL_UP, Vector3.new(h, 2 * rr, 2 * rr), mk(c, true))
	end
end
Landmark.rsquareCut = rsquareCut
Landmark.rsquare = rsquare

-- a → b 를 잇는 얇은 Neon 리브. up = 리브 두께 방향 힌트(면 법선)
local function rib(parent: Instance, a: Vector3, b: Vector3, w: number, d: number, up: Vector3, c: Color3, name: string): BasePart
	local len = (b - a).Magnitude + w * 0.5
	return Kit.part(parent, CFrame.lookAt((a + b) / 2, b, up), Vector3.new(w, d, len), {
		name = name,
		material = Enum.Material.Neon,
		color = c,
		collide = false,
		query = false,
		shadow = false,
		glow = true,
		dayMaterial = Enum.Material.Metal,
		dayColor = P.MullionLight,
	})
end

-- 출입구 캐노피(하부 CANOPY_CLEAR) + 아래 조명 띠 (+ 선택: 기둥, 광원). cf = 캐노피 앞 중심의 바닥(포장 윗면), 로컬 +Z = 바깥.
local function canopy(m: Model, cf: CFrame, w: number, d: number, posts: boolean, light: boolean)
	local cy = CANOPY_CLEAR + CANOPY_T / 2
	Kit.box(m, cf * CFrame.new(0, cy, d / 2), Vector3.new(w, CANOPY_T, d), P.ConcreteDark, Enum.Material.Metal, { name = "Canopy", collide = true })
	-- 조명 띠: 캐노피 아랫면에서 0.35 stud 떨어져 겹침 없음
	local strip = Kit.box(m, cf * CFrame.new(0, CANOPY_CLEAR - 0.35 - 0.15, d / 2 + 0.3), Vector3.new(w - m2s(1.5), 0.3, d - m2s(1.6)), P.WindowWarm, Enum.Material.Neon, {
		name = "CanopyLight",
		collide = false,
		query = false,
		glow = true,
		dayMaterial = Enum.Material.SmoothPlastic,
		dayColor = P.ConcreteLight,
	})
	if light then
		Kit.light(strip, "PointLight", { color = P.LampWarm, brightness = 1.6, range = 50 })
	end
	if posts then
		for _, sx in { -1, 1 } do
			Kit.part(m, cf * CFrame.new(sx * (w / 2 - m2s(1.2)), CANOPY_CLEAR / 2, d - m2s(1.0)) * CYL_UP, Vector3.new(CANOPY_CLEAR, m2s(0.45), m2s(0.45)), {
				name = "CanopyPost",
				shape = "Cylinder",
				material = Enum.Material.Metal,
				color = P.Mullion,
				collide = true,
			})
		end
	end
end

------------------------------------------------------------------------------------------------------
-- 타워 본체
------------------------------------------------------------------------------------------------------
local function coreColor(rng: Random, t: number, faceK: number, refuge: boolean): Color3
	local c = CORE_PAL[rng:NextInteger(1, #CORE_PAL)]
	local k = faceK * rng:NextNumber(0.5, 0.82)
	if rng:NextNumber() < 0.12 then
		k *= 0.5 -- 드문드문 불 꺼진 층 묶음
	end
	if refuge then
		k *= 0.42 -- 피난/기계층 띠
	end
	if t > 0.86 then
		k *= 0.72 -- 꼭대기 근처: 호텔/전망대 아래 어두운 유리
	end
	return scale(c, k)
end

------------------------------------------------------------------------------------------------------
-- 서울스카이 전망대 띠 (꼭대기 2 세그먼트): 슬래브 A(바닥, 스카이데크 구멍) / 118F 유리 / 슬래브 B / 123F 유리 / 슬래브 C
-- 층 사이 조명 코어 대신 바닥부터 천장까지 투명 유리 커튼월 + 1.8 m 간격 슬림 멀리언 → 밤에는 밝은 유리 띠로 읽힘.
------------------------------------------------------------------------------------------------------
local function glassBand(m: Model, TF: CFrame, yb: number, yt: number, w: number, seamMk: OptFn)
	local h = yt - yb + 0.6 -- 위아래 슬래브 속으로 0.3 씩
	local yc = (yb + yt) / 2
	local r = w * CORNER_R
	local W = w / 2
	local o = W - r
	local t = OBS_GLASS_T
	local gO: PartOpts = { name = "ObsGlass", material = Enum.Material.Glass, color = OBS_GLASS_C, transparency = 0.62, reflectance = 0.05, collide = true, shadow = false }
	local mO: PartOpts = { name = "ObsMullion", material = Enum.Material.Metal, color = P.Mullion, collide = false, query = false, shadow = false }
	local n = math.max(2, math.floor(2 * o / m2s(1.8) + 0.5))
	if n % 2 == 1 then
		n += 1 -- 면 가운데 = 솔기 자리
	end
	local da = math.pi / 6
	local fw = 2 * r * math.sin(da / 2)
	for f = 0, 3 do
		local FR = TF * CFrame.Angles(0, f * math.pi / 2, 0)
		Kit.part(m, FR * CFrame.new(0, yc, W - t / 2), Vector3.new(2 * o + 0.1, h, t), gO)
		for i = 0, n do
			if i ~= n / 2 then
				Kit.part(m, FR * CFrame.new(-o + i * 2 * o / n, yc, W - 0.15), Vector3.new(0.35, h, 1.2), mO)
			end
		end
		local CC = FR * CFrame.new(o, yc, o)
		for k = 0, 2 do
			Kit.part(m, CC * CFrame.Angles(0, (k + 0.5) * da, 0) * CFrame.new(0, 0, r * math.cos(da / 2) - t / 2), Vector3.new(fw + 0.15, h, t), gO)
		end
		for k = 1, 2 do
			Kit.part(m, CC * CFrame.Angles(0, k * da, 0) * CFrame.new(0, 0, r - 0.15), Vector3.new(0.35, h, 1.2), mO)
		end
		-- 솔기: 유리 밖 가는 금빛 선(전망을 가리지 않게 0.3 m)
		Kit.part(m, FR * CFrame.new(0, yc, W + 0.55), Vector3.new(1.0, h - 0.6, 1.0), seamMk(SEAM_C, false))
	end
end

local function buildObservatory(m: Model, TF: CFrame, y0: number, slabH: number, seamMk: OptFn): { [string]: any }
	local H = T.Height
	local yA = y0 + slabH -- 118F 바닥(슬래브 A 윗면)
	local rest = H - yA - OBS_SLAB_MID - OBS_SLAB_TOP
	local yA1 = yA + rest * 0.52 -- 118F 천장(슬래브 B 아랫면): 약 9 m 2개 층 높이 전망 홀
	local yB = yA1 + OBS_SLAB_MID -- 123F 라운지 바닥
	local yB1 = H - OBS_SLAB_TOP -- 라운지 천장
	local wB = widthAt(yA1 + OBS_SLAB_MID / 2)
	local wC = widthAt(yB1 + OBS_SLAB_TOP / 2)
	local gw1 = wB - 2 * OBS_GLASS_IN
	local gw2 = wC - 2 * OBS_GLASS_IN
	-- 슬래브 A (스카이데크 유리 바닥 구멍)
	local wA = widthAt(y0 + slabH / 2)
	local pz1 = gw1 / 2 - OBS_PIT_GAP
	local pit = { -OBS_PIT_W / 2, OBS_PIT_W / 2, pz1 - OBS_PIT_D, pz1 }
	rsquareCut(m, TF * CFrame.new(0, y0 + slabH / 2, 0), wA, slabH, wA * CORNER_R, pit, GLASS, slabOpts(true))
	rsquare(m, TF * CFrame.new(0, yA1 + OBS_SLAB_MID / 2, 0), wB, OBS_SLAB_MID, wB * CORNER_R, GLASS, GLASS, GLASS, slabOpts(true))
	rsquare(m, TF * CFrame.new(0, yB1 + OBS_SLAB_TOP / 2, 0), wC, OBS_SLAB_TOP, wC * CORNER_R, GLASS, GLASS, GLASS, slabOpts(true))
	-- 슬래브 솔기: A 는 면마다(구멍을 지나지 않게), B·C 는 관통 핀(슬래브 속에 숨음)
	for f = 0, 3 do
		local FR = TF * CFrame.Angles(0, f * math.pi / 2, 0)
		Kit.part(m, FR * CFrame.new(0, y0 + slabH / 2, wA / 2 + 0.05), Vector3.new(SEAM_W, slabH - 0.4, 1.3), seamMk(SEAM_C, false))
	end
	for _, s in { { yA1 + OBS_SLAB_MID / 2, OBS_SLAB_MID, wB }, { yB1 + OBS_SLAB_TOP / 2, OBS_SLAB_TOP, wC } } do
		local cf = TF * CFrame.new(0, s[1], 0)
		Kit.part(m, cf, Vector3.new(SEAM_W, s[2] - 0.4, s[3] + 1.4), seamMk(SEAM_C, false))
		Kit.part(m, cf, Vector3.new(s[3] + 1.4, s[2] - 0.4, SEAM_W), seamMk(SEAM_C, false))
	end
	glassBand(m, TF, yA, yA1, gw1, seamMk)
	glassBand(m, TF, yB, yB1, gw2, seamMk)
	return { y0 = y0, yA = yA, yA1 = yA1, yB = yB, yB1 = yB1, gw1 = gw1, gw2 = gw2, glassT = OBS_GLASS_T, pit = pit, cornerR = CORNER_R }
end

local function buildShaft(m: Model, TF: CFrame, rng: Random): (number, { [string]: any })
	local H = T.Height
	local shaftH = H - LOBBY_H
	local nSeg = math.max(1, math.floor(shaftH / (FLOOR_TARGET * FLOORS_PER_SEG) + 0.5))
	local hs = shaftH / nSeg
	local floorH = hs / FLOORS_PER_SEG -- ≈ 4.16 m
	local slabH = floorH * SLAB_RATIO
	local coreMk = neonOpts("Core", Enum.Material.Glass, P.GlassBlue)
	local seamMk = neonOpts("Seam", Enum.Material.Metal, P.MullionLight)
	local obsFrom = nSeg - OBS_SEGS
	for k = 0, nSeg - 1 do
		local y0 = LOBBY_H + k * hs
		local y1 = y0 + hs
		local t = (y0 + hs / 2) / H
		if k >= obsFrom then
			-- 전망대 띠(buildObservatory)가 대신함. rng 소비만 맞춰 아래 몰/광장 배치를 그대로 유지.
			local refuge = (k % REFUGE_EVERY) == REFUGE_EVERY - 1
			coreColor(rng, t, 1.0, refuge)
			coreColor(rng, t, 0.7, refuge)
			continue
		end
		-- 1) 층 슬래브(반사 유리 링) — 층마다 하나
		local wsMax = 0
		for j = 0, FLOORS_PER_SEG - 1 do
			local yc = y0 + j * floorH + slabH / 2
			local ws = widthAt(yc)
			wsMax = math.max(wsMax, ws)
			rsquare(m, TF * CFrame.new(0, yc, 0), ws, slabH, ws * CORNER_R, GLASS, GLASS, GLASS, slabOpts(j == 0))
		end
		-- 2) 조명 코어: 이 세그먼트 위의(더 좁은) 슬래브 기준으로 inset → 모든 슬래브보다 안쪽
		local wTop = widthAt(y1 + slabH / 2)
		local refuge = (k % REFUGE_EVERY) == REFUGE_EVERY - 1
		local cA, cB = coreColor(rng, t, 1.0, refuge), coreColor(rng, t, 0.7, refuge) -- ±Z 면은 어둡게(면 대비)
		rsquare(m, TF * CFrame.new(0, (y0 + y1) / 2, 0), wTop - 2 * CORE_INSET, hs, wTop * CORNER_R - CORE_INSET, cA, cB, cA:Lerp(cB, 0.5), coreMk)
		-- 3) 면 중앙 솔기 (관통 핀 2개 → 4면)
		if y0 >= H * SEAM_FROM then
			local L = wsMax + 1.4
			local cf = TF * CFrame.new(0, (y0 + y1) / 2, 0)
			Kit.part(m, cf, Vector3.new(SEAM_W, hs, L), seamMk(SEAM_C, false))
			Kit.part(m, cf, Vector3.new(L, hs, SEAM_W), seamMk(SEAM_C, false))
		end
	end
	-- 항공장애등: 중간 높이 모서리 4개
	local yb = H * 0.56
	local ws = widthAt(yb)
	local r = ws * CORNER_R
	local diag = (ws / 2 - r) * math.sqrt(2) + r + 2
	for i = 0, 3 do
		local a = i * math.pi / 2
		Kit.beacon(m, (TF * CFrame.Angles(0, a + math.pi / 4, 0) * CFrame.new(0, yb, diag)).Position, 5)
	end
	local obs = buildObservatory(Kit.group(m, "SeoulSkyShell"), TF, LOBBY_H + obsFrom * hs, slabH, seamMk)
	return nSeg * FLOORS_PER_SEG, obs
end

------------------------------------------------------------------------------------------------------
-- 로비 / 기단 / 캐노피
------------------------------------------------------------------------------------------------------
local function buildBase(m: Model, TF: CFrame): { [string]: any }
	-- 화강석 기단 (포장 위로 0.8 stud 낮은 단: 아바타가 걸어 오를 수 있음)
	local pw = T.BaseWidth + m2s(8)
	rsquare(m, TF * CFrame.new(0, PLINTH_H / 2, 0), pw, PLINTH_H, pw * CORNER_R, P.ConcreteGrey, P.ConcreteGrey, P.ConcreteGrey, function(c: Color3, cyl: boolean): PartOpts
		return { name = "Plinth", shape = if cyl then "Cylinder" else "Block", material = Enum.Material.Slate, color = c, collide = true, shadow = false }
	end)
	-- 로비 유리 상자(금빛 발광, 13.5 m): 첫 슬래브보다 1.5 m 안쪽.
	-- 정면(+Z) 가운데는 걸어 들어갈 수 있는 로비 홀(32 × 25 m, 천장 13.5 m) + 뒷벽 엘리베이터 알코브로 비워 둠.
	-- 나머지는 이전처럼 금빛 발광 덩어리(코어/후방 공간) — 조각끼리 맞닿기만 함.
	local w0 = widthAt(LOBBY_H)
	local inset = m2s(1.5)
	local wl = w0 - 2 * inset
	local rl = w0 * CORNER_R - inset
	local lh = LOBBY_H - PLINTH_H
	local ly = PLINTH_H + lh / 2
	local W = wl / 2
	local rr = math.clamp(rl, 0.4, wl * 0.45)
	local o = W - rr
	local HX = LOBBY_HALL_W / 2
	local ZB = W - LOBBY_HALL_D
	local AX = LOBBY_ALCOVE_W / 2
	local AZ0 = ZB - LOBBY_ALCOVE_D
	local lobbyMk = neonOpts("Lobby", Enum.Material.Glass, P.GlassSilver, true)
	local function vol(x0: number, x1: number, z0: number, z1: number, y0: number, y1: number)
		Kit.part(m, TF * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), Vector3.new(x1 - x0, y1 - y0, z1 - z0), lobbyMk(LOBBY_C, false))
	end
	vol(-W, -o, -o, o, PLINTH_H, LOBBY_H)
	vol(o, W, -o, o, PLINTH_H, LOBBY_H)
	vol(-o, -HX, -W, W, PLINTH_H, LOBBY_H)
	vol(HX, o, -W, W, PLINTH_H, LOBBY_H)
	vol(-HX, -AX, -W, ZB, PLINTH_H, LOBBY_H)
	vol(AX, HX, -W, ZB, PLINTH_H, LOBBY_H)
	vol(-AX, AX, -W, AZ0, PLINTH_H, LOBBY_H)
	vol(-AX, AX, AZ0, ZB, LOBBY_ALCOVE_TOP, LOBBY_H)
	for _, s in CORNERS do
		Kit.part(m, TF * CFrame.new(s[1] * o, ly, s[2] * o) * CYL_UP, Vector3.new(lh, 2 * rr, 2 * rr), lobbyMk(LOBBY_C, true))
	end
	-- 메자닌 띠 (6.5 m): 로비가 2개 층 높이로 읽히게. 홀을 가로지르지 않도록 외곽 링(면 4 + 모서리 원기둥 4)으로.
	local my = PLINTH_H + m2s(6.5)
	local bandMk = slabOpts(false)
	for f = 0, 3 do
		local FR = TF * CFrame.Angles(0, f * math.pi / 2, 0)
		Kit.part(m, FR * CFrame.new(0, my, W + 0.2), Vector3.new(2 * o, m2s(0.7), 1.6), bandMk(GLASS, false))
	end
	for _, s in CORNERS do
		Kit.part(m, TF * CFrame.new(s[1] * o, my, s[2] * o) * CYL_UP, Vector3.new(m2s(0.7), 2 * (rr + 1), 2 * (rr + 1)), bandMk(GLASS, true))
	end
	-- 로비 멀리언(3 m 간격): 면마다 짧은 핀(유리 안팎 0.4 m) — 홀 안을 가로지르지 않음
	local span = wl / 2 - rl - m2s(0.6)
	local n = math.max(1, math.floor(span * 2 / m2s(3)))
	if n % 2 == 0 then
		n += 1 -- 정면 가운데가 유리 칸(양옆 칸에 문)
	end
	local step = span * 2 / n
	local finO: PartOpts = { name = "LobbyFin", material = Enum.Material.Metal, color = P.Mullion, collide = false, query = false, shadow = false }
	for f = 0, 3 do
		local FR = TF * CFrame.Angles(0, f * math.pi / 2, 0)
		for i = 0, n do
			Kit.part(m, FR * CFrame.new(-span + i * step, ly, W - 0.3), Vector3.new(m2s(0.25), lh, 2.0), finO)
		end
	end
	-- 홀 정면 유리(두께 0.4, 투명) + 자동문 2곳(멀리언 사이 칸, 유효 폭 2.4 m × 2.7 m) 위 트랜섬/문틀 헤더
	local gz = W - 0.3
	local doorXs = { -step, step }
	local glassO: PartOpts = { name = "LobbyGlass", material = Enum.Material.Glass, color = rgb(176, 194, 208), transparency = 0.62, reflectance = 0.06, collide = true, shadow = false }
	local gy0, gy1 = PLINTH_H - 0.3, LOBBY_H + 0.3
	local function pane(x0: number, x1: number, y0: number, y1: number)
		Kit.part(m, TF * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, gz), Vector3.new(x1 - x0, y1 - y0, OBS_GLASS_T), glassO)
	end
	local dTop = LOBBY_FLOOR + DOOR_H
	pane(-HX, doorXs[1] - DOOR_W / 2, gy0, gy1)
	pane(doorXs[1] + DOOR_W / 2, doorXs[2] - DOOR_W / 2, gy0, gy1)
	pane(doorXs[2] + DOOR_W / 2, HX, gy0, gy1)
	for _, dx in doorXs do
		pane(dx - DOOR_W / 2, dx + DOOR_W / 2, dTop + 0.8, gy1)
		Kit.box(m, TF * CFrame.new(dx, dTop + 0.45, gz - 0.25), Vector3.new(DOOR_W + 0.6, 0.9, 1.3), P.Mullion, Enum.Material.Metal, { name = "DoorHeader", collide = true, shadow = false })
	end
	-- 각 면 중앙 출입구 캐노피(16 m × 8 m, 하부 5.5 m) + 조명 띠 + 기둥 + 실제 광원
	for f = 0, 3 do
		local FR = TF * CFrame.Angles(0, f * math.pi / 2, 0)
		canopy(m, FR * CFrame.new(0, PAVE_UP, wl / 2 - 1), m2s(16), m2s(8), true, true)
	end
	return {
		W = W, -- 로비 외곽 반폭(정면 유리 바깥면)
		HX = HX, -- 홀 반폭
		ZB = ZB, -- 홀 뒷벽
		AX = AX, -- 알코브 반폭
		AZ0 = AZ0, -- 알코브 안쪽 끝벽
		alcoveTop = LOBBY_ALCOVE_TOP,
		plinthY = PLINTH_H,
		floorY = LOBBY_FLOOR,
		ceilY = LOBBY_H,
		glassZ = gz,
		doorXs = doorXs,
		doorW = DOOR_W,
		doorH = DOOR_H,
		mezzY = my,
		finStep = step,
		finSpan = span,
	}
end

------------------------------------------------------------------------------------------------------
-- 랜턴 크라운 + 첨탑
------------------------------------------------------------------------------------------------------
local function buildCrown(m: Model, TF: CFrame)
	local H = T.Height
	-- 본체 마감 데크
	local wd = widthAt(H) + 1
	rsquare(m, TF * CFrame.new(0, H + 1, 0), wd, 2, wd * CORNER_R, GLASS, GLASS, GLASS, slabOpts(true))
	local yc0 = H + 2
	local CHc = T.CrownHeight - 2
	local function cw(u: number): number
		local a = u / CHc
		return T.TopWidth * (CROWN_BASE_RATIO + (CROWN_TOP_RATIO - CROWN_BASE_RATIO) * a)
	end
	-- 안쪽 등불(아래 2단): 격자 사이로 은은하게
	for i = 0, 1 do
		local u0, u1 = i * CHc / CROWN_TIERS, (i + 1) * CHc / CROWN_TIERS
		local dia = cw(u1) * 0.55
		local c = scale(LANTERN_C, 1 + i * 0.15)
		local p = Kit.part(m, TF * CFrame.new(0, yc0 + (u0 + u1) / 2, 0) * CYL_UP, Vector3.new(u1 - u0, dia, dia), neonOpts("Lantern", Enum.Material.Glass, P.GlassSilver)(c, true))
		Kit.light(p, "PointLight", { color = P.LampWarm, brightness = 1.8, range = 60 })
	end
	-- 4면 격자 리브
	for f = 0, 3 do
		local FR = TF * CFrame.Angles(0, f * math.pi / 2, 0)
		local nrm = FR:VectorToWorldSpace(Vector3.zAxis)
		local function pt(x: number, u: number): Vector3
			local hw = cw(u) / 2
			return FR * Vector3.new(x * hw, yc0 + u, hw)
		end
		for i = 0, CROWN_TIERS do
			local u = i * CHc / CROWN_TIERS
			rib(m, pt(-1, u), pt(1, u), RIB_W, RIB_D, nrm, RIB_C, "CrownRing")
		end
		for i = 0, CROWN_TIERS - 1 do
			local u0, u1 = i * CHc / CROWN_TIERS, (i + 1) * CHc / CROWN_TIERS
			rib(m, pt(-1, u0), pt(0, u1), RIB_W, RIB_D, nrm, RIB_C, "CrownRib")
			rib(m, pt(0, u0), pt(-1, u1), RIB_W, RIB_D, nrm, RIB_C, "CrownRib")
			rib(m, pt(0, u0), pt(1, u1), RIB_W, RIB_D, nrm, RIB_C, "CrownRib")
			rib(m, pt(1, u0), pt(0, u1), RIB_W, RIB_D, nrm, RIB_C, "CrownRib")
		end
		-- 솔기의 연장(중앙 세로 리브) + 모서리 리브
		rib(m, pt(0, 0), pt(0, CHc), m2s(1.3), m2s(0.9), nrm, SEAM_C, "CrownSeam")
		local cn = (nrm + FR:VectorToWorldSpace(Vector3.xAxis)).Unit
		rib(m, pt(1, 0), pt(1, CHc), m2s(1.2), m2s(1.2), cn, RIB_CORNER_C, "CrownCorner")
		-- 데크 모서리 항공장애등
		Kit.beacon(m, (FR * CFrame.new(cw(0) / 2 + 1.6, yc0 + 3.4, cw(0) / 2 + 1.6)).Position, 4.3)
	end
	-- 첨탑: 꼭대기 네 모서리에서 모이는 버팀대 + 마스트 (27 m)
	local yTop = yc0 + CHc
	local hwT = cw(CHc) / 2
	local apex = TF * Vector3.new(0, yTop + m2s(8), 0)
	for _, s in CORNERS do
		local a = TF * Vector3.new(s[1] * hwT, yTop, s[2] * hwT)
		rib(m, a, apex, m2s(0.9), m2s(0.9), Vector3.yAxis, RIB_CORNER_C, "SpireStrut")
		Kit.beacon(m, a + Vector3.new(0, 3.6, 0), 4)
	end
	local S = T.SpireHeight
	local lo, hi = S * 0.55, S * 0.45
	Kit.part(m, TF * CFrame.new(0, yTop + lo / 2, 0) * CYL_UP, Vector3.new(lo, m2s(1.7), m2s(1.7)), { name = "Spire", shape = "Cylinder", material = Enum.Material.Metal, color = P.MullionLight, collide = false })
	Kit.part(m, TF * CFrame.new(0, yTop + lo + hi / 2, 0) * CYL_UP, Vector3.new(hi, m2s(0.9), m2s(0.9)), { name = "Spire", shape = "Cylinder", material = Enum.Material.Metal, color = P.MullionLight, collide = false })
	Kit.beacon(m, TF * Vector3.new(0, yTop + S + 2.6, 0), 6.5)
	Kit.beacon(m, TF * Vector3.new(0, yTop + lo + 0.7, 0), 5)
end

------------------------------------------------------------------------------------------------------
-- 몰 (롯데월드몰 모티브: 8~12층 블록 + 곡면 지붕 홀)
------------------------------------------------------------------------------------------------------
-- 몰 홀 외피: Facade "curtain" 과 같은 야경 언어(층 슬래브 띠 + 1.4 안쪽 조명 코어 + 6 m 멀리언 + 꺼진 창)를 쓰되,
-- 조명 코어를 실내 공간(갤러리아/상점/입구 통로)을 비운 8 덩어리로 나누고, 슬래브·멀리언은 외곽 링/면별 핀으로 만듦.
local function buildHall(m: Model, rng: Random, HF: CFrame, hw: number, hd: number, hh: number): { [string]: any }
	local HXo, HZo = hw / 2, hd / 2
	local inset = 1.4
	local HXi, HZi = HXo - inset, HZo - inset
	local GX, GZ, SD = HALL_GX, HALL_GZ, HALL_SD
	local EX = GX / HALL_SHOPS -- 가운데 상점 칸 반폭 = 입구 통로 반폭
	local floorH = m2s(5.5)
	local slabH = floorH * 0.4
	local lobbyH = math.min(20, hh * 0.06)
	local fy0 = lobbyH + 1.6
	-- 1) 조명 코어 (실내를 비운 8 덩어리, 같은 색 → 바깥에서는 이전과 같은 따뜻한 층 불빛)
	local cF = MALL_LIT[rng:NextInteger(1, #MALL_LIT)]
	local coreO: PartOpts = { name = "Core", material = Enum.Material.Neon, color = cF, collide = true, shadow = false, glow = true, dayMaterial = Enum.Material.Glass, dayColor = P.GlassDeep }
	local function core(x0: number, x1: number, z0: number, z1: number, y0: number, y1: number)
		Kit.part(m, HF * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), Vector3.new(x1 - x0, y1 - y0, z1 - z0), coreO)
	end
	core(-HXi, -GX, -HZi, HZi, 0, hh)
	core(GX, HXi, -HZi, HZi, 0, hh)
	core(-GX, GX, -HZi, -SD, 0, hh)
	core(-GX, -EX, SD, HZi, 0, hh)
	core(EX, GX, SD, HZi, 0, hh)
	core(-EX, EX, SD, HZi, HALL_ET, hh)
	core(-GX, GX, GZ, SD, HALL_ST, hh)
	core(-GX, GX, -SD, -GZ, HALL_ST, hh)
	-- 2) 외곽 링(캐노피 띠 / 층 슬래브 / 상단 마감): out = 외벽 밖 돌출, depth = 안쪽 깊이, gap = 정면 입구 통로
	local function ring(y0: number, y1: number, out: number, depth: number, gap: number?, opts: PartOpts)
		local yc, yh = (y0 + y1) / 2, y1 - y0
		local xo, zo, xi, zi = HXo + out, HZo + out, HXo - depth, HZo - depth
		local function b(x0: number, x1: number, z0: number, z1: number)
			Kit.part(m, HF * CFrame.new((x0 + x1) / 2, yc, (z0 + z1) / 2), Vector3.new(x1 - x0, yh, z1 - z0), opts)
		end
		b(-xo, -xi, -zo, zo)
		b(xi, xo, -zo, zo)
		b(-xi, xi, -zo, -zi)
		if gap then
			b(-xi, -gap, zi, zo)
			b(gap, xi, zi, zo)
		else
			b(-xi, xi, zi, zo)
		end
	end
	ring(lobbyH, lobbyH + 1.6, 3, 2, EX, { name = "Canopy", material = Enum.Material.Concrete, color = P.ConcreteDark, collide = true, shadow = false })
	local slabO: PartOpts = { name = "Slab", material = Enum.Material.Glass, color = P.GlassBlue, reflectance = 0.18, collide = true, shadow = false }
	local nFloors = math.floor((hh - fy0) / floorH)
	for i = 0, nFloors - 1 do
		local yb = fy0 + i * floorH
		ring(yb, yb + slabH, 0, 2, if yb < HALL_ET then EX else nil, slabO)
	end
	ring(hh - slabH, hh, 0.2, 2, nil, slabO)
	-- 3) 멀리언(6 m): 면마다 짧은 핀(외벽 -1.1 ~ +0.5). 입구 칸은 통로 천장 위부터.
	local bay = m2s(6)
	local nx = math.max(1, math.floor(hw / bay))
	local nz = math.max(1, math.floor(hd / bay))
	local finO: PartOpts = { name = "Fin", material = Enum.Material.Metal, color = P.Mullion, collide = false, query = false, shadow = false }
	for i = 1, nx - 1 do
		local x = -HXo + i * (hw / nx)
		for _, sz in { -1, 1 } do
			local yb = if sz == 1 and math.abs(x) < EX + 0.6 then HALL_ET else fy0
			Kit.part(m, HF * CFrame.new(x, (yb + hh) / 2, sz * (HZo - 0.3)), Vector3.new(1.1, hh - yb, 1.6), finO)
		end
	end
	for i = 1, nz - 1 do
		local z = -HZo + i * (hd / nz)
		for _, sx in { -1, 1 } do
			Kit.part(m, HF * CFrame.new(sx * (HXo - 0.3), (fy0 + hh) / 2, z), Vector3.new(1.6, hh - fy0, 1.1), finO)
		end
	end
	for _, s in CORNERS do
		Kit.part(m, HF * CFrame.new(s[1] * HXo, (fy0 + hh) / 2, s[2] * HZo), Vector3.new(2.2, hh - fy0, 2.2), { name = "Corner", material = Enum.Material.Metal, color = P.Mullion, collide = false, shadow = false })
	end
	-- 4) 꺼진 창 패치(위 불빛 띠, 코어 앞 0.1)
	local s1 = fy0 + floorH + slabH
	local s2 = math.min(hh - slabH, s1 + floorH - slabH)
	local offO: PartOpts = { name = "Off", material = Enum.Material.Glass, color = P.WindowOff, reflectance = 0.1, collide = false, query = false, shadow = false }
	for _ = 1, 8 do
		local face = rng:NextInteger(1, 3)
		local nb = rng:NextInteger(1, 3)
		if face <= 2 then
			local i0 = rng:NextInteger(0, nx - nb)
			local x = -HXo + (i0 + nb / 2) * (hw / nx)
			local sz = if face == 1 then 1 else -1
			Kit.part(m, HF * CFrame.new(x, (s1 + s2) / 2, sz * (HZo - 0.95)), Vector3.new(nb * (hw / nx) - 1.1, s2 - s1, 0.7), offO)
		else
			local i0 = rng:NextInteger(0, nz - nb)
			local z = -HZo + (i0 + nb / 2) * (hd / nz)
			local sx = if rng:NextNumber() < 0.5 then 1 else -1
			Kit.part(m, HF * CFrame.new(sx * (HXo - 0.95), (s1 + s2) / 2, z), Vector3.new(0.7, s2 - s1, nb * (hd / nz) - 1.1), offO)
		end
	end
	-- 5) 지붕 슬래브(갤러리아 위는 열림 → 돔 볼트가 실내에서 보임)
	local roofO: PartOpts = { name = "Roof", material = Enum.Material.Concrete, color = P.ConcreteDark, collide = true }
	local function roof(x0: number, x1: number, z0: number, z1: number)
		Kit.part(m, HF * CFrame.new((x0 + x1) / 2, hh + 1, (z0 + z1) / 2), Vector3.new(x1 - x0, 2, z1 - z0), roofO)
	end
	roof(-HXo, HXo, GZ, HZo)
	roof(-HXo, HXo, -HZo, -GZ)
	roof(-HXo, -GX, -GZ, GZ)
	roof(GX, HXo, -GZ, GZ)
	-- 6) 정면 입구: 통로 폭 전체 유리(두께 0.4) + 자동문 2곳 + 문틀 헤더 + 양끝 문설주
	local ez = HZo - 0.3
	local dx = EX * 0.45
	local glassO: PartOpts = { name = "EntranceGlass", material = Enum.Material.Glass, color = rgb(176, 194, 208), transparency = 0.62, reflectance = 0.06, collide = true, shadow = false }
	local gy0, gy1 = 0, HALL_ET + 0.3
	local function pane(x0: number, x1: number, y0: number, y1: number)
		Kit.part(m, HF * CFrame.new((x0 + x1) / 2, (y0 + y1) / 2, ez), Vector3.new(x1 - x0, y1 - y0, OBS_GLASS_T), glassO)
	end
	local dTop = HALL_FY1 + DOOR_H
	pane(-EX, -dx - DOOR_W / 2, gy0, gy1)
	pane(-dx + DOOR_W / 2, dx - DOOR_W / 2, gy0, gy1)
	pane(dx + DOOR_W / 2, EX, gy0, gy1)
	for _, sx in { -1, 1 } do
		pane(sx * dx - DOOR_W / 2, sx * dx + DOOR_W / 2, dTop + 0.8, gy1)
		Kit.box(m, HF * CFrame.new(sx * dx, dTop + 0.45, ez - 0.25), Vector3.new(DOOR_W + 0.6, 0.9, 1.3), P.Mullion, Enum.Material.Metal, { name = "DoorHeader", collide = true, shadow = false })
		Kit.box(m, HF * CFrame.new(sx * EX, HALL_ET / 2, (HZi + HZo) / 2 - 0.1), Vector3.new(1.2, HALL_ET, inset + 0.4), P.Mullion, Enum.Material.Metal, { name = "Jamb", collide = true, shadow = false })
	end
	return {
		cf = HF,
		HX = HXo,
		HZ = HZo,
		H = hh,
		GX = GX,
		GZ = GZ,
		VZ = HALL_VZ,
		SD = SD,
		EX = EX,
		ET = HALL_ET,
		ST = HALL_ST,
		FY1 = HALL_FY1,
		FY2 = HALL_FY2,
		shops = HALL_SHOPS,
		doorXs = { -dx, dx },
		doorW = DOOR_W,
		doorH = DOOR_H,
		glassZ = ez,
	}
end

-- 다면 타원 돔(위 반쪽만): 경도(u) 14 × 위도(θ) 8 패널 + 아치 리브 15 + 용마루. 패널은 Neon(밤) → 밖에서는 이전 타원체 돔과 같고,
-- 안(갤러리아)에서는 파랗게 빛나는 볼트와 밝은 리브가 보임. 같은 색 패널끼리는 가장자리만 살짝 겹침.
local function buildDome(m: Model, HF: CFrame, a: number, bR: number, c: number, ey: number)
	local NU, NT = 14, 8
	local UMAX = 0.995
	local function pt(u: number, th: number): Vector3
		local s = math.sqrt(math.max(0, 1 - u * u))
		return Vector3.new(a * u, ey + bR * s * math.sin(th), c * s * math.cos(th))
	end
	local function nrmAt(p: Vector3): Vector3
		return Vector3.new(p.X / (a * a), (p.Y - ey) / (bR * bR), p.Z / (c * c)).Unit
	end
	local us = {}
	for i = 0, NU do
		us[i + 1] = UMAX * math.sin(-math.pi / 2 + math.pi * i / NU)
	end
	local panelO: PartOpts = { name = "Dome", material = Enum.Material.Neon, color = DOME_C, collide = true, shadow = false, glow = true, dayMaterial = Enum.Material.Glass, dayColor = P.GlassBlue }
	local center = Vector3.new(0, ey, 0)
	for i = 1, NU do
		for j = 0, NT - 1 do
			local t0, t1 = math.pi * j / NT, math.pi * (j + 1) / NT
			local p00, p10, p01, p11 = pt(us[i], t0), pt(us[i + 1], t0), pt(us[i], t1), pt(us[i + 1], t1)
			local ctr = (p00 + p10 + p01 + p11) / 4
			local eu = (p10 + p11 - p00 - p01) / 2
			local et = (p01 + p11 - p00 - p10) / 2
			local nrm = eu:Cross(et)
			if nrm.Magnitude > 1e-3 and eu.Magnitude > 1e-3 then
				nrm = nrm.Unit
				if nrm:Dot(ctr - center) < 0 then
					nrm = -nrm
				end
				local ex = eu.Unit
				local ez = ex:Cross(nrm).Unit
				local wU = math.max((p10 - p00).Magnitude, (p11 - p01).Magnitude) + 0.6
				local wT = math.max(math.abs((p01 - p00):Dot(ez)), math.abs((p11 - p10):Dot(ez))) + 0.6
				Kit.part(m, HF * CFrame.fromMatrix(ctr, ex, nrm, ez), Vector3.new(wU, 0.8, wT), panelO)
			end
		end
	end
	-- 양 끝 마개(얇은 타원판, 아랫반은 지붕/코어 속)
	local sEnd = math.sqrt(1 - UMAX * UMAX)
	for _, sx in { -1, 1 } do
		Kit.ellipsoid(m, HF * CFrame.new(sx * a * UMAX, ey, 0), Vector3.new(1.2, 2 * bR * sEnd + 1, 2 * c * sEnd + 1), DOME_C, Enum.Material.Neon, { name = "DomeCap", shadow = false, glow = true, dayMaterial = Enum.Material.Glass, dayColor = P.GlassBlue })
	end
	-- 아치 리브(약 8 m 간격) + 용마루: 패널을 안팎으로 1 stud 씩 관통하는 띠 → 밖과 안 모두에서 빛나는 선
	local ribO: PartOpts = { name = "DomeRib", material = Enum.Material.Neon, color = DOME_RIB_C, collide = false, query = false, shadow = false, glow = true, dayMaterial = Enum.Material.Metal, dayColor = P.MullionLight }
	local function seg(q0: Vector3, q1: Vector3)
		local mid = (q0 + q1) / 2
		Kit.part(m, HF * CFrame.lookAt(mid, q1, nrmAt(mid)), Vector3.new(m2s(0.7), 2.0, (q1 - q0).Magnitude + 0.8), ribO)
	end
	local nR = 15
	for i = 1, nR do
		local u = -1 + 2 * i / (nR + 1)
		for j = 0, NT - 1 do
			seg(pt(u, math.pi * j / NT), pt(u, math.pi * (j + 1) / NT))
		end
	end
	for i = 1, NU do
		seg(pt(us[i], math.pi / 2), pt(us[i + 1], math.pi / 2))
	end
end

type Block = { name: string, x0: number, x1: number, z0: number, z1: number, h: number, glass: Color3, crown: string, led: Color3? }

local function buildMall(m: Model, rng: Random)
	local mx0, mz0, mx1, mz1 = M.Min.X, M.Min.Y, M.Max.X, M.Max.Y
	local e = m2s(4) -- 블록 사이/가장자리 여유 4 m
	local blocks: { Block } = {
		-- 서쪽 백화점 블록 65 × 42 m, 9층 40 m
		{ name = "MallWest", x0 = mx0 + 2 * e, x1 = mx0 + m2s(72), z0 = mz0 + e, z1 = mz0 + m2s(46), h = m2s(40), glass = P.GlassBlue, crown = "led", led = scale(P.LedGold, 0.8) },
		-- 중앙 쇼핑몰 블록 65 × 36 m, 8층 35 m
		{ name = "MallMid", x0 = mx0 + m2s(80), x1 = mx0 + m2s(145), z0 = mz0 + e, z1 = mz0 + m2s(40), h = m2s(35), glass = P.GlassDeep, crown = "flat" },
		-- 동쪽 블록 51 × 76 m, 12층 50 m
		{ name = "MallEast", x0 = mx1 - m2s(55), x1 = mx1 - e, z0 = mz0 + e, z1 = mz0 + m2s(80), h = m2s(50), glass = P.GlassTeal, crown = "led", led = scale(P.LedCyan, 0.7) },
		-- 동쪽 앞 파빌리온 45 × 27 m, 4층 18 m
		{ name = "Pavilion", x0 = mx1 - m2s(55), x1 = mx1 - m2s(10), z0 = mz1 - m2s(31), z1 = mz1 - e, h = m2s(18), glass = P.GlassSilver, crown = "flat" },
	}
	for _, b in blocks do
		Facade.tower(m, {
			name = b.name,
			style = "curtain",
			cf = CFrame.new((b.x0 + b.x1) / 2, CITY_Y, (b.z0 + b.z1) / 2),
			w = b.x1 - b.x0,
			d = b.z1 - b.z0,
			h = b.h,
			rng = rng,
			floorH = m2s(4.6), -- 상업시설 층고
			bay = m2s(4.2),
			glass = b.glass,
			lit = MALL_LIT,
			litChance = 0.7,
			crown = b.crown,
			ledColor = b.led,
			beacon = false,
		})
	end
	-- 곡면 지붕 홀 (사진: 타워 오른쪽 발치의 파랗게 빛나는 둥근 지붕). 벽 17 m + 지붕 10 m = 27 m.
	local hx0, hx1, hz0, hz1 = mx0 + m2s(13), mx0 + m2s(140), mz1 - m2s(67), mz1 - m2s(13)
	local hh = m2s(17)
	local hcx, hcz = (hx0 + hx1) / 2, (hz0 + hz1) / 2
	local hw, hd = hx1 - hx0, hz1 - hz0
	-- 홀 외피(Facade 커튼월과 같은 층 띠/멀리언/불빛) + 속을 비운 갤러리아 + 정면 입구, 다면 타원 돔(안에서도 보이는 파란 볼트)
	local HF = CFrame.new(hcx, CITY_Y, hcz)
	local hall = buildHall(Kit.group(m, "Hall"), rng, HF, hw, hd, hh)
	buildDome(Kit.group(m, "HallRoof"), HF, (hw - m2s(5)) / 2, m2s(10), (hd - m2s(7)) / 2, hh + 0.8)
	-- 홀 정면 출입구: 30 m × 9 m 캐노피 + 빛 띠 + 광원
	canopy(m, CFrame.new(hcx, CITY_Y + PAVE_UP, hz1 - 1), m2s(30), m2s(9), true, true)
	-- 동쪽 블록 출입구 (MallEast 앞면, 파빌리온과의 사이 통로 쪽)
	local eb = blocks[3]
	local ex = (eb.x0 + eb.x1) / 2
	canopy(m, CFrame.new(ex, CITY_Y + PAVE_UP, eb.z1 - 1), m2s(20), m2s(7), false, true)
	return hcx, hcz, ex, (eb.z0 + eb.z1) / 2, hall
end

------------------------------------------------------------------------------------------------------
-- 광장
------------------------------------------------------------------------------------------------------
-- 나무: H = 전체 높이(stud). 줄기 지름 0.35 m, 수관 폭 ≈ 0.6 H (8~12 m 나무 → 5~7 m 수관)
local function tree(m: Model, rng: Random, pos: Vector3, H: number)
	local cw = H * rng:NextNumber(0.55, 0.65)
	local th = H * 0.36
	Kit.part(m, CFrame.new(pos + Vector3.new(0, th / 2, 0)) * CYL_UP, Vector3.new(th + cw * 0.2, m2s(0.35), m2s(0.35)), { name = "Trunk", shape = "Cylinder", material = Enum.Material.Wood, color = P.Bark, collide = true, shadow = false })
	local leaf = ({ P.Leaf1, P.Leaf2, P.Leaf3 })[rng:NextInteger(1, 3)]
	local c0 = pos + Vector3.new(0, th + cw * 0.4, 0)
	Kit.ellipsoid(m, CFrame.new(c0), Vector3.new(cw, cw * 0.82, cw), leaf, Enum.Material.Grass, { name = "Crown", query = false })
	Kit.ellipsoid(m, CFrame.new(c0 + Vector3.new(rng:NextNumber(-0.2, 0.2) * cw, cw * 0.3, rng:NextNumber(-0.2, 0.2) * cw)), Vector3.new(cw * 0.66, cw * 0.6, cw * 0.66), scale(leaf, 1.12), Enum.Material.Grass, { name = "Crown", query = false })
end

local function treeH(rng: Random): number
	return m2s(rng:NextNumber(8, 12))
end

-- 7 m 광장 가로등: 기둥 + 등기구
local function lamp(m: Model, pos: Vector3, real: boolean)
	Kit.part(m, CFrame.new(pos + Vector3.new(0, LAMP_H / 2, 0)) * CYL_UP, Vector3.new(LAMP_H, m2s(0.18), m2s(0.18)), { name = "LampPole", shape = "Cylinder", material = Enum.Material.Metal, color = P.Mullion, collide = true })
	local head = Kit.ball(m, pos + Vector3.new(0, LAMP_H + m2s(0.25), 0), m2s(0.6), P.LampWarm, Enum.Material.Neon, { name = "LampHead", collide = false, query = false, glow = true, dayMaterial = Enum.Material.Glass, dayColor = P.LampWhite })
	if real then
		Kit.light(head, "PointLight", { color = P.LampWarm, brightness = 1.3, range = 45 })
	end
end

local function buildPlaza(m: Model, rng: Random, TF: CFrame, px0: number, pz0: number, px1: number, pz1: number)
	local TC = T.Center
	local mx0, mz0, mx1, mz1 = M.Min.X, M.Min.Y, M.Max.X, M.Max.Y
	local top = CITY_Y + PAVE_UP -- 포장 윗면 (도시 지면보다 0.4 높음 → 겹치는 면 없음)
	local bot = CITY_Y - 10
	local function pave(x0: number, z0: number, x1: number, z1: number, c: Color3, mat: Enum.Material)
		Kit.box(m, CFrame.new((x0 + x1) / 2, (top + bot) / 2, (z0 + z1) / 2), Vector3.new(x1 - x0, top - bot, z1 - z0), c, mat, { name = "Paving", collide = true })
	end
	-- 서로 겹치지 않는 3장: 타워 광장(뒤) / 타워 광장(앞) / 몰 포디움
	pave(px0, pz0, px1, mz0, PAVE_C, Enum.Material.Slate)
	pave(px0, mz0, mx0, pz1, PAVE_C, Enum.Material.Slate)
	pave(mx0, mz0, mx1, mz1, rgb(108, 108, 110), Enum.Material.Concrete)
	-- 타워 둘레: 밝은 돌띠(바깥, 2 m) + 바닥 조명 띠(안쪽, 0.6 m) — 포장보다 0.3 위. 모서리가 겹치지 않게 짝/홀 면 길이를 다르게.
	local function ring(side: number, wdt: number, c: Color3, neon: boolean)
		for f = 0, 3 do
			local FR = TF * CFrame.Angles(0, f * math.pi / 2, 0)
			local o: PartOpts = if neon
				then { name = "GroundLight", material = Enum.Material.Neon, color = c, collide = false, query = false, glow = true, dayMaterial = Enum.Material.Slate, dayColor = P.ConcreteLight }
				else { name = "StoneBand", material = Enum.Material.Slate, color = c, collide = false, query = false, shadow = false }
			local len = if f % 2 == 0 then side + wdt else side - wdt
			Kit.part(m, FR * CFrame.new(0, PAVE_UP, side / 2), Vector3.new(len, 0.6, wdt), o)
		end
	end
	local bandSide = T.BaseWidth + m2s(25)
	ring(bandSide, m2s(2), P.ConcreteLight, false)
	ring(T.BaseWidth + m2s(15), m2s(0.6), scale(P.WindowWarm, 0.7), true)
	-- 가로등: 돌띠 안쪽 모서리 4 + 면 중앙 바깥 4 (+ 몰 앞 4)
	local diag = bandSide / 2 * math.sqrt(2)
	for i = 0, 3 do
		local a = i * math.pi / 2
		local pc = (TF * CFrame.Angles(0, a + math.pi / 4, 0) * CFrame.new(0, PAVE_UP, diag - m2s(2.2))).Position
		lamp(m, pc, i == 1 or i == 2)
		local pf = (TF * CFrame.Angles(0, a, 0) * CFrame.new(m2s(16), PAVE_UP, bandSide / 2 + m2s(4.5))).Position
		lamp(m, pf, false)
	end
	-- 몰 앞(홀 캐노피 구간은 비움)
	for i, x in { mx0 + m2s(15), mx0 + m2s(50), mx0 + m2s(105), mx0 + m2s(135) } do
		lamp(m, Vector3.new(x, top, mz1 - m2s(6)), i == 1 or i == 4)
	end
	-- 화단(앞 광장): 10 m × 3 m, 높이 0.55 m 턱 + 관목
	local fx0, fx1 = px0 + m2s(15), mx0 - m2s(10)
	local nPl = 5
	for i = 0, nPl - 1 do
		local x = fx0 + (fx1 - fx0) * (i + 0.5) / nPl
		local z = pz1 - m2s(13)
		Kit.box(m, CFrame.new(x, top + PLANTER_H / 2, z), Vector3.new(m2s(10), PLANTER_H, m2s(3)), P.ConcreteGrey, Enum.Material.Concrete, { name = "Planter", collide = true })
		Kit.ellipsoid(m, CFrame.new(x, top + PLANTER_H, z), Vector3.new(m2s(9.4), m2s(1.6), m2s(2.5)), P.GrassDark, Enum.Material.Grass, { name = "Shrub", query = false })
	end
	-- 나무 (8~12 m): 앞 광장 가로수 1열(≈ 12 m 간격) + 2열 + 몰 앞 + 타워 오른쪽 뒤
	local nFront = math.max(2, math.floor((mx0 - px0 - m2s(24)) / m2s(12)))
	for i = 0, nFront do
		local x = px0 + m2s(12) + i * ((mx0 - px0 - m2s(24)) / nFront) + rng:NextNumber(-2, 2)
		tree(m, rng, Vector3.new(x, top, pz1 - m2s(4) + rng:NextNumber(-1, 1)), treeH(rng))
	end
	for i = 0, 3 do
		local x = px0 + m2s(20) + i * m2s(30) + rng:NextNumber(-4, 4)
		tree(m, rng, Vector3.new(x, top, pz1 - m2s(26) + rng:NextNumber(-3, 3)), treeH(rng))
	end
	for _, x in { mx0 + m2s(24), mx0 + m2s(36), mx0 + m2s(115), mx0 + m2s(126) } do
		tree(m, rng, Vector3.new(x + rng:NextNumber(-3, 3), top, mz1 - m2s(3.5)), treeH(rng))
	end
	for i = 0, 4 do
		tree(m, rng, Vector3.new(px1 - m2s(7), top, TC.Z - m2s(12) - i * m2s(24) + rng:NextNumber(-6, 6)), treeH(rng))
	end
end

------------------------------------------------------------------------------------------------------
-- 수면 반사: 카메라(히어로)–광원 시선을 따라 기울인 스트릭 → 화면에서 수직으로 보임
------------------------------------------------------------------------------------------------------
local REFL_Y = Config.Level.Water + 0.7 -- Kit.reflection(수면 +0.3) 위 0.4 → 겹치는 면 없음

local function streak(m: Model, objX: number, objZ: number, z0: number, z1: number, width: number, c: Color3, tr: number, yOff: number)
	local cam = Config.Viewpoint.ReflectionEye
	local k = (objX - cam.X) / (objZ - cam.Z)
	local zc = (z0 + z1) / 2
	local xc = cam.X + (zc - cam.Z) * k
	local len = math.abs(z1 - z0) * math.sqrt(1 + k * k)
	-- 단일 조각(대시 패턴은 buildReflections 가 직접 만듦) — Kit.reflection 과 같은 재질/야간 규약
	Kit.part(m, CFrame.new(xc, REFL_Y + yOff, zc) * CFrame.Angles(0, math.atan(k), 0), Vector3.new(width, 0.12, len), {
		name = "WaterGlint",
		material = Enum.Material.Neon,
		color = c,
		transparency = tr,
		collide = false,
		query = false,
		shadow = false,
		glow = true,
		dayMaterial = Enum.Material.Glass,
		dayColor = Color3.fromRGB(40, 60, 80),
	})
end

local function buildReflections(m: Model, rng: Random, hallX: number, hallZ: number, eastX: number, eastZ: number)
	local TC = T.Center
	local HW = Config.River.HalfWidth
	local zStart = Config.FarBank.WaterEdge + 10
	-- 타워: 끊어진 금빛 대시(물결) + 가운데 가는 밝은 줄(솔기) — 서로 0.35 높이차, 대시끼리는 간격
	local z = zStart
	local zEnd = HW * 0.36 -- 먼 쪽 절반은 진하게, 가까운 쪽으로 갈수록 옅어지는 꼬리
	while z < zEnd do
		local f = (z - zStart) / (zEnd - zStart)
		local len = rng:NextNumber(30, 57)
		local z1 = math.min(z + len, zEnd)
		local w = (80 - 30 * f) * rng:NextNumber(0.7, 1.15)
		local c = if rng:NextNumber() < 0.5 then P.WindowGold else P.WindowWarm
		streak(m, TC.X, TC.Z, z, z1, w, scale(c, rng:NextNumber(0.8, 1)), 0.6 + 0.24 * f + rng:NextNumber(0, 0.06), 0)
		z = z1 + rng:NextNumber(0.8, 4.2) -- 거의 이어진 기둥(물결 가장자리는 폭 변화로)
	end
	streak(m, TC.X, TC.Z, zStart + 7, -HW * 0.29, 10, P.WindowGold, 0.55, 0.35)
	-- 몰: 파란 돔 + 동쪽 블록(따뜻한 빛)
	streak(m, hallX, hallZ, zStart, zStart + 200, 50, P.LedBlue, 0.7, 0)
	streak(m, hallX, hallZ, zStart + 217, zStart + 350, 37, P.LedBlue, 0.78, 0)
	streak(m, eastX, eastZ, zStart, zStart + 250, 30, P.WindowWarm, 0.72, 0)
end

------------------------------------------------------------------------------------------------------
-- 진입점
------------------------------------------------------------------------------------------------------
function Landmark.build(ctx: any)
	local rng: Random = ctx.rng
	local root: Model = ctx.model
	local TC = T.Center
	local TF = CFrame.new(TC.X, CITY_Y, TC.Z) * CFrame.Angles(0, math.rad(T.Yaw), 0)

	-- 발자국 예약: 타워(+기단/캐노피 여유 15 m) / 광장(타워 중심 ±110 m, 몰 앞 60 m) / 몰
	local px0, px1 = TC.X - m2s(110), Config.Zones.SkylineMid.XMin
	local pz0, pz1 = TC.Z - m2s(110), M.Min.Y + m2s(60)
	Kit.reserveRect(TC.X, TC.Z, T.BaseWidth + m2s(30), T.BaseWidth + m2s(30), T.Yaw, "LandmarkTower")
	Kit.reserve(px0, pz0, px1, pz1, "LandmarkPlaza")
	Kit.reserve(M.Min.X, M.Min.Y, M.Max.X, M.Max.Y, "LandmarkMall")

	local tower = Kit.group(root, "Tower")
	local lobby = buildBase(tower, TF)
	local floors, obs = buildShaft(tower, TF, rng)
	local crown = Kit.group(tower, "Crown")
	buildCrown(crown, TF)

	local mall = Kit.group(root, "Mall")
	local hallX, hallZ, eastX, eastZ, hall = buildMall(mall, rng)
	-- 실내 모듈(LandmarkInterior)이 쓰는 배치 정보
	Landmark.layout = { TF = TF, lobby = lobby, obs = obs, hall = hall }

	local plaza = Kit.group(root, "Plaza")
	buildPlaza(plaza, rng, TF, px0, pz0, px1, pz1)

	local refl = Kit.group(root, "Reflections")
	buildReflections(refl, rng, hallX, hallZ, eastX, eastZ)

	local total = T.Height + T.CrownHeight + T.SpireHeight
	tower:SetAttribute("Height", total)
	tower:SetAttribute("HeightMeters", total * Config.METERS_PER_STUD)
	tower:SetAttribute("Floors", floors + 2 + CROWN_TIERS * 3) -- 로비 2 + 오피스/호텔 + 크라운 전망층
end

return Landmark
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000000000000000000000000000009"><Properties><string name="Name">LandmarkInterior</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / LandmarkInterior
-- 롯데월드타워 모티브 타워 + 몰의 "걸어 들어가는" 실내 (Landmark 바로 다음에 빌드, Landmark.layout 을 읽음).
-- 실제 스케일 1 stud = 0.3 m. 모든 치수는 Config.m(미터) / Config.Real.
--
--   1) 타워 로비 (지상, 강 쪽 +Z 로컬 면 가운데): 32 × 25 m, 천장 12.6 m 대리석 2개 층 높이 홀.
--      자동 미닫이문 2곳(유효 2.4 × 2.7 m) + 방풍실, 안내 데스크(1.1 m), 보안 게이트 7대(차선 1.1 m), 라운지 2조,
--      미디어 아트 월(28 × 6 m Neon 타일), 실내 나무 4 그루, 한/영 안내 사인, 엘리베이터 알코브(8.4 × 10 m, 천장 4.2 m):
--      양쪽 3대씩 + 끝벽 서울스카이 직행 셔틀(호출 버튼 = 태그 SeoulElevator → 전망대).
--   2) 서울스카이 전망대 (본체 꼭대기 유리 띠): 118F 전망 홀(천장 ≈ 8.6 m) — 광택 바닥, 스카이데크 유리 바닥(7.2 × 3.6 m,
--      빛나는 무한 거울 구덩이 아래 "500 m 아래 야경"), 파노라마 벤치, 망원경, 카페 카운터 + 메뉴판, 기념품숍,
--      반환 엘리베이터 / 123F 스카이 라운지(바 + 라운지 의자)로 가는 엘리베이터.
--      천장·바닥·코어(밖에서 보이는 밝은 유리 띠의 내용)는 Persistent 그룹 → 원경에서도 띠가 밝게 읽힘.
--   3) 몰 아트리움 (파란 곡면 지붕 홀): 정면 입구 통로(자동문) → 66 × 21.6 m 2개 층 갤러리아.
--      양쪽 2개 층 상점 27곳(진열창 + 한글 간판), 에스컬레이터 한 쌍(보이는 계단 + 숨은 경사로), 유리 난간 메자닌 + 다리 2,
--      앉음 섬(나무 화분), 팝업 키오스크, 행잉 배너, 미디어 스크린, 지붕을 열어 실내에서 보이는 파란 볼트 + 리브.
--   광원 30개 이하(로비 8 · 전망대 9 · 몰 12), 파트 ≈ 2000.

local CollectionService = game:GetService("CollectionService")
local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)
local Landmark = require(script.Parent.Landmark) :: any

local LandmarkInterior = {}

local P = Config.Palette
local Real = Config.Real
local m2s = Config.m
local rgb = Color3.fromRGB
local MAT = Enum.Material
local FRONT = Enum.NormalId.Front
local BACK = Enum.NormalId.Back
local CYL_UP = CFrame.Angles(0, 0, math.rad(90))
type PartOpts = Kit.PartOpts

-- 파트 Front(-Z) 가 로컬 방향을 보게 하는 yaw
local FACE_PZ, FACE_NZ, FACE_PX, FACE_NX = math.pi, 0, -math.pi / 2, math.pi / 2

local SEAT = Real.Seat -- 0.43 m
local TABLE_H = Real.Table -- 0.75 m
local COUNTER = Real.Counter -- 0.9 m

local C = {
	marble = rgb(228, 223, 214),
	marbleWarm = rgb(214, 200, 178),
	granite = rgb(56, 54, 56),
	floorDark = rgb(52, 52, 58),
	travertine = rgb(214, 202, 182),
	plaster = rgb(234, 231, 224),
	walnut = rgb(84, 60, 42),
	oak = rgb(170, 130, 88),
	bronze = rgb(146, 112, 72),
	steel = rgb(196, 198, 202),
	steelDark = rgb(66, 68, 74),
	black = rgb(24, 25, 28),
	white = rgb(240, 240, 236),
	leather = rgb(96, 64, 44),
	fabricGrey = rgb(122, 120, 116),
	fabricBlue = rgb(54, 72, 106),
	fabricSand = rgb(198, 184, 160),
	warmLight = rgb(255, 226, 182),
	coolLight = rgb(224, 236, 255),
	glass = rgb(186, 204, 216),
	textWarm = rgb(255, 236, 204),
	textWhite = rgb(244, 244, 240),
}

------------------------------------------------------------------------------------------------------
-- 공용 헬퍼
------------------------------------------------------------------------------------------------------
local LIGHT_CAP = 30
local lightsUsed = 0

local function light(p: BasePart, kind: string, props: Kit.LightProps)
	if lightsUsed >= LIGHT_CAP then
		return
	end
	if Kit.light(p, kind, props) then
		lightsUsed += 1
	end
end

-- 충돌하는 큰 덩어리(바닥/벽/가구)
local function S(m: Instance, cf: CFrame, size: Vector3, color: Color3, mat: Enum.Material, name: string?, refl: number?): BasePart
	return Kit.part(m, cf, size, { name = name or "Solid", material = mat, color = color, collide = true, reflectance = refl })
end
-- 장식 소품(충돌·쿼리 없음)
local function D(m: Instance, cf: CFrame, size: Vector3, color: Color3, mat: Enum.Material, name: string?, refl: number?): BasePart
	return Kit.part(m, cf, size, { name = name or "Prop", material = mat, color = color, collide = false, query = false, reflectance = refl })
end
-- 발광(밤 Neon / 낮 밝은 무광)
local function N(m: Instance, cf: CFrame, size: Vector3, color: Color3, name: string?, tr: number?): BasePart
	return Kit.part(m, cf, size, {
		name = name or "Lamp",
		material = MAT.Neon,
		color = color,
		transparency = tr,
		collide = false,
		query = false,
		shadow = false,
		glow = true,
		dayMaterial = MAT.SmoothPlastic,
		dayColor = color:Lerp(rgb(236, 236, 232), 0.55),
	})
end
local function G(m: Instance, cf: CFrame, size: Vector3, color: Color3, tr: number, collide: boolean, name: string?): BasePart
	return Kit.part(m, cf, size, { name = name or "Glass", material = MAT.Glass, color = color, transparency = tr, reflectance = 0.05, collide = collide, query = collide, shadow = false })
end
-- 세로 원기둥 (cf 위치 = 중심)
local function VC(m: Instance, cf: CFrame, h: number, d: number, color: Color3, mat: Enum.Material, collide: boolean, name: string?): BasePart
	return Kit.part(m, CFrame.new(cf.Position) * CYL_UP, Vector3.new(h, d, d), { name = name or "Cyl", shape = "Cylinder", material = mat, color = color, collide = collide, query = collide })
end
-- 글자 판(Front 면). glow: 글자가 빛 영향 없이 밝음
local function sign(m: Instance, cf: CFrame, size: Vector3, bg: Color3, bgMat: Enum.Material, text: string, tc: Color3?, ppS: number?): BasePart
	local p = Kit.part(m, cf, size, { name = "Sign", material = bgMat, color = bg, collide = false, query = false, shadow = false })
	if bgMat == MAT.Neon then
		Kit.glow(p, MAT.SmoothPlastic, bg)
	end
	Kit.label(p, FRONT, text, { color = tc or C.textWhite, glow = true, pixelsPerStud = ppS or 24, maxDistance = 500, font = Enum.Font.GothamBold })
	return p
end

-- 엘리베이터 호출 버튼(SeoulSkylineBoot 가 ElevatorTarget 으로 순간 이동)
local function elevatorButton(m: Instance, cf: CFrame, target: Vector3, action: string, object: string): BasePart
	local b = Kit.part(m, cf, Vector3.new(0.55, 0.55, 0.16), {
		name = "ElevatorCall",
		material = MAT.Neon,
		color = rgb(150, 214, 255),
		collide = false,
		query = true,
		shadow = false,
		glow = true,
		dayMaterial = MAT.SmoothPlastic,
		dayColor = rgb(206, 214, 222),
	})
	b:SetAttribute("ElevatorTarget", target)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "ElevatorPrompt"
	pp.ActionText = action
	pp.ObjectText = object
	pp.HoldDuration = 0.25
	pp.MaxActivationDistance = 8
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.Parent = b
	CollectionService:AddTag(b, "SeoulElevator")
	return b
end

------------------------------------------------------------------------------------------------------
-- 가구 (cf = 바닥 위 발자국 중심, 로컬 -Z = 정면(앉은 사람이 보는 쪽))
------------------------------------------------------------------------------------------------------
-- 소파: 좌면 0.43 m, 깊이 0.9 m, 등받이 0.8 m
local function sofa(m: Instance, cf: CFrame, len: number, col: Color3, pillow: Color3?)
	S(m, cf * CFrame.new(0, 0.5, 0), Vector3.new(len, 1.0, 3.0), col:Lerp(C.black, 0.45), MAT.Fabric, "SofaBase")
	D(m, cf * CFrame.new(0, SEAT - 0.21, -0.2), Vector3.new(len - 1.52, 0.42, 2.5), col, MAT.Fabric, "Cushion")
	S(m, cf * CFrame.new(0, 1.85, 1.15), Vector3.new(len, 1.7, 0.7), col, MAT.Fabric, "SofaBack")
	for _, sx in { -1, 1 } do
		S(m, cf * CFrame.new(sx * (len / 2 - 0.37), 1.5, -0.05), Vector3.new(0.74, 1.0, 2.9), col, MAT.Fabric, "SofaArm")
	end
	if pillow then
		D(m, cf * CFrame.new(-len / 2 + 1.6, 2.0, 0.55) * CFrame.Angles(math.rad(-14), 0, math.rad(9)), Vector3.new(1.4, 1.25, 0.36), pillow, MAT.Fabric, "Pillow")
	end
end

-- 라운지/카페 의자(좌면 0.43 m)
local function chair(m: Instance, cf: CFrame, col: Color3, mat: Enum.Material?)
	local mt = mat or MAT.Wood
	S(m, cf * CFrame.new(0, SEAT - 0.07, 0), Vector3.new(1.45, 0.14, 1.45), col, mt, "ChairSeat")
	D(m, cf * CFrame.new(0, SEAT + 0.95, 0.66), Vector3.new(1.45, 1.6, 0.12), col, mt, "ChairBack")
	for _, sx in { -1, 1 } do
		D(m, cf * CFrame.new(sx * 0.62, (SEAT - 0.14) / 2, 0), Vector3.new(0.1, SEAT - 0.14, 1.3), C.black, MAT.Metal, "ChairLeg")
	end
end

-- 둥근 테이블(높이 h, 지름 dia)
local function roundTable(m: Instance, cf: CFrame, dia: number, h: number, top: Color3, topMat: Enum.Material)
	VC(m, cf * CFrame.new(0, 0.08, 0), 0.16, dia * 0.55, C.black, MAT.Metal, true, "TableFoot")
	VC(m, cf * CFrame.new(0, h / 2, 0), h - 0.2, 0.3, C.black, MAT.Metal, true, "TableStem")
	VC(m, cf * CFrame.new(0, h - 0.07, 0), 0.14, dia, top, topMat, true, "TableTop")
end

-- 등받이 없는 가죽 벤치(좌면 0.43 m, 폭 0.6 m)
local function bench(m: Instance, cf: CFrame, len: number, col: Color3)
	S(m, cf * CFrame.new(0, 0.5, 0), Vector3.new(len - 0.8, 1.0, 1.3), C.black, MAT.Metal, "BenchBase")
	S(m, cf * CFrame.new(0, SEAT - 0.21, 0), Vector3.new(len, 0.42, 2.0), col, MAT.Leather, "BenchSeat")
end

-- 화분 + 나무(실내): potD 지름, potH 높이, treeH 나무 높이
local function treePlanter(m: Instance, cf: CFrame, potD: number, potH: number, treeH: number, rng: Random, potCol: Color3, potMat: Enum.Material)
	VC(m, cf * CFrame.new(0, potH / 2, 0), potH, potD, potCol, potMat, true, "Planter")
	VC(m, cf * CFrame.new(0, potH + 0.02, 0), 0.1, potD - 0.7, P.Soil, MAT.Ground, false, "Soil")
	VC(m, cf * CFrame.new(0, potH + treeH * 0.32, 0), treeH * 0.64, math.max(0.55, treeH * 0.026), P.Bark, MAT.Wood, true, "Trunk")
	local leaves = { P.Leaf2, P.Leaf3, P.Leaf1 }
	for k = 1, 3 do
		local cw = treeH * rng:NextNumber(0.3, 0.4)
		local off = Vector3.new(rng:NextNumber(-0.1, 0.1) * treeH, potH + treeH * (0.55 + 0.13 * k) - cw * 0.15, rng:NextNumber(-0.1, 0.1) * treeH)
		Kit.ellipsoid(m, cf * CFrame.new(off), Vector3.new(cw, cw * 0.78, cw), leaves[k], MAT.Grass, { name = "Foliage", query = false })
	end
end

-- 작은 화분(관엽식물)
local function pottedPlant(m: Instance, cf: CFrame, h: number, potCol: Color3)
	VC(m, cf * CFrame.new(0, h * 0.18, 0), h * 0.36, h * 0.32, potCol, MAT.Concrete, true, "Pot")
	Kit.ellipsoid(m, cf * CFrame.new(0, h * 0.62, 0), Vector3.new(h * 0.5, h * 0.62, h * 0.5), P.Leaf2, MAT.Grass, { name = "Plant", query = false })
end

-- 동전 망원경(접안부 ≈ 1.45 m), 로컬 -Z = 보는 방향
local function telescope(m: Instance, cf: CFrame)
	VC(m, cf * CFrame.new(0, 0.1, 0), 0.2, 2.0, C.steelDark, MAT.Metal, true, "ScopeFoot")
	VC(m, cf * CFrame.new(0, 2.1, 0), 4.0, 0.6, C.steelDark, MAT.Metal, true, "ScopePost")
	D(m, cf * CFrame.new(0, 3.1, 0.38), Vector3.new(0.75, 1.0, 0.36), rgb(40, 96, 168), MAT.Metal, "CoinBox", 0.1)
	local head = cf * CFrame.new(0, 4.75, 0) * CFrame.Angles(math.rad(-5), 0, 0)
	S(m, head, Vector3.new(2.1, 1.05, 1.8), rgb(40, 96, 168), MAT.Metal, "ScopeHead", 0.15)
	for _, sx in { -0.52, 0.52 } do
		D(m, head * CFrame.new(sx, 0.05, -1.0) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(0.3, 0.72, 0.72), rgb(30, 40, 52), MAT.Glass, "ScopeLens", 0.3)
		D(m, head * CFrame.new(sx * 1.05, 0.12, 1.02) * CFrame.Angles(0, math.pi / 2, 0), Vector3.new(0.36, 0.38, 0.38), C.black, MAT.Rubber, "Eyepiece")
	end
end

-- 엘리베이터 문(벽면 위 cf, 로컬 -Z = 복도 쪽): 스테인리스 문틀 + 미닫이 두 짝 + 홀 랜턴 + 층 표시
local function elevatorDoor(m: Instance, cf: CFrame, dw: number, dh: number, floorTxt: string)
	D(m, cf * CFrame.new(0, (dh + 0.7) / 2, -0.15), Vector3.new(dw + 1.2, dh + 0.7, 0.3), C.steel, MAT.Metal, "DoorFrame", 0.25)
	for _, sx in { -1, 1 } do
		S(m, cf * CFrame.new(sx * (dw / 4 + 0.02), dh / 2, -0.42), Vector3.new(dw / 2 - 0.04, dh, 0.2), rgb(182, 184, 188), MAT.Metal, "DoorLeaf", 0.35)
	end
	N(m, cf * CFrame.new(0, dh + 1.25, -0.34), Vector3.new(1.4, 0.42, 0.06), rgb(255, 238, 206), "HallLantern")
	sign(m, cf * CFrame.new(0, dh + 2.15, -0.36), Vector3.new(1.7, 0.85, 0.1), C.black, MAT.Glass, floorTxt, rgb(255, 140, 70), 40)
end

-- 호출 패널(▲▼ 버튼 장식)
local function callPanel(m: Instance, cf: CFrame)
	D(m, cf * CFrame.new(0, 3.7, -0.07), Vector3.new(0.6, 1.3, 0.14), C.steel, MAT.Metal, "CallPanel", 0.25)
	N(m, cf * CFrame.new(0, 3.95, -0.16), Vector3.new(0.22, 0.22, 0.05), rgb(255, 230, 190), "CallUp")
	N(m, cf * CFrame.new(0, 3.45, -0.16), Vector3.new(0.22, 0.22, 0.05), rgb(255, 230, 190), "CallDown")
end

-- 차단봉(스탠션): 기둥 사이 벨트
local function stanchions(m: Instance, pts: { CFrame }, belt: Color3)
	for i, cf in pts do
		VC(m, cf * CFrame.new(0, 0.08, 0), 0.16, 1.2, C.steel, MAT.Metal, false, "StanchionBase")
		VC(m, cf * CFrame.new(0, 1.6, 0), 3.1, 0.22, C.steel, MAT.Metal, true, "Stanchion")
		if i > 1 then
			local a, b = pts[i - 1].Position + Vector3.new(0, 2.95, 0), cf.Position + Vector3.new(0, 2.95, 0)
			D(m, CFrame.lookAt((a + b) / 2, b), Vector3.new(0.06, 0.24, (b - a).Magnitude), belt, MAT.Fabric, "Belt")
		end
	end
end

------------------------------------------------------------------------------------------------------
-- 1) 타워 로비
------------------------------------------------------------------------------------------------------
local ART = { rgb(34, 48, 140), rgb(96, 58, 178), rgb(196, 74, 160), rgb(244, 118, 84), rgb(250, 190, 100) }
local function artColor(t: number): Color3
	local x = math.clamp(t, 0, 0.999) * (#ART - 1)
	local i = math.floor(x)
	return ART[i + 1]:Lerp(ART[i + 2], x - i)
end

local function buildLobby(m: Model, TF: CFrame, Lb: any, obsTarget: Vector3, rng: Random)
	local W, HX, ZB, AX, AZ0 = Lb.W, Lb.HX, Lb.ZB, Lb.AX, Lb.AZ0
	local FY, CY = Lb.floorY, Lb.ceilY
	local gIn = Lb.glassZ - 0.2 -- 정면 유리 안쪽 면
	local AH = FY + m2s(4.2) -- 알코브 천장
	local cyB = CY - 1.4 -- 홀 천장 아랫면 (바닥에서 12.6 m)
	local function at(x: number, y: number, z: number, yaw: number?): CFrame
		return TF * CFrame.new(x, y, z) * CFrame.Angles(0, yaw or 0, 0)
	end

	-- 바닥: 밝은 대리석 + 화강석 런너/테두리 + 가운데 원형 메달리온, 알코브는 어두운 화강석
	S(m, at(0, FY - 0.25, (ZB + W + 0.4) / 2), Vector3.new(2 * HX, 0.5, W + 0.4 - ZB), C.marble, MAT.Marble, "LobbyFloor", 0.08)
	S(m, at(0, FY - 0.25, (AZ0 + ZB) / 2), Vector3.new(2 * AX, 0.5, ZB - AZ0), C.granite, MAT.Granite, "AlcoveFloor", 0.12)
	local function inlay(x0: number, x1: number, z0: number, z1: number, c: Color3)
		D(m, at((x0 + x1) / 2, FY - 0.125, (z0 + z1) / 2), Vector3.new(x1 - x0, 0.35, z1 - z0), c, MAT.Granite, "Inlay", 0.1)
	end
	local bz0, bz1, bx = ZB + 9, gIn - 15, HX - 5
	inlay(-5, 5, bz0, bz1, C.granite)
	inlay(-bx, -bx + 0.8, bz0, bz1, C.granite)
	inlay(bx - 0.8, bx, bz0, bz1, C.granite)
	inlay(-bx, bx, bz0, bz0 + 0.8, C.granite)
	inlay(-bx, bx, bz1 - 0.8, bz1, C.granite)
	local medZ = (bz0 + bz1) / 2 + 4
	VC(m, at(0, FY - 0.1, medZ), 0.36, 15, rgb(170, 140, 98), MAT.Marble, false, "Medallion")
	VC(m, at(0, FY - 0.06, medZ), 0.36, 9, C.granite, MAT.Granite, false, "MedallionCore")

	-- 벽: 트래버틴 마감(Neon 덩어리 속으로 0.4 겹침) + 청동 세로 리빌 + 걸레받이
	local wallTop = CY - 0.9
	local wh = wallTop - FY + 0.3
	local wy = (FY - 0.3 + wallTop) / 2
	for _, sx in { -1, 1 } do
		S(m, at(sx * (HX + 0.1), wy, (ZB + gIn - 0.1) / 2), Vector3.new(1.0, wh, gIn - 0.1 - ZB), C.travertine, MAT.Limestone, "WallClad")
		for k = 1, 5 do
			local z = ZB + (gIn - ZB) * k / 6
			D(m, at(sx * (HX - 0.45), wy, z), Vector3.new(0.12, wh, 0.3), C.bronze, MAT.Metal, "Reveal", 0.2)
		end
		D(m, at(sx * (HX - 0.47), FY + 0.25, (ZB + gIn) / 2), Vector3.new(0.16, 0.5, gIn - ZB - 1.2), C.bronze, MAT.Metal, "Skirting")
	end
	for _, sx in { -1, 1 } do
		S(m, at(sx * (HX + AX) / 2, wy, ZB + 0.1), Vector3.new(HX - AX, wh, 1.0), C.travertine, MAT.Limestone, "BackClad")
		D(m, at(sx * (HX + AX) / 2, FY + 0.25, ZB + 0.67), Vector3.new(HX - AX - 1.0, 0.5, 0.16), C.bronze, MAT.Metal, "Skirting")
	end
	S(m, at(0, (AH + wallTop) / 2, ZB + 0.1), Vector3.new(2 * AX, wallTop - AH, 1.0), C.travertine, MAT.Limestone, "BackClad")

	-- 천장(12.6 m): 석고 + 가로 선형 조명 6줄 (3줄은 실제 SurfaceLight)
	D(m, at(0, cyB + 0.3, (ZB + gIn) / 2), Vector3.new(2 * HX, 0.6, gIn - ZB), C.plaster, MAT.Plaster, "Ceiling")
	for k = 0, 5 do
		local z = ZB + 8 + (gIn - ZB - 16) * k / 5
		local s = N(m, at(0, cyB - 0.05, z), Vector3.new(2 * HX - 10, 0.12, 0.8), rgb(255, 238, 212), "CeilingSlot")
		if k % 2 == 1 then
			light(s, "SurfaceLight", { color = rgb(255, 232, 200), brightness = 1.6, range = 52, angle = 120, face = Enum.NormalId.Bottom })
		end
	end

	-- 엘리베이터 알코브: 어두운 화강석 벽, 청동 포털, 낮은 천장(4.2 m) + 조명 3줄
	for _, sx in { -1, 1 } do
		S(m, at(sx * (AX - 0.1), (FY - 0.3 + AH + 0.5) / 2, (AZ0 + ZB) / 2), Vector3.new(1.0, AH + 0.8 - FY, ZB - AZ0), C.granite, MAT.Granite, "AlcoveWall", 0.12)
		D(m, at(sx * (AX - 0.67), FY + 0.25, (AZ0 + ZB) / 2), Vector3.new(0.16, 0.5, ZB - AZ0 - 1.2), C.bronze, MAT.Metal, "Skirting")
		S(m, at(sx * (AX - 0.2), (FY - 0.3 + AH + 1.0) / 2, ZB + 0.2), Vector3.new(1.2, AH + 1.3 - FY, 1.6), C.bronze, MAT.Metal, "PortalJamb", 0.2)
	end
	S(m, at(0, (FY - 0.3 + AH + 0.5) / 2, AZ0 + 0.1), Vector3.new(2 * AX, AH + 0.8 - FY, 1.0), C.granite, MAT.Granite, "AlcoveEnd", 0.12)
	S(m, at(0, AH + 0.4, ZB + 0.2), Vector3.new(2 * AX + 1.2, 1.2, 1.6), C.bronze, MAT.Metal, "PortalLintel", 0.2)
	D(m, at(0, AH + 0.3, (AZ0 + ZB - 0.6) / 2), Vector3.new(2 * AX, 0.6, ZB - 0.6 - AZ0), C.plaster, MAT.Plaster, "AlcoveCeiling")
	local alcLamp: BasePart? = nil
	for _, x in { -6.5, 0, 6.5 } do
		local s = N(m, at(x, AH - 0.05, (AZ0 + ZB) / 2 - 0.5), Vector3.new(0.5, 0.12, ZB - AZ0 - 5), rgb(236, 242, 255), "AlcoveLight")
		alcLamp = alcLamp or s
	end
	if alcLamp then
		light(alcLamp, "PointLight", { color = rgb(236, 240, 255), brightness = 1.2, range = 26 })
	end
	-- 양쪽 엘리베이터 3대씩 + 호출 패널 + 뱅크 표시
	local edw, edh = m2s(1.1), m2s(2.4)
	local doorZ = { AZ0 + 6.5, AZ0 + 16.5, AZ0 + 26.5 }
	for side, sx in { -1, 1 } do
		local wx = sx * (AX - 0.6)
		local yaw = if sx < 0 then FACE_PX else FACE_NX
		for k, z in doorZ do
			elevatorDoor(m, at(wx, FY, z, yaw), edw, edh, if side == 1 then tostring(14 + k * 2) else tostring(40 + k * 3))
			if k < 3 then
				callPanel(m, at(wx, FY, z + 5, yaw))
			end
		end
		sign(m, at(wx + sx * -0.3, FY + edh + 4.4, (doorZ[1] + doorZ[3]) / 2, yaw), Vector3.new(14, 1.5, 0.1), C.black, MAT.SmoothPlastic, if side == 1 then "14–38F  오피스 OFFICE" else "42–71F  레지던스 RESIDENCE", C.textWarm, 30)
	end
	-- 끝벽: 서울스카이 직행 셔틀(넓은 문 1.5 × 2.6 m) + 백라이트 오닉스 패널 + 사인 + 호출 버튼(→ 전망대)
	local sdw, sdh = m2s(1.5), m2s(2.6)
	local endCF = at(0, FY, AZ0 + 0.6, FACE_PZ)
	elevatorDoor(m, endCF, sdw, sdh, "118")
	for _, sx in { -1, 1 } do
		N(m, endCF * CFrame.new(sx * (sdw / 2 + 5.0), 5.6, -0.12), Vector3.new(4.6, 10.4, 0.2), rgb(156, 112, 66), "OnyxPanel")
	end
	sign(m, endCF * CFrame.new(0, sdh + 3.6, -0.12), Vector3.new(16, 2.2, 0.2), C.black, MAT.SmoothPlastic, "서울스카이 전망대 직행  SEOUL SKY SHUTTLE", C.textWarm, 30)
	D(m, endCF * CFrame.new(sdw / 2 + 1.7, 3.8, -0.08), Vector3.new(1.0, 2.4, 0.16), C.steel, MAT.Metal, "ShuttlePanel", 0.25)
	sign(m, endCF * CFrame.new(sdw / 2 + 1.7, 4.65, -0.18), Vector3.new(0.85, 0.42, 0.04), C.black, MAT.SmoothPlastic, "▲ 118F", rgb(150, 214, 255), 60)
	elevatorButton(m, endCF * CFrame.new(sdw / 2 + 1.7, 3.6, -0.2), obsTarget, "서울스카이로 올라가기", "전망대 엘리베이터")

	-- 보안 게이트(스피드 게이트 7대, 차선 1.1 m) + 알코브 입구 유리 칸막이 + 보안 데스크
	local gz0, gz1 = ZB + 2.2, ZB + 7.2
	local nPed = 7
	for k = 0, nPed - 1 do
		local x = -AX + 0.45 + k * (2 * AX - 0.9) / (nPed - 1)
		S(m, at(x, FY + 1.6, (gz0 + gz1) / 2), Vector3.new(0.85, 3.2, gz1 - gz0), C.steel, MAT.Metal, "GatePedestal", 0.2)
		D(m, at(x, FY + 3.27, (gz0 + gz1) / 2), Vector3.new(0.95, 0.14, gz1 - gz0 + 0.1), C.black, MAT.Glass, "GateTop", 0.3)
		N(m, at(x, FY + 3.36, gz1 - 0.8), Vector3.new(0.34, 0.05, 0.5), rgb(80, 230, 140), "GateArrow")
		D(m, at(x, FY + 3.38, gz1 - 2.1), Vector3.new(0.6, 0.08, 0.8), rgb(36, 38, 44), MAT.SmoothPlastic, "CardReader")
		if k > 0 and k < nPed - 1 then
			for _, sx in { -1, 1 } do
				G(m, at(x + sx * 0.5, FY + 2.2, (gz0 + gz1) / 2 + 0.6), Vector3.new(0.08, 1.4, 1.6), rgb(200, 220, 230), 0.55, false, "GateFlap")
			end
		end
	end
	for _, sx in { -1, 1 } do
		G(m, at(sx * (AX - 0.45), FY + 1.8, (ZB + 0.9 + gz0) / 2), Vector3.new(0.3, 3.6, gz0 - ZB - 0.9), C.glass, 0.55, true, "GateBarrier")
	end
	local secX, secZ = -AX - 6, ZB + 8
	S(m, at(secX, FY + 1.75, secZ), Vector3.new(4.5, 3.5, 2.0), C.walnut, MAT.Wood, "SecurityDesk")
	D(m, at(secX, FY + 3.56, secZ), Vector3.new(4.8, 0.12, 2.3), C.marble, MAT.Marble, "SecurityTop")
	D(m, at(secX + 0.8, FY + 4.3, secZ - 0.5) * CFrame.Angles(math.rad(10), 0, 0), Vector3.new(1.6, 1.0, 0.1), C.black, MAT.SmoothPlastic, "Monitor")
	sign(m, at(secX, FY + 2.6, secZ + 1.06, FACE_PZ), Vector3.new(3.2, 0.7, 0.1), C.bronze, MAT.Metal, "보안 SECURITY", C.textWarm, 40)

	-- 미디어 아트 월(뒷벽 알코브 위, 28 × 6 m): 검은 프레임 + 12 × 5 Neon 타일 "한강의 노을"
	local mx0, mx1 = -HX + 7, HX - 7
	local my0, my1 = AH + 5, CY - 5
	S(m, at(0, (my0 + my1) / 2, ZB + 0.8), Vector3.new(mx1 - mx0 + 1.4, my1 - my0 + 1.4, 0.5), C.black, MAT.SmoothPlastic, "MediaWallFrame")
	local cols, rows = 12, 5
	local cw, rh = (mx1 - mx0) / cols, (my1 - my0) / rows
	for i = 0, cols - 1 do
		for j = 0, rows - 1 do
			local u, v = (i + 0.5) / cols, (j + 0.5) / rows
			local t = 0.12 + 0.45 * (1 - v) + 0.32 * (0.5 + 0.5 * math.sin(u * math.pi * 2.3 + v * 2.6)) + rng:NextNumber(-0.05, 0.05)
			local c = artColor(t)
			N(m, at(mx0 + (i + 0.5) * cw, my0 + (j + 0.5) * rh, ZB + 1.15), Vector3.new(cw - 0.25, rh - 0.25, 0.16), Color3.new(c.R * 0.82, c.G * 0.82, c.B * 0.82), "MediaTile")
		end
	end
	local mwLamp = N(m, at(0, my0 - 1.3, ZB + 1.0), Vector3.new(mx1 - mx0, 0.15, 0.3), rgb(160, 120, 255), "MediaUplight")
	light(mwLamp, "PointLight", { color = rgb(170, 120, 255), brightness = 0.9, range = 34 })
	sign(m, at(0, AH + 3.2, ZB + 0.7, FACE_PZ), Vector3.new(26, 2.2, 0.1), C.black, MAT.SmoothPlastic, "엘리베이터  ELEVATORS   ·   서울스카이  SEOUL SKY", C.textWarm, 30)

	-- 안내 데스크(카운터 1.1 m, 작업면 0.75 m) + 백월 사인 + 모니터/의자 + 소품
	local dX, dZ = -HX + 19, ZB + 40
	D(m, at(dX, FY + 0.3, dZ), Vector3.new(19.4, 0.6, 2.2), C.black, MAT.Metal, "DeskPlinth")
	N(m, at(dX, FY + 0.66, dZ + 1.18), Vector3.new(19.2, 0.1, 0.1), C.warmLight, "DeskGlow")
	S(m, at(dX, FY + 0.6 + 1.43, dZ), Vector3.new(20, 2.86, 2.6), C.marble, MAT.Marble, "ReceptionDesk", 0.08)
	S(m, at(dX, FY + 3.56, dZ + 0.2), Vector3.new(20.4, 0.2, 3.0), C.walnut, MAT.Wood, "DeskTop")
	D(m, at(dX, FY + TABLE_H - 0.08, dZ - 2.1), Vector3.new(19, 0.16, 1.8), C.walnut, MAT.Wood, "WorkTop")
	sign(m, at(dX, FY + 2.2, dZ + 1.36, FACE_PZ), Vector3.new(6.5, 1.0, 0.1), C.bronze, MAT.Metal, "안내  INFORMATION", rgb(255, 238, 206), 40)
	for _, ox in { -5, 5 } do
		D(m, at(dX + ox, FY + 3.0, dZ - 1.9), Vector3.new(0.25, 1.0, 0.25), C.black, MAT.Metal, "MonitorStand")
		D(m, at(dX + ox, FY + 3.95, dZ - 1.95) * CFrame.Angles(math.rad(8), 0, 0), Vector3.new(2.0, 1.2, 0.1), C.black, MAT.SmoothPlastic, "Monitor")
		N(m, at(dX + ox, FY + 3.95, dZ - 2.02) * CFrame.Angles(math.rad(8), 0, 0), Vector3.new(1.8, 1.0, 0.04), rgb(70, 110, 160), "Screen")
		local chairCF = at(dX + ox, FY, dZ - 4.6)
		VC(m, chairCF * CFrame.new(0, 0.9, 0), 1.8, 0.3, C.black, MAT.Metal, false, "ChairPost")
		S(m, chairCF * CFrame.new(0, SEAT + 0.6, 0), Vector3.new(1.6, 0.3, 1.6), C.black, MAT.Leather, "OfficeSeat")
		D(m, chairCF * CFrame.new(0, SEAT + 2.0, -0.75), Vector3.new(1.5, 2.2, 0.25), C.black, MAT.Leather, "OfficeBack")
	end
	D(m, at(dX - 7, FY + 4.0, dZ + 0.6), Vector3.new(1.8, 0.75, 1.0), C.bronze, MAT.Metal, "BrochureRack")
	for k = 0, 2 do
		D(m, at(dX - 7.6 + k * 0.6, FY + 4.35, dZ + 0.55) * CFrame.Angles(math.rad(-12), 0, 0), Vector3.new(0.5, 0.75, 0.04), ({ rgb(36, 96, 170), rgb(220, 170, 60), rgb(196, 60, 70) })[k + 1], MAT.SmoothPlastic, "Brochure")
	end
	VC(m, at(dX + 7.5, FY + 4.2, dZ + 0.4), 1.1, 0.7, rgb(230, 230, 236), MAT.Glass, false, "Vase")
	Kit.ellipsoid(m, at(dX + 7.5, FY + 5.2, dZ + 0.4), Vector3.new(1.7, 1.3, 1.7), rgb(220, 226, 236), MAT.Fabric, { name = "Orchids", query = false })
	-- 백월: 호두나무 + 청동 테 + 빛나는 글자
	local bwZ = dZ - 8.5
	S(m, at(dX, FY + 7.5, bwZ), Vector3.new(24, 15, 1.2), C.walnut, MAT.Wood, "BackdropWall")
	D(m, at(dX, FY + 9.8, bwZ + 0.66), Vector3.new(17.2, 5.2, 0.1), C.bronze, MAT.Metal, "BackdropFrame", 0.2)
	sign(m, at(dX, FY + 9.8, bwZ + 0.75, FACE_PZ), Vector3.new(16.4, 4.4, 0.1), rgb(20, 20, 22), MAT.SmoothPlastic, "서울스카이  SEOUL SKY\n안내 · 매표  Information & Tickets", C.textWarm, 30)
	N(m, at(dX, FY + 6.7, bwZ + 0.68), Vector3.new(17.2, 0.12, 0.12), C.warmLight, "BackdropLine")
	local rcLamp = N(m, at(dX, cyB - 0.3, dZ - 1), Vector3.new(4, 0.1, 0.6), C.warmLight, "DeskPendantLine")
	light(rcLamp, "SpotLight", { color = rgb(255, 222, 180), brightness = 2.2, range = 48, angle = 70, face = Enum.NormalId.Bottom })
	-- 무인 발권기 2대 + 대기줄 차단봉
	for k = 0, 1 do
		local kc = at(dX + 13 + k * 3.4, FY, dZ + 5, FACE_PZ)
		S(m, kc * CFrame.new(0, 2.6, 0), Vector3.new(2.2, 5.2, 1.4), rgb(36, 38, 44), MAT.Metal, "Kiosk", 0.15)
		N(m, kc * CFrame.new(0, 3.9, -0.73) * CFrame.Angles(math.rad(10), 0, 0), Vector3.new(1.7, 2.2, 0.05), rgb(96, 150, 220), "KioskScreen")
		sign(m, kc * CFrame.new(0, 5.6, 0), Vector3.new(2.2, 0.7, 1.42), rgb(196, 40, 60), MAT.SmoothPlastic, "발권 TICKET", C.textWhite, 40)
	end
	local sq = {}
	for k = 0, 3 do
		table.insert(sq, at(dX - 8 + k * 5.3, FY, dZ + 7))
	end
	stanchions(m, sq, rgb(150, 24, 36))

	-- 라운지 2조: 러그 + 소파(2.2 m) + 안락의자 2 + 커피 테이블 + 플로어 램프 + 소품
	local lounges = { { HX - 19, ZB + 34 }, { HX - 19, ZB + 58 } }
	for li, lp in lounges do
		local lx, lz = lp[1], lp[2]
		D(m, at(lx, FY + 0.03, lz), Vector3.new(15, 0.06, 13), rgb(150, 138, 120), MAT.Fabric, "Rug")
		local col = if li == 1 then C.fabricSand else C.fabricBlue
		sofa(m, at(lx + 5.4, FY + 0.06, lz, FACE_NX), m2s(2.2), col, rgb(196, 120, 60))
		for _, sz in { -1, 1 } do
			sofa(m, at(lx - 5.0, FY + 0.06, lz + sz * 3.2, FACE_PX), m2s(0.9), C.leather)
		end
		S(m, at(lx, FY + 0.66, lz), Vector3.new(2.6, 1.2, 5.2), C.black, MAT.Metal, "TableBase")
		S(m, at(lx, FY + 1.36, lz), Vector3.new(3.4, 0.2, 6.2), C.marble, MAT.Marble, "TableTop", 0.06)
		VC(m, at(lx - 0.5, FY + 1.71, lz - 1.6), 0.5, 0.42, C.white, MAT.SmoothPlastic, false, "Cup")
		VC(m, at(lx + 0.6, FY + 1.71, lz - 1.1), 0.5, 0.42, C.white, MAT.SmoothPlastic, false, "Cup")
		D(m, at(lx + 0.2, FY + 1.56, lz + 1.4) * CFrame.Angles(0, 0.3, 0), Vector3.new(1.4, 0.2, 1.9), rgb(40, 70, 120), MAT.SmoothPlastic, "Book")
		D(m, at(lx + 0.2, FY + 1.76, lz + 1.4) * CFrame.Angles(0, -0.2, 0), Vector3.new(1.3, 0.2, 1.8), rgb(180, 60, 50), MAT.SmoothPlastic, "Book")
		local lampCF = at(lx + 6.2, FY, lz + 5.2)
		VC(m, lampCF * CFrame.new(0, 0.1, 0), 0.2, 1.4, C.black, MAT.Metal, false, "LampBase")
		VC(m, lampCF * CFrame.new(0, 2.8, 0), 5.4, 0.15, C.black, MAT.Metal, false, "LampPole")
		local shade = VC(m, lampCF * CFrame.new(0, 5.8, 0), 1.3, 1.6, rgb(255, 220, 170), MAT.Neon, false, "LampShade")
		Kit.glow(shade, MAT.Fabric, rgb(236, 226, 206))
		light(shade, "PointLight", { color = rgb(255, 214, 164), brightness = 1.1, range = 18 })
		pottedPlant(m, at(lx - 6.5, FY, lz - 6.5), 5, rgb(70, 66, 62))
	end

	-- 실내 나무 4 그루(7 m, 화강석 화분 Ø 2.4 m) + 그 옆 벤치
	for _, tp in { { -26, ZB + 14 }, { 26, ZB + 14 }, { -14, ZB + 52 }, { 14, ZB + 52 } } do
		treePlanter(m, at(tp[1], FY, tp[2]), m2s(2.4), m2s(0.6), m2s(7), rng, rgb(62, 60, 58), MAT.Granite)
	end
	for _, sx in { -1, 1 } do
		bench(m, at(sx * 26, FY, ZB + 22, FACE_PZ), m2s(2.4), C.leather)
	end

	-- 방풍실(입구 안쪽 3.6 m, 높이 3.3 m): 유리 벽/지붕 + 안쪽 자동문 + 매트, 바깥/안쪽 미닫이문은 열린 상태
	local dxs, DW, DH = Lb.doorXs, Lb.doorW, Lb.doorH
	local VX = math.abs(dxs[2]) + DW / 2 + 4.9
	local VD, VH = m2s(3.6), m2s(3.3)
	local zI = gIn - VD
	for _, sx in { -1, 1 } do
		G(m, at(sx * VX, FY + VH / 2, (gIn + zI) / 2), Vector3.new(0.3, VH, VD), C.glass, 0.6, true, "VestibuleGlass")
		D(m, at(sx * VX, FY + VH / 2, zI), Vector3.new(0.5, VH, 0.5), C.steelDark, MAT.Metal, "VestibulePost")
	end
	G(m, at(0, FY + VH + 0.2, (gIn + zI) / 2), Vector3.new(2 * VX + 0.5, 0.4, VD), rgb(206, 214, 220), 0.35, true, "VestibuleRoof")
	sign(m, at(0, FY + VH + 0.1, zI - 0.05), Vector3.new(2 * VX + 0.5, 1.2, 0.4), C.steelDark, MAT.Metal, "서울스카이  SEOUL SKY   ·   117–123F", C.textWarm, 24)
	local function vPane(x0: number, x1: number, y0: number, y1: number)
		G(m, at((x0 + x1) / 2, (y0 + y1) / 2, zI), Vector3.new(x1 - x0, y1 - y0, 0.3), C.glass, 0.6, true, "VestibuleGlass")
	end
	vPane(-VX, dxs[1] - DW / 2, FY, FY + VH)
	vPane(dxs[1] + DW / 2, dxs[2] - DW / 2, FY, FY + VH)
	vPane(dxs[2] + DW / 2, VX, FY, FY + VH)
	for _, dx in dxs do
		vPane(dx - DW / 2, dx + DW / 2, FY + DH + 0.7, FY + VH)
		D(m, at(dx, FY + DH + 0.35, zI), Vector3.new(DW + 0.5, 0.7, 0.9), C.steelDark, MAT.Metal, "DoorOperator")
		-- 열린 미닫이 두 짝(바깥: 멀리언 안쪽 / 안쪽: 방풍실 안쪽) — 유리 + 바닥 레일 + 손잡이 스타일
		for _, zl in { Lb.W - 1.65, zI + 0.6 } do
			for _, sx in { -1, 1 } do
				local lx = dx + sx * (DW / 2 + 2.1 - 0.25)
				G(m, at(lx, FY + DH / 2, zl), Vector3.new(4.2, DH - 0.1, 0.22), C.glass, 0.62, false, "DoorLeaf")
				D(m, at(lx, FY + 0.22, zl), Vector3.new(4.2, 0.36, 0.3), C.steelDark, MAT.Metal, "LeafRail")
				D(m, at(lx - sx * 2.0, FY + DH / 2, zl), Vector3.new(0.22, DH - 0.1, 0.32), C.steelDark, MAT.Metal, "LeafStile")
			end
		end
	end
	D(m, at(0, FY + 0.04, (gIn + zI) / 2), Vector3.new(2 * VX - 0.6, 0.08, VD - 0.4), rgb(46, 44, 42), MAT.Fabric, "EntranceMat")
	-- 미끄럼 주의 A형 표지
	local wet = at(VX + 4, FY, zI - 3, FACE_PZ)
	for _, sz in { -1, 1 } do
		D(m, wet * CFrame.new(0, 1.55, sz * 0.32) * CFrame.Angles(-sz * math.rad(10), 0, 0), Vector3.new(1.7, 3.1, 0.1), rgb(250, 200, 30), MAT.SmoothPlastic, "WetFloorSign")
	end
	sign(m, wet * CFrame.new(0, 1.55, -0.32) * CFrame.Angles(math.rad(10), 0, 0) * CFrame.new(0, 0.45, -0.08), Vector3.new(1.5, 1.0, 0.04), rgb(250, 200, 30), MAT.SmoothPlastic, "미끄럼 주의\nCAUTION", rgb(30, 30, 30), 50)

	-- 안내 사인: 행잉 사인(입구 쪽을 봄), 토템, 층별 안내, 환영 디지털 사이니지
	local hz = ZB + 19
	local hs = sign(m, at(0, FY + 17, hz, FACE_PZ), Vector3.new(26, 3.4, 0.4), rgb(28, 30, 34), MAT.Metal, "서울스카이 전망대  SEOUL SKY  ↑\n엘리베이터  Elevators  ↑", C.textWarm, 24)
	Kit.label(hs, BACK, "출구  EXIT  ↑", { color = C.textWhite, glow = true, pixelsPerStud = 24, maxDistance = 500 })
	for _, sx in { -1, 1 } do
		D(m, at(sx * 11, (FY + 18.7 + cyB) / 2, hz), Vector3.new(0.15, cyB - FY - 18.7, 0.15), C.steelDark, MAT.Metal, "SignRod")
	end
	local totem = at(-VX - 6, FY, zI - 4, FACE_PZ)
	S(m, totem * CFrame.new(0, 3.65, 0), Vector3.new(2.2, 7.3, 0.9), rgb(34, 36, 40), MAT.Metal, "Totem", 0.15)
	N(m, totem * CFrame.new(0, 3.65, -0.48), Vector3.new(0.12, 7.0, 0.08), C.warmLight, "TotemEdge")
	sign(m, totem * CFrame.new(0, 4.6, -0.47), Vector3.new(2.0, 4.6, 0.04), rgb(34, 36, 40), MAT.SmoothPlastic, "서울스카이\n전망대\nSEOUL\nSKY\n117–123F\n↑", C.textWarm, 40)
	sign(m, at(HX - 0.5, FY + 9, ZB + 24, FACE_NX), Vector3.new(11, 9, 0.12), rgb(30, 30, 34), MAT.SmoothPlastic, "층별 안내  DIRECTORY\n117–123F  서울스카이 SEOUL SKY\n76–101F  호텔 HOTEL\n42–71F  레지던스 RESIDENCE\n14–38F  오피스 OFFICE\nB1–B2  쇼핑몰 MALL", C.textWarm, 30)
	local ds = at(VX + 3, FY, zI - 7, FACE_PZ)
	D(m, ds * CFrame.new(0, 0.1, 0), Vector3.new(2.4, 0.2, 1.6), C.steelDark, MAT.Metal, "SignageFoot")
	D(m, ds * CFrame.new(0, 3.8, 0.1), Vector3.new(2.6, 6.0, 0.5), C.black, MAT.Metal, "SignageBody")
	sign(m, ds * CFrame.new(0, 3.9, -0.17), Vector3.new(2.3, 5.6, 0.04), rgb(22, 30, 56), MAT.Neon, "환영합니다\nWELCOME\n\n서울스카이\n오늘의 일몰\n17:31", rgb(255, 240, 220), 40)
	for _, sx in { -1, 1 } do
		VC(m, at(sx * (VX + 1.6), FY + 1.5, zI - 1.5), 3.0, 1.4, C.steel, MAT.Metal, true, "Bin")
	end
end

------------------------------------------------------------------------------------------------------
-- 2) 서울스카이 전망대 (118F 전망 홀 + 123F 스카이 라운지)
------------------------------------------------------------------------------------------------------
local function optsFn(name: string, mat: Enum.Material, refl: number?, collide: boolean): (Color3, boolean) -> PartOpts
	return function(c: Color3, cyl: boolean): PartOpts
		return { name = name, shape = if cyl then "Cylinder" else "Block", material = mat, color = c, reflectance = refl, collide = collide, query = collide, shadow = false }
	end
end

local CORE_H = m2s(5.4) -- 전망대 코어 반폭(엘리베이터/계단 코어 10.8 m)
local SHUTTLE_W, SHUTTLE_H = m2s(1.5), m2s(2.6)

local MENUS = {
	"COFFEE  커피\n아메리카노 Americano  6.0\n카페라떼 Café Latte  6.5\n바닐라라떼 Vanilla Latte  7.0\n콜드브루 Cold Brew  6.5",
	"SKY SPECIAL\n서울스카이 라떼  8.0\n한강 노을 에이드  8.5\n117 블렌드 티  7.0\n구름 솜사탕  5.0",
	"DESSERT  디저트\n크루아상 Croissant  4.5\n치즈케이크 Cheesecake  7.5\n마카롱 Macaron  3.0\n젤라토 Gelato  5.5",
}
local PRODUCT_C = { rgb(196, 60, 70), rgb(40, 96, 170), rgb(236, 190, 70), rgb(70, 150, 110), rgb(236, 236, 230), rgb(150, 90, 170), rgb(236, 140, 90), rgb(60, 60, 66) }

local function buildObservatory(m: Model, gm: Model, TF: CFrame, Ob: any, lobbyT: Vector3, obsT: Vector3, loungeT: Vector3, rng: Random)
	local CH = CORE_H
	local gT, cr = Ob.glassT, Ob.cornerR
	local FY1, FY2 = Ob.yA + 0.15, Ob.yB + 0.15
	local function at(x: number, y: number, z: number, yaw: number?): CFrame
		return TF * CFrame.new(x, y, z) * CFrame.Angles(0, yaw or 0, 0)
	end
	-- 층 둘레(유리 모서리 원과 같은 중심의 둥근 정사각 판)
	local function ringOf(gw: number): (number, number, number, number)
		local gIn = gw / 2 - gT
		local o = gw / 2 - gw * cr
		local fw = 2 * (gIn - 0.1)
		return gIn, o, fw, fw / 2 - o
	end
	local gIn1, o1, fw1, fr1 = ringOf(Ob.gw1)
	local gIn2, o2, fw2, fr2 = ringOf(Ob.gw2)
	local cove = rgb(255, 232, 200)

	-- ── 밖에서 보이는 밝은 띠의 내용(Persistent): 바닥, 천장 + 빛 띠, 코어 ─────────────────────────────
	Landmark.rsquareCut(gm, TF * CFrame.new(0, Ob.yA - 0.1, 0), fw1, 0.5, fr1, Ob.pit, C.floorDark, optsFn("ObsFloor", MAT.Marble, 0.14, true))
	Landmark.rsquare(gm, TF * CFrame.new(0, Ob.yB - 0.1, 0), fw2, 0.5, fr2, C.oak, C.oak, C.oak, optsFn("LoungeFloor", MAT.WoodPlanks, nil, true))
	Landmark.rsquare(gm, TF * CFrame.new(0, Ob.yA1 - 0.6, 0), fw1, 0.6, fr1, C.plaster, C.plaster, C.plaster, optsFn("ObsCeiling", MAT.Plaster, nil, false))
	Landmark.rsquare(gm, TF * CFrame.new(0, Ob.yB1 - 0.6, 0), fw2, 0.6, fr2, C.plaster, C.plaster, C.plaster, optsFn("LoungeCeiling", MAT.Plaster, nil, false))
	for lv = 1, 2 do
		local yc = (if lv == 1 then Ob.yA1 else Ob.yB1) - 0.95
		local gIn, o = (if lv == 1 then gIn1 else gIn2), (if lv == 1 then o1 else o2)
		local inner = CH + 5
		for f = 0, 3 do
			local FR = TF * CFrame.Angles(0, f * math.pi / 2, 0)
			local s = N(gm, FR * CFrame.new(0, yc, gIn - 6), Vector3.new(2 * o - 2, 0.12, 0.9), cove, "CeilingCove")
			N(gm, FR * CFrame.new(0, yc, inner), Vector3.new(2 * inner + 0.9, 0.12, 0.9), cove, "CeilingCove")
			if lv == 1 or f ~= 3 then
				light(s, "PointLight", { color = rgb(255, 224, 186), brightness = if lv == 1 then 1.3 else 1.0, range = if lv == 1 then 44 else 34 })
			end
		end
		local fy = if lv == 1 then FY1 else FY2
		local top = if lv == 1 then Ob.yA1 else Ob.yB1
		S(gm, at(0, (fy - 0.2 + top + 0.3) / 2, 0), Vector3.new(2 * CH, top + 0.5 - fy, 2 * CH), C.walnut, MAT.Wood, "Core")
		D(m, at(0, fy + 0.25, 0), Vector3.new(2 * CH + 0.3, 0.5, 2 * CH + 0.3), C.bronze, MAT.Metal, "CoreSkirting")
		for _, s in { { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } } do
			D(m, at(s[1] * CH, (fy + top) / 2, s[2] * CH), Vector3.new(0.7, top - fy, 0.7), C.bronze, MAT.Metal, "CoreTrim", 0.2)
		end
	end

	-- ── 118F: 엘리베이터(코어 -Z 면, 도착 지점 앞) + 반환/라운지 버튼 + 큰 사인 ───────────────────────
	local eF = at(0, FY1, -CH, FACE_NZ)
	for _, x in { -7.5, 7.5 } do
		elevatorDoor(m, eF * CFrame.new(x, 0, 0), SHUTTLE_W, SHUTTLE_H, "118")
	end
	D(m, eF * CFrame.new(0, 3.8, -0.08), Vector3.new(1.1, 2.4, 0.16), C.steel, MAT.Metal, "CallPanel", 0.25)
	sign(m, eF * CFrame.new(0, 4.7, -0.18), Vector3.new(0.95, 0.42, 0.04), C.black, MAT.SmoothPlastic, "▼ 1F", rgb(150, 214, 255), 60)
	elevatorButton(m, eF * CFrame.new(0, 3.6, -0.2), lobbyT, "1층으로 내려가기", "전망대 엘리베이터")
	D(m, eF * CFrame.new(14, 3.8, -0.08), Vector3.new(1.1, 2.4, 0.16), C.steel, MAT.Metal, "CallPanel", 0.25)
	sign(m, eF * CFrame.new(14, 4.7, -0.18), Vector3.new(0.95, 0.42, 0.04), C.black, MAT.SmoothPlastic, "▲ 123F", rgb(150, 214, 255), 60)
	elevatorButton(m, eF * CFrame.new(14, 3.6, -0.2), loungeT, "123층 라운지로 올라가기", "스카이 라운지 엘리베이터")
	sign(m, eF * CFrame.new(0, 14.5, -0.12), Vector3.new(28, 3.4, 0.2), rgb(18, 18, 22), MAT.SmoothPlastic, "서울스카이  SEOUL SKY   118F", C.textWarm, 24)
	N(m, eF * CFrame.new(0, 12.6, -0.14), Vector3.new(28, 0.14, 0.1), C.warmLight, "SignLine")
	sign(m, eF * CFrame.new(-14, 5.5, -0.12), Vector3.new(5.5, 4.5, 0.1), rgb(24, 26, 32), MAT.SmoothPlastic, "스카이데크 SKY DECK ↑\n(코어 건너편)\n\n카페 CAFÉ →\n기념품 GIFT SHOP ←", C.textWarm, 36)

	-- ── 스카이데크: 강 쪽(+Z) 유리 바닥 7.2 × 3.6 m, 아래는 무한 거울 + "500 m 아래 야경" ───────────────
	local px0, px1, pz0, pz1 = Ob.pit[1], Ob.pit[2], Ob.pit[3], Ob.pit[4]
	local pb = Ob.y0 + 0.8
	local pw, pd = px1 - px0, pz1 - pz0
	local pcx, pcz = (px0 + px1) / 2, (pz0 + pz1) / 2
	local wallH, wy = Ob.yA - pb, (pb + Ob.yA) / 2
	local MIR = rgb(16, 18, 26)
	D(m, at(px0 + 0.2, wy, pcz), Vector3.new(0.4, wallH, pd), MIR, MAT.Glass, "PitMirror", 0.5)
	D(m, at(px1 - 0.2, wy, pcz), Vector3.new(0.4, wallH, pd), MIR, MAT.Glass, "PitMirror", 0.5)
	D(m, at(pcx, wy, pz0 + 0.2), Vector3.new(pw - 0.8, wallH, 0.4), MIR, MAT.Glass, "PitMirror", 0.5)
	D(m, at(pcx, wy, pz1 - 0.2), Vector3.new(pw - 0.8, wallH, 0.4), MIR, MAT.Glass, "PitMirror", 0.5)
	D(m, at(pcx, pb - 0.25, pcz), Vector3.new(pw, 0.5, pd), rgb(8, 10, 16), MAT.SmoothPlastic, "PitFloor")
	N(m, at(pcx, pb + 0.03, pz0 + pd * 0.32), Vector3.new(pw - 0.8, 0.06, pd * 0.22), rgb(18, 34, 72), "PitRiver")
	N(m, at(pcx + pw * 0.2, pb + 0.15, pcz), Vector3.new(0.2, 0.04, pd - 0.8), rgb(255, 200, 120), "PitBridge")
	for _, zz in { 0.62, 0.84 } do
		N(m, at(pcx, pb + 0.08, pz0 + pd * zz), Vector3.new(pw - 0.8, 0.04, 0.12), rgb(230, 150, 70), "PitRoad")
	end
	N(m, at(pcx - pw * 0.28, pb + 0.08, pz0 + pd * 0.73), Vector3.new(0.12, 0.04, pd * 0.48), rgb(230, 150, 70), "PitRoad")
	for _ = 1, 30 do
		local zz = rng:NextNumber(0.5, 0.97)
		local sz = rng:NextNumber(0.18, 0.5)
		local c = if rng:NextNumber() < 0.7 then rgb(255, 210, 150) else rgb(210, 226, 255)
		N(m, at(px0 + rng:NextNumber(0.7, pw - 0.7), pb + 0.12, pz0 + pd * zz), Vector3.new(sz, 0.04, sz * rng:NextNumber(0.8, 1.6)), c, "PitCityLight")
	end
	for k, dpt in { 1.2, 2.6, 4.0 } do
		local y = FY1 - dpt
		if y > pb + 0.5 then
			local c = rgb(160, 210, 255):Lerp(rgb(20, 34, 64), (k - 1) / 3)
			N(m, at(px0 + 0.45, y, pcz), Vector3.new(0.1, 0.12, pd - 0.9), c, "PitFrame")
			N(m, at(px1 - 0.45, y, pcz), Vector3.new(0.1, 0.12, pd - 0.9), c, "PitFrame")
			N(m, at(pcx, y, pz0 + 0.45), Vector3.new(pw - 0.9, 0.12, 0.1), c, "PitFrame")
			N(m, at(pcx, y, pz1 - 0.45), Vector3.new(pw - 0.9, 0.12, 0.1), c, "PitFrame")
		end
	end
	G(m, at(pcx, Ob.yA - 0.05, pcz), Vector3.new(pw + 0.4, 0.48, pd + 0.4), rgb(206, 228, 240), 0.84, true, "SkyDeckGlass")
	local fy = FY1 + 0.09
	D(m, at(px0 - 0.05, fy, pcz), Vector3.new(0.6, 0.12, pd + 1.0), C.steel, MAT.Metal, "SkyDeckFrame", 0.3)
	D(m, at(px1 + 0.05, fy, pcz), Vector3.new(0.6, 0.12, pd + 1.0), C.steel, MAT.Metal, "SkyDeckFrame", 0.3)
	D(m, at(pcx, fy, pz0 - 0.05), Vector3.new(pw + 1.0, 0.12, 0.6), C.steel, MAT.Metal, "SkyDeckFrame", 0.3)
	D(m, at(pcx, fy, pz1 + 0.05), Vector3.new(pw + 1.0, 0.12, 0.6), C.steel, MAT.Metal, "SkyDeckFrame", 0.3)
	D(m, at(pcx, FY1 + 0.09, pcz), Vector3.new(0.4, 0.1, pd), C.steel, MAT.Metal, "SkyDeckFrame", 0.3)
	local lec = at(px1 + 3.2, FY1, pz0 - 1.6, FACE_NZ)
	D(m, lec * CFrame.new(0, 1.5, 0), Vector3.new(0.4, 3.0, 0.4), C.steelDark, MAT.Metal, "LecternPost")
	sign(m, lec * CFrame.new(0, 3.2, 0) * CFrame.Angles(math.rad(35), 0, 0), Vector3.new(3.6, 2.0, 0.12), rgb(24, 26, 32), MAT.Metal, string.format("SKY DECK  스카이데크\n지상 %d m\n유리 바닥 위를 걸어 보세요", math.floor(Ob.yA * Config.METERS_PER_STUD + 0.5)), C.textWarm, 50)

	-- ── 창가: 망원경 5, 파노라마 벤치 6, 전망 안내판 ───────────────────────────────────────────────
	for _, x in { -22, 22 } do
		telescope(m, at(x, FY1, gIn1 - 4.5, FACE_PZ))
	end
	for _, x in { -26, 26 } do
		telescope(m, at(x, FY1, -gIn1 + 4.5, FACE_NZ))
	end
	telescope(m, at(-gIn1 + 4.5, FY1, 30, FACE_NX))
	telescope(m, at(gIn1 - 4.5, FY1, -30, FACE_PX))
	for _, x in { -34, 34 } do
		bench(m, at(x, FY1, gIn1 - 10, FACE_PZ), m2s(2.4), C.leather)
	end
	for _, x in { -34, 34 } do
		bench(m, at(x, FY1, -gIn1 + 10, FACE_NZ), m2s(2.4), C.leather)
	end
	bench(m, at(gIn1 - 10, FY1, 30, FACE_PX), m2s(2.4), C.leather)
	bench(m, at(-gIn1 + 10, FY1, -32, FACE_NX), m2s(2.4), C.leather)
	bench(m, at(0, FY1, CH + 7, FACE_PZ), m2s(3.0), C.leather)
	local function plaque(cf: CFrame, text: string)
		D(m, cf * CFrame.new(0, 1.3, 0), Vector3.new(0.3, 2.6, 0.3), C.steelDark, MAT.Metal, "PlaquePost")
		sign(m, cf * CFrame.new(0, 2.9, 0) * CFrame.Angles(math.rad(35), 0, 0), Vector3.new(3.6, 1.7, 0.12), rgb(28, 30, 36), MAT.Metal, text, C.textWarm, 50)
	end
	plaque(at(-30, FY1, gIn1 - 2.2, FACE_NZ), "잠실대교  JAMSIL BRIDGE\n↑ 1.3 km")
	plaque(at(30, FY1, gIn1 - 2.2, FACE_NZ), "한강공원  HANGANG PARK\n↑ 강 건너")
	plaque(at(0, FY1, -gIn1 + 2.2, FACE_PZ), "잠실 시가지  JAMSIL CITY\n↑")
	plaque(at(-gIn1 + 2.2, FY1, 0 + 40, FACE_PX), "노을  SUNSET\n← 서쪽 WEST")
	-- 코어 +Z 면: 그래픽 월 + 높이 막대
	local zF = at(0, FY1, CH, FACE_PZ)
	sign(m, zF * CFrame.new(0, 10, -0.12), Vector3.new(24, 6.5, 0.2), rgb(16, 18, 26), MAT.SmoothPlastic, "SEOUL SKY\n서울스카이  117F – 123F", C.textWarm, 24)
	N(m, zF * CFrame.new(0, 6.4, -0.14), Vector3.new(24, 0.14, 0.1), C.warmLight, "GraphicLine")
	N(m, zF * CFrame.new(-14.5, 8.2, -0.14), Vector3.new(0.18, 14, 0.1), rgb(150, 214, 255), "HeightBar")
	for k, t in { "500 m", "300 m", "100 m" } do
		sign(m, zF * CFrame.new(-16.3, 14.6 - (k - 1) * 5.2, -0.13), Vector3.new(3.2, 0.9, 0.06), rgb(16, 18, 26), MAT.SmoothPlastic, t, rgb(150, 214, 255), 50)
	end

	-- ── 카페(코어 -X 면): 뒤 카운터 + 앞 카운터 + 쇼케이스 + 메뉴판 3 + 펜던트 + 테이블 4 ──────────────
	local cX = -CH
	S(m, at(cX - 1.1, FY1 + COUNTER / 2, 0), Vector3.new(2.2, COUNTER, 26), C.walnut, MAT.Wood, "BackCounter")
	D(m, at(cX - 1.15, FY1 + COUNTER + 0.06, 0), Vector3.new(2.4, 0.12, 26.2), C.marble, MAT.Marble, "BackTop", 0.05)
	D(m, at(cX - 1.2, FY1 + COUNTER + 0.92, -6), Vector3.new(1.6, 1.6, 2.8), C.steel, MAT.Metal, "Espresso", 0.3)
	N(m, at(cX - 2.02, FY1 + COUNTER + 1.4, -6), Vector3.new(0.05, 0.25, 1.6), rgb(120, 200, 255), "EspressoLed")
	VC(m, at(cX - 1.1, FY1 + COUNTER + 0.8, -2), 1.5, 0.8, C.black, MAT.Metal, false, "Grinder")
	for k = 0, 3 do
		VC(m, at(cX - 1.1, FY1 + COUNTER + 0.3 + k * 0.42, 2.5), 0.4, 0.55, C.white, MAT.SmoothPlastic, false, "CupStack")
	end
	for k = 0, 3 do
		VC(m, at(cX - 1.2, FY1 + COUNTER + 0.6, 6 + k * 0.7), 1.1, 0.4, ({ rgb(150, 70, 40), rgb(220, 180, 90), rgb(110, 40, 50), rgb(230, 220, 200) })[k + 1], MAT.Glass, false, "Syrup")
	end
	S(m, at(cX - 6.4, FY1 + 1.45, 0), Vector3.new(2.4, 2.9, 22), C.oak, MAT.Wood, "CafeCounter")
	D(m, at(cX - 6.5, FY1 + COUNTER + 0.08, 0), Vector3.new(2.9, 0.16, 22.4), C.white, MAT.Marble, "CafeTop", 0.05)
	G(m, at(cX - 6.4, FY1 + COUNTER + 0.92, 5.5), Vector3.new(2.2, 1.6, 8), rgb(220, 232, 240), 0.55, false, "PastryCase")
	N(m, at(cX - 6.4, FY1 + COUNTER + 0.25, 5.5), Vector3.new(2.0, 0.08, 7.8), rgb(255, 236, 200), "CaseShelf")
	for k = 0, 3 do
		Kit.ellipsoid(m, at(cX - 6.4, FY1 + COUNTER + 0.55, 2.6 + k * 1.9), Vector3.new(1.0, 0.55, 1.4), rgb(206, 146, 72):Lerp(rgb(240, 220, 200), (k % 2) * 0.5), MAT.SmoothPlastic, { name = "Pastry", query = false })
	end
	D(m, at(cX - 6.4, FY1 + COUNTER + 0.55, -5), Vector3.new(1.2, 0.8, 1.4), C.black, MAT.SmoothPlastic, "Register")
	N(m, at(cX - 7.08, FY1 + COUNTER + 0.95, -5) * CFrame.Angles(0, 0, math.rad(-15)), Vector3.new(0.05, 0.6, 1.1), rgb(90, 140, 200), "RegisterScreen")
	for k, txt in MENUS do
		sign(m, at(cX - 0.12, FY1 + 8.6, (k - 2) * 8.4, FACE_NX), Vector3.new(7.6, 4.8, 0.2), C.black, MAT.SmoothPlastic, txt, C.textWarm, 30)
	end
	sign(m, at(cX - 0.12, FY1 + 12.8, 0, FACE_NX), Vector3.new(16, 2.2, 0.2), C.walnut, MAT.Wood, "SKY CAFÉ  스카이 카페", C.textWarm, 30)
	local pendantTop = Ob.yA1 - 0.9
	for k, z in { -7, 0, 7 } do
		D(m, at(cX - 6.4, (FY1 + 8.6 + pendantTop) / 2, z), Vector3.new(0.06, pendantTop - FY1 - 8.6, 0.06), C.black, MAT.Metal, "PendantCord")
		local pend = Kit.ball(m, (at(cX - 6.4, FY1 + 8.1, z)).Position, 1.3, rgb(255, 214, 160), MAT.Neon, { name = "Pendant", collide = false, query = false, shadow = false, glow = true, dayMaterial = MAT.Glass, dayColor = rgb(236, 228, 214) })
		if k == 2 then
			light(pend, "PointLight", { color = rgb(255, 212, 160), brightness = 1.2, range = 24 })
		end
	end
	for _, tx in { -46, -36 } do
		for _, tz in { -10, 9 } do
			roundTable(m, at(tx, FY1, tz), m2s(0.7), TABLE_H, C.marble, MAT.Marble)
			chair(m, at(tx, FY1, tz - 2.6, FACE_PZ), C.oak)
			chair(m, at(tx, FY1, tz + 2.6, FACE_NZ), C.oak)
			VC(m, at(tx + 0.4, FY1 + TABLE_H + 0.25, tz - 0.3), 0.5, 0.42, C.white, MAT.SmoothPlastic, false, "Cup")
		end
	end
	pottedPlant(m, at(cX - 4, FY1, 15), 5, rgb(70, 66, 62))
	pottedPlant(m, at(cX - 4, FY1, -15), 5, rgb(70, 66, 62))

	-- ── 기념품숍(코어 +X 면): 벽 선반 3 + 진열 테이블 2 + 계산대 + 사인 ─────────────────────────────
	local gX = CH
	D(m, at(gX + 13, FY1 + 0.04, 0), Vector3.new(24, 0.08, 36), C.oak, MAT.WoodPlanks, "ShopFloor")
	local shelfLamp: BasePart? = nil
	for _, z in { -11.5, 0, 11.5 } do
		S(m, at(gX + 0.9, FY1 + 4.5, z), Vector3.new(1.8, 9, 10.6), C.white, MAT.Wood, "WallShelf")
		for r = 0, 3 do
			for h = -1, 1, 2 do
				D(m, at(gX + 1.97, FY1 + 1.3 + r * 2.0, z + h * 2.5), Vector3.new(0.3, rng:NextNumber(0.9, 1.4), 4.6), PRODUCT_C[rng:NextInteger(1, #PRODUCT_C)], MAT.SmoothPlastic, "Products")
			end
		end
		local sl = N(m, at(gX + 1.88, FY1 + 8.7, z), Vector3.new(0.12, 0.12, 10), C.warmLight, "ShelfLight")
		shelfLamp = shelfLamp or sl
	end
	if shelfLamp then
		light(shelfLamp, "PointLight", { color = rgb(255, 232, 200), brightness = 1.0, range = 22 })
	end
	for _, tz in { -8, 8 } do
		local tcf = at(gX + 12, FY1, tz)
		S(m, tcf * CFrame.new(0, 1.4, 0), Vector3.new(4.5, 2.8, 6.5), C.white, MAT.Wood, "DisplayTable")
		for k = 0, 2 do
			local mc = tcf * CFrame.new(-1.3 + k * 1.3, 2.8, -1.8)
			D(m, mc * CFrame.new(0, 0.8, 0), Vector3.new(0.55, 1.6, 0.55), rgb(176, 190, 206), MAT.Glass, "MiniTower", 0.2)
			D(m, mc * CFrame.new(0, 1.95, 0), Vector3.new(0.32, 0.7, 0.32), rgb(220, 196, 150), MAT.Metal, "MiniTowerTop", 0.2)
		end
		for k = 0, 1 do
			Kit.ball(m, (tcf * CFrame.new(-0.8 + k * 1.6, 3.45, 1.0)).Position, 1.3, ({ rgb(240, 200, 120), rgb(150, 200, 236) })[k + 1], MAT.Fabric, { name = "Plush", collide = false, query = false })
		end
		D(m, tcf * CFrame.new(1.4, 3.1, 2.2), Vector3.new(1.2, 0.6, 1.2), rgb(196, 40, 60), MAT.SmoothPlastic, "GiftBox")
	end
	S(m, at(gX + 21, FY1 + 1.6, -15), Vector3.new(2.6, 3.2, 6), C.walnut, MAT.Wood, "GiftCounter")
	D(m, at(gX + 20.8, FY1 + 3.6, -16), Vector3.new(1.0, 0.8, 1.2), C.black, MAT.SmoothPlastic, "Register")
	sign(m, at(gX + 0.2, FY1 + 11, 0, FACE_PX), Vector3.new(14, 2.2, 0.2), C.white, MAT.Wood, "기념품  GIFT SHOP", rgb(170, 40, 50), 30)

	-- ── 123F 스카이 라운지: 엘리베이터 + 바 + 창가 라운지 의자 6조 ──────────────────────────────────
	local eF2 = at(0, FY2, -CH, FACE_NZ)
	elevatorDoor(m, eF2 * CFrame.new(-8, 0, 0), SHUTTLE_W, SHUTTLE_H, "123")
	D(m, eF2 * CFrame.new(2, 3.8, -0.08), Vector3.new(1.1, 2.4, 0.16), C.steel, MAT.Metal, "CallPanel", 0.25)
	sign(m, eF2 * CFrame.new(2, 4.7, -0.18), Vector3.new(0.95, 0.42, 0.04), C.black, MAT.SmoothPlastic, "▼ 118F", rgb(150, 214, 255), 60)
	elevatorButton(m, eF2 * CFrame.new(2, 3.6, -0.2), obsT, "118층 전망대로 내려가기", "스카이 라운지 엘리베이터")
	D(m, eF2 * CFrame.new(12, 3.8, -0.08), Vector3.new(1.1, 2.4, 0.16), C.steel, MAT.Metal, "CallPanel", 0.25)
	sign(m, eF2 * CFrame.new(12, 4.7, -0.18), Vector3.new(0.95, 0.42, 0.04), C.black, MAT.SmoothPlastic, "▼ 1F", rgb(150, 214, 255), 60)
	elevatorButton(m, eF2 * CFrame.new(12, 3.6, -0.2), lobbyT, "1층으로 내려가기", "전망대 엘리베이터")
	sign(m, at(0, FY2 + 11, CH + 0.12, FACE_PZ), Vector3.new(22, 3.4, 0.2), rgb(16, 18, 26), MAT.SmoothPlastic, "SKY LOUNGE 123  스카이 라운지", C.textWarm, 24)
	-- 바(코어 -X 면): 백바(빛나는 선반 + 병) + 바 카운터 1.05 m + 스툴 5
	S(m, at(cX - 1.0, FY2 + 1.5, 0), Vector3.new(2.0, 3.0, 24), C.walnut, MAT.Wood, "BackBar")
	for r = 0, 1 do
		N(m, at(cX - 0.5, FY2 + 5.2 + r * 2.4, 0), Vector3.new(0.8, 0.1, 22), rgb(255, 190, 110), "BackBarShelf")
		for k = 0, 9 do
			VC(m, at(cX - 0.55, FY2 + 6.05 + r * 2.4, -9.9 + k * 2.2), 1.6, 0.42, ({ rgb(150, 90, 40), rgb(60, 110, 70), rgb(200, 200, 210), rgb(120, 40, 50) })[(k + r) % 4 + 1], MAT.Glass, false, "Bottle")
		end
	end
	S(m, at(cX - 6.4, FY2 + 1.75, 0), Vector3.new(2.4, 3.5, 20), rgb(30, 30, 34), MAT.Marble, "BarCounter", 0.1)
	D(m, at(cX - 6.6, FY2 + 3.58, 0), Vector3.new(3.0, 0.16, 20.4), C.walnut, MAT.Wood, "BarTop")
	N(m, at(cX - 7.65, FY2 + 0.5, 0), Vector3.new(0.1, 0.1, 19.6), rgb(255, 190, 110), "BarGlow")
	D(m, at(cX - 8.0, FY2 + 0.9, 0), Vector3.new(0.18, 0.18, 19.6), C.bronze, MAT.Metal, "FootRail", 0.3)
	for k = -2, 2 do
		local sc = at(cX - 9.6, FY2, k * 4)
		VC(m, sc * CFrame.new(0, 1.25, 0), 2.5, 0.3, C.bronze, MAT.Metal, true, "StoolPost")
		VC(m, sc * CFrame.new(0, 2.55, 0), 0.3, 1.5, C.leather, MAT.Leather, true, "StoolSeat")
	end
	-- 창가 라운지 세트(안락의자 2 + 낮은 원탁 + 촛불)
	local sets = {
		{ -20, gIn2 - 8, FACE_PZ },
		{ 20, gIn2 - 8, FACE_PZ },
		{ gIn2 - 8, -14, FACE_PX },
		{ gIn2 - 8, 16, FACE_PX },
		{ -24, -gIn2 + 8, FACE_NZ },
		{ 26, -gIn2 + 8, FACE_NZ },
	}
	for i, st in sets do
		local cf = at(st[1], FY2, st[2], st[3])
		local col = if i % 2 == 0 then C.fabricBlue else C.fabricSand
		for _, sx in { -1, 1 } do
			sofa(m, cf * CFrame.new(sx * 2.4, 0, 0), m2s(0.85), col)
		end
		roundTable(m, cf * CFrame.new(0, 0, -3.0), 2.2, 1.6, C.marble, MAT.Marble)
		N(m, cf * CFrame.new(0, 1.85, -3.0), Vector3.new(0.3, 0.4, 0.3), rgb(255, 196, 120), "Candle")
	end
	pottedPlant(m, at(16, FY2, CH + 5), 6, rgb(60, 58, 56))
	pottedPlant(m, at(-16, FY2, CH + 5), 6, rgb(60, 58, 56))
end

------------------------------------------------------------------------------------------------------
-- 3) 몰 아트리움 (파란 곡면 지붕 홀 속)
------------------------------------------------------------------------------------------------------
type ShopSpec = { ko: string, en: string, kind: string }
type KindStyle = { wall: Color3, wallMat: Enum.Material, floor: Color3, floorMat: Enum.Material, fascia: Color3, text: Color3, lamp: Color3 }

local KIND: { [string]: KindStyle } = {
	cafe = { wall = rgb(92, 66, 46), wallMat = MAT.Wood, floor = rgb(150, 110, 74), floorMat = MAT.WoodPlanks, fascia = rgb(40, 30, 24), text = rgb(255, 226, 180), lamp = rgb(255, 214, 160) },
	books = { wall = rgb(226, 220, 204), wallMat = MAT.Plaster, floor = rgb(160, 120, 80), floorMat = MAT.WoodPlanks, fascia = rgb(28, 52, 42), text = rgb(236, 230, 200), lamp = rgb(255, 232, 196) },
	fashion = { wall = rgb(238, 236, 232), wallMat = MAT.Plaster, floor = rgb(172, 170, 166), floorMat = MAT.Concrete, fascia = rgb(20, 20, 22), text = rgb(250, 250, 250), lamp = rgb(240, 244, 255) },
	cosmetics = { wall = rgb(246, 230, 234), wallMat = MAT.Plaster, floor = rgb(236, 234, 232), floorMat = MAT.CeramicTiles, fascia = rgb(250, 244, 246), text = rgb(200, 60, 110), lamp = rgb(255, 246, 250) },
	bakery = { wall = rgb(228, 198, 152), wallMat = MAT.Plaster, floor = rgb(206, 186, 158), floorMat = MAT.CeramicTiles, fascia = rgb(120, 70, 40), text = rgb(255, 236, 200), lamp = rgb(255, 214, 150) },
	food = { wall = rgb(56, 58, 62), wallMat = MAT.CeramicTiles, floor = rgb(120, 116, 110), floorMat = MAT.CeramicTiles, fascia = rgb(196, 54, 42), text = rgb(255, 244, 220), lamp = rgb(255, 230, 190) },
	goods = { wall = rgb(214, 216, 220), wallMat = MAT.Plaster, floor = rgb(190, 188, 182), floorMat = MAT.CeramicTiles, fascia = rgb(36, 60, 110), text = rgb(240, 244, 255), lamp = rgb(240, 244, 255) },
	shoes = { wall = rgb(74, 76, 80), wallMat = MAT.Concrete, floor = rgb(140, 110, 80), floorMat = MAT.WoodPlanks, fascia = rgb(18, 18, 20), text = rgb(255, 200, 80), lamp = rgb(255, 236, 210) },
	jewelry = { wall = rgb(30, 30, 34), wallMat = MAT.SmoothPlastic, floor = rgb(60, 58, 60), floorMat = MAT.Marble, fascia = rgb(14, 14, 16), text = rgb(230, 200, 140), lamp = rgb(255, 240, 220) },
	flowers = { wall = rgb(84, 112, 80), wallMat = MAT.Plaster, floor = rgb(150, 140, 126), floorMat = MAT.Slate, fascia = rgb(40, 70, 44), text = rgb(250, 240, 220), lamp = rgb(255, 236, 200) },
	tech = { wall = rgb(236, 238, 242), wallMat = MAT.SmoothPlastic, floor = rgb(200, 202, 206), floorMat = MAT.SmoothPlastic, fascia = rgb(240, 240, 244), text = rgb(30, 30, 34), lamp = rgb(236, 244, 255) },
}

local function sh(ko: string, en: string, kind: string): ShopSpec
	return { ko = ko, en = en, kind = kind }
end
-- 줄별 상점 (서→동). L1P 는 가운데 칸(입구 통로)을 건너뜀.
local SHOPS_L1P = { sh("편집숍", "SELECT SHOP", "fashion"), sh("신발", "SHOES", "shoes"), sh("카페", "CAFÉ", "cafe"), sh("베이커리", "BAKERY", "bakery"), sh("꽃집", "FLOWERS", "flowers"), sh("안경", "EYEWEAR", "goods") }
local SHOPS_L1N = { sh("아웃도어", "OUTDOOR", "fashion"), sh("서점", "BOOKS", "books"), sh("향수", "PERFUME", "cosmetics"), sh("화장품", "COSMETICS", "cosmetics"), sh("주얼리", "JEWELRY", "jewelry"), sh("시계", "WATCHES", "jewelry"), sh("디저트", "DESSERT", "bakery") }
local SHOPS_L2P = { sh("리빙", "LIVING", "goods"), sh("문구", "STATIONERY", "goods"), sh("전자", "ELECTRONICS", "tech"), sh("음반", "RECORDS", "books"), sh("아동복", "KIDS", "fashion"), sh("스포츠", "SPORTS", "shoes"), sh("푸드코트", "FOOD COURT", "food") }
local SHOPS_L2N = { sh("남성복", "MEN", "fashion"), sh("가방", "BAGS", "fashion"), sh("팝업스토어", "POP-UP", "goods"), sh("찻집", "TEA HOUSE", "cafe"), sh("약국", "PHARMACY", "cosmetics"), sh("분식", "SNACK BAR", "food"), sh("아이스크림", "GELATO", "bakery") }
local LIT_SHOPS = { ["카페"] = true, ["베이커리"] = true, ["화장품"] = true, ["서점"] = true, ["푸드코트"] = true }
local BOOK_C = { rgb(150, 60, 50), rgb(46, 70, 110), rgb(196, 170, 110), rgb(60, 96, 70), rgb(120, 96, 140), rgb(210, 200, 186) }
local CLOTH_C = { rgb(196, 186, 170), rgb(46, 52, 66), rgb(150, 70, 60), rgb(90, 110, 90), rgb(220, 214, 204), rgb(60, 60, 64) }
local PASTEL_C = { rgb(250, 200, 210), rgb(200, 230, 240), rgb(250, 236, 200), rgb(220, 210, 246), rgb(255, 255, 255) }

local function pick<T>(rng: Random, t: { T }): T
	return t[rng:NextInteger(1, #t)]
end

-- 진열창 상품(cf = 받침 윗면 중심, 로컬 -Z = 진열창 밖)
local function windowItem(m: Instance, cf: CFrame, kind: string, rng: Random)
	if kind == "fashion" or kind == "shoes" then
		VC(m, cf * CFrame.new(0, 1.2, 0), 2.4, 0.18, C.steel, MAT.Metal, false, "MannequinStand")
		Kit.ellipsoid(m, cf * CFrame.new(0, 3.7, 0), Vector3.new(1.5, 3.4, 0.9), pick(rng, CLOTH_C), MAT.Fabric, { name = "Mannequin" })
		Kit.ball(m, (cf * CFrame.new(0, 5.85, 0)).Position, 0.85, rgb(236, 232, 226), MAT.SmoothPlastic, { name = "MannequinHead", collide = false, query = false })
	elseif kind == "cosmetics" or kind == "jewelry" or kind == "tech" then
		for k = 0, 2 do
			local sz = 1.5 - k * 0.4
			D(m, cf * CFrame.new(-1 + k * 1.1, sz / 2, 0) * CFrame.Angles(0, rng:NextNumber(-0.4, 0.4), 0), Vector3.new(sz * 0.7, sz, sz * 0.7), if kind == "jewelry" then rgb(220, 190, 120) else pick(rng, PASTEL_C), if kind == "jewelry" then MAT.Metal else MAT.SmoothPlastic, "Product", 0.2)
		end
	elseif kind == "cafe" or kind == "bakery" or kind == "food" then
		VC(m, cf * CFrame.new(0, 0.6, 0), 1.2, 0.3, C.steel, MAT.Metal, false, "CakeStand")
		VC(m, cf * CFrame.new(0, 1.25, 0), 0.1, 2.2, C.white, MAT.SmoothPlastic, false, "Plate")
		VC(m, cf * CFrame.new(0, 1.75, 0), 0.9, 1.7, rgb(236, 214, 190), MAT.SmoothPlastic, false, "Cake")
	elseif kind == "books" then
		for k = 0, 2 do
			D(m, cf * CFrame.new(0, 0.2 + k * 0.4, 0) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0), Vector3.new(1.8, 0.4, 2.4), pick(rng, BOOK_C), MAT.SmoothPlastic, "Book")
		end
	elseif kind == "flowers" then
		VC(m, cf * CFrame.new(0, 0.9, 0), 1.8, 1.0, rgb(230, 230, 236), MAT.Glass, false, "Vase")
		Kit.ellipsoid(m, cf * CFrame.new(0, 2.4, 0), Vector3.new(2.2, 1.6, 2.2), pick(rng, { rgb(236, 120, 140), rgb(250, 210, 90), rgb(210, 120, 220) }), MAT.Fabric, { name = "Bouquet", query = false })
	else
		D(m, cf * CFrame.new(-0.6, 0.8, 0), Vector3.new(1.6, 1.6, 1.6), pick(rng, PRODUCT_C), MAT.SmoothPlastic, "Product")
		D(m, cf * CFrame.new(0.9, 0.5, 0.3), Vector3.new(1.2, 1.0, 1.2), pick(rng, PRODUCT_C), MAT.SmoothPlastic, "Product")
	end
end

-- 상점 내부 집기 (sp(dx, y, d) = 상점 앞 중심 기준, d = 진열창에서 안쪽 깊이)
local function shopFixtures(m: Instance, sp: (number, number, number) -> CFrame, kind: string, inner: number, depth: number, rng: Random, K: KindStyle)
	local back = depth - 0.4
	if kind == "cafe" then
		S(m, sp(0, COUNTER / 2, back - 3.2), Vector3.new(inner - 8, COUNTER, 2.4), C.walnut, MAT.Wood, "Counter")
		D(m, sp(0, COUNTER + 0.08, back - 3.3), Vector3.new(inner - 7.6, 0.16, 2.8), C.marble, MAT.Marble, "CounterTop")
		D(m, sp(-3, COUNTER + 0.9, back - 3.0), Vector3.new(2.2, 1.6, 1.4), C.steel, MAT.Metal, "Espresso", 0.3)
		sign(m, sp(0, 8.4, back - 0.06), Vector3.new(8, 3.8, 0.1), C.black, MAT.SmoothPlastic, "MENU  메뉴\n아메리카노 4,500\n카페라떼 5,000\n말차라떼 5,500", C.textWarm, 30)
		for _, dx in { -5.5, 5.5 } do
			roundTable(m, sp(dx, 0, 7), m2s(0.6), TABLE_H, C.marble, MAT.Marble)
			VC(m, sp(dx + 2.2, SEAT / 2, 7), SEAT, 1.3, C.oak, MAT.Wood, true, "Stool")
		end
	elseif kind == "books" then
		for _, sx in { -1, 1 } do
			local dx = sx * inner / 4
			S(m, sp(dx, 4.5, back - 0.9), Vector3.new(inner / 2 - 1.5, 9, 1.8), C.walnut, MAT.Wood, "Bookcase")
			for r = 0, 2 do
				D(m, sp(dx, 1.6 + r * 2.6, back - 1.9), Vector3.new(inner / 2 - 2.4, 1.7, 0.3), pick(rng, BOOK_C), MAT.SmoothPlastic, "Books")
			end
		end
		S(m, sp(0, 1.3, 9), Vector3.new(8, 2.6, 4), C.oak, MAT.Wood, "BookTable")
		for _, dx in { -2.2, 1.8 } do
			D(m, sp(dx, 2.9, 9) * CFrame.Angles(0, rng:NextNumber(-0.3, 0.3), 0), Vector3.new(1.8, 0.6, 2.4), pick(rng, BOOK_C), MAT.SmoothPlastic, "BookStack")
		end
	elseif kind == "fashion" then
		for _, sx in { -1, 1 } do
			local dx = sx * inner / 4
			local len = inner / 2 - 4
			D(m, sp(dx, 4.7, 10), Vector3.new(len, 0.15, 0.15), C.steel, MAT.Metal, "Rail", 0.3)
			for _, ex in { -1, 1 } do
				D(m, sp(dx + ex * len / 2, 2.35, 10), Vector3.new(0.15, 4.7, 0.15), C.steel, MAT.Metal, "RailPost", 0.3)
			end
			D(m, sp(dx, 3.0, 10), Vector3.new(len - 0.6, 3.2, 1.3), pick(rng, CLOTH_C), MAT.Fabric, "Clothes")
		end
		D(m, sp(0, 5.0, back - 0.7), Vector3.new(inner - 6, 0.25, 1.4), C.oak, MAT.Wood, "WallShelf")
		D(m, sp(0, 5.6, back - 0.8), Vector3.new(inner - 7, 1.0, 1.2), pick(rng, CLOTH_C), MAT.Fabric, "FoldedClothes")
	elseif kind == "cosmetics" then
		for _, sx in { -1, 1 } do
			S(m, sp(sx * inner / 4, 1.5, 9), Vector3.new(6, 3.0, 3.5), C.white, MAT.SmoothPlastic, "Island")
			D(m, sp(sx * inner / 4, 3.3, 9), Vector3.new(5, 0.6, 2.8), pick(rng, PASTEL_C), MAT.Glass, "Products", 0.2)
		end
		N(m, sp(0, 6.2, back - 0.3), Vector3.new(inner - 4, 0.15, 0.3), rgb(255, 246, 250), "ShelfLight")
		D(m, sp(0, 5.2, back - 0.4), Vector3.new(inner - 5, 1.2, 0.6), pick(rng, PASTEL_C), MAT.SmoothPlastic, "WallProducts")
	elseif kind == "bakery" then
		S(m, sp(0, 1.5, 6), Vector3.new(inner - 10, 3.0, 2.6), C.oak, MAT.Wood, "DisplayBase")
		G(m, sp(0, 3.85, 6), Vector3.new(inner - 10, 1.7, 2.4), rgb(220, 232, 240), 0.55, false, "DisplayCase")
		N(m, sp(0, 3.06, 6), Vector3.new(inner - 10.4, 0.08, 2.2), rgb(255, 230, 190), "CaseShelf")
		for k = -1, 1 do
			Kit.ellipsoid(m, sp(k * (inner - 14) / 3, 3.4, 6), Vector3.new(2.2, 0.6, 1.4), rgb(200, 140, 70), MAT.SmoothPlastic, { name = "Bread", query = false })
		end
		S(m, sp(0, 3.5, back - 0.9), Vector3.new(inner - 6, 7, 1.6), C.oak, MAT.Wood, "BreadRack")
		for r = 0, 1 do
			D(m, sp(0, 2.6 + r * 2.6, back - 1.9), Vector3.new(inner - 7, 0.9, 0.5), rgb(196, 136, 70), MAT.SmoothPlastic, "BreadRow")
		end
	elseif kind == "food" then
		S(m, sp(0, COUNTER / 2, back - 3.4), Vector3.new(inner - 6, COUNTER, 2.4), rgb(70, 72, 76), MAT.Metal, "FoodCounter", 0.15)
		sign(m, sp(0, 8.2, back - 0.06), Vector3.new(inner - 4, 4.4, 0.1), rgb(120, 30, 24), MAT.Neon, "비빔밥 9,000   떡볶이 5,000\n돈까스 10,000   라멘 9,500\n김밥 4,000   냉면 9,000", rgb(255, 246, 226), 24)
		for _, dx in { -5.5, 5.5 } do
			S(m, sp(dx, TABLE_H - 0.1, 7.5), Vector3.new(4.2, 0.2, 3.0), C.white, MAT.SmoothPlastic, "FoodTable")
			D(m, sp(dx, (TABLE_H - 0.2) / 2, 7.5), Vector3.new(0.4, TABLE_H - 0.2, 0.4), C.black, MAT.Metal, "TableLeg")
			for _, dz in { -2.4, 2.4 } do
				VC(m, sp(dx, SEAT / 2, 7.5 + dz), SEAT, 1.2, rgb(220, 70, 50), MAT.SmoothPlastic, true, "Stool")
			end
		end
	elseif kind == "shoes" then
		for r = 0, 2 do
			D(m, sp(0, 2.0 + r * 2.6, back - 0.6), Vector3.new(inner - 4, 0.2, 1.2), C.oak, MAT.Wood, "ShoeShelf")
			D(m, sp(0, 2.55 + r * 2.6, back - 0.7), Vector3.new(inner - 5, 0.9, 1.0), pick(rng, CLOTH_C), MAT.Leather, "Shoes")
		end
		bench(m, sp(0, 0, 9), 8, C.leather)
	elseif kind == "jewelry" then
		for _, sx in { -1, 1 } do
			S(m, sp(sx * inner / 4, 1.3, 8), Vector3.new(6, 2.6, 2.6), C.black, MAT.SmoothPlastic, "CaseBase")
			G(m, sp(sx * inner / 4, 3.2, 8), Vector3.new(6, 1.2, 2.6), rgb(226, 236, 244), 0.6, false, "JewelCase")
			N(m, sp(sx * inner / 4, 2.66, 8), Vector3.new(5.6, 0.08, 2.2), rgb(255, 240, 220), "CaseLight")
		end
	elseif kind == "flowers" then
		for k = 0, 3 do
			local dx = -inner / 2 + 3 + k * (inner - 6) / 3
			VC(m, sp(dx, 1.0, back - 2.5), 2.0, 1.8, C.steel, MAT.Metal, true, "Bucket")
			Kit.ellipsoid(m, sp(dx, 2.6, back - 2.5), Vector3.new(2.4, 1.8, 2.4), pick(rng, { rgb(236, 120, 140), rgb(250, 210, 90), rgb(210, 120, 220), rgb(250, 250, 240) }), MAT.Fabric, { name = "Flowers", query = false })
		end
		S(m, sp(0, COUNTER / 2, 9), Vector3.new(7, COUNTER, 2.4), C.oak, MAT.Wood, "Counter")
	else -- goods / tech
		for _, sx in { -1, 1 } do
			S(m, sp(sx * inner / 4, 2.1, 9.5), Vector3.new(inner / 2 - 4, 4.2, 3.0), if kind == "tech" then C.white else C.oak, MAT.Wood, "Gondola")
			D(m, sp(sx * inner / 4, 4.5, 9.5), Vector3.new(inner / 2 - 5, 0.6, 2.4), pick(rng, PRODUCT_C), MAT.SmoothPlastic, "Products")
		end
		D(m, sp(0, 5.0, back - 0.4), Vector3.new(inner - 5, 3.0, 0.6), pick(rng, PRODUCT_C), MAT.SmoothPlastic, "WallProducts")
	end
end

local function buildShop(m: Instance, HF: CFrame, x0: number, x1: number, s: number, yf: number, ytop: number, ceilB: number, GZ: number, SD: number, spec: ShopSpec, rng: Random)
	local K = KIND[spec.kind] or KIND.goods
	local xc, inner = (x0 + x1) / 2, (x1 - x0) - 1.2
	local depth = SD - GZ
	local yawF = if s > 0 then FACE_NZ else FACE_PZ -- 갤러리아(정면)를 보는 yaw
	local function sp(dx: number, y: number, d: number): CFrame
		return HF * CFrame.new(xc + dx, yf + y, s * (GZ + d)) * CFrame.Angles(0, yawF, 0)
	end
	S(m, sp(0, -0.125, depth / 2), Vector3.new(inner, 0.35, depth), K.floor, K.floorMat, "ShopFloor")
	S(m, sp(0, (ytop - yf) / 2, depth + 0.05), Vector3.new(inner, ytop - yf, 0.9), K.wall, K.wallMat, "ShopWall")
	local lamp = N(m, sp(0, ceilB - yf - 0.05, depth / 2 + 1), Vector3.new(inner - 6, 0.12, depth - 8), K.lamp, "ShopLight")
	if LIT_SHOPS[spec.ko] then
		light(lamp, "PointLight", { color = K.lamp, brightness = 1.3, range = 26 })
	end
	-- 간판 띠(진열창 위 3.45 m ~ 4.35 m)
	local fy = 11.5
	local fas = Kit.part(m, sp(0, fy + 1.5, -0.25), Vector3.new(inner, 3.0, 0.5), { name = "Fascia", material = MAT.SmoothPlastic, color = K.fascia, collide = false, query = false, shadow = false })
	Kit.label(fas, FRONT, spec.ko .. "   " .. spec.en, { color = K.text, glow = true, pixelsPerStud = 20, maxDistance = 700, font = Enum.Font.GothamBold })
	-- 진열창 2 + 입구(2.4 m) 문설주 + 진열 받침 + 상품
	local ew = 8
	local gw = inner / 2 - ew / 2
	for _, sx in { -1, 1 } do
		local wx = sx * (ew / 2 + gw / 2)
		G(m, sp(wx, fy / 2, 0), Vector3.new(gw, fy, 0.3), rgb(200, 216, 226), 0.7, true, "ShopWindow")
		D(m, sp(sx * ew / 2, fy / 2, 0), Vector3.new(0.35, fy, 0.5), C.steelDark, MAT.Metal, "Mullion")
		S(m, sp(wx, 0.6, 2.6), Vector3.new(gw - 2.4, 1.2, 3.0), K.wall:Lerp(C.white, 0.6), MAT.SmoothPlastic, "WindowPlinth")
		windowItem(m, sp(wx, 1.2, 2.6), spec.kind, rng)
	end
	shopFixtures(m, sp, spec.kind, inner, depth, rng, K)
end

-- 에스컬레이터: (xb, yb) → (xt, yt) 30° 경사, 폭 방향 = Z. 보이는 계단 24 + 숨은 경사로(투명, 충돌) + 유리 난간 + 고무 손잡이
local function escalator(m: Instance, HF: CFrame, xb: number, xt: number, zc: number, yb: number, yt: number)
	local rise, run = yt - yb, xt - xb
	local ang = math.atan2(rise, run)
	local L = math.sqrt(rise * rise + run * run)
	local inc = HF * CFrame.new((xb + xt) / 2, (yb + yt) / 2, zc) * CFrame.Angles(0, 0, ang)
	local NS = 24
	local d, h = run / NS, rise / NS
	S(m, inc * CFrame.new(-1.5, -1.75, 0), Vector3.new(L + 3, 3.2, 5.4), C.steel, MAT.Metal, "EscalatorTruss", 0.12)
	S(m, HF * CFrame.new(xt + 1.5, yt - 1.62, zc), Vector3.new(5, 3.2, 5.4), C.steel, MAT.Metal, "EscalatorHead", 0.12)
	for i = 0, NS - 1 do
		local top = yb + (i + 1) * h
		D(m, HF * CFrame.new(xb + (i + 0.5) * d, top - h * 0.75, zc), Vector3.new(d + 0.02, h * 1.5, 3.4), rgb(70, 72, 78), MAT.DiamondPlate, "Step")
	end
	S(m, HF * CFrame.new(xb - 2.0, yb + 0.03, zc), Vector3.new(4, 0.1, 3.6), rgb(190, 190, 184), MAT.DiamondPlate, "CombPlate")
	S(m, HF * CFrame.new(xt + 2.0 - d / 4, yt + 0.03, zc), Vector3.new(4 + d / 2, 0.1, 3.6), rgb(190, 190, 184), MAT.DiamondPlate, "CombPlate")
	-- 숨은 경사로: 계단 디딤판 중간선
	local p0 = Vector3.new(xb - d / 2, yb, zc)
	local p1 = Vector3.new(xt - d / 2, yt, zc)
	local dir = (p1 - p0).Unit
	local nrm = Vector3.new(-dir.Y, dir.X, 0)
	local ext = 3
	local ctr = (p0 + p1) / 2 - dir * (ext / 2) - nrm * 0.5
	Kit.part(m, HF * CFrame.fromMatrix(ctr, dir, nrm), Vector3.new((p1 - p0).Magnitude + ext, 1.0, 3.6), { name = "EscalatorRamp", color = C.steel, transparency = 1, collide = true, query = false, shadow = false })
	for _, sz in { -1, 1 } do
		G(m, inc * CFrame.new(0, 2.05, sz * 2.45), Vector3.new(L + 1.0, 3.0, 0.2), rgb(206, 222, 230), 0.55, true, "EscalatorGlass")
		D(m, inc * CFrame.new(0, 3.7, sz * 2.45), Vector3.new(L + 1.2, 0.32, 0.42), C.black, MAT.Rubber, "Handrail")
		D(m, inc * CFrame.new(0, 0.55, sz * 1.85), Vector3.new(L, 1.1, 0.16), C.steel, MAT.Metal, "Skirt", 0.3)
		for _, e in { { xt + 2.0, yt }, { xb - 2.0, yb } } do
			G(m, HF * CFrame.new(e[1], e[2] + 2.05, zc + sz * 2.45), Vector3.new(4.0, 3.0, 0.2), rgb(206, 222, 230), 0.55, true, "EscalatorGlass")
			D(m, HF * CFrame.new(e[1], e[2] + 3.7, zc + sz * 2.45), Vector3.new(4.2, 0.32, 0.42), C.black, MAT.Rubber, "Handrail")
		end
	end
end

local function balustrade(m: Instance, cf: CFrame, len: number) -- cf = 바닥 위 중심, 로컬 X = 길이
	G(m, cf * CFrame.new(0, 1.85, 0), Vector3.new(len, 3.1, 0.25), rgb(206, 222, 230), 0.6, true, "Balustrade")
	D(m, cf * CFrame.new(0, 3.55, 0), Vector3.new(len + 0.2, 0.25, 0.45), C.steel, MAT.Metal, "Handrail", 0.3)
	D(m, cf * CFrame.new(0, 0.35, 0), Vector3.new(len, 0.5, 0.5), C.steel, MAT.Metal, "BaseShoe", 0.2)
end

local function buildMall(m: Model, Hl: any, rng: Random)
	local HF: CFrame = Hl.cf
	local GX, GZ, VZ, SD, EX = Hl.GX, Hl.GZ, Hl.VZ, Hl.SD, Hl.EX
	local FY1, FY2, H, HZ = Hl.FY1, Hl.FY2, Hl.H, Hl.HZ
	local nS = Hl.shops
	local sw = 2 * GX / nS
	local slabB = FY2 - 3 -- 메자닌 슬래브 아랫면
	local c1B = slabB - 1.3 -- 1층 상점 천장 아랫면
	local c2B = FY2 + 14.2 -- 2층 상점 천장 아랫면
	local mid = (nS + 1) // 2 - 1 -- 가운데 칸 = 입구 통로 (0 기반)
	local function at(x: number, y: number, z: number, yaw: number?): CFrame
		return HF * CFrame.new(x, y, z) * CFrame.Angles(0, yaw or 0, 0)
	end

	-- 바닥(밝은 대리석) + 상점 앞 화강석 띠 + 보이드 테두리 띠
	S(m, at(0, FY1 - 0.3, 0), Vector3.new(2 * GX, 0.6, 2 * GZ), C.marble, MAT.Marble, "AtriumFloor", 0.06)
	S(m, at(0, FY1 - 0.3, (GZ + HZ + 0.3) / 2), Vector3.new(2 * EX, 0.6, HZ + 0.3 - GZ), C.marble, MAT.Marble, "PassageFloor", 0.06)
	for _, sz in { -1, 1 } do
		D(m, at(0, FY1 - 0.125, sz * (GZ - 2.5)), Vector3.new(2 * GX - 2, 0.35, 1.2), C.granite, MAT.Granite, "Inlay", 0.1)
		D(m, at(0, FY1 - 0.125, sz * VZ), Vector3.new(2 * GX - 30, 0.35, 0.8), rgb(178, 160, 128), MAT.Marble, "Inlay")
	end

	-- 메자닌(2층 보행로 + 2층 상점 바닥) + 보이드 쪽 흰 띠 + LED + 하부 조명, 양 끝 다리 2
	for _, sz in { -1, 1 } do
		S(m, at(0, FY2 - 1.5, sz * (VZ + SD) / 2), Vector3.new(2 * GX, 3, SD - VZ), C.marble, MAT.Marble, "Mezzanine", 0.05)
		D(m, at(0, FY2 - 1.4, sz * (VZ - 0.1)), Vector3.new(2 * GX - 28, 3.3, 0.4), C.white, MAT.SmoothPlastic, "MezzFascia")
		N(m, at(0, FY2 - 2.6, sz * (VZ - 0.33)), Vector3.new(2 * GX - 28, 0.14, 0.06), C.coolLight, "MezzLed")
		N(m, at(0, FY2 - 3.05, sz * (GZ - 5)), Vector3.new(2 * GX - 8, 0.12, 0.7), C.warmLight, "SoffitLight")
		balustrade(m, at(0, FY2, sz * (VZ + 0.5)), 2 * GX - 28)
	end
	for _, sx in { -1, 1 } do
		S(m, at(sx * (GX - 7), FY2 - 1.5, 0), Vector3.new(14, 3, 2 * VZ), C.marble, MAT.Marble, "Bridge", 0.05)
		D(m, at(sx * (GX - 13.9), FY2 - 1.4, 0), Vector3.new(0.4, 3.3, 2 * VZ + 0.6), C.white, MAT.SmoothPlastic, "BridgeFascia")
		N(m, at(sx * (GX - 14.13), FY2 - 2.6, 0), Vector3.new(0.06, 0.14, 2 * VZ), C.coolLight, "MezzLed")
	end
	balustrade(m, at(-(GX - 13.5), FY2, 0, math.pi / 2), 2 * VZ + 1)
	local gap = 6.2
	for _, sz in { -1, 1 } do
		local z0, z1 = gap, VZ + 0.5
		balustrade(m, at(GX - 13.5, FY2, sz * (z0 + z1) / 2, math.pi / 2), z1 - z0)
	end

	-- 에스컬레이터 한 쌍(동쪽 다리로): 30°, 층고 6 m
	local xTop = GX - 14
	local run = (FY2 - FY1) / math.tan(math.rad(30))
	local xb = xTop - 4 - run
	for _, zc in { -3.2, 3.2 } do
		escalator(m, HF, xb, xTop - 4, zc, FY1, FY2)
	end
	sign(m, at(xb - 4.3, FY1 + 6.2, 0, FACE_NX), Vector3.new(5.6, 1.4, 0.12), rgb(24, 26, 32), MAT.SmoothPlastic, "↑ 2F  푸드코트 · 리빙", C.textWarm, 40)
	D(m, at(xb - 4.3, FY1 + 3.4, 0), Vector3.new(0.3, 5.0, 0.3), C.steelDark, MAT.Metal, "SignPost")

	-- 상점 천장 / 1층 벌크헤드 / 클리어스토리(2층 간판 위 ~ 지붕) / 칸막이 기둥 / 양 끝벽
	for _, sz in { -1, 1 } do
		if sz > 0 then
			for _, sx in { -1, 1 } do
				D(m, at(sx * (GX + EX) / 2, c1B + 0.3, (GZ + SD) / 2), Vector3.new(GX - EX, 0.6, SD - GZ), C.plaster, MAT.Plaster, "ShopCeiling")
			end
		else
			D(m, at(0, c1B + 0.3, -(GZ + SD) / 2), Vector3.new(2 * GX, 0.6, SD - GZ), C.plaster, MAT.Plaster, "ShopCeiling")
		end
		D(m, at(0, c2B + 0.3, sz * (GZ + SD) / 2), Vector3.new(2 * GX, 0.6, SD - GZ), C.plaster, MAT.Plaster, "ShopCeiling")
		S(m, at(0, (FY1 + 14.3 + slabB + 0.1) / 2, sz * (GZ + 0.2)), Vector3.new(2 * GX, slabB + 0.1 - FY1 - 14.3, 0.9), C.white, MAT.Plaster, "Bulkhead")
		S(m, at(0, (c2B - 0.2 + H) / 2, sz * (GZ + 0.2)), Vector3.new(2 * GX, H - c2B + 0.2, 0.9), rgb(232, 228, 220), MAT.Limestone, "Clerestory")
		for _, y in { FY2 + 22, FY2 + 30 } do
			N(m, at(0, y, sz * (GZ - 0.3)), Vector3.new(2 * GX - 2, 0.15, 0.1), C.warmLight, "ClerestoryLine")
		end
		for k = 0, nS do
			local x = -GX + k * sw
			S(m, at(x, (FY1 - 0.3 + c2B + 0.6) / 2, sz * (GZ - 0.6 + SD) / 2), Vector3.new(1.2, c2B + 0.9 - FY1, SD - GZ + 0.6), rgb(232, 230, 224), MAT.Limestone, "Pilaster")
		end
	end
	for _, sx in { -1, 1 } do
		S(m, at(sx * (GX + 0.1), (FY1 - 0.3 + H) / 2, 0), Vector3.new(1.0, H - FY1 + 0.3, 2 * GZ - 1.2), C.travertine, MAT.Limestone, "EndWall")
	end
	-- 서쪽 끝벽: 몰 이름 + 1층 안내 / 동쪽 끝벽: 미디어 스크린(다리 위)
	sign(m, at(-GX + 0.45, FY2 + 23, 0, FACE_PX), Vector3.new(40, 7, 0.12), rgb(20, 24, 34), MAT.SmoothPlastic, "아트리움 몰   ATRIUM MALL", rgb(200, 226, 255), 16)
	N(m, at(-GX + 0.43, FY2 + 19.2, 0, FACE_PX), Vector3.new(40, 0.18, 0.08), rgb(120, 182, 255), "SignLine")
	sign(m, at(-GX + 0.45, FY1 + 9, 0, FACE_PX), Vector3.new(16, 2.2, 0.12), rgb(24, 26, 32), MAT.SmoothPlastic, "화장실 RESTROOM   ·   고객센터 INFO", C.textWarm, 30)
	local scr0, scr1 = FY2 + 7, FY2 + 25
	S(m, at(GX - 0.65, (scr0 + scr1) / 2, 0), Vector3.new(0.5, scr1 - scr0 + 1.2, 2 * VZ + 1.2), C.black, MAT.SmoothPlastic, "ScreenFrame")
	local cols, rows = 6, 3
	local cw, rh = 2 * VZ / cols, (scr1 - scr0) / rows
	for i = 0, cols - 1 do
		for j = 0, rows - 1 do
			local t = (i + 0.5) / cols
			local c = rgb(40, 110, 220):Lerp(rgb(120, 220, 255), (j + 0.5) / rows * 0.7 + 0.3 * math.sin(t * math.pi))
			N(m, at(GX - 0.98, scr0 + (j + 0.5) * rh, -VZ + (i + 0.5) * cw), Vector3.new(0.12, rh - 0.25, cw - 0.25), Color3.new(c.R * 0.8, c.G * 0.8, c.B * 0.8), "ScreenTile")
		end
	end
	sign(m, at(GX - 1.08, scr0 + rh * 1.5, 0, FACE_NX), Vector3.new(2 * VZ - 6, rh * 0.8, 0.05), rgb(20, 40, 90), MAT.SmoothPlastic, "가을 페스티벌  AUTUMN FESTIVAL  11.01 – 11.30", C.textWhite, 20)

	-- 1층 통로(정면 입구 → 갤러리아): 벽 마감 + 천장 + 열린 자동문 + 매트 + 층별 안내 + 라이트박스
	for _, sx in { -1, 1 } do
		S(m, at(sx * (EX - 0.1), (FY1 - 0.3 + c1B + 0.6) / 2, (SD + HZ - 1.6) / 2), Vector3.new(1.0, c1B + 0.9 - FY1, HZ - 1.6 - SD), C.travertine, MAT.Limestone, "PassageWall")
	end
	D(m, at(0, c1B + 0.3, (GZ + HZ - 0.6) / 2), Vector3.new(2 * EX - 1.2, 0.6, HZ - 0.6 - GZ), C.plaster, MAT.Plaster, "PassageCeiling")
	local psLamp: BasePart? = nil
	for _, x in { -5, 5 } do
		local s = N(m, at(x, c1B - 0.05, (GZ + HZ) / 2), Vector3.new(0.6, 0.12, HZ - GZ - 6), C.warmLight, "PassageLight")
		psLamp = psLamp or s
	end
	if psLamp then
		light(psLamp, "PointLight", { color = rgb(255, 228, 190), brightness = 1.2, range = 30 })
	end
	local dxs, DW, DH = Hl.doorXs, Hl.doorW, Hl.doorH
	for i, dx in dxs do
		for _, sx in { -1, 1 } do
			local lx = dx + sx * (DW / 2 + 2.1 - 0.25)
			local zl = if (i == 1 and sx == 1) then HZ - 1.4 else HZ - 1.0
			G(m, at(lx, FY1 + DH / 2, zl), Vector3.new(4.2, DH - 0.1, 0.22), C.glass, 0.62, false, "DoorLeaf")
			D(m, at(lx, FY1 + 0.22, zl), Vector3.new(4.2, 0.36, 0.3), C.steelDark, MAT.Metal, "LeafRail")
			D(m, at(lx - sx * 2.0, FY1 + DH / 2, zl), Vector3.new(0.22, DH - 0.1, 0.32), C.steelDark, MAT.Metal, "LeafStile")
		end
	end
	D(m, at(0, FY1 + 0.04, HZ - 6), Vector3.new(2 * EX - 1.4, 0.08, 9), rgb(46, 44, 42), MAT.Fabric, "EntranceMat")
	sign(m, at(EX - 0.65, FY1 + 6.5, SD + 9, FACE_NX), Vector3.new(10, 8, 0.12), rgb(26, 28, 34), MAT.SmoothPlastic, "층별 안내  FLOOR GUIDE\n2F  푸드코트 · 리빙 · 스포츠 · 전자\n1F  카페 · 베이커리 · 화장품 · 서점\n← 아트리움 ATRIUM →", C.textWarm, 30)
	sign(m, at(-EX + 0.65, FY1 + 6.5, SD + 9, FACE_PX), Vector3.new(9, 9, 0.12), rgb(36, 70, 140), MAT.Neon, "ATRIUM MALL\n아트리움 몰\n\n가을 페스티벌\n11.01 – 11.30", rgb(255, 255, 255), 30)

	-- 갤러리아 1층: 앉음 섬(Ø 3.3 m 화분 + 나무 8 m + 원목 좌면 0.43 m) 3, 팝업 키오스크, 벤치
	for _, ix in { -78, -18, 26 } do
		local cf = at(ix, FY1, 0)
		treePlanter(m, cf, 11, 1.25, m2s(8), rng, rgb(232, 228, 220), MAT.Concrete)
		VC(m, cf * CFrame.new(0, 1.34, 0), 0.18, 11.8, C.oak, MAT.Wood, true, "SeatRim")
		VC(m, cf * CFrame.new(0, 1.47, 0), 0.1, 9.6, P.Soil, MAT.Ground, false, "Soil")
	end
	local kc = at(-48, FY1, 0)
	S(m, kc * CFrame.new(0, 1.7, 0), Vector3.new(9, 3.4, 4), C.white, MAT.Wood, "KioskCounter")
	D(m, kc * CFrame.new(0, 3.48, 0), Vector3.new(9.4, 0.16, 4.4), C.oak, MAT.Wood, "KioskTop")
	for _, sx in { -1, 1 } do
		D(m, kc * CFrame.new(sx * 4.4, 6.2, 0), Vector3.new(0.3, 5.4, 0.3), C.steelDark, MAT.Metal, "KioskPost")
	end
	local roof = D(m, kc * CFrame.new(0, 9.1, 0), Vector3.new(10, 0.5, 5.2), rgb(196, 54, 42), MAT.SmoothPlastic, "KioskRoof")
	local ks = sign(m, kc * CFrame.new(0, 8.2, 0), Vector3.new(9, 1.3, 4.6), rgb(250, 246, 240), MAT.SmoothPlastic, "팝업스토어  POP-UP", rgb(196, 54, 42), 30)
	Kit.label(ks, BACK, "팝업스토어  POP-UP", { color = rgb(196, 54, 42), glow = true, pixelsPerStud = 30, maxDistance = 500 })
	light(roof, "PointLight", { color = rgb(255, 226, 190), brightness = 1.0, range = 20 })
	for k = 0, 2 do
		D(m, kc * CFrame.new(-2.8 + k * 2.8, 4.0, 0), Vector3.new(1.4, 0.9, 1.4), pick(rng, PRODUCT_C), MAT.SmoothPlastic, "Goods")
	end
	for _, bp in { { -32, 1 }, { 6, 1 }, { -62, -1 }, { 6, -1 } } do
		bench(m, at(bp[1], FY1, bp[2] * (VZ + 4), if bp[2] > 0 then FACE_NZ else FACE_PZ), m2s(2.4), C.oak)
	end
	-- 2층 보행로: 벤치 + 긴 화분
	for _, bp in { { -60, 1 }, { 20, 1 }, { -20, -1 }, { 60, -1 } } do
		bench(m, at(bp[1], FY2, bp[2] * (GZ - 4), if bp[2] > 0 then FACE_NZ else FACE_PZ), m2s(2.4), C.oak)
	end
	for _, pp in { { -40, 1 }, { 40, 1 }, { -40, -1 }, { 40, -1 } } do
		S(m, at(pp[1], FY2 + 1.0, pp[2] * (VZ + 2.6)), Vector3.new(9, 2.0, 2.2), rgb(70, 68, 66), MAT.Concrete, "Planter")
		Kit.ellipsoid(m, at(pp[1], FY2 + 2.1, pp[2] * (VZ + 2.6)), Vector3.new(8.6, 2.2, 2.0), P.Leaf2, MAT.Grass, { name = "Shrub", query = false })
	end

	-- 보이드: 볼트에서 내려오는 대형 펜던트 3(실제 광원), 클리어스토리 행잉 배너 6, 벽 조명
	local vaultY = H + 0.8 + m2s(10) - 1
	for _, px in { -60, -20, 20 } do
		local gy = FY2 + 16
		D(m, at(px, (gy + vaultY) / 2, 0), Vector3.new(0.12, vaultY - gy, 0.12), C.black, MAT.Metal, "PendantCable")
		local g = Kit.ball(m, (at(px, gy, 0)).Position, 3.2, rgb(255, 226, 180), MAT.Neon, { name = "PendantGlobe", collide = false, query = false, shadow = false, glow = true, dayMaterial = MAT.Glass, dayColor = rgb(236, 230, 220) })
		D(m, at(px, gy + 1.9, 0), Vector3.new(1.4, 0.6, 1.4), C.bronze, MAT.Metal, "PendantCap", 0.2)
		light(g, "PointLight", { color = rgb(255, 222, 176), brightness = 1.4, range = 58 })
	end
	local BANNERS = { "가을 페스티벌\nAUTUMN\nFESTIVAL", "11.01\n—\n11.30", "아트리움 몰\nATRIUM\nMALL" }
	for i, bx in { -72, 0, 72 } do
		for _, sz in { -1, 1 } do
			local yawB = if sz > 0 then FACE_NZ else FACE_PZ
			local bcf = at(bx, FY2 + 26, sz * (GZ - 1.6), yawB)
			D(m, bcf * CFrame.new(0, 8.6, 0), Vector3.new(6.2, 0.25, 0.25), C.steelDark, MAT.Metal, "BannerRod")
			local col = if (i + (if sz > 0 then 0 else 1)) % 2 == 0 then rgb(150, 30, 44) else rgb(28, 50, 110)
			sign(m, bcf, Vector3.new(5.6, 16.6, 0.12), col, MAT.Fabric, BANNERS[i], rgb(255, 244, 224), 20)
		end
	end
	for _, sz in { -1, 1 } do
		for _, x in { -50, 50 } do
			local sc = N(m, at(x, FY2 + 9.5, sz * (GZ - 0.45), if sz > 0 then FACE_NZ else FACE_PZ), Vector3.new(1.0, 2.2, 0.3), C.warmLight, "Sconce")
			if x == 50 then
				light(sc, "PointLight", { color = rgb(255, 224, 186), brightness = 0.9, range = 24 })
			end
		end
	end

	-- 상점 27 (1층 북/남 + 2층 북/남)
	local rowsDef = {
		{ s = 1, yf = FY1, ytop = slabB, ceilB = c1B, list = SHOPS_L1P, skip = mid },
		{ s = -1, yf = FY1, ytop = slabB, ceilB = c1B, list = SHOPS_L1N, skip = -1 },
		{ s = 1, yf = FY2, ytop = c2B + 0.6, ceilB = c2B, list = SHOPS_L2P, skip = -1 },
		{ s = -1, yf = FY2, ytop = c2B + 0.6, ceilB = c2B, list = SHOPS_L2N, skip = -1 },
	}
	for _, row in rowsDef do
		local idx = 0
		for k = 0, nS - 1 do
			if k ~= row.skip then
				idx += 1
				local spec = row.list[idx]
				if spec then
					buildShop(m, HF, -GX + k * sw, -GX + (k + 1) * sw, row.s, row.yf, row.ytop, row.ceilB, GZ, SD, spec, rng)
				end
			end
		end
	end
end

------------------------------------------------------------------------------------------------------
-- 진입점
------------------------------------------------------------------------------------------------------
function LandmarkInterior.build(ctx: any)
	local L = Landmark.layout
	if not L or not L.lobby or not L.obs or not L.hall then
		warn("[SeoulSkyline] LandmarkInterior: Landmark.layout 이 없습니다 — Landmark 를 먼저 빌드하세요")
		return
	end
	lightsUsed = 0
	local rng: Random = ctx.rng
	local root: Model = ctx.model
	local TF: CFrame = L.TF
	local Lb, Ob, Hl = L.lobby, L.obs, L.hall
	-- 엘리베이터 도착 지점(캐릭터 피벗 = 바닥 + 3.5, SeoulSkylineBoot 가 -Z 를 보게 세움)
	local obsT = (TF * CFrame.new(0, Ob.yA + 0.15 + 3.5, -CORE_H - 9)).Position
	local loungeT = (TF * CFrame.new(0, Ob.yB + 0.15 + 3.5, -CORE_H - 9)).Position
	local lobbyT = (TF * CFrame.new(0, Lb.floorY + 3.5, Lb.ZB + 22)).Position
	local p0 = Kit.stats.parts
	buildLobby(Kit.group(root, "TowerLobby", Config.InteriorStreaming), TF, Lb, obsT, rng)
	local p1 = Kit.stats.parts
	buildObservatory(Kit.group(root, "SeoulSky", Config.InteriorStreaming), Kit.group(root, "SeoulSkyGlow"), TF, Ob, lobbyT, obsT, loungeT, rng)
	local p2 = Kit.stats.parts
	buildMall(Kit.group(root, "MallAtrium", Config.InteriorStreaming), Hl, rng)
	local p3 = Kit.stats.parts
	-- 다른 도구/디버그용 좌표
	root:SetAttribute("LobbyEntrance", (TF * CFrame.new(0, Lb.floorY + 3.5, Lb.W + 8)).Position)
	root:SetAttribute("LobbyArrival", lobbyT)
	root:SetAttribute("ObservatoryArrival", obsT)
	root:SetAttribute("LoungeArrival", loungeT)
	root:SetAttribute("MallEntrance", (Hl.cf * CFrame.new(0, Hl.FY1 + 3.5, Hl.HZ + 8)).Position)
	root:SetAttribute("Parts", string.format("lobby %d / observatory %d / mall %d", p1 - p0, p2 - p1, p3 - p2))
	root:SetAttribute("Lights", lightsUsed)
end

return LandmarkInterior
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000A"><Properties><string name="Name">Park</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Park
-- 가까운 쪽(+Z) 한강공원 + 관람 전망대(플레이어 스폰).  실측 스케일: 1 stud = 0.3 m (Config.m(미터) → stud).
--
--   * 범위: Z [N.WaterEdge + 24 m, N.SlopeTo] (≈ 780 ~ 1317), X ±800 m. 수변 띠(700 ~ 777)는 Riverside 소유, 다리 축
--     (Bridge.X ± (반폭 + 6 m)) 은 비움. 히어로 구도 하단(Z 790 ~ 965)은 둥근 수관이 촘촘한 "숲 카펫" 띠이고,
--     그 강 쪽 가장자리 산책로의 공원등(4.5 m) 줄이 수관을 아래에서 비춤.
--   * 높이 층(겹치는 면 없음): 잔디(지형) 5.0 / 연결 산책로 +0.4 (이음 원판 +0.1) / 메인·강변 산책로 +0.8
--     (이음 +0.5) / 광장·매점 테라스·주차장 +1.2 / 주차선 +1.5.  교차부는 위층이 아래층을 덮음.
--   * 전망대(60 m): DeckCenter 위 16 x 12 m 데크(유리 난간 1.15 m, 망원경 1.3 m, 벤치 0.45 m), 콘크리트 코어 Ø 3.2 m
--     + 경사 버팀대 4.
--     뒤쪽 원통 유리 계단탑: 가운데 유리 엘리베이터 샤프트(Ø 2.7 m) + 둘레 나선 계단(유효폭 1.6 m,
--     챌판 0.17 m / 디딤판 0.30 m, 한 바퀴 48 단 = 8.2 m) → 꼭대기 착지판 → 데크. 지붕 없음(히어로 좌하단 가림 방지).
--     디테일: 데크 앞 "잠실 야경" 경사 안내판(약도 + 이름표), 계단 입구 표지(조명) + 샤프트에 10 m 마다 높이 표시,
--     엘리베이터 호출 버튼(SeoulElevator) 받침 기둥 + 지상 안내 토템 / 데크 계단 안내판. 버튼 위치는 그대로.
--   * 한강 편의점(KIOSK_X, 메인 산책로 강 쪽): 12 x 8 m, 천장고 2.9 m, 지붕 3.45 m(+ 띠 간판 3.75 m).
--     강 쪽 전면 유리 커튼월 + 자동문(유효폭 1.8 m x 2.3 m, 열린 상태; 문짝 태그 SeoulAutoDoor + ClosedOffset).
--     실내: 60 cm 타일 바닥, 곤돌라 2 (1.8 m, 4 단 양면, 상품 반복 패턴), 음료 냉장고 벽(유리문 6, 네온 백라이트),
--     아이스크림 냉동고, 한강라면 조리기 4 대(LED 표시창) + 온수기 + 라면 진열대, 계산대 0.9 m(POS·핫바), 담배 진열장,
--     창가 바 테이블 1.0 m + 스툴 8, 커피·전자레인지 코너, 직원 출입문 0.9 x 2.1 m, 걸이 간판·포스터·가격표(한글).
--     강 쪽 테라스 6.9 m: 파라솔 테이블 5, 줄조명(기둥 3 ↔ 캐노피), 분리수거함 4. 뒤편 자판기 2.
--   * 공중화장실(편의점 서쪽 9 m): 10 x 6 m 노출콘크리트 파빌리온, 천장고 2.6 m, 입구 2(폭 1.0 m) + 눈가림벽,
--     세면대 0.86 m·거울, 대변기 칸(1.0 x 1.5 m), 소변기, 고창(발광 띠).
--   * 공공자전거 대여소(강변 자전거도로 옆 Z 751 ~ 769): 거치대 9 + 자전거 5 + 키오스크 + 안내판.
--     편의점 테라스 → 피크닉장 → 강변 산책로 → 자전거도로를 잇는 3 m 연결로 + 테라스 조망 축(나무 없음).
--   * 나무: 줄기 1 + 수관 타원체 1~3 개. 높이 8 ~ 14 m, 줄기 Ø 0.3 ~ 0.6 m, 수관 Ø 5 ~ 9 m.
--   * 실제 광원은 MAX_LIGHTS 이내: 전망대 → 광장 → 편의점·화장실·대여소 → 주차장 → 히어로 띠 공원등 순서.

local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)

local Park = {}

local rgb = Color3.fromRGB
local P = Config.Palette
local L = Config.Level
local N = Config.NearBank
local B = Config.Bridge
local V = Config.Viewpoint
local R = Config.Real
local M = Config.m
local MAT = Enum.Material

------------------------------------------------------------------------------------------------------
-- 상수 (레이아웃 = Config 기준 / 사물 = 실측 m)
------------------------------------------------------------------------------------------------------
local PART_BUDGET = 3260 -- 공원 본체(길·전망대·주차장·가로등·나무). 나무가 남은 예산을 채움
local INTERIOR_BUDGET = 1800 -- 편의점·화장실·자전거 대여소·전망대 디테일(실내/근접 디테일) — 본체 예산과 별도
local MAX_LIGHTS = 56 -- 본체 40 + 실내 16

local Z0 = N.WaterEdge + M(24) -- 780: Riverside 수변 띠(~777) 안쪽부터
local Z1 = N.SlopeTo -- 1317: 제방 사면 끝
local X0, X1 = -M(800), M(800) -- 공원 길이 1.6 km
local GROUND = L.Promenade -- 5 (둔치 잔디 윗면)
local CONN_TOP = GROUND + 0.4
local MAIN_TOP = GROUND + 0.8
local PLAZA_TOP = GROUND + 1.2

local BRIDGE_CORR = B.Width / 2 + M(6) -- 다리 축 비움 반폭 (= 80)

-- 히어로 카메라 시선이 Z 에서 지나는 X (화면 하단 중앙)
local function heroX(z: number): number
	local a, b = V.HeroCamPos, V.HeroCamLook
	return a.X + (b.X - a.X) * (a.Z - z) / (a.Z - b.Z)
end
local VIEW_X = heroX(Z0 + M(30)) -- ≈ 76
local BELT_X0, BELT_X1, BELT_Z1 = VIEW_X - M(255), VIEW_X + M(255), Z0 + M(56) -- 히어로 하단 숲 띠 (큰 수관, 촘촘)

-- 산책로 (폭 3 ~ 4 m)
local MAIN_W = M(4)
local CONN_W = M(3)
local EDGE_W = M(3)
local EDGE_Z = Z0 + M(4) -- 숲 앞 강변 쪽 산책로 중심선 (788 ~ 798)
local TREE_Z0 = EDGE_Z + EDGE_W / 2 + M(1)

-- 전망대
local DC = V.DeckCenter
local DY = V.DeckHeight -- 데크 바닥 윗면 (60 m)
local DECK_W, DECK_D = M(16), M(12)
local DECK_DZ = M(1) -- 데크 중심을 DeckCenter 보다 1 m 뒤(+Z)로: 앞 난간 5 m 앞, 히어로 좌하단에서 작게
local RAIL_H = M(1.15) -- 유리 난간 높이 (바닥 기준)
local STAIR_RIN, STAIR_ROUT = M(1.45), M(3.05) -- 나선 계단 (유효폭 1.6 m)
local SHAFT_R = M(1.35) -- 엘리베이터 샤프트 Ø 2.7 m
local RISER, TREAD = M(0.17), M(0.30)
local LAND_W = M(1.6) -- 꼭대기 착지판 폭
local TOWER = Vector2.new(DC.X, DC.Z + DECK_DZ + DECK_D / 2 + M(2.4) + STAIR_ROUT) -- 계단탑 중심 (X, Z)
local PLAZA = Vector2.new(DC.X, DC.Z + M(8))
local PLAZA_R = M(19)

-- 매점 / 피크닉 / 주차장 (옛 레이아웃 × 5/3)
local KIOSK_X = -500
local PICNIC = { -577, 830, -423, 893 } -- x0, z0, x1, z1 (나무 없는 잔디밭)
local LOT_X0, LOT_X1 = -1000, -783
local LOT_Z1 = N.ParkTo - M(10)
local LOT_Z0 = LOT_Z1 - (M(5) * 2 + M(6) + M(2)) -- 2.5 x 5 m 주차칸 2 열 + 통로 6 m

-- 색
local WOOD = rgb(104, 78, 56)
local STEEL = rgb(58, 62, 70)
local STEEL_LIGHT = rgb(150, 156, 164)
local STAIR_C = rgb(168, 164, 156)
local GLASS_C = rgb(124, 154, 176)
local RAIL_GLOW = rgb(104, 80, 54)
local UNDER_GLOW = rgb(214, 176, 126)
local FASCIA_GLOW = rgb(124, 96, 62)
local HELIX_GLOW = rgb(176, 132, 84)
local CAB_GLOW = rgb(226, 196, 150)
local LAMP_HEAD = P.LampWarm
local LAMP_DAY = rgb(214, 214, 206)
local POLE_C = rgb(52, 56, 62)
local BRICK_C = rgb(122, 90, 76)
local PAVE_C = rgb(124, 118, 108)
local EDGE_C = rgb(112, 108, 100)
local PLAZA_C = rgb(108, 104, 98)
local BENCH_WOOD = rgb(110, 82, 58)
local BENCH_BASE = rgb(116, 114, 110)
local BARK = P.Bark
local LEAF_LIGHT = rgb(124, 146, 70)
local LEAF_DARK = rgb(30, 54, 38)
local LEAVES = {
	rgb(60, 102, 56),
	rgb(74, 118, 62),
	rgb(54, 92, 54),
	rgb(84, 126, 66),
	rgb(64, 108, 72),
	rgb(94, 132, 68),
	rgb(50, 86, 54),
	rgb(102, 138, 72),
	rgb(76, 120, 76),
}
local CAR_COLORS = { rgb(222, 222, 224), rgb(150, 154, 160), rgb(28, 30, 34), rgb(36, 44, 70), rgb(132, 30, 30), rgb(92, 94, 98), rgb(210, 206, 196) }

------------------------------------------------------------------------------------------------------
-- 유틸
------------------------------------------------------------------------------------------------------
local function opts(name: string, extra: { [string]: any }?): any
	local o: { [string]: any } = { name = name, collide = false, query = false }
	if extra then
		for k, v in extra do
			o[k] = v
		end
	end
	if o.collide then
		o.query = true -- CanCollide 파트는 CanQuery 를 끌 수 없음
	end
	return o
end

local function glowOpts(name: string, dayColor: Color3?): any
	return { name = name, collide = false, query = false, shadow = false, glow = true, dayMaterial = MAT.SmoothPlastic, dayColor = dayColor or LAMP_DAY }
end

local lightsUsed = 0
local function tryLight(p: BasePart, className: string, props: Kit.LightProps): boolean
	if lightsUsed >= MAX_LIGHTS then
		return false
	end
	if Kit.light(p, className, props) then
		lightsUsed += 1
		return true
	end
	return false
end

local function segDist(px: number, pz: number, ax: number, az: number, bx: number, bz: number): number
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local t = if l2 > 0 then math.clamp(((px - ax) * dx + (pz - az) * dz) / l2, 0, 1) else 0
	local qx, qz = ax + dx * t - px, az + dz * t - pz
	return math.sqrt(qx * qx + qz * qz)
end

------------------------------------------------------------------------------------------------------
-- 점유 격자 (6 stud 셀): 1 = 길/벤치, 2 = 구조물(광장·매점·주차장), 3 = 히어로 띠의 빛길
------------------------------------------------------------------------------------------------------
local CELL = 6
local grid: { [number]: number } = {}

local function gkey(ix: number, iz: number): number
	return ix * 16384 + iz
end

local function mark(ix: number, iz: number, v: number)
	local k = gkey(ix, iz)
	local cur = grid[k]
	if cur == nil or cur < v then
		grid[k] = v
	end
end

local function markSeg(ax: number, az: number, bx: number, bz: number, r: number, v: number)
	local ix0, ix1 = math.floor((math.min(ax, bx) - r) / CELL), math.floor((math.max(ax, bx) + r) / CELL)
	local iz0, iz1 = math.floor((math.min(az, bz) - r) / CELL), math.floor((math.max(az, bz) + r) / CELL)
	for ix = ix0, ix1 do
		for iz = iz0, iz1 do
			if segDist((ix + 0.5) * CELL, (iz + 0.5) * CELL, ax, az, bx, bz) <= r then
				mark(ix, iz, v)
			end
		end
	end
end

local function markRect(x0: number, z0: number, x1: number, z1: number, v: number)
	for ix = math.floor(x0 / CELL), math.floor(x1 / CELL) do
		for iz = math.floor(z0 / CELL), math.floor(z1 / CELL) do
			mark(ix, iz, v)
		end
	end
end

-- (x,z) 반경 r 안에 v 이상 값의 셀이 있는가
local function occupied(x: number, z: number, r: number, v: number): boolean
	local ix0, ix1 = math.floor((x - r) / CELL), math.floor((x + r) / CELL)
	local iz0, iz1 = math.floor((z - r) / CELL), math.floor((z + r) / CELL)
	for ix = ix0, ix1 do
		for iz = iz0, iz1 do
			local g = grid[gkey(ix, iz)]
			if g and g >= v then
				local cx, cz = (ix + 0.5) * CELL - x, (iz + 0.5) * CELL - z
				if cx * cx + cz * cz <= (r + CELL * 0.71) ^ 2 then
					return true
				end
			end
		end
	end
	return false
end

------------------------------------------------------------------------------------------------------
-- 점 해시 (가로등 / 나무 간격)
------------------------------------------------------------------------------------------------------
type PointHash = { cell: number, map: { [number]: { { number } } } }

local function newHash(cell: number): PointHash
	return { cell = cell, map = {} }
end

local function hashAdd(h: PointHash, x: number, z: number, r: number)
	local k = gkey(math.floor(x / h.cell), math.floor(z / h.cell))
	local b = h.map[k]
	if not b then
		b = {}
		h.map[k] = b
	end
	table.insert(b, { x, z, r })
end

-- 가장 가까운 점과의 거리 조건: dist < k * (r + p.r) + pad 인 점이 있으면 true
local function hashHit(h: PointHash, x: number, z: number, r: number, k: number, pad: number): boolean
	local ix, iz = math.floor(x / h.cell), math.floor(z / h.cell)
	for dx = -1, 1 do
		for dz = -1, 1 do
			local b = h.map[gkey(ix + dx, iz + dz)]
			if b then
				for _, p in b do
					local ex, ez = p[1] - x, p[2] - z
					local md = k * (r + p[3]) + pad
					if ex * ex + ez * ez < md * md then
						return true
					end
				end
			end
		end
	end
	return false
end

local HASH_CELL = 40
local lamps = newHash(HASH_CELL)

------------------------------------------------------------------------------------------------------
-- 지면 높이 (레이아웃 + 잔디 둔덕)
------------------------------------------------------------------------------------------------------
local mounds: { { number } } = {} -- { x, z, r, centerY, footR }

local function groundAt(x: number, z: number): number
	local y = Kit.groundY(x, z)
	for _, m in mounds do
		local dx, dz = x - m[1], z - m[2]
		local d2 = dx * dx + dz * dz
		if d2 < m[3] * m[3] then
			y = math.max(y, m[4] + math.sqrt(m[3] * m[3] - d2))
		end
	end
	return y
end

local function inBridge(x: number, pad: number): boolean
	return math.abs(x - B.X) < BRIDGE_CORR + pad
end

local function inPicnic(x: number, z: number, pad: number): boolean
	return x > PICNIC[1] - pad and x < PICNIC[3] + pad and z > PICNIC[2] - pad and z < PICNIC[4] + pad
end

------------------------------------------------------------------------------------------------------
-- 경로 (Catmull-Rom → 직선 조각 + 꺾임 이음 원판)
------------------------------------------------------------------------------------------------------
local function catmull(pts: { Vector2 }, stepAt: (x: number) -> number): { Vector2 }
	local out: { Vector2 } = {}
	for i = 1, #pts - 1 do
		local p0 = pts[math.max(i - 1, 1)]
		local p1 = pts[i]
		local p2 = pts[i + 1]
		local p3 = pts[math.min(i + 2, #pts)]
		local n = math.max(1, math.ceil((p2 - p1).Magnitude / stepAt((p1.X + p2.X) / 2)))
		for k = 0, n - 1 do
			local t = k / n
			local t2, t3 = t * t, t * t * t
			local v = (p1 * 2 + (p2 - p0) * t + (p0 * 2 - p1 * 5 + p2 * 4 - p3) * t2 + (p1 * 3 - p0 - p2 * 3 + p3) * t3) * 0.5
			table.insert(out, v)
		end
	end
	table.insert(out, pts[#pts])
	return out
end

local function drawPath(parent: Instance, pts: { Vector2 }, width: number, top: number, color: Color3, mat: Enum.Material, name: string, skip: ((x: number) -> boolean)?)
	local th = 0.8
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local mid = (a + b) / 2
		if skip and (skip(a.X) or skip(b.X)) then
			continue
		end
		local d = b - a
		local len = d.Magnitude
		if len < 0.2 then
			continue
		end
		local cf = CFrame.lookAt(Vector3.new(mid.X, top - th / 2, mid.Y), Vector3.new(b.X, top - th / 2, b.Y))
		Kit.box(parent, cf, Vector3.new(width, th, len), color, mat, { name = name, shadow = false })
		markSeg(a.X, a.Y, b.X, b.Y, width / 2 + 1.5, 1)
		-- 꺾인 이음부 바깥쪽 틈을 아래층 원판으로 메움(윗면이 0.3 낮아 겹친 곳은 가려짐)
		if i > 1 then
			local pd = a - pts[i - 1]
			if pd.Magnitude > 0.2 then
				local c = math.clamp(pd.Unit:Dot(d.Unit), -1, 1)
				if math.acos(c) > math.rad(2.5) then
					Kit.vcyl(parent, Vector3.new(a.X, top - 0.3 - th / 2, a.Y), th, width, color, mat, opts(name .. "Joint", { shadow = false }))
				end
			end
		end
	end
end

-- 폴리라인을 따라 일정 간격(spacingAt) 위치 + 진행 방향
local function stations(pts: { Vector2 }, spacingAt: (x: number) -> number, start: number): { { Vector2 } }
	local out: { { Vector2 } } = {}
	local nextS = start
	local s = 0
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local len = (b - a).Magnitude
		if len > 0 then
			local dir = (b - a) / len
			while nextS <= s + len do
				local p = a + dir * (nextS - s)
				table.insert(out, { p, dir })
				nextS += spacingAt(p.X)
			end
		end
		s += len
	end
	return out
end

local function zOnPath(pts: { Vector2 }, x: number): number
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		if (x >= a.X and x <= b.X) or (x <= a.X and x >= b.X) then
			local t = if b.X ~= a.X then (x - a.X) / (b.X - a.X) else 0
			return a.Y + (b.Y - a.Y) * t
		end
	end
	return pts[#pts].Y
end

------------------------------------------------------------------------------------------------------
-- 공원등 / 벤치 / 휴지통 (실측)
------------------------------------------------------------------------------------------------------
local LAMP_H = R.ParkLamp -- 4.5 m
local LAMP_BALL = M(0.45)

-- 공원등: 기둥(Ø 0.12 m) + 둥근 등(Ø 0.45 m, Neon). 반환: 등 머리 파트
local function lamp(parent: Instance, x: number, z: number, base: number?): BasePart
	local hh = LAMP_H
	local gy = base or groundAt(x, z)
	Kit.vcyl(parent, Vector3.new(x, gy + (hh - 0.5) / 2, z), hh + 0.5, M(0.12), POLE_C, MAT.Metal, opts("LampPole", { shadow = false }))
	local hp = Kit.ball(parent, Vector3.new(x, gy + hh + LAMP_BALL * 0.4, z), LAMP_BALL, LAMP_HEAD, MAT.Neon, glowOpts("LampHead"))
	hashAdd(lamps, x, z, 0)
	return hp
end

local function lampLight(head: BasePart, range: number?)
	tryLight(head, "PointLight", { color = LAMP_HEAD, brightness = 1.3, range = range or M(12) })
end

-- 벤치: 좌판 높이 0.45 m, 길이 1.8 m, 깊이 0.45 m, 등받이 상단 0.85 m.  cf = 바닥 중심, 앞(-Z) = 앉는 사람이 보는 쪽
local function benchAt(parent: Instance, cf: CFrame, prefix: string)
	local len, seatY, seatD = M(1.8), M(0.45), M(0.45)
	Kit.box(parent, cf * CFrame.new(0, (seatY - 0.6) / 2, 0), Vector3.new(len * 0.7, seatY, seatD * 0.6), BENCH_BASE, MAT.Concrete, opts(prefix .. "BenchBase"))
	Kit.box(parent, cf * CFrame.new(0, seatY - 0.2, 0), Vector3.new(len, 0.4, seatD), BENCH_WOOD, MAT.WoodPlanks, opts(prefix .. "BenchSeat", { collide = true }))
	local backH = M(0.85) - seatY
	Kit.box(parent, cf * CFrame.new(0, seatY + backH / 2 - 0.1, seatD / 2 - 0.15), Vector3.new(len, backH + 0.2, 0.3), BENCH_WOOD, MAT.WoodPlanks, opts(prefix .. "BenchBack"))
end

-- 경로를 바라보는 벤치 (dirToPath: 벤치 → 경로 단위 벡터)
local function bench(parent: Instance, x: number, z: number, dirToPath: Vector2)
	local gy = groundAt(x, z)
	benchAt(parent, CFrame.lookAt(Vector3.new(x, gy, z), Vector3.new(x + dirToPath.X, gy, z + dirToPath.Y)), "")
	markSeg(x, z, x, z, M(1.2), 1)
end

-- 휴지통 Ø 0.55 m, 높이 0.9 m
local function bin(parent: Instance, x: number, z: number, gy: number)
	Kit.vcyl(parent, Vector3.new(x, gy + M(0.45) - 0.15, z), M(0.9) + 0.3, M(0.55), rgb(70, 82, 74), MAT.Metal, opts("TrashBin", { collide = true }))
end

------------------------------------------------------------------------------------------------------
-- 1) 전망대 (스폰) — 데크 + 유리 계단탑(엘리베이터 + 나선 계단) + 하부 광장
------------------------------------------------------------------------------------------------------
local function buildDeck(parent: Instance)
	local cx, cz = DC.X, DC.Z + DECK_DZ
	local hw, hd = DECK_W / 2, DECK_D / 2
	local x0, x1, z0, z1 = cx - hw, cx + hw, cz - hd, cz + hd
	local slabTop = DY - M(0.25) -- 목재 바닥 0.25 m
	local slabBot = slabTop - M(0.8) -- 강재 슬래브 0.8 m
	local sx, sz = TOWER.X, TOWER.Y
	local lh = LAND_W / 2

	-- 하부 광장 (원형 포장 Ø 38 m)
	Kit.vcyl(parent, Vector3.new(PLAZA.X, PLAZA_TOP - 0.6, PLAZA.Y), 1.2, PLAZA_R * 2, PLAZA_C, MAT.Slate, { name = "DeckPlaza", shadow = false })
	Kit.vcyl(parent, Vector3.new(PLAZA.X, PLAZA_TOP - 0.75, PLAZA.Y), 1.2, PLAZA_R * 2 + M(0.6), BENCH_BASE, MAT.Concrete, opts("PlazaCurb", { shadow = false }))

	-- 데크: 구조 슬래브 + 목재 바닥(가장자리 0.6 안쪽)
	Kit.box(parent, CFrame.new(cx, (slabTop + slabBot) / 2, cz), Vector3.new(DECK_W, slabTop - slabBot, DECK_D), STEEL, MAT.Metal, { name = "DeckSlab" })
	Kit.box(parent, CFrame.new(cx, (DY + slabTop - 0.3) / 2, cz), Vector3.new(DECK_W - 1.2, DY - slabTop + 0.3, DECK_D - 1.2), WOOD, MAT.WoodPlanks, { name = "DeckFloor" })

	-- 슬래브 옆면 LED 띠 (뒤쪽은 착지판 구간 비움)
	local fy = (slabTop + slabBot) / 2
	local fh = M(0.2)
	local gX0, gX1 = sx - lh, sx + lh
	Kit.box(parent, CFrame.new(cx, fy, z0 - 0.2), Vector3.new(DECK_W, fh, 0.4), FASCIA_GLOW, MAT.Neon, glowOpts("DeckFascia", STEEL_LIGHT))
	Kit.box(parent, CFrame.new(x0 - 0.2, fy, cz), Vector3.new(0.4, fh, DECK_D + 0.8), FASCIA_GLOW, MAT.Neon, glowOpts("DeckFascia", STEEL_LIGHT))
	Kit.box(parent, CFrame.new(x1 + 0.2, fy, cz), Vector3.new(0.4, fh, DECK_D + 0.8), FASCIA_GLOW, MAT.Neon, glowOpts("DeckFascia", STEEL_LIGHT))
	Kit.box(parent, CFrame.new((x0 + gX0) / 2, fy, z1 + 0.2), Vector3.new(gX0 - x0, fh, 0.4), FASCIA_GLOW, MAT.Neon, glowOpts("DeckFascia", STEEL_LIGHT))
	Kit.box(parent, CFrame.new((gX1 + x1) / 2, fy, z1 + 0.2), Vector3.new(x1 - gX1, fh, 0.4), FASCIA_GLOW, MAT.Neon, glowOpts("DeckFascia", STEEL_LIGHT))

	-- 하부 다운라이트 6 (+ SpotLight 2)
	for _, dx in { -(hw - M(3)), hw - M(3) } do
		for j, dz in { -M(3), 0, M(3) } do
			local dl = Kit.box(parent, CFrame.new(cx + dx, slabBot - 0.1, cz + dz), Vector3.new(M(0.7), 0.3, M(0.7)), UNDER_GLOW, MAT.Neon, glowOpts("DeckDownlight", STEEL_LIGHT))
			if j == 2 then
				tryLight(dl, "SpotLight", { face = Enum.NormalId.Bottom, angle = 70, range = 60, brightness = 2.6, color = P.LampWarm })
			end
		end
	end

	-- 받침: 가운데 콘크리트 코어(Ø 3.2 m) + 머리 확대부(Ø 5 m) + 경사 강관 버팀대 4 + 세로 LED 4
	local coreR = M(1.6)
	local capH = M(1.2)
	local coreTop = slabBot - capH + 0.3
	local coreBot = PLAZA_TOP - 0.5
	Kit.vcyl(parent, Vector3.new(cx, (coreTop + coreBot) / 2, cz), coreTop - coreBot, coreR * 2, rgb(200, 196, 188), MAT.Concrete, { name = "DeckCore" })
	Kit.vcyl(parent, Vector3.new(cx, slabBot - capH / 2 + 0.15, cz), capH + 0.3, M(5), rgb(186, 182, 174), MAT.Concrete, { name = "DeckCoreCap" })
	for q = 0, 3 do
		local a = math.rad(45 + 90 * q)
		Kit.box(parent, CFrame.new(cx + math.cos(a) * (coreR + 0.05), (PLAZA_TOP + coreTop) / 2, cz + math.sin(a) * (coreR + 0.05)) * CFrame.Angles(0, -a, 0), Vector3.new(0.3, coreTop - PLAZA_TOP, 0.4), FASCIA_GLOW, MAT.Neon, glowOpts("CoreLed", STEEL_LIGHT))
		local sxq, szq = if q == 0 or q == 3 then 1 else -1, if q <= 1 then 1 else -1
		local pa = Vector3.new(cx + sxq * coreR * 0.6, slabBot - M(10), cz + szq * coreR * 0.6)
		local pb = Vector3.new(cx + sxq * (hw - M(2)), slabBot + 0.3, cz + szq * (hd - M(1.8)))
		Kit.cylAlongY(parent, CFrame.lookAt((pa + pb) / 2, pb) * CFrame.Angles(math.rad(90), 0, 0), (pb - pa).Magnitude, M(0.45), STEEL_LIGHT, MAT.Metal, { name = "DeckStrut" })
	end

	-- 착지판: 계단 꼭대기(탑 -Z 쪽) → 데크 뒤 가장자리 (바닥 윗면 = DY)
	local landT = 1.0
	local lz0, lz1 = z1 - 0.6, sz - STAIR_RIN
	Kit.box(parent, CFrame.new(sx, DY - landT / 2, (lz0 + lz1) / 2), Vector3.new(LAND_W, landT, lz1 - lz0), WOOD, MAT.WoodPlanks, { name = "StairLanding" })
	Kit.box(parent, CFrame.new(sx, DY - landT - M(0.3), (z1 + sz - STAIR_ROUT) / 2), Vector3.new(LAND_W, M(0.6), sz - STAIR_ROUT - z1), STEEL, MAT.Metal, { name = "LandingBeam" })

	-- 유리 난간(1.15 m) + 발광 손잡이
	local gTop = DY + RAIL_H
	local function rail(cfr: CFrame, len: number)
		local y0 = slabTop - 0.3
		Kit.box(parent, cfr * CFrame.new(0, (y0 + gTop) / 2 - cfr.Position.Y, 0), Vector3.new(len, gTop - y0, 0.3), GLASS_C, MAT.Glass, { name = "GlassRail", transparency = 0.72 })
		Kit.box(parent, cfr * CFrame.new(0, gTop + 0.15 - cfr.Position.Y, 0), Vector3.new(len + 0.3, 0.3, 0.4), RAIL_GLOW, MAT.Neon, glowOpts("Handrail", STEEL_LIGHT))
	end
	local turn = CFrame.Angles(0, math.rad(90), 0)
	rail(CFrame.new(cx, DY, z0 + 0.4), DECK_W - 0.8)
	rail(CFrame.new(x0 + 0.4, DY, cz) * turn, DECK_D - 0.8)
	rail(CFrame.new(x1 - 0.4, DY, cz) * turn, DECK_D - 0.8)
	rail(CFrame.new((x0 + 0.4 + gX0) / 2, DY, z1 - 0.4), gX0 - x0 - 0.4)
	rail(CFrame.new((gX1 + x1 - 0.4) / 2, DY, z1 - 0.4), x1 - 0.4 - gX1)
	-- 착지판 양옆: -X 쪽은 탑 밖 구간만(계단에서 들어오는 입구), +X 쪽은 계단 우물 위까지
	rail(CFrame.new(gX0 + 0.2, DY, (z1 + sz - STAIR_ROUT - 0.6) / 2) * turn, sz - STAIR_ROUT - 0.6 - z1)
	rail(CFrame.new(gX1 - 0.2, DY, (z1 + sz - STAIR_RIN) / 2) * turn, sz - STAIR_RIN - z1)

	-- 엘리베이터: 유리 원통 샤프트 + 세로 LED 4 + 발광 캐빈 + 상부 기계실 캡 + 하부 링
	local shaftTop = DY + M(3.0)
	local shaftH = shaftTop - PLAZA_TOP
	Kit.vcyl(parent, Vector3.new(sx, PLAZA_TOP + shaftH / 2, sz), shaftH, SHAFT_R * 2, GLASS_C, MAT.Glass, { name = "ElevatorShaft", transparency = 0.5, shadow = false })
	for k = 0, 3 do
		local a = math.rad(45 + 90 * k)
		Kit.box(parent, CFrame.new(sx + math.cos(a) * (SHAFT_R + 0.15), PLAZA_TOP + shaftH / 2, sz + math.sin(a) * (SHAFT_R + 0.15)) * CFrame.Angles(0, -a, 0), Vector3.new(0.3, shaftH, 0.3), FASCIA_GLOW, MAT.Neon, glowOpts("ShaftLed", STEEL_LIGHT))
	end
	local cab = Kit.box(parent, CFrame.new(sx, PLAZA_TOP + shaftH * 0.42, sz), Vector3.new(M(1.5), M(2.3), M(1.5)), CAB_GLOW, MAT.Neon, glowOpts("ElevatorCab", rgb(200, 200, 196)))
	tryLight(cab, "PointLight", { color = CAB_GLOW, brightness = 1.4, range = M(10) })
	-- 작동하는 엘리베이터: 호출 버튼(ProximityPrompt) → SeoulSkylineBoot 이 플레이어를 반대편 층으로 이동
	local function callButton(pos: Vector3, target: Vector3, action: string)
		local b = Kit.box(parent, CFrame.new(pos), Vector3.new(M(0.45), M(0.6), M(0.45)), CAB_GLOW, MAT.Neon, glowOpts("ElevatorCall", STEEL_LIGHT))
		b.CanQuery = true
		b:SetAttribute("ElevatorTarget", target)
		local pp = Instance.new("ProximityPrompt")
		pp.ActionText = action
		pp.ObjectText = "전망대 엘리베이터"
		pp.HoldDuration = 0.3
		pp.MaxActivationDistance = 12
		pp.RequiresLineOfSight = false
		pp.Parent = b
		game:GetService("CollectionService"):AddTag(b, "SeoulElevator")
	end
	local downAt = Vector3.new(sx, PLAZA_TOP + M(1.1), sz + STAIR_ROUT + M(1.2))
	local upAt = Vector3.new(cx + hw - M(1.6), DY + M(1.1), z1 - M(1.4))
	callButton(downAt, Vector3.new(cx, DY + 3.5, cz), "전망대로 올라가기")
	callButton(upAt, Vector3.new(sx, PLAZA_TOP + 3.5, sz + STAIR_ROUT + M(3.5)), "공원으로 내려가기")
	Kit.vcyl(parent, Vector3.new(sx, shaftTop + M(0.2), sz), M(0.4), SHAFT_R * 2 + M(0.4), STEEL_LIGHT, MAT.Metal, { name = "ShaftCap" })
	local ring = Kit.vcyl(parent, Vector3.new(sx, PLAZA_TOP, sz), 0.6, (STAIR_ROUT + 0.6) * 2, STEEL, MAT.Metal, { name = "TowerBase" })
	tryLight(ring, "PointLight", { color = P.LampWarm, brightness = 1.2, range = M(12) })

	-- 나선 계단: 챌판 0.17 m, 보행선(중심 반경) 디딤판 0.30 m → 한 바퀴 48 단.
	-- 마지막 단 다음이 착지판(θ = -90°, 데크 쪽). 진행 방향 = θ 증가.
	local rise = DY - PLAZA_TOP
	local n = math.ceil(rise / RISER)
	local riser = rise / n
	local rc = (STAIR_RIN + STAIR_ROUT) / 2
	local perTurn = math.floor(2 * math.pi * rc / TREAD + 0.5)
	local dTheta = 2 * math.pi / perTurn
	local thLand = -math.pi / 2
	local thLast = thLand - math.asin(lh / rc) - dTheta * 0.5
	local stepW = STAIR_ROUT - STAIR_RIN
	local depth = 2 * STAIR_ROUT * math.tan(dTheta / 2) + 0.1
	local stepT = 0.9
	local stairs = Kit.group(parent, "SpiralStair")
	for k = 1, n - 1 do
		local th = thLast - (n - 1 - k) * dTheta
		local top = PLAZA_TOP + k * riser
		local rm = (STAIR_RIN + STAIR_ROUT) / 2
		local c = Vector3.new(sx + rm * math.cos(th), top - stepT / 2, sz + rm * math.sin(th))
		local tangent = Vector3.new(-math.sin(th), 0, math.cos(th))
		Kit.box(stairs, CFrame.lookAt(c, c + tangent), Vector3.new(stepW, stepT, depth), STAIR_C, MAT.Concrete, { name = "Step", shadow = false })
	end
	-- 계단 바깥 가장자리 LED 나선 (6 단마다 한 조각)
	local ledR = STAIR_ROUT - 0.3
	local k = 1
	while k < n - 1 do
		local k2 = math.min(k + 6, n - 1)
		local ta, tb = thLast - (n - 1 - k) * dTheta, thLast - (n - 1 - k2) * dTheta
		local pa = Vector3.new(sx + ledR * math.cos(ta), PLAZA_TOP + k * riser - stepT - 0.15, sz + ledR * math.sin(ta))
		local pb = Vector3.new(sx + ledR * math.cos(tb), PLAZA_TOP + k2 * riser - stepT - 0.15, sz + ledR * math.sin(tb))
		Kit.box(stairs, CFrame.lookAt((pa + pb) / 2, pb), Vector3.new(0.3, 0.3, (pb - pa).Magnitude + 0.2), HELIX_GLOW, MAT.Neon, glowOpts("StairLed", STEEL_LIGHT))
		k = k2
	end

	-- 원통 유리 외피(24 면, 아래 2.3 m 는 출입 개방) + LED 멀리언 12. 착지판 앞 2 면은 착지판 아래에서 끝남.
	local NP = 24
	local pr = STAIR_ROUT + 0.4
	local pw = 2 * pr * math.tan(math.pi / NP) + 0.1
	local yB = PLAZA_TOP + M(2.3)
	local yT = DY + RAIL_H
	local skin = Kit.group(parent, "TowerSkin")
	for p = 0, NP - 1 do
		local a = thLand + (p + 0.5) * 2 * math.pi / NP
		local top = if p == 0 or p == NP - 1 then DY - landT - M(0.6) else yT
		local c = Vector3.new(sx + pr * math.cos(a), (yB + top) / 2, sz + pr * math.sin(a))
		Kit.box(skin, CFrame.lookAt(c, Vector3.new(sx, c.Y, sz)), Vector3.new(pw, top - yB, 0.3), GLASS_C, MAT.Glass, { name = "TowerGlass", transparency = 0.66 })
		if p % 2 == 1 then
			local am = thLand + (p + 1) * 2 * math.pi / NP
			local mr = pr + 0.25
			Kit.box(skin, CFrame.new(sx + mr * math.cos(am), (PLAZA_TOP + yT) / 2, sz + mr * math.sin(am)) * CFrame.Angles(0, -am, 0), Vector3.new(0.35, yT - PLAZA_TOP, 0.35), FASCIA_GLOW, MAT.Neon, glowOpts("TowerLed", STEEL_LIGHT))
		end
	end

	-- 데크 소품: 유료 망원경 3 (높이 1.3 m), 벤치 2
	for _, dx in { -M(6.2), M(1.2), M(5.4) } do
		local tx, tz = cx + dx, z0 + M(0.9)
		Kit.vcyl(parent, Vector3.new(tx, DY + M(0.525) - 0.15, tz), M(1.05) + 0.3, M(0.16), STEEL_LIGHT, MAT.Metal, opts("ScopePost", { collide = true }))
		Kit.box(parent, CFrame.new(tx, DY + M(1.15), tz) * CFrame.Angles(math.rad(10), 0, 0), Vector3.new(M(0.32), M(0.28), M(0.5)), rgb(40, 96, 110), MAT.Metal, opts("Binocular"))
	end
	for _, dx in { -M(4.5), M(4.5) } do
		benchAt(parent, CFrame.new(cx + dx, DY, cz + M(3.4)), "Deck")
	end
	-- 볼라드 조명 2 (0.9 m): 데크 바닥을 따뜻하게 (히어로 좌하단에서 불 켜진 전망대로 읽히도록)
	for i, dx in { -(hw - M(1)), hw - M(1) } do
		local bx, bz = cx + dx, z1 - M(1)
		Kit.vcyl(parent, Vector3.new(bx, DY + M(0.4) - 0.15, bz), M(0.8) + 0.3, M(0.2), STEEL, MAT.Metal, opts("Bollard", { collide = true }))
		local bh = Kit.vcyl(parent, Vector3.new(bx, DY + M(0.85), bz), M(0.1), M(0.2), LAMP_HEAD, MAT.Neon, glowOpts("BollardLight"))
		if i == 1 then
			tryLight(bh, "PointLight", { color = P.LampWarm, brightness = 1.6, range = M(11) })
		end
	end

	-- 포토 스팟: 바닥 표지판 + 삼각대(1.5 m) + 카메라(PhotoSpot, ProximityPrompt)
	local px, pz = cx - M(2.6), z0 + M(1.6)
	local plate = Kit.box(parent, CFrame.new(px, DY + 0.1, pz + M(0.9)), Vector3.new(M(1.5), 0.4, M(0.7)), rgb(34, 36, 42), MAT.SmoothPlastic, opts("PhotoSpotSign"))
	Kit.label(plate, Enum.NormalId.Top, "포토 스팟", { glow = true, color = rgb(255, 214, 150), pixelsPerStud = 40 })
	tryLight(plate, "PointLight", { color = P.LampWarm, brightness = 0.9, range = M(4) })
	Kit.vcyl(parent, Vector3.new(px, DY + M(0.72), pz), M(1.44), M(0.05), STEEL, MAT.Metal, opts("Tripod"))
	local spot = Kit.box(parent, CFrame.new(px, DY + M(1.52), pz), Vector3.new(M(0.36), M(0.26), M(0.22)), rgb(24, 24, 28), MAT.SmoothPlastic, { name = "PhotoSpot", collide = false, query = true })
	Kit.hcyl(parent, CFrame.new(px, DY + M(1.52), pz - M(0.16)) * CFrame.Angles(0, math.rad(90), 0), M(0.12), M(0.18), rgb(60, 62, 70), MAT.Glass, opts("Lens"))
	spot:SetAttribute("HeroCamPos", V.HeroCamPos)
	spot:SetAttribute("HeroCamLook", V.HeroCamLook)
	spot:SetAttribute("HeroFov", V.HeroFov)
	local pp = Instance.new("ProximityPrompt")
	pp.Name = "PhotoPrompt"
	pp.ActionText = "사진 구도"
	pp.ObjectText = "포토 스팟"
	pp.HoldDuration = 0
	pp.MaxActivationDistance = M(3.6)
	pp.RequiresLineOfSight = false
	pp.KeyboardKeyCode = Enum.KeyCode.E
	pp.Parent = spot

	-- 스폰 (반투명 패드 2 x 2 m, 정면 = -Z). 바닥과 면이 겹치지 않게 0.3 띄움
	local sp = Instance.new("SpawnLocation")
	sp.Name = "DeckSpawn"
	sp.Anchored = true
	sp.Size = Vector3.new(M(2), 0.4, M(2))
	sp.CFrame = CFrame.new(cx + M(2), DY + 0.15, DC.Z + M(0.8))
	sp.Material = MAT.SmoothPlastic
	sp.Color = rgb(232, 204, 160)
	sp.Transparency = 0.8
	sp.TopSurface = Enum.SurfaceType.Smooth
	sp.BottomSurface = Enum.SurfaceType.Smooth
	sp.CastShadow = false
	sp.CanCollide = true
	sp.Neutral = true
	sp.Duration = 0
	sp.AllowTeamChangeOnTouch = false
	sp.Enabled = true
	sp.Parent = parent
	Kit.stats.parts += 1

	-- 광장 공원등 4 (광원) + 벤치 2
	for q = 0, 3 do
		local a = math.rad(200 + q * 45)
		local lx, lz = PLAZA.X + math.cos(a) * (PLAZA_R - M(1.5)), PLAZA.Y + math.sin(a) * (PLAZA_R - M(1.5))
		local hp = lamp(parent, lx, lz, PLAZA_TOP)
		lampLight(hp)
	end
	for _, a in { 160, 20 } do
		local r = PLAZA_R - M(2.5)
		local bx, bz = PLAZA.X + math.cos(math.rad(a)) * r, PLAZA.Y + math.sin(math.rad(a)) * r
		benchAt(parent, CFrame.lookAt(Vector3.new(bx, PLAZA_TOP, bz), Vector3.new(PLAZA.X, PLAZA_TOP, PLAZA.Y)), "Plaza")
	end

	-- 예약 / 격자 (광장 원판 + 데크 전체)
	Kit.reserve(PLAZA.X - PLAZA_R, PLAZA.Y - PLAZA_R, PLAZA.X + PLAZA_R, PLAZA.Y + PLAZA_R, "ParkDeck")
	Kit.reserve(x0, z0, x1, z1, "ParkDeckSlab")
	for ix = math.floor((PLAZA.X - PLAZA_R) / CELL) - 1, math.floor((PLAZA.X + PLAZA_R) / CELL) + 1 do
		for iz = math.floor((PLAZA.Y - PLAZA_R) / CELL) - 1, math.floor((PLAZA.Y + PLAZA_R) / CELL) + 1 do
			local ex, ez = (ix + 0.5) * CELL - PLAZA.X, (iz + 0.5) * CELL - PLAZA.Y
			if ex * ex + ez * ez <= (PLAZA_R + M(1)) ^ 2 then
				mark(ix, iz, 2)
			end
		end
	end
end

------------------------------------------------------------------------------------------------------
-- 실내 헬퍼: ORG 기준 로컬 미터 좌표 (축 정렬 건물, -Z = 강 쪽).  B = 두 모서리 상자, CY = 세로 원기둥(바닥~윗면),
-- CH = 가로 원기둥(로컬 X 축 / alongZ), BAR = 두 점 사이 각재(튜브·전선).  모두 미터 단위.
------------------------------------------------------------------------------------------------------
local ORG = CFrame.identity
local irng = Random.new(Config.SEED + 4242) -- 실내 소품 전용(공원 rng 순서를 건드리지 않음) — Park.build 에서 재시드

local function at(x: number, y: number, z: number): CFrame
	return ORG * CFrame.new(M(x), M(y), M(z))
end

local function solid(name: string, extra: { [string]: any }?): any
	local o = opts(name, extra)
	o.collide = true
	o.query = true
	return o
end

local function BX(parent: Instance, x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, color: Color3, mat: Enum.Material, o: any?): BasePart
	return Kit.box(parent, at((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2), Vector3.new(M(math.abs(x1 - x0)), M(math.abs(y1 - y0)), M(math.abs(z1 - z0))), color, mat, o or opts("Prop"))
end

local function CY(parent: Instance, x: number, z: number, y0: number, y1: number, dia: number, color: Color3, mat: Enum.Material, o: any?): BasePart
	return Kit.cylAlongY(parent, at(x, (y0 + y1) / 2, z), M(y1 - y0), M(dia), color, mat, o or opts("Prop"))
end

local function CH(parent: Instance, x: number, y: number, z: number, len: number, dia: number, alongZ: boolean, color: Color3, mat: Enum.Material, o: any?): BasePart
	local cf = at(x, y, z)
	if alongZ then
		cf *= CFrame.Angles(0, math.rad(90), 0)
	end
	return Kit.hcyl(parent, cf, M(len), M(dia), color, mat, o or opts("Prop"))
end

local function BAR(parent: Instance, a: Vector3, b: Vector3, t: number, color: Color3, mat: Enum.Material, o: any?): BasePart
	local pa, pb = at(a.X, a.Y, a.Z).Position, at(b.X, b.Y, b.Z).Position
	local d = pb - pa
	local up = if math.abs(d.Unit.Y) > 0.98 then Vector3.zAxis else Vector3.yAxis
	return Kit.box(parent, CFrame.lookAt((pa + pb) / 2, pb, up), Vector3.new(M(t), M(t), d.Magnitude + M(t) * 0.5), color, mat, o or opts("Prop"))
end

-- 야간 발광 + 충돌(벽 일부인 발광 띠)
local function glowSolid(name: string, dayColor: Color3?): any
	local o = glowOpts(name, dayColor)
	o.collide = true
	o.query = true
	return o
end

local function matOr(name: string, fallback: Enum.Material): Enum.Material
	local ok, m = pcall(function(): any
		return (Enum.Material :: any)[name]
	end)
	if ok and typeof(m) == "EnumItem" then
		return m :: Enum.Material
	end
	return fallback
end
local TILE_MAT = matOr("CeramicTiles", MAT.SmoothPlastic)

-- 색 (편의점 = 가상 브랜드: 청록 띠 + 라임 포인트)
local WHITE_WALL = rgb(236, 234, 228)
local BRAND = rgb(20, 112, 134)
local BRAND2 = rgb(150, 206, 64)
local SS = rgb(184, 188, 194) -- 스테인리스
local SS_DARK = rgb(116, 120, 126)
local FLOOR_TILE = rgb(212, 210, 204)
local GROUT = rgb(160, 158, 152)
local LED_COOL = rgb(232, 242, 255)
local LED_DAY = rgb(226, 228, 230)
local GLASS_STORE = rgb(176, 200, 214)
local FRAME_DARK = rgb(44, 48, 54)
local WHITE_LABEL = rgb(255, 255, 255)

-- 상품 팔레트 / 진열 패턴(폭·높이 m, 같은 상품 연속 수 run, 깊이 d, cyl = 원기둥)
local C_SNACK = { rgb(222, 50, 44), rgb(250, 198, 40), rgb(244, 130, 36), rgb(40, 108, 198), rgb(58, 158, 78), rgb(150, 68, 170), rgb(238, 236, 228), rgb(34, 34, 38) }
local C_RAMEN = { rgb(204, 30, 30), rgb(224, 52, 36), rgb(238, 122, 30), rgb(250, 202, 60), rgb(34, 30, 30), rgb(240, 236, 224), rgb(178, 28, 36) }
local C_DAILY = { rgb(238, 242, 246), rgb(118, 180, 222), rgb(98, 190, 160), rgb(242, 170, 192), rgb(250, 222, 120), rgb(168, 200, 92), rgb(70, 90, 160) }
local C_SWEET = { rgb(118, 68, 40), rgb(202, 30, 60), rgb(250, 200, 40), rgb(240, 120, 160), rgb(82, 50, 30), rgb(238, 230, 210), rgb(60, 120, 200) }
local C_BREAD = { rgb(230, 190, 120), rgb(200, 148, 88), rgb(242, 232, 212), rgb(250, 212, 80), rgb(212, 92, 60), rgb(120, 170, 222) }
local C_DRINK = { rgb(74, 30, 22), rgb(236, 120, 30), rgb(70, 150, 230), rgb(176, 120, 52), rgb(120, 196, 110), rgb(222, 52, 44), rgb(240, 214, 80) }
local C_CAN = { rgb(200, 204, 210), rgb(36, 80, 170), rgb(214, 170, 60), rgb(40, 120, 60), rgb(200, 40, 40), rgb(30, 30, 34), rgb(240, 240, 236) }
local C_CIG = { rgb(240, 240, 236), rgb(196, 200, 206), rgb(30, 46, 96), rgb(200, 36, 40), rgb(206, 168, 80), rgb(110, 170, 220), rgb(40, 110, 70), rgb(26, 26, 30), rgb(120, 70, 140) }

-- 진열 패턴 (실측 m): w = 한 개 폭, h = 높이, d = 앞뒤 줄 깊이, gap = 개별 상품 사이 틈(≥ 2 cm, 낱개로 읽힘),
-- run = 같은 상품 연속 수(페이싱), fill = 페이싱이 채워질 확률(빈 자리 = 팔린 칸), stack = 세로 적층, lid = 컵 뚜껑 색
local G_MULTI = { colors = C_SNACK, w = { 0.26, 0.34 }, h = { 0.22, 0.3 }, run = { 1, 2 }, gap = 0.03, d = 0.28, fill = 0.9 } -- 묶음 과자
local G_BOX = { colors = C_SWEET, w = { 0.12, 0.18 }, h = { 0.15, 0.22 }, run = { 2, 4 }, gap = 0.025, d = 0.24, fill = 0.85 } -- 쿠키·비스킷 상자
local G_BAG = { colors = C_SNACK, w = { 0.17, 0.19 }, h = { 0.24, 0.26 }, run = { 2, 4 }, gap = 0.025, d = 0.26, fill = 0.85 } -- 봉지 과자 18 x 25 cm
local G_BAG_S = { colors = C_SNACK, w = { 0.14, 0.16 }, h = { 0.2, 0.23 }, run = { 2, 3 }, gap = 0.025, d = 0.24, fill = 0.6 } -- 작은 봉지(반쯤 팔림)
local G_RAMEN5 = { colors = C_RAMEN, w = { 0.36, 0.4 }, h = { 0.16, 0.2 }, run = { 1, 2 }, gap = 0.03, d = 0.27, fill = 0.9 } -- 5 입 묶음
local G_BOWL = { colors = C_RAMEN, w = { 0.15, 0.16 }, h = { 0.085, 0.095 }, run = { 2, 4 }, gap = 0.02, d = 0.16, cyl = true, stack = 2, fill = 0.85 } -- 큰사발 2 단
local G_CUP = { colors = C_RAMEN, w = { 0.1, 0.1 }, h = { 0.11, 0.11 }, run = { 3, 5 }, gap = 0.018, d = 0.1, cyl = true, lid = rgb(236, 236, 232), fill = 0.85 } -- 컵라면 Ø 10 x 11 cm + 뚜껑
local G_PACK = { colors = C_RAMEN, w = { 0.15, 0.15 }, h = { 0.2, 0.2 }, run = { 2, 4 }, gap = 0.025, d = 0.24, fill = 0.85 } -- 봉지라면 15 x 20 cm 세워 진열
local G_DAILY = { colors = C_DAILY, w = { 0.2, 0.26 }, h = { 0.1, 0.13 }, run = { 1, 3 }, gap = 0.025, d = 0.22, fill = 0.85 } -- 티슈·물티슈
local G_SMALL = { colors = C_DAILY, w = { 0.06, 0.09 }, h = { 0.16, 0.21 }, run = { 3, 5 }, gap = 0.025, d = 0.06, cyl = true, fill = 0.8 } -- 샴푸·세제 병
local G_ROLL = { colors = C_DAILY, w = { 0.3, 0.36 }, h = { 0.26, 0.3 }, run = { 1, 2 }, gap = 0.03, d = 0.3, fill = 0.9 } -- 화장지 묶음
local G_SWEET = { colors = C_SWEET, w = { 0.09, 0.14 }, h = { 0.08, 0.14 }, run = { 3, 5 }, gap = 0.02, d = 0.2, fill = 0.7 } -- 초콜릿·사탕
local G_BREAD = { colors = C_BREAD, w = { 0.16, 0.2 }, h = { 0.1, 0.14 }, run = { 1, 3 }, gap = 0.025, d = 0.25, fill = 0.75 } -- 빵
-- 냉장고 (500 ml PET Ø 6.8 cm × 21 cm, 캔 Ø 6.6 × 12.3 cm, 소주병 Ø 6.5 × 22 cm, 1.5 L Ø 9 × 31 cm)
local F_PET = { colors = C_DRINK, w = { 0.068, 0.072 }, h = { 0.23, 0.25 }, run = { 3, 6 }, gap = 0.03, d = 0.07, cyl = true, fill = 0.9 }
local F_WATER = { colors = { rgb(196, 226, 250) }, w = { 0.07, 0.075 }, h = { 0.23, 0.25 }, run = { 8, 14 }, gap = 0.03, d = 0.07, cyl = true, tr = 0.35 }
local F_SOJU = { colors = { rgb(56, 132, 78), rgb(46, 116, 70) }, w = { 0.065, 0.066 }, h = { 0.22, 0.22 }, run = { 6, 10 }, gap = 0.035, d = 0.065, cyl = true, tr = 0.25, mat = MAT.Glass }
local F_CAN = { colors = C_CAN, w = { 0.066, 0.066 }, h = { 0.123, 0.123 }, run = { 3, 6 }, gap = 0.025, d = 0.066, cyl = true, mat = MAT.Metal, stack = 2, fill = 0.85 }
local F_BIG = { colors = { rgb(74, 30, 22), rgb(120, 196, 110), rgb(236, 120, 30), rgb(196, 226, 250) }, w = { 0.09, 0.095 }, h = { 0.3, 0.32 }, run = { 2, 4 }, gap = 0.035, d = 0.09, cyl = true }
local F_CASE = { colors = { rgb(214, 170, 60), rgb(36, 80, 170), rgb(200, 204, 210), rgb(40, 120, 60), rgb(200, 40, 40) }, w = { 0.2, 0.26 }, h = { 0.13, 0.25 }, run = { 1, 2 }, gap = 0.03, d = 0.3, fill = 0.85 }
local F_MILK = { colors = { rgb(240, 240, 236), rgb(250, 220, 120), rgb(240, 180, 200), rgb(180, 120, 70), rgb(150, 200, 240) }, w = { 0.07, 0.08 }, h = { 0.16, 0.2 }, run = { 3, 6 }, gap = 0.025, d = 0.07 }

-- 선반 한 칸 진열: 진열 축(alongZ 이면 Z) a0..a1, 바닥 y, 선반 앞 가장자리 front, 안쪽 방향 inward(±1).
-- 같은 상품을 run 개씩(페이싱) 낱개 파트로 놓되 이웃 낱개는 명도를 번갈아(14 %) 바꾸고 2 cm 이상 띄워 개별 상품으로 읽히게 함.
-- 페이싱 일부는 비움(fill). 반환: 파트 수
local DARKEN = Color3.new(0, 0, 0)
local function fillShelf(parent: Instance, a0: number, a1: number, y: number, front: number, inward: number, kind: any, alongZ: boolean?): number
	local n = 0
	local a = a0 + 0.02
	local left = 0
	local col: Color3 = kind.colors[1]
	local w, h = 0.2, 0.2
	local empty = false
	local idx = 0
	local mat = kind.mat or MAT.SmoothPlastic
	local o = if kind.tr then { transparency = kind.tr } else nil
	local stack = kind.stack or 1
	while true do
		if left <= 0 then
			col = kind.colors[irng:NextInteger(1, #kind.colors)]
			left = irng:NextInteger(kind.run[1], kind.run[2])
			w = irng:NextNumber(kind.w[1], kind.w[2])
			h = irng:NextNumber(kind.h[1], kind.h[2])
			empty = irng:NextNumber() > (kind.fill or 1)
		end
		if a + w > a1 - 0.02 then
			break
		end
		if not empty then
			idx += 1
			local c = if idx % 2 == 0 then col:Lerp(DARKEN, 0.14) else col
			local f0 = front + inward * 0.025
			for k = 0, stack - 1 do
				local yb = y + k * h
				local ck = if k % 2 == 1 then c:Lerp(DARKEN, 0.1) else c
				if kind.cyl then
					local cc = f0 + inward * w / 2
					local px, pz = if alongZ then cc else a + w / 2, if alongZ then a + w / 2 else cc
					CY(parent, px, pz, yb, yb + h, w * 0.94, ck, mat, opts("Goods", o))
					n += 1
					if kind.lid and k == stack - 1 then
						CY(parent, px, pz, yb + h, yb + h + 0.012, w * 0.98, kind.lid, MAT.SmoothPlastic, opts("GoodsLid"))
						n += 1
					end
				else
					local f1 = f0 + inward * kind.d
					if alongZ then
						BX(parent, f0, yb, a, f1, yb + h, a + w, ck, mat, opts("Goods", o))
					else
						BX(parent, a, yb, f0, a + w, yb + h, f1, ck, mat, opts("Goods", o))
					end
					n += 1
				end
			end
		end
		left -= 1
		a += w + kind.gap
	end
	return n
end

-- 가격표(노랑/빨강), 일부만 글자
local PRICES = { "1,500", "2,200", "990", "1+1", "2+1", "3,300", "1,200", "4,500" }
local function priceTag(parent: Instance, x: number, y: number, zFace: number, out: number, labelled: boolean)
	local red = irng:NextNumber() < 0.3
	local t = BX(parent, x, y - 0.04, zFace, x + 0.075, y, zFace + out * 0.02, if red then rgb(222, 40, 40) else rgb(252, 222, 60), MAT.SmoothPlastic, opts("PriceTag"))
	if labelled then
		Kit.label(t, if out < 0 then Enum.NormalId.Front else Enum.NormalId.Back, PRICES[irng:NextInteger(1, #PRICES)], { glow = true, color = if red then WHITE_LABEL else rgb(30, 30, 30), pixelsPerStud = 120, font = Enum.Font.GothamBold })
	end
end

-- 곤돌라 진열대 (높이 1.8 m, 양면 각 깊이 0.35 m, 선반 4 단). kinds[side][level]: side 1 = -Z 면, 2 = +Z 면
local LV = { 0.12, 0.55, 0.98, 1.41 }
local GH, GD = 1.8, 0.35
local function gondola(parent: Instance, xa: number, xb: number, zc: number, kinds: { { any } }): number
	local base = rgb(70, 74, 82)
	local body = rgb(226, 228, 230)
	BX(parent, xa, 0, zc - GD + 0.02, xb, LV[1], zc + GD - 0.02, base, MAT.SmoothPlastic, solid("GondolaBase"))
	BX(parent, xa, LV[1], zc - 0.025, xb, GH, zc + 0.025, rgb(104, 108, 116), MAT.SmoothPlastic, solid("GondolaSpine")) -- 어두운 타공판: 상품 사이 틈이 보임
	BX(parent, xa - 0.03, 0, zc - GD, xa, GH + 0.03, zc + GD, body, MAT.SmoothPlastic, solid("GondolaEnd"))
	BX(parent, xb, 0, zc - GD, xb + 0.03, GH + 0.03, zc + GD, body, MAT.SmoothPlastic, solid("GondolaEnd"))
	BX(parent, xa, GH, zc - 0.07, xb, GH + 0.03, zc + 0.07, body, MAT.SmoothPlastic, opts("GondolaTop"))
	local n = 5
	for si, s in { -1, 1 } do
		local zf = zc + s * GD
		for li, lv in LV do
			if li > 1 then
				BX(parent, xa, lv - 0.025, zc + s * 0.025, xb, lv, zf, rgb(200, 202, 206), MAT.Metal, opts("Shelf"))
				BX(parent, xa, lv - 0.055, zf - s * 0.01, xb, lv - 0.004, zf + s * 0.015, rgb(246, 246, 240), MAT.SmoothPlastic, opts("PriceRail"))
				n += 2
				local nt = if li >= 3 then 4 else 2
				for k = 1, nt do
					local tx = xa + (xb - xa) * (k - 0.5) / nt + irng:NextNumber(-0.3, 0.3)
					priceTag(parent, tx, lv - 0.008, zf + s * 0.015, s, li >= 3 and k % 2 == 1)
					n += 1
				end
			else
				local zp = zc + s * (GD - 0.02)
				BX(parent, xa, 0.02, zp - s * 0.01, xb, 0.1, zp + s * 0.015, rgb(246, 246, 240), MAT.SmoothPlastic, opts("PriceRail"))
				n += 1
			end
			local kd = kinds[si][li]
			if kd.split then -- 한 칸을 반씩 두 상품군으로
				local xm = (xa + xb) / 2
				n += fillShelf(parent, xa, xm, lv, zf, -s, kd.split[1])
				n += fillShelf(parent, xm, xb, lv, zf, -s, kd.split[2])
			else
				n += fillShelf(parent, xa, xb, lv, zf, -s, kd)
			end
		end
	end
	return n
end

------------------------------------------------------------------------------------------------------
-- 2) 한강 편의점 (12 x 8 m, 천장고 2.9 m) + 테라스 + 화장실 + 자전거 대여소 + 피크닉장 + "한강공원" 표지석
------------------------------------------------------------------------------------------------------
-- 파라솔: 높이 2.3 m, 지름 2.4 m
local function parasol(parent: Instance, x: number, y: number, z: number, color: Color3)
	Kit.vcyl(parent, Vector3.new(x, y + M(1.15), z), M(2.3), M(0.05), rgb(220, 220, 214), MAT.Metal, opts("ParasolPole"))
	Kit.ellipsoid(parent, CFrame.new(x, y + M(2.15), z), Vector3.new(M(2.4), M(0.45), M(2.4)), color, MAT.Fabric, opts("Parasol"))
end

-- 표지석: 폭 4 m, 높이 1.1 m
local function signStone(parent: Instance, x: number, z: number, text: string)
	local gy = groundAt(x, z)
	Kit.box(parent, CFrame.new(x, gy + M(0.15) - 0.2, z), Vector3.new(M(4.4), M(0.3) + 0.4, M(1.0)), BENCH_BASE, MAT.Concrete, { name = "SignBase" })
	local board = Kit.box(parent, CFrame.new(x, gy + M(0.3) + M(0.55), z), Vector3.new(M(4), M(1.1), M(0.4)), rgb(48, 50, 56), MAT.Granite, { name = "SignStone" })
	Kit.label(board, Enum.NormalId.Back, text, { glow = true, color = rgb(250, 232, 200), pixelsPerStud = 24 })
	Kit.box(parent, CFrame.new(x, gy + M(0.3) + 0.15, z + M(0.4)), Vector3.new(M(3.6), 0.3, 0.6), LAMP_HEAD, MAT.Neon, glowOpts("SignUplight"))
	markSeg(x - M(2.2), z, x + M(2.2), z, M(1.2), 1)
end

-- 피크닉 테이블 세트: 상판 0.75 m (1.8 x 0.8 m), 의자 0.45 m
local function picnicSet(parent: Instance, cf: CFrame)
	local len = M(1.8)
	Kit.box(parent, cf * CFrame.new(0, M(0.75) - 0.15, 0), Vector3.new(len, 0.3, M(0.8)), BENCH_WOOD, MAT.WoodPlanks, opts("PicnicTable", { collide = true }))
	Kit.box(parent, cf * CFrame.new(0, (M(0.75) - 0.2) / 2, 0), Vector3.new(len * 0.7, M(0.75) - 0.2, 0.6), BENCH_BASE, MAT.Concrete, opts("PicnicLeg"))
	for _, s in { 1, -1 } do
		Kit.box(parent, cf * CFrame.new(0, M(0.45) - 0.15, s * M(0.75)), Vector3.new(len, 0.3, M(0.32)), BENCH_WOOD, MAT.WoodPlanks, opts("PicnicSeat", { collide = true }))
	end
end

-- 매장 실내 (로컬 m, 바닥 윗면 y = 0, 외벽 x ±6 / z ±4, 실내 x ±5.8 / z ±3.8)
local function storeInterior(inner: Instance)
	-- 바닥 타일 줄눈 (60 cm 격자)
	for k = 1, 19 do
		local x = -5.8 + 0.6 * k
		BX(inner, x - 0.0075, -0.01, -3.8, x + 0.0075, 0.016, 3.8, GROUT, MAT.SmoothPlastic, opts("Grout", { shadow = false }))
	end
	for k = 1, 12 do
		local z = -3.8 + 0.6 * k
		BX(inner, -5.8, -0.01, z - 0.0075, 5.8, 0.016, z + 0.0075, GROUT, MAT.SmoothPlastic, opts("Grout", { shadow = false }))
	end
	-- 걸레받이(양 측벽)
	BX(inner, -5.8, 0, -3.8, -5.775, 0.1, 3.8, rgb(90, 92, 96), MAT.SmoothPlastic, opts("Skirting"))
	BX(inner, 5.775, 0, -3.8, 5.8, 0.1, 3.8, rgb(90, 92, 96), MAT.SmoothPlastic, opts("Skirting"))

	-- 천장(2.9 m) + LED 라인 조명 4 (실광원 3) + 천장형 에어컨 + CCTV
	BX(inner, -5.8, 2.9, -3.8, 5.8, 2.96, 3.8, rgb(244, 244, 240), MAT.SmoothPlastic, solid("StoreCeiling"))
	for i, zc in { -2.2, -0.1, 2.1 } do
		local strip = BX(inner, -5.0, 2.86, zc - 0.08, 3.4, 2.9, zc + 0.08, LED_COOL, MAT.Neon, glowOpts("CeilingLed", LED_DAY))
		tryLight(strip, "PointLight", { color = LED_COOL, brightness = if i == 2 then 1.2 else 1.0, range = M(6.5) })
	end
	BX(inner, 4.92, 2.86, -2.0, 5.08, 2.9, 1.4, LED_COOL, MAT.Neon, glowOpts("CeilingLed", LED_DAY))
	BX(inner, -2.3, 2.86, 0.6, -1.5, 2.9, 1.4, rgb(236, 236, 234), MAT.SmoothPlastic, opts("AirCon"))
	BX(inner, -2.2, 2.84, 0.7, -1.6, 2.86, 1.3, rgb(120, 122, 126), MAT.SmoothPlastic, opts("AirConGrille"))
	Kit.ball(inner, at(5.3, 2.84, -3.4).Position, M(0.12), rgb(30, 30, 34), MAT.Glass, opts("CCTV"))

	-- 통로 걸이 간판 3 (계산대 쪽에서 통로를 바라볼 때 보임)
	for _, a in { { -2.15, "과자 · 스낵" }, { -0.1, "라면 · 생활용품" }, { 2.05, "음료 · 아이스크림" } } do
		local zc = a[1] :: number
		local sg = BX(inner, 1.235, 2.3, zc - 0.45, 1.265, 2.55, zc + 0.45, BRAND, MAT.SmoothPlastic, opts("AisleSign"))
		Kit.label(sg, Enum.NormalId.Right, a[2] :: string, { glow = true, color = WHITE_LABEL, pixelsPerStud = 50 })
		Kit.label(sg, Enum.NormalId.Left, a[2] :: string, { glow = true, color = WHITE_LABEL, pixelsPerStud = 50 })
		BX(inner, 1.24, 2.55, zc - 0.01, 1.26, 2.9, zc + 0.01, SS, MAT.Metal, opts("SignRod"))
	end

	-- 곤돌라 2 (x -3.8 ~ 1.0, 높이 1.8 m): 창가 통로 1.55 m / 가운데 1.1 m / 냉장고 앞 1.85 m
	gondola(inner, -3.8, 1.0, -1.0, {
		{ G_MULTI, G_BOX, G_BAG, G_BAG_S },
		{ G_RAMEN5, G_BOWL, { split = { G_CUP, G_PACK } }, G_PACK },
	})
	gondola(inner, -3.8, 1.0, 0.8, {
		{ G_ROLL, G_DAILY, G_SMALL, G_SWEET },
		{ G_MULTI, G_BREAD, G_BAG, G_BOX },
	})
	-- 엔드캡 행사 매대 (+X 끝, 입구 쪽): 음료 박스 / 컵라면 박스 + "2+1" "1+1"
	for i, zc in { -1.0, 0.8 } do
		local ca, cb = if i == 1 then rgb(214, 170, 60) else rgb(204, 30, 30), if i == 1 then rgb(36, 80, 170) else rgb(238, 122, 30)
		BX(inner, 1.03, 0, zc - 0.3, 1.4, 0.1, zc + 0.3, rgb(70, 74, 82), MAT.SmoothPlastic, solid("Endcap"))
		BX(inner, 1.06, 0.1, zc - 0.28, 1.38, 0.38, zc - 0.01, ca, MAT.SmoothPlastic, opts("PromoCase"))
		BX(inner, 1.06, 0.1, zc + 0.01, 1.38, 0.38, zc + 0.28, cb, MAT.SmoothPlastic, opts("PromoCase"))
		BX(inner, 1.08, 0.38, zc - 0.2, 1.36, 0.64, zc + 0.2, ca:Lerp(cb, 0.5), MAT.SmoothPlastic, opts("PromoCase"))
		local pop = BX(inner, 1.38, 0.86, zc - 0.15, 1.395, 1.06, zc + 0.15, rgb(226, 36, 40), MAT.SmoothPlastic, opts("PromoPOP"))
		Kit.label(pop, Enum.NormalId.Right, if i == 1 then "2+1" else "1+1", { glow = true, color = rgb(255, 240, 120), pixelsPerStud = 60, font = Enum.Font.GothamBold })
		BX(inner, 1.36, 0.64, zc - 0.006, 1.372, 0.88, zc + 0.006, SS, MAT.Metal, opts("PromoStick"))
	end

	-- 음료 냉장고 벽 (뒷벽, 유리문 6 × 0.8 m, 높이 2.0 m + 상부 간판) — 네온 백라이트 + 상단 SurfaceLight
	local fx0, fx1 = -4.9, -0.1
	local doors = 6
	local dw = (fx1 - fx0) / doors
	BX(inner, fx0 - 0.05, 0, 3.0, fx0, 2.4, 3.8, rgb(232, 232, 230), MAT.SmoothPlastic, solid("FridgeSide"))
	BX(inner, fx1, 0, 3.0, fx1 + 0.05, 2.4, 3.8, rgb(232, 232, 230), MAT.SmoothPlastic, solid("FridgeSide"))
	BX(inner, fx0, 0, 3.03, fx1, 0.15, 3.8, rgb(54, 58, 64), MAT.SmoothPlastic, solid("FridgeKick"))
	local fhead = BX(inner, fx0, 2.0, 2.96, fx1, 2.4, 3.8, BRAND, MAT.SmoothPlastic, solid("FridgeHeader"))
	Kit.label(fhead, Enum.NormalId.Front, "음료 · 맥주 · 생수", { glow = true, color = WHITE_LABEL, pixelsPerStud = 30 })
	tryLight(fhead, "SurfaceLight", { face = Enum.NormalId.Bottom, angle = 110, range = M(3.2), brightness = 1.6, color = LED_COOL })
	BX(inner, fx0, 0.15, 3.72, fx1, 2.0, 3.78, rgb(150, 172, 196), MAT.Neon, glowOpts("FridgeBacklight", rgb(214, 218, 222)))
	local levels = { 0.15, 0.5, 0.86, 1.22, 1.58 }
	local kindsAt = {
		{ F_CASE, F_BIG, F_CASE },
		{ F_SOJU, F_PET, F_WATER },
		{ F_PET, F_PET, F_WATER },
		{ F_CAN, F_CAN, F_MILK },
		{ F_MILK, F_PET, F_PET },
	}
	for li, lv in levels do
		if li > 1 then
			BX(inner, fx0, lv - 0.02, 3.06, fx1, lv, 3.7, rgb(190, 194, 200), MAT.Metal, opts("FridgeShelf"))
			BX(inner, fx0, lv - 0.05, 3.045, fx1, lv - 0.004, 3.07, rgb(246, 246, 240), MAT.SmoothPlastic, opts("PriceRail"))
		end
		for seg = 1, 3 do
			local a0 = fx0 + (seg - 1) * dw * 2
			fillShelf(inner, a0, a0 + dw * 2, lv, 3.06, 1, kindsAt[li][seg])
		end
	end
	BX(inner, fx0, 0.15, 3.0, fx1, 2.0, 3.02, rgb(200, 220, 235), MAT.Glass, solid("FridgeGlass", { transparency = 0.74 }))
	for k = 0, doors do
		local x = fx0 + k * dw
		BX(inner, x - 0.025, 0.15, 2.97, x + 0.025, 2.0, 3.0, FRAME_DARK, MAT.Metal, opts("FridgeFrame"))
		if k < doors then
			local hx = x + dw - 0.09
			BX(inner, hx - 0.012, 0.85, 2.92, hx + 0.012, 1.55, 2.97, SS, MAT.Metal, opts("FridgeHandle"))
		end
	end
	BX(inner, fx0, 0.15, 2.97, fx1, 0.21, 3.0, FRAME_DARK, MAT.Metal, opts("FridgeRail"))
	BX(inner, fx0, 1.94, 2.97, fx1, 2.0, 3.0, FRAME_DARK, MAT.Metal, opts("FridgeRail"))
	for i, x in { -4.6, -1.4 } do
		local tg = BX(inner, x, 1.66, 2.95, x + 0.2, 1.78, 2.97, rgb(226, 36, 40), MAT.SmoothPlastic, opts("GlassPOP"))
		Kit.label(tg, Enum.NormalId.Front, if i == 1 then "4캔 1만원" else "2+1", { glow = true, color = WHITE_LABEL, pixelsPerStud = 80, font = Enum.Font.GothamBold })
	end

	-- 한강라면 조리기 스테이션 (-X 벽, 스테인리스 카운터 0.9 m, 조리기 4 대 + 온수기 + 라면 진열대)
	BX(inner, -5.75, 0, -2.38, -5.15, 0.1, 2.38, rgb(60, 62, 66), MAT.Metal, solid("RamenKick"))
	BX(inner, -5.8, 0.1, -2.4, -5.1, 0.86, 2.4, SS, MAT.Metal, solid("RamenCounter"))
	BX(inner, -5.8, 0.86, -2.43, -5.06, 0.9, 2.43, rgb(208, 212, 218), MAT.Metal, solid("RamenTop", { reflectance = 0.08 }))
	for i, c in { -1.75, -0.85, 0.05, 0.95 } do
		BX(inner, -5.66, 0.9, c - 0.19, -5.22, 0.93, c + 0.19, rgb(22, 22, 26), MAT.SmoothPlastic, opts("CookerPlate", { reflectance = 0.15 }))
		BX(inner, -5.79, 0.9, c - 0.2, -5.62, 1.34, c + 0.2, rgb(226, 228, 232), MAT.SmoothPlastic, solid("RamenCooker", { reflectance = 0.06 }))
		BX(inner, -5.79, 1.34, c - 0.2, -5.24, 1.54, c + 0.2, rgb(226, 228, 232), MAT.SmoothPlastic, solid("RamenCookerHead", { reflectance = 0.06 }))
		local led = BX(inner, -5.24, 1.38, c - 0.13, -5.225, 1.48, c + 0.13, rgb(14, 14, 16), MAT.SmoothPlastic, opts("CookerLED"))
		Kit.label(led, Enum.NormalId.Right, if i == 2 then "02:47" elseif i == 3 then "01:15" else "READY", { glow = true, color = if i == 2 or i == 3 then rgb(255, 64, 40) else rgb(90, 255, 120), font = Enum.Font.GothamBold, pixelsPerStud = 90 })
		BX(inner, -5.24, 1.495, c - 0.19, -5.225, 1.53, c + 0.19, rgb(206, 36, 36), MAT.SmoothPlastic, opts("CookerBand"))
		CY(inner, -5.44, c, 1.29, 1.34, 0.04, SS_DARK, MAT.Metal, opts("CookerNozzle"))
		BX(inner, -5.24, 1.345, c + 0.14, -5.225, 1.37, c + 0.18, rgb(255, 120, 60), MAT.Neon, glowOpts("CookerBtn", rgb(200, 60, 40)))
		if i == 2 or i == 3 then -- 조리 중인 라면 (은박 용기 + 빨간 국물)
			CY(inner, -5.44, c, 0.93, 1.02, 0.17, rgb(214, 214, 210), MAT.Metal, opts("RamenBowl"))
			CY(inner, -5.44, c, 1.02, 1.04, 0.14, rgb(196, 82, 36), MAT.SmoothPlastic, opts("RamenSoup"))
		end
	end
	-- 온수기 + 받침대
	BX(inner, -5.78, 0.9, 1.52, -5.4, 1.56, 1.98, rgb(236, 236, 232), MAT.SmoothPlastic, solid("HotWater"))
	BX(inner, -5.4, 1.18, 1.68, -5.32, 1.24, 1.82, rgb(200, 40, 36), MAT.SmoothPlastic, opts("HotWaterTap"))
	BX(inner, -5.42, 0.9, 1.6, -5.25, 0.94, 1.9, rgb(70, 72, 76), MAT.Metal, opts("DripTray"))
	local hwl = BX(inner, -5.4, 1.36, 1.6, -5.385, 1.5, 1.9, rgb(200, 40, 36), MAT.SmoothPlastic, opts("HotWaterLabel"))
	Kit.label(hwl, Enum.NormalId.Right, "뜨거운 물", { glow = true, color = WHITE_LABEL, pixelsPerStud = 80 })
	-- 용기 더미, 젓가락·냅킨, 국물 버리는 곳
	CY(inner, -5.55, 2.2, 0.9, 1.3, 0.17, rgb(238, 238, 232), MAT.SmoothPlastic, opts("BowlStack"))
	CY(inner, -5.3, 2.2, 0.9, 1.15, 0.17, rgb(206, 206, 202), MAT.Metal, opts("FoilBowlStack"))
	CY(inner, -5.3, 1.33, 0.9, 1.05, 0.08, rgb(84, 62, 42), MAT.Wood, opts("ChopstickCup"))
	BX(inner, -5.33, 1.05, 1.3, -5.27, 1.22, 1.36, rgb(222, 202, 160), MAT.Wood, opts("Chopsticks"))
	BX(inner, -5.64, 0.9, 1.22, -5.46, 1.08, 1.42, rgb(40, 40, 44), MAT.SmoothPlastic, opts("NapkinBox"))
	BX(inner, -5.75, 0.9, -2.38, -5.2, 0.96, -2.02, rgb(146, 150, 156), MAT.Metal, opts("SoupSink"))
	local ssl = BX(inner, -5.8, 1.06, -2.38, -5.785, 1.26, -2.0, rgb(250, 250, 246), MAT.SmoothPlastic, opts("SoupSinkSign"))
	Kit.label(ssl, Enum.NormalId.Right, "국물 버리는 곳", { glow = true, color = rgb(40, 40, 40), pixelsPerStud = 80 })
	-- 벽 라면 진열대 (스테인리스 3 단): 봉지라면 2 단 + 5 입 묶음 1 단
	for li, lv in { 1.62, 1.88, 2.14 } do
		BX(inner, -5.8, lv - 0.02, -2.4, -5.5, lv, 2.4, SS, MAT.Metal, opts("RamenRack"))
		BX(inner, -5.51, lv - 0.05, -2.4, -5.485, lv - 0.004, 2.4, rgb(252, 222, 60), MAT.SmoothPlastic, opts("PriceRail"))
		fillShelf(inner, -2.38, 2.38, lv, -5.5, -1, if li == 3 then G_RAMEN5 else G_PACK, true)
	end
	BX(inner, -5.8, 1.55, -2.43, -5.5, 2.16, -2.4, SS_DARK, MAT.Metal, opts("RackSide"))
	BX(inner, -5.8, 1.55, 2.4, -5.5, 2.16, 2.43, SS_DARK, MAT.Metal, opts("RackSide"))
	local rsign = BX(inner, -5.8, 2.42, -1.9, -5.72, 2.82, 1.9, rgb(198, 28, 30), MAT.SmoothPlastic, opts("RamenSign"))
	Kit.label(rsign, Enum.NormalId.Right, "한강라면 조리기", { glow = true, color = rgb(255, 242, 206), pixelsPerStud = 30 })
	tryLight(rsign, "PointLight", { color = rgb(255, 214, 170), brightness = 1.0, range = M(4.5) })
	local how = BX(inner, -5.8, 1.0, 2.55, -5.785, 2.1, 3.55, rgb(252, 238, 204), MAT.SmoothPlastic, opts("RamenHowTo"))
	Kit.label(how, Enum.NormalId.Right, "한강라면 끓이는 법\n① 라면 고르기\n② 계산 후 용기에 담기\n③ 조리기에 올리고 버튼\n④ 3분 30초 완성!", { glow = true, color = rgb(150, 24, 24), pixelsPerStud = 60, font = Enum.Font.GothamMedium })
	BX(inner, -5.7, 0, 2.85, -5.25, 0.75, 3.3, rgb(90, 96, 100), MAT.Metal, solid("CupBin"))
	BX(inner, -5.72, 0.75, 2.83, -5.23, 0.8, 3.32, rgb(60, 140, 90), MAT.SmoothPlastic, opts("CupBinLid"))

	-- 창가 바 테이블 (강을 향함, 상판 1.0 m) + 스툴 8 (좌면 0.74 m) + 먹다 남은 소품
	BX(inner, -5.75, 0.97, -3.84, 1.3, 1.02, -3.32, rgb(176, 140, 100), MAT.Wood, solid("WindowCounter"))
	BX(inner, -5.75, 0, -3.84, 1.3, 0.97, -3.8, rgb(226, 224, 218), MAT.SmoothPlastic, solid("WindowCounterApron"))
	CH(inner, -2.225, 0.25, -3.45, 6.95, 0.035, false, SS, MAT.Metal, opts("FootRail"))
	for i = 0, 7 do
		local sx = -5.2 + i * 0.85
		CY(inner, sx, -3.0, 0, 0.03, 0.4, rgb(50, 52, 56), MAT.Metal, opts("StoolBase"))
		CY(inner, sx, -3.0, 0.03, 0.68, 0.05, SS, MAT.Metal, opts("StoolPole"))
		CY(inner, sx, -3.0, 0.68, 0.74, 0.36, rgb(36, 36, 40), MAT.SmoothPlastic, solid("StoolSeat"))
	end
	CY(inner, -4.35, -3.6, 1.02, 1.11, 0.16, rgb(214, 214, 210), MAT.Metal, opts("RamenBowl"))
	CY(inner, -4.35, -3.6, 1.11, 1.13, 0.13, rgb(196, 82, 36), MAT.SmoothPlastic, opts("RamenSoup"))
	BX(inner, -4.33, 1.13, -3.72, -4.31, 1.145, -3.46, rgb(222, 202, 160), MAT.Wood, opts("Chopsticks"))
	CY(inner, -4.0, -3.55, 1.02, 1.143, 0.066, rgb(214, 170, 60), MAT.Metal, opts("BeerCan"))
	CY(inner, -3.9, -3.62, 1.02, 1.143, 0.066, rgb(36, 80, 170), MAT.Metal, opts("BeerCan"))
	BX(inner, -4.62, 1.02, -3.62, -4.47, 1.036, -3.47, rgb(246, 246, 242), MAT.SmoothPlastic, opts("Napkin"))
	CY(inner, -1.8, -3.6, 1.02, 1.12, 0.08, rgb(244, 244, 240), MAT.SmoothPlastic, opts("CoffeeCup"))
	CY(inner, -1.8, -3.6, 1.12, 1.135, 0.085, rgb(60, 40, 30), MAT.SmoothPlastic, opts("CupLid"))
	BX(inner, -2.12, 1.02, -3.7, -2.04, 1.036, -3.55, rgb(20, 20, 24), MAT.SmoothPlastic, opts("Phone"))
	CY(inner, -0.1, -3.58, 1.02, 1.14, 0.12, rgb(204, 30, 30), MAT.SmoothPlastic, opts("CupNoodle"))
	BX(inner, -0.02, 1.02, -3.72, 0.0, 1.036, -3.46, rgb(222, 202, 160), MAT.Wood, opts("Chopsticks"))
	-- 유리창 포스터 (밖을 향함)
	for _, p in { { 0.35, 1.15, "1+1 · 2+1\n행사 상품", rgb(222, 40, 44), WHITE_LABEL }, { 3.75, 4.6, "한강라면\n조리기 운영중", rgb(250, 196, 40), rgb(150, 20, 20) } } do
		local pst = BX(inner, p[1] :: number, 1.45, -3.875, p[2] :: number, 2.05, -3.86, p[4] :: Color3, MAT.SmoothPlastic, opts("WindowPoster"))
		Kit.label(pst, Enum.NormalId.Front, p[3] :: string, { glow = true, color = p[5] :: Color3, pixelsPerStud = 50, font = Enum.Font.GothamBold })
	end

	-- 계산대 (상판 0.9 m) + POS + 고객 화면 + 카드 단말 + 핫바 온장고 + 껌 매대
	BX(inner, 4.0, 0, -2.2, 4.6, 0.88, 1.6, rgb(240, 240, 236), MAT.SmoothPlastic, solid("Counter"))
	BX(inner, 3.97, 0.12, -2.1, 4.0, 0.8, 1.5, BRAND, MAT.SmoothPlastic, opts("CounterFront"))
	BX(inner, 3.955, 0.74, -2.1, 3.97, 0.77, 1.5, BRAND2, MAT.Neon, glowOpts("CounterStripe", BRAND2))
	BX(inner, 3.95, 0.88, -2.25, 4.65, 0.92, 1.65, rgb(70, 72, 78), MAT.Granite, solid("CounterTop"))
	local age = BX(inner, 3.955, 0.45, -0.95, 3.97, 0.62, -0.15, rgb(250, 250, 246), MAT.SmoothPlastic, opts("AgeNotice"))
	Kit.label(age, Enum.NormalId.Left, "19세 미만 술·담배 판매 금지", { glow = true, color = rgb(200, 20, 20), pixelsPerStud = 80 })
	CY(inner, 4.42, -0.4, 0.92, 1.05, 0.06, rgb(30, 30, 34), MAT.Metal, opts("POSStand"))
	BX(inner, 4.38, 1.04, -0.62, 4.45, 1.3, -0.18, rgb(24, 24, 28), MAT.SmoothPlastic, opts("POS"))
	BX(inner, 4.45, 1.06, -0.6, 4.465, 1.28, -0.2, rgb(140, 196, 255), MAT.Neon, glowOpts("POSScreen", rgb(40, 50, 60)))
	BX(inner, 4.05, 0.92, -0.75, 4.12, 1.12, -0.5, rgb(24, 24, 28), MAT.SmoothPlastic, opts("CustomerDisplay"))
	BX(inner, 4.035, 0.95, -0.72, 4.05, 1.1, -0.53, rgb(110, 214, 255), MAT.Neon, glowOpts("CustomerScreen", rgb(40, 50, 60)))
	BX(inner, 4.06, 0.92, -0.1, 4.2, 0.97, 0.06, rgb(30, 30, 34), MAT.SmoothPlastic, opts("CardTerminal"))
	BX(inner, 4.3, 0.92, 0.15, 4.5, 1.04, 0.35, rgb(40, 40, 44), MAT.SmoothPlastic, opts("ReceiptPrinter"))
	BX(inner, 4.15, 0.92, -1.1, 4.27, 0.98, -0.95, rgb(30, 30, 34), MAT.SmoothPlastic, opts("Scanner"))
	BX(inner, 4.08, 0.92, 1.05, 4.55, 0.96, 1.55, rgb(255, 170, 90), MAT.Neon, glowOpts("HotbarWarm", rgb(150, 150, 146)))
	BX(inner, 4.08, 0.96, 1.05, 4.55, 1.22, 1.55, rgb(230, 230, 220), MAT.Glass, opts("HotbarGlass", { transparency = 0.6 }))
	for j = 0, 2 do
		CH(inner, 4.31, 1.0, 1.17 + j * 0.13, 0.36, 0.04, false, rgb(176, 72, 50), MAT.SmoothPlastic, opts("Hotbar"))
	end
	BX(inner, 3.93, 0.5, 0.35, 3.95, 0.88, 1.25, rgb(214, 214, 210), MAT.Metal, opts("GumRack"))
	for r = 0, 1 do
		for k = 0, 2 do
			BX(inner, 3.82, 0.52 + r * 0.18, 0.38 + k * 0.29, 3.93, 0.64 + r * 0.18, 0.64 + k * 0.29, C_SWEET[irng:NextInteger(1, #C_SWEET)], MAT.SmoothPlastic, opts("Gum"))
		end
	end
	-- 담배 진열장 (계산대 뒤, 일반 포장) + 하부장 + 헤더
	BX(inner, 5.35, 0, -2.2, 5.8, 0.9, 1.6, rgb(240, 240, 236), MAT.SmoothPlastic, solid("CigCabinet"))
	BX(inner, 5.6, 0.9, -2.2, 5.8, 2.4, 1.6, rgb(36, 38, 44), MAT.SmoothPlastic, solid("CigWall"))
	local chd = BX(inner, 5.5, 2.4, -2.2, 5.8, 2.7, 1.6, rgb(36, 38, 44), MAT.SmoothPlastic, opts("CigHeader"))
	Kit.label(chd, Enum.NormalId.Left, "담배 · 전자담배", { glow = true, color = rgb(230, 230, 230), pixelsPerStud = 30 })
	-- 담뱃갑 낱개 5.5 x 8.8 cm, 11.5 cm 간격 3 단 (아크릴 칸막이 뒤 어두운 배경, 일부 품절)
	for r = 0, 2 do
		local y = 1.05 + r * 0.4
		BX(inner, 5.48, y - 0.03, -2.15, 5.6, y, 1.55, rgb(232, 238, 246), MAT.Neon, glowOpts("CigShelfLed", LED_DAY))
		local z = -2.1
		local col = C_CIG[1]
		while z + 0.055 <= 1.52 do
			if irng:NextNumber() < 0.35 then
				col = C_CIG[irng:NextInteger(1, #C_CIG)]
			end
			if irng:NextNumber() > 0.08 then
				BX(inner, 5.52, y, z, 5.58, y + 0.088, z + 0.055, col, MAT.SmoothPlastic, opts("CigPack"))
			end
			z += 0.115
		end
	end
	BX(inner, 4.62, 0, -2.0, 5.33, 0.016, 1.4, rgb(30, 30, 32), MAT.Fabric, opts("CashierMat"))
	-- 직원 출입문 (+Z 벽, 0.9 x 2.1 m)
	BX(inner, 4.54, 0, 3.72, 4.6, 2.16, 3.8, FRAME_DARK, MAT.Metal, solid("DoorJamb"))
	BX(inner, 5.5, 0, 3.72, 5.56, 2.16, 3.8, FRAME_DARK, MAT.Metal, solid("DoorJamb"))
	BX(inner, 4.6, 2.1, 3.72, 5.5, 2.16, 3.8, FRAME_DARK, MAT.Metal, solid("DoorHead"))
	BX(inner, 4.6, 0.01, 3.76, 5.5, 2.1, 3.8, rgb(150, 156, 164), MAT.Metal, solid("StaffDoor"))
	BX(inner, 4.66, 0.98, 3.7, 4.8, 1.01, 3.76, SS, MAT.Metal, opts("DoorLever"))
	local stf = BX(inner, 4.8, 1.45, 3.745, 5.3, 1.6, 3.76, rgb(240, 240, 236), MAT.SmoothPlastic, opts("StaffSign"))
	Kit.label(stf, Enum.NormalId.Front, "관계자 외 출입금지", { glow = true, color = rgb(200, 20, 20), pixelsPerStud = 80 })

	-- 커피 머신 · 전자레인지 코너 (+Z 벽)
	BX(inner, 0.12, 0, 3.22, 2.08, 0.86, 3.8, rgb(232, 232, 228), MAT.SmoothPlastic, solid("CoffeeCabinet"))
	BX(inner, 0.08, 0.86, 3.18, 2.12, 0.9, 3.8, rgb(70, 72, 78), MAT.Granite, solid("CoffeeTop"))
	BX(inner, 0.3, 0.9, 3.38, 0.78, 1.6, 3.78, rgb(28, 28, 32), MAT.SmoothPlastic, solid("CoffeeMachine"))
	BX(inner, 0.38, 1.36, 3.365, 0.7, 1.52, 3.38, rgb(140, 210, 255), MAT.Neon, glowOpts("CoffeeScreen", rgb(40, 50, 60)))
	BX(inner, 0.38, 0.9, 3.3, 0.7, 0.95, 3.38, rgb(60, 62, 66), MAT.Metal, opts("CoffeeTray"))
	CY(inner, 0.98, 3.55, 0.9, 1.3, 0.1, rgb(244, 244, 240), MAT.SmoothPlastic, opts("CupStack"))
	for _, mx in { 1.38, 1.84 } do
		BX(inner, mx - 0.22, 0.9, 3.4, mx + 0.22, 1.18, 3.78, rgb(214, 214, 210), MAT.SmoothPlastic, solid("Microwave"))
		BX(inner, mx - 0.2, 0.93, 3.385, mx + 0.08, 1.15, 3.4, rgb(30, 34, 40), MAT.Glass, opts("MicrowaveDoor"))
	end
	local cfs = BX(inner, 0.2, 1.75, 3.785, 2.0, 1.95, 3.8, BRAND, MAT.SmoothPlastic, opts("CoffeeSign"))
	Kit.label(cfs, Enum.NormalId.Front, "원두커피 1,500원  ·  전자레인지", { glow = true, color = WHITE_LABEL, pixelsPerStud = 60 })

	-- 아이스크림 냉동고 (뒷벽, 1.4 x 0.7 m, 높이 0.85 m, 유리 슬라이딩 뚜껑)
	local qz0, qz1 = 3.05, 3.75
	BX(inner, 2.3, 0, qz0, 3.7, 0.62, qz1, rgb(244, 244, 240), MAT.SmoothPlastic, solid("IceFreezer"))
	BX(inner, 2.3, 0.62, qz0, 3.7, 0.85, qz0 + 0.05, rgb(244, 244, 240), MAT.SmoothPlastic, solid("FreezerRim"))
	BX(inner, 2.3, 0.62, qz1 - 0.05, 3.7, 0.85, qz1, rgb(244, 244, 240), MAT.SmoothPlastic, solid("FreezerRim"))
	BX(inner, 2.3, 0.62, qz0 + 0.05, 2.35, 0.85, qz1 - 0.05, rgb(244, 244, 240), MAT.SmoothPlastic, solid("FreezerRim"))
	BX(inner, 3.65, 0.62, qz0 + 0.05, 3.7, 0.85, qz1 - 0.05, rgb(244, 244, 240), MAT.SmoothPlastic, solid("FreezerRim"))
	for row = 0, 1 do
		local x = 2.37
		while true do
			local w = irng:NextNumber(0.1, 0.16)
			if x + w > 3.63 then
				break
			end
			local zA = if row == 0 then qz0 + 0.07 else qz0 + 0.37
			BX(inner, x, 0.62, zA, x + w, 0.62 + irng:NextNumber(0.06, 0.15), zA + 0.26, C_SWEET[irng:NextInteger(1, #C_SWEET)]:Lerp(rgb(255, 255, 255), 0.15), MAT.SmoothPlastic, opts("IceCream"))
			x += w + 0.025
		end
	end
	BX(inner, 2.35, 0.81, qz0 + 0.05, 3.65, 0.83, qz1 - 0.05, rgb(210, 230, 245), MAT.Glass, opts("FreezerLid", { transparency = 0.65 }))
	local ice = BX(inner, 2.55, 0.28, qz0 - 0.015, 3.45, 0.56, qz0, BRAND, MAT.SmoothPlastic, opts("FreezerSign"))
	Kit.label(ice, Enum.NormalId.Front, "아이스크림 2+1", { glow = true, color = WHITE_LABEL, pixelsPerStud = 60, font = Enum.Font.GothamBold })

	-- 장바구니 더미 (입구 옆, 빨간 플라스틱 3 단 + 손잡이)
	for k = 0, 2 do
		BX(inner, 3.75, k * 0.09, -3.68, 4.2, 0.2 + k * 0.09, -3.38, rgb(206, 34, 40), MAT.SmoothPlastic, opts("Basket", { collide = k == 0 }))
	end
	BX(inner, 3.96, 0.38, -3.68, 3.99, 0.5, -3.38, rgb(40, 40, 44), MAT.SmoothPlastic, opts("BasketHandle"))
	-- 입구 매트 (180° 돌려 들어오는 손님 쪽으로 글자)
	local mat = Kit.box(inner, at(2.7, 0.008, -3.25) * CFrame.Angles(0, math.pi, 0), Vector3.new(M(1.6), M(0.016), M(1.0)), rgb(40, 52, 70), MAT.Fabric, opts("EntranceMat"))
	Kit.label(mat, Enum.NormalId.Top, "어서오세요", { glow = false, color = rgb(196, 206, 220), pixelsPerStud = 40 })
end

-- 매장 외피 (강 쪽 유리 커튼월 + 자동문, 지붕 캐노피, 간판, 자판기, 실외기)
local function storeShell(shell: Instance, TY: number)
	local CLAD = rgb(206, 208, 210)
	local STONE = rgb(70, 72, 76)
	-- 바닥 슬래브 (윗면 = 매장 바닥, 테라스보다 0.09 m 높음)
	BX(shell, -6, -0.63, -4, 6, 0, 4, FLOOR_TILE, MAT.SmoothPlastic, solid("StoreFloor"))
	-- 벽 (안쪽 흰색) + 바깥 알루미늄 복합패널 + 화강석 걸레받이
	BX(shell, -6, 0, 3.8, 6, 3.15, 4.0, WHITE_WALL, MAT.SmoothPlastic, solid("StoreWall"))
	BX(shell, -6, 0, -4, -5.8, 3.15, 3.8, WHITE_WALL, MAT.SmoothPlastic, solid("StoreWall"))
	BX(shell, 5.8, 0, -4, 6, 3.15, 3.8, WHITE_WALL, MAT.SmoothPlastic, solid("StoreWall"))
	BX(shell, -6, TY, 4.0, 6, 3.15, 4.09, CLAD, MAT.Metal, solid("StoreCladding"))
	BX(shell, -6.09, TY, -4.0, -6.0, 3.15, 4.09, CLAD, MAT.Metal, solid("StoreCladding"))
	BX(shell, 6.0, TY, -4.0, 6.09, 3.15, 4.09, CLAD, MAT.Metal, solid("StoreCladding"))
	BX(shell, -6.09, TY, 4.09, 6.09, 0.45, 4.19, STONE, MAT.Granite, solid("StoreBase"))
	BX(shell, -6.19, TY, -4.0, -6.09, 0.45, 4.19, STONE, MAT.Granite, solid("StoreBase"))
	BX(shell, 6.09, TY, -4.0, 6.19, 0.45, 4.19, STONE, MAT.Granite, solid("StoreBase"))
	-- 강 쪽 유리 커튼월: 문틀 x 1.8 ~ 3.6 (유효폭 1.8 m, 높이 2.3 m), 멀리언 1.5 m 간격
	BX(shell, -5.8, 0, -4.0, 1.74, 0.08, -3.8, FRAME_DARK, MAT.Metal, solid("StoreSill"))
	BX(shell, 3.66, 0, -4.0, 5.8, 0.08, -3.8, FRAME_DARK, MAT.Metal, solid("StoreSill"))
	BX(shell, 1.8, 0, -4.05, 3.6, 0.016, -3.75, SS, MAT.Metal, solid("DoorThreshold"))
	BX(shell, -5.8, 2.85, -4.0, 5.8, 3.15, -3.8, WHITE_WALL, MAT.SmoothPlastic, solid("StoreHeadBand"))
	BX(shell, -5.8, 0.08, -3.92, 1.77, 2.85, -3.88, GLASS_STORE, MAT.Glass, solid("StoreGlass", { transparency = 0.8 }))
	BX(shell, 3.63, 0.08, -3.92, 5.8, 2.85, -3.88, GLASS_STORE, MAT.Glass, solid("StoreGlass", { transparency = 0.8 }))
	BX(shell, 1.77, 2.35, -3.92, 3.63, 2.85, -3.88, GLASS_STORE, MAT.Glass, solid("StoreGlass", { transparency = 0.8 }))
	for _, x in { -4.28, -2.76, -1.24, 0.28, 4.7 } do
		BX(shell, x - 0.03, 0.08, -4.0, x + 0.03, 2.85, -3.8, FRAME_DARK, MAT.Metal, solid("Mullion"))
	end
	BX(shell, 1.74, 0, -4.0, 1.8, 2.85, -3.8, FRAME_DARK, MAT.Metal, solid("DoorJamb"))
	BX(shell, 3.6, 0, -4.0, 3.66, 2.85, -3.8, FRAME_DARK, MAT.Metal, solid("DoorJamb"))
	BX(shell, 1.8, 2.3, -4.0, 3.6, 2.35, -3.8, FRAME_DARK, MAT.Metal, solid("DoorHead"))
	-- 자동문: 문짝 2 (열린 상태 = 고정창 바깥으로 0.9 m 씩 밀려 있음). 태그 SeoulAutoDoor + ClosedOffset 속성(애니메이션용)
	BX(shell, 0.85, 2.3, -4.22, 4.55, 2.5, -4.0, FRAME_DARK, MAT.Metal, solid("AutoDoorHeader"))
	BX(shell, 2.6, 2.25, -4.18, 2.8, 2.3, -4.1, rgb(20, 20, 24), MAT.SmoothPlastic, opts("AutoDoorSensor"))
	local CS = game:GetService("CollectionService")
	for i, xs in { { 0.88, 1.8, 1 }, { 3.6, 4.52, -1 } } do
		local leaf = BX(shell, xs[1], 0.02, -4.13, xs[2], 2.3, -4.09, rgb(176, 200, 214), MAT.Glass, opts("AutoDoorLeaf", { transparency = 0.55 }))
		local stile = BX(shell, if i == 1 then xs[2] - 0.04 else xs[1], 0.02, -4.135, if i == 1 then xs[2] else xs[1] + 0.04, 2.3, -4.085, FRAME_DARK, MAT.Metal, opts("AutoDoorStile"))
		for _, p in { leaf, stile } do
			CS:AddTag(p, "SeoulAutoDoor")
			p:SetAttribute("ClosedOffset", Vector3.new(xs[3] * M(0.9), 0, 0)) -- 열린 위치 + 이 값 = 닫힌 위치 (월드)
		end
		if i == 1 then
			local st = BX(shell, 1.12, 1.12, -4.145, 1.56, 1.26, -4.13, rgb(230, 236, 240), MAT.SmoothPlastic, opts("AutoDoorSticker"))
			Kit.label(st, Enum.NormalId.Front, "자동문", { glow = true, color = rgb(30, 60, 120), pixelsPerStud = 80 })
		end
	end
	-- 지붕 슬래브 + 강 쪽 캐노피(1.6 m) + 띠 간판 + 라임 네온 라인 + 캐노피 다운라이트
	BX(shell, -6.3, 3.15, -5.6, 6.3, 3.45, 4.3, rgb(64, 68, 76), MAT.Metal, solid("StoreRoof"))
	BX(shell, -6.3, 3.05, -5.72, 6.3, 3.75, -5.6, rgb(238, 240, 242), MAT.SmoothPlastic, solid("StoreFascia"))
	BX(shell, -6.3, 3.05, 4.3, 6.3, 3.75, 4.42, rgb(238, 240, 242), MAT.SmoothPlastic, solid("StoreFascia"))
	BX(shell, -6.42, 3.05, -5.72, -6.3, 3.75, 4.42, rgb(238, 240, 242), MAT.SmoothPlastic, solid("StoreFascia"))
	BX(shell, 6.3, 3.05, -5.72, 6.42, 3.75, 4.42, rgb(238, 240, 242), MAT.SmoothPlastic, solid("StoreFascia"))
	BX(shell, -6.3, 3.0, -5.75, 6.3, 3.05, -5.63, BRAND2, MAT.Neon, glowOpts("StoreStripe", BRAND2))
	local s1 = BX(shell, -3.3, 3.12, -5.84, 3.3, 3.7, -5.72, BRAND, MAT.SmoothPlastic, opts("StoreSign"))
	Kit.label(s1, Enum.NormalId.Front, "편의점  ·  한강공원점  24", { glow = true, color = WHITE_LABEL, pixelsPerStud = 24 })
	local s2 = BX(shell, -2.6, 3.12, 4.42, 2.6, 3.7, 4.54, BRAND, MAT.SmoothPlastic, opts("StoreSign"))
	Kit.label(s2, Enum.NormalId.Back, "편의점  24시", { glow = true, color = WHITE_LABEL, pixelsPerStud = 24 })
	for i, x in { -3.6, 0.0, 2.7 } do
		local dl = CY(shell, x, -4.8, 3.11, 3.15, 0.18, LAMP_HEAD, MAT.Neon, glowOpts("CanopyLight"))
		if i == 3 then
			tryLight(dl, "SpotLight", { face = Enum.NormalId.Bottom, angle = 100, range = M(6), brightness = 1.5, color = P.LampWarm })
		end
	end
	-- 지붕 위 실외기 + 점검구 (전망대에서 내려다보임), 측벽 실외기
	BX(shell, 2.0, 3.45, 0.5, 3.2, 3.95, 1.6, rgb(200, 200, 196), MAT.Metal, opts("RoofAC"))
	BX(shell, -3.5, 3.45, 1.0, -2.7, 3.6, 1.8, rgb(150, 150, 146), MAT.Metal, opts("RoofHatch"))
	BX(shell, -6.75, TY, 0.6, -6.25, 0.72, 1.5, rgb(214, 214, 210), MAT.Metal, solid("ACUnit"))
	CH(shell, -6.76, 0.41, 1.05, 0.02, 0.46, false, rgb(60, 62, 66), MAT.Metal, opts("ACFan"))
	-- 자판기 2 (산책로 쪽 뒷벽, 1.83 x 1.0 x 0.8 m)
	for i, c in { rgb(170, 34, 40), rgb(36, 90, 160) } do
		local x0 = 1.4 + (i - 1) * 1.15
		BX(shell, x0, TY, 4.2, x0 + 1.0, 1.74, 4.99, c, MAT.SmoothPlastic, solid("Vending"))
		BX(shell, x0 + 0.12, 0.85, 4.99, x0 + 0.88, 1.6, 5.03, rgb(220, 226, 236), MAT.Neon, glowOpts("VendingGlow", rgb(180, 190, 200)))
		BX(shell, x0 + 0.2, 0.12, 4.99, x0 + 0.7, 0.32, 5.02, rgb(30, 30, 34), MAT.SmoothPlastic, opts("VendingSlot"))
	end
end

-- 테라스: 파라솔 테이블 5 세트, 줄조명(전선 + 전구), 분리수거함
local function storeTerrace(ter: Instance, TY: number)
	local cols = { rgb(196, 54, 46), rgb(236, 230, 214), rgb(44, 112, 168), rgb(70, 150, 90), rgb(236, 180, 50) }
	local sets = { { -6.2, -7.2 }, { -2.8, -7.2 }, { 6.6, -7.2 }, { -4.5, -9.7 }, { 5.0, -9.7 } }
	for i, s in sets do
		local cx, cz = s[1], s[2]
		CY(ter, cx, cz, TY, TY + 0.03, 0.45, rgb(60, 62, 66), MAT.Metal, opts("TableBase"))
		CY(ter, cx, cz, TY + 0.03, 0.72, 0.06, rgb(220, 220, 216), MAT.Metal, opts("TablePole"))
		CY(ter, cx, cz, 0.72, 0.75, 0.8, if i % 2 == 0 then rgb(236, 236, 230) else rgb(40, 110, 160), MAT.SmoothPlastic, solid("CafeTable"))
		CY(ter, cx, cz, 0.75, 2.35, 0.04, rgb(220, 220, 214), MAT.Metal, opts("ParasolPole"))
		Kit.ellipsoid(ter, at(cx, 2.2, cz), Vector3.new(M(2.4), M(0.45), M(2.4)), cols[i], MAT.Fabric, opts("Parasol"))
		local chairC = if i % 2 == 0 then rgb(238, 238, 232) else rgb(40, 110, 160)
		for k = 0, 2 do
			local a = math.rad(irng:NextNumber(-20, 20) + k * 120 + 30)
			local base = at(cx + math.cos(a) * 0.72, TY, cz + math.sin(a) * 0.72).Position
			local cf = CFrame.lookAt(base, Vector3.new(at(cx, TY, cz).Position.X, base.Y, at(cx, TY, cz).Position.Z))
			Kit.box(ter, cf * CFrame.new(0, M(0.43 - 0.02), 0), Vector3.new(M(0.42), M(0.04), M(0.42)), chairC, MAT.SmoothPlastic, solid("ChairSeat"))
			Kit.box(ter, cf * CFrame.new(0, M(0.41), M(0.195)), Vector3.new(M(0.42), M(0.82), M(0.03)), chairC, MAT.SmoothPlastic, opts("ChairBack"))
			Kit.box(ter, cf * CFrame.new(0, M(0.2), -M(0.18)), Vector3.new(M(0.38), M(0.4), M(0.03)), chairC, MAT.SmoothPlastic, opts("ChairLegs"))
		end
	end
	-- 줄조명: 강 쪽 기둥 3 (3.2 m) ↔ 캐노피 끝 2 점, W 자 + 앞줄. 처짐 0.35 m, 전구 1 m 간격
	local poles = { Vector3.new(-7.6, 3.1, -10.7), Vector3.new(0.6, 3.1, -10.7), Vector3.new(8.6, 3.1, -10.7) }
	for _, p in poles do
		CY(ter, p.X, p.Z, TY, 3.2, 0.08, rgb(52, 56, 62), MAT.Metal, solid("StringPole"))
		CY(ter, p.X, p.Z, TY, TY + 0.3, 0.26, rgb(110, 110, 108), MAT.Concrete, opts("PoleFoot"))
	end
	local A1, A2 = Vector3.new(-4.6, 3.0, -5.62), Vector3.new(4.4, 3.0, -5.62)
	local spans = { { poles[1], A1 }, { A1, poles[2] }, { poles[2], A2 }, { A2, poles[3] }, { poles[1], poles[2] }, { poles[2], poles[3] } }
	local lit = 0
	for si, sp in spans do
		local a, b = sp[1], sp[2]
		local sag = 0.35
		local function pt(t: number): Vector3
			return a:Lerp(b, t) - Vector3.new(0, sag * 4 * t * (1 - t), 0)
		end
		for k = 0, 2 do
			BAR(ter, pt(k / 3), pt((k + 1) / 3), 0.012, rgb(28, 28, 30), MAT.SmoothPlastic, opts("Wire"))
		end
		local nb = math.max(3, math.floor((b - a).Magnitude / 1.0 + 0.5))
		for k = 0, nb - 1 do
			local q = pt((k + 0.5) / nb) - Vector3.new(0, 0.05, 0)
			local bulb = Kit.ball(ter, at(q.X, q.Y, q.Z).Position, M(0.1), rgb(255, 202, 124), MAT.Neon, glowOpts("StringBulb", rgb(230, 222, 204)))
			if (si == 1 or si == 4) and k == math.floor(nb / 2) and lit < 2 then
				if tryLight(bulb, "PointLight", { color = rgb(255, 196, 130), brightness = 0.9, range = M(5) }) then
					lit += 1
				end
			end
		end
	end
	-- 분리수거함 4 (일반 / 캔·병 / 플라스틱 / 종이) + 안내판
	BX(ter, 6.9, TY, -4.15, 8.7, 1.25, -4.1, rgb(60, 66, 74), MAT.Metal, solid("RecycleBoard"))
	local rh = BX(ter, 6.9, 1.0, -4.17, 8.7, 1.25, -4.15, BRAND, MAT.SmoothPlastic, opts("RecycleHeader"))
	Kit.label(rh, Enum.NormalId.Front, "분리수거  RECYCLE", { glow = true, color = WHITE_LABEL, pixelsPerStud = 60 })
	local bins = { { "일반", rgb(120, 124, 130) }, { "캔·병", rgb(40, 100, 180) }, { "플라스틱", rgb(230, 140, 40) }, { "종이", rgb(60, 140, 80) } }
	for k, bn in bins do
		local x0 = 6.95 + (k - 1) * 0.44
		local body = BX(ter, x0, TY, -4.58, x0 + 0.4, 0.8, -4.18, rgb(228, 230, 232), MAT.SmoothPlastic, solid("RecycleBin"))
		Kit.label(body, Enum.NormalId.Front, bn[1] :: string, { glow = true, color = bn[2] :: Color3, pixelsPerStud = 60 })
		BX(ter, x0 - 0.01, 0.8, -4.59, x0 + 0.41, 0.85, -4.17, bn[2] :: Color3, MAT.SmoothPlastic, opts("RecycleLid"))
	end
end

-- 공중화장실 (10 x 6 m 노출콘크리트 파빌리온, 천장고 2.6 m). 입구 2 (+Z, 산책로 쪽, 폭 1.0 m) + 눈가림벽
local function buildRestroom(parent: Instance, rx: number, rz: number, FY: number)
	ORG = CFrame.new(rx, FY, rz)
	local sh = Kit.group(parent, "Restroom")
	local rin = Kit.group(parent, "RestroomInterior", Config.InteriorStreaming)
	local CONC = rgb(196, 194, 188)
	local TILE_W = rgb(236, 238, 236)
	local H = 2.9
	BX(sh, -5, -0.63, -3, 5, 0, 3, rgb(132, 136, 140), MAT.SmoothPlastic, solid("RestroomFloor"))
	BX(sh, -5, 0, -3, 5, 2.2, -2.8, CONC, MAT.Concrete, solid("RestroomWall"))
	BX(sh, -5, 2.2, -3, 5, 2.55, -2.8, rgb(236, 228, 204), MAT.Neon, glowSolid("RestroomClerestory", rgb(176, 184, 190)))
	BX(sh, -5, 2.55, -3, 5, H, -2.8, CONC, MAT.Concrete, solid("RestroomWall"))
	BX(sh, -5, 0, -2.8, -4.8, H, 2.8, CONC, MAT.Concrete, solid("RestroomWall"))
	BX(sh, 4.8, 0, -2.8, 5, H, 2.8, CONC, MAT.Concrete, solid("RestroomWall"))
	BX(sh, -5, 0, 2.8, -1.45, H, 3, CONC, MAT.Concrete, solid("RestroomWall"))
	BX(sh, -0.45, 0, 2.8, 0.45, H, 3, CONC, MAT.Concrete, solid("RestroomWall"))
	BX(sh, 1.45, 0, 2.8, 5, H, 3, CONC, MAT.Concrete, solid("RestroomWall"))
	BX(sh, -1.45, 2.1, 2.8, -0.45, H, 3, CONC, MAT.Concrete, solid("RestroomWall"))
	BX(sh, 0.45, 2.1, 2.8, 1.45, H, 3, CONC, MAT.Concrete, solid("RestroomWall"))
	-- 지붕(입구 쪽 1.3 m 캐노피) + 목재 처마 반자 + 다운라이트
	BX(sh, -5.5, H, -3.5, 5.5, H + 0.25, 4.3, rgb(170, 168, 162), MAT.Concrete, solid("RestroomRoof"))
	BX(sh, -5.5, H - 0.03, 3.0, 5.5, H, 4.3, rgb(150, 112, 76), MAT.Wood, opts("RestroomSoffit"))
	for i, x in { -0.95, 0.95 } do
		local dl = CY(sh, x, 3.65, H - 0.06, H - 0.03, 0.16, LAMP_HEAD, MAT.Neon, glowOpts("RestroomDownlight"))
		if i == 1 then
			tryLight(dl, "SpotLight", { face = Enum.NormalId.Bottom, angle = 110, range = M(5), brightness = 1.3, color = P.LampWarm })
		end
	end
	-- 입구 면 목재 루버 패널 + 간판 + 남/여 표지 + 문틀
	BX(sh, -4.7, 0.25, 3.0, -1.75, 2.5, 3.09, rgb(150, 110, 74), MAT.Wood, solid("WoodClad"))
	BX(sh, 1.75, 0.25, 3.0, 4.7, 2.5, 3.09, rgb(150, 110, 74), MAT.Wood, solid("WoodClad"))
	local rs = BX(sh, -0.42, 2.25, 3.0, 0.42, 2.72, 3.09, rgb(40, 44, 50), MAT.SmoothPlastic, opts("RestroomSign"))
	Kit.label(rs, Enum.NormalId.Back, "화장실", { glow = true, color = WHITE_LABEL, pixelsPerStud = 40 })
	local fs = BX(sh, -2.4, 1.45, 3.09, -1.8, 2.0, 3.13, rgb(206, 60, 72), MAT.SmoothPlastic, opts("WomenSign"))
	Kit.label(fs, Enum.NormalId.Back, "여자", { glow = true, color = WHITE_LABEL, pixelsPerStud = 60 })
	local ms = BX(sh, 1.8, 1.45, 3.09, 2.4, 2.0, 3.13, rgb(50, 110, 200), MAT.SmoothPlastic, opts("MenSign"))
	Kit.label(ms, Enum.NormalId.Back, "남자", { glow = true, color = WHITE_LABEL, pixelsPerStud = 60 })
	for _, d in { { -1.45, -0.45 }, { 0.45, 1.45 } } do
		BX(sh, d[1] - 0.06, 0, 2.76, d[1] + 0.02, 2.16, 3.05, SS, MAT.Metal, solid("DoorFrame"))
		BX(sh, d[2] - 0.02, 0, 2.76, d[2] + 0.06, 2.16, 3.05, SS, MAT.Metal, solid("DoorFrame"))
		BX(sh, d[1] - 0.06, 2.08, 2.76, d[2] + 0.06, 2.16, 3.05, SS, MAT.Metal, solid("DoorFrame"))
	end

	-- 실내: 천장 + 바닥 줄눈 + 가운데 칸막이벽
	BX(rin, -4.8, 2.6, -2.8, 4.8, 2.64, 2.8, rgb(242, 242, 238), MAT.SmoothPlastic, solid("RestroomCeiling"))
	for k = 1, 15 do
		local x = -4.8 + 0.6 * k
		BX(rin, x - 0.0075, -0.01, -2.8, x + 0.0075, 0.016, 2.8, rgb(176, 180, 184), MAT.SmoothPlastic, opts("Grout", { shadow = false }))
	end
	for k = 1, 9 do
		local z = -2.8 + 0.6 * k
		BX(rin, -4.8, -0.01, z - 0.0075, 4.8, 0.016, z + 0.0075, rgb(176, 180, 184), MAT.SmoothPlastic, opts("Grout", { shadow = false }))
	end
	BX(rin, -0.1, 0, -2.8, 0.1, H, 2.8, TILE_W, TILE_MAT, solid("RestroomPartition"))

	-- 방 하나 (sg = -1 여자 / +1 남자, u = |x| : 0.1 칸막이 ~ 4.8 외벽)
	local function room(sg: number)
		local function X(u: number): number
			return sg * u
		end
		local PANEL = if sg < 0 then rgb(214, 186, 178) else rgb(160, 182, 204)
		local DOOR = PANEL:Lerp(rgb(255, 255, 255), 0.25)
		-- 벽 타일(1.5 m)
		BX(rin, X(4.78), 0, -2.8, X(4.8), 1.5, 2.8, TILE_W, TILE_MAT, opts("Wainscot"))
		BX(rin, X(0.12), 0, -2.8, X(4.78), 1.5, -2.78, TILE_W, TILE_MAT, opts("Wainscot"))
		BX(rin, X(1.45), 0, 2.78, X(4.78), 1.5, 2.8, TILE_W, TILE_MAT, opts("Wainscot"))
		-- 눈가림벽 (입구에서 안이 보이지 않게)
		BX(rin, X(0.1), 0, 1.4, X(2.3), 2.1, 1.55, TILE_W, TILE_MAT, solid("PrivacyScreen"))
		-- 세면대 (상판 0.86 m, 볼 세면기 2) + 거울 + 손 건조기 + 휴지통
		BX(rin, X(2.55), 0.82, 2.25, X(4.65), 0.86, 2.78, rgb(64, 66, 70), MAT.Granite, solid("Vanity"))
		BX(rin, X(2.55), 0.62, 2.27, X(4.65), 0.82, 2.78, rgb(64, 66, 70), MAT.Granite, solid("VanityApron"))
		for _, u in { 3.1, 4.1 } do
			CY(rin, X(u), 2.5, 0.86, 0.98, 0.4, rgb(246, 246, 244), MAT.SmoothPlastic, opts("Basin"))
			CY(rin, X(u), 2.72, 0.86, 1.06, 0.03, SS, MAT.Metal, opts("Faucet"))
			BX(rin, X(u) - 0.015, 1.03, 2.58, X(u) + 0.015, 1.06, 2.72, SS, MAT.Metal, opts("Spout"))
		end
		BX(rin, X(2.6), 1.0, 2.755, X(4.6), 1.85, 2.775, rgb(196, 206, 214), MAT.Glass, opts("Mirror", { reflectance = 0.45 }))
		BX(rin, X(1.6), 1.05, 2.6, X(1.95), 1.35, 2.78, rgb(220, 222, 226), MAT.SmoothPlastic, solid("HandDryer"))
		CY(rin, X(2.35), 2.5, 0, 0.6, 0.32, rgb(200, 200, 196), MAT.Metal, solid("RestroomBin"))
		-- 대변기 칸 (폭 1.0 m, 깊이 1.5 m, 칸막이 높이 0.15 ~ 2.0 m). 가운데 칸은 문이 열려 있음
		local stalls = if sg < 0 then { { 3.8, 4.8 }, { 2.8, 3.8 }, { 1.8, 2.8 } } else { { 3.8, 4.8 }, { 2.8, 3.8 } }
		for si, st in stalls do
			local ua, ub = st[1], st[2]
			BX(rin, X(ua - 0.0125), 0.15, -2.78, X(ua + 0.0125), 2.0, -1.3, PANEL, MAT.SmoothPlastic, solid("StallPanel"))
			BX(rin, X(ub - 0.18), 0.15, -1.32, X(ub), 2.0, -1.28, PANEL, MAT.SmoothPlastic, solid("StallPilaster"))
			local w = (ub - 0.2) - (ua + 0.02)
			if si == 2 then
				local hinge = at(X(ua + 0.02), 1.075, -1.3) * CFrame.Angles(0, math.rad(sg * 80), 0)
				Kit.box(rin, hinge * CFrame.new(M(sg * w / 2), 0, 0), Vector3.new(M(w), M(1.85), M(0.03)), DOOR, MAT.SmoothPlastic, solid("StallDoor"))
			else
				BX(rin, X(ua + 0.02), 0.15, -1.315, X(ub - 0.2), 2.0, -1.285, DOOR, MAT.SmoothPlastic, solid("StallDoor"))
				BX(rin, X(ub - 0.32), 1.0, -1.285, X(ub - 0.26), 1.08, -1.265, rgb(220, 60, 50), MAT.SmoothPlastic, opts("StallIndicator"))
			end
			local uc = (ua + ub) / 2
			BX(rin, X(uc - 0.2), 0.42, -2.78, X(uc + 0.2), 0.78, -2.6, rgb(248, 248, 246), MAT.SmoothPlastic, solid("ToiletTank"))
			CY(rin, X(uc), -2.36, 0, 0.38, 0.32, rgb(248, 248, 246), MAT.SmoothPlastic, solid("ToiletBowl"))
			CY(rin, X(uc), -2.38, 0.38, 0.42, 0.4, rgb(240, 240, 238), MAT.SmoothPlastic, opts("ToiletSeat"))
			BX(rin, X(ua + 0.0125), 0.66, -2.05, X(ua + 0.1), 0.76, -1.88, SS, MAT.Metal, opts("PaperHolder"))
		end
		if sg < 0 then
			-- 청소도구함 (칸 줄 끝)
			BX(rin, X(0.1), 0.0, -1.32, X(0.3), 2.0, -1.28, PANEL, MAT.SmoothPlastic, solid("ClosetFront"))
			BX(rin, X(1.2), 0.0, -1.32, X(1.8), 2.0, -1.28, PANEL, MAT.SmoothPlastic, solid("ClosetFront"))
			local cd = BX(rin, X(0.3), 0.02, -1.315, X(1.2), 2.0, -1.285, DOOR, MAT.SmoothPlastic, solid("ClosetDoor"))
			Kit.label(cd, Enum.NormalId.Back, "청소도구함", { glow = false, color = rgb(90, 70, 70), pixelsPerStud = 40 })
		else
			-- 소변기 3 + 칸막이 2
			for _, uc in { 0.75, 1.45, 2.15 } do
				BX(rin, X(uc - 0.18), 0.4, -2.78, X(uc + 0.18), 1.05, -2.48, rgb(248, 248, 246), MAT.SmoothPlastic, solid("Urinal"))
				BX(rin, X(uc - 0.12), 0.5, -2.48, X(uc + 0.12), 0.94, -2.465, rgb(222, 226, 230), MAT.SmoothPlastic, opts("UrinalBowl"))
				CY(rin, X(uc), -2.74, 1.05, 1.3, 0.04, SS, MAT.Metal, opts("FlushValve"))
			end
			for _, u in { 1.1, 1.8 } do
				BX(rin, X(u - 0.01), 0.6, -2.78, X(u + 0.01), 1.5, -2.35, PANEL, MAT.SmoothPlastic, opts("UrinalDivider"))
			end
		end
		-- 천장 조명 패널 + 실광원
		local lp = BX(rin, X(1.2), 2.56, -0.5, X(3.8), 2.6, 0.5, LED_COOL, MAT.Neon, glowOpts("RestroomCeilingLight", LED_DAY))
		tryLight(lp, "PointLight", { color = LED_COOL, brightness = 1.0, range = M(5) })
	end
	room(-1)
	room(1)
end

-- 공공자전거 대여소 (자전거도로 옆 둔치): 거치대 9 + 자전거 5 + 키오스크 + 안내판. 로컬 원점 = 패드 중심, -Z = 강(자전거도로) 쪽
local function buildBikeStation(parent: Instance, bx: number, bz: number, top: number)
	ORG = CFrame.new(bx, top, bz)
	local bk = Kit.group(parent, "BikeStation")
	local GREEN = rgb(70, 170, 90)
	local FRAME_W = rgb(232, 236, 236)
	BX(bk, -5.4, -0.36, -2.7, 5.4, 0, 2.7, rgb(150, 150, 146), MAT.Pavement, { name = "BikePad", shadow = false })
	BX(bk, -4.4, 0, -1.55, 3.6, 0.08, -1.25, rgb(120, 124, 130), MAT.Concrete, solid("DockBase"))
	local bikesAt = { [0] = true, [1] = true, [3] = true, [4] = true, [6] = true }
	for i = 0, 8 do
		local x = -4.0 + i * 0.9
		BX(bk, x - 0.06, 0, -1.48, x + 0.06, 0.62, -1.32, FRAME_W, MAT.Metal, solid("DockPost"))
		BX(bk, x - 0.09, 0.45, -1.32, x + 0.09, 0.66, -1.12, rgb(54, 60, 66), MAT.SmoothPlastic, opts("DockLock"))
		BX(bk, x - 0.03, 0.6, -1.12, x + 0.03, 0.63, -1.105, if bikesAt[i] then rgb(80, 255, 120) else rgb(255, 170, 60), MAT.Neon, glowOpts("DockLed", rgb(60, 120, 70)))
		if bikesAt[i] then
			-- 자전거 (바퀴 Ø 0.6 m, 축거 1.05 m, 스텝스루 프레임, 앞 바구니): 앞바퀴가 거치대에 물림
			local zf, zr = -0.92, 0.13
			for _, zw in { zf, zr } do
				CH(bk, x, 0.3, zw, 0.045, 0.6, false, rgb(24, 24, 26), MAT.SmoothPlastic, opts("BikeTire"))
				CH(bk, x, 0.3, zw, 0.075, 0.44, false, rgb(196, 200, 206), MAT.Metal, opts("BikeRim", { transparency = 0.45 }))
			end
			local Hd, BB, S, Rr, Fr = Vector3.new(x, 0.86, zf + 0.15), Vector3.new(x, 0.3, zf + 0.55), Vector3.new(x, 0.84, zf + 0.73), Vector3.new(x, 0.3, zr), Vector3.new(x, 0.3, zf)
			BAR(bk, Hd, BB, 0.05, FRAME_W, MAT.Metal, opts("BikeFrame"))
			BAR(bk, BB, S, 0.045, FRAME_W, MAT.Metal, opts("BikeFrame"))
			BAR(bk, BB, Rr, 0.035, FRAME_W, MAT.Metal, opts("BikeFrame"))
			BAR(bk, Hd, Fr, 0.035, FRAME_W, MAT.Metal, opts("BikeFork"))
			BAR(bk, Hd, Vector3.new(x, 1.0, zf + 0.1), 0.03, rgb(40, 40, 44), MAT.Metal, opts("BikeStem"))
			CH(bk, x, 1.0, zf + 0.1, 0.56, 0.03, false, rgb(30, 30, 34), MAT.SmoothPlastic, opts("BikeBar"))
			BX(bk, x - 0.08, 0.86, zf + 0.65, x + 0.08, 0.92, zf + 0.89, rgb(30, 30, 34), MAT.SmoothPlastic, opts("BikeSaddle"))
			BX(bk, x - 0.17, 0.74, zf - 0.28, x + 0.17, 0.96, zf - 0.02, rgb(60, 64, 70), MAT.Metal, opts("BikeBasket", { transparency = 0.3 }))
			BX(bk, x + 0.04, 0.22, zf + 0.55, x + 0.07, 0.38, zr, GREEN, MAT.SmoothPlastic, opts("BikeChainGuard"))
		end
	end
	-- 키오스크 (QR / 카드) + 안내판
	BX(bk, 4.15, 0, -1.6, 4.65, 1.55, -1.25, FRAME_W, MAT.SmoothPlastic, solid("BikeKiosk"))
	local kt = BX(bk, 4.15, 1.55, -1.6, 4.65, 1.75, -1.25, GREEN, MAT.SmoothPlastic, opts("BikeKioskTop"))
	Kit.label(kt, Enum.NormalId.Back, "공공자전거", { glow = true, color = WHITE_LABEL, pixelsPerStud = 60 })
	local scr = BX(bk, 4.22, 0.95, -1.25, 4.58, 1.35, -1.235, rgb(150, 220, 255), MAT.Neon, glowOpts("BikeKioskScreen", rgb(40, 50, 60)))
	tryLight(scr, "PointLight", { color = rgb(190, 230, 255), brightness = 0.8, range = M(4) })
	BX(bk, 4.3, 0.75, -1.25, 4.5, 0.85, -1.22, rgb(24, 24, 28), MAT.SmoothPlastic, opts("CardReader"))
	CY(bk, -5.25, -1.4, 0, 1.9, 0.06, rgb(120, 124, 130), MAT.Metal, solid("MapPost"))
	CY(bk, -4.55, -1.4, 0, 1.9, 0.06, rgb(120, 124, 130), MAT.Metal, solid("MapPost"))
	local mp = BX(bk, -5.35, 0.95, -1.45, -4.45, 1.9, -1.38, GREEN, MAT.SmoothPlastic, opts("BikeMapBoard"))
	Kit.label(mp, Enum.NormalId.Back, "공공자전거 대여소\n한강공원 502번\nQR 대여 · 1시간 1,000원", { glow = true, color = WHITE_LABEL, pixelsPerStud = 60 })
end

local function buildKiosk(parent: Instance, rng: Random, mainPts: { Vector2 })
	local kx = KIOSK_X
	local pz = zOnPath(mainPts, kx)
	local kz = pz - MAIN_W / 2 - M(2.2) - M(4) -- 매장 중심 (뒷벽 바깥면이 메인 산책로 2.2 m 앞)
	local FY = PLAZA_TOP + 0.3 -- 매장 바닥 윗면 (테라스 윗면 = PLAZA_TOP)
	local TY = -0.3 * Config.METERS_PER_STUD -- 테라스 윗면 (로컬 m)
	local zEdge = (pz - MAIN_W / 2 + 0.6 - kz) * Config.METERS_PER_STUD -- 메인 산책로 가장자리까지 (로컬 m)
	ORG = CFrame.new(kx, FY, kz)
	local store = Kit.group(parent, "ConvenienceStore")
	local ter = Kit.group(store, "Terrace")
	BX(ter, -8, TY - 0.36, -11, 9, TY, zEdge, PAVE_C, MAT.Pavement, { name = "StoreTerrace", shadow = false })
	storeShell(Kit.group(store, "Shell"), TY)
	storeInterior(Kit.group(store, "Interior", Config.InteriorStreaming))
	ORG = CFrame.new(kx, FY, kz)
	storeTerrace(ter, TY)
	local tx0, tx1 = kx - M(8), kx + M(9)
	local tz0, tz1 = kz - M(11), pz - MAIN_W / 2 + 0.6
	Kit.reserve(tx0, tz0, tx1, tz1, "ParkStore")
	markRect(tx0 - M(1), tz0 - M(1), tx1 + M(1), tz1, 2)

	-- 화장실 (매장 서쪽 9 m): 입구 앞 포장 마당은 테라스와 이어짐
	local rx = kx - M(6) - M(9) - M(5)
	local rpz = zOnPath(mainPts, rx)
	local rz = rpz - MAIN_W / 2 - M(2.5) - M(3)
	local ax0 = rx - M(5.6)
	local az0, az1 = rz - M(3.6), rpz - MAIN_W / 2 + 0.6
	Kit.box(store, CFrame.new((ax0 + tx0) / 2, PLAZA_TOP - 0.6, (az0 + az1) / 2), Vector3.new(tx0 - ax0, 1.2, az1 - az0), PAVE_C, MAT.Pavement, { name = "RestroomApron", shadow = false })
	buildRestroom(Kit.group(store, "PublicRestroom"), rx, rz, FY)
	Kit.reserve(ax0, az0, tx0, az1, "ParkRestroom")
	markRect(ax0 - M(1), az0 - M(1), tx0, az1, 2)

	-- 강 쪽 연결로 (테라스 → 피크닉장 → 강변 산책로 → 자전거도로, 폭 3 m) + 테라스 조망 축(나무 없음)
	local z0p = N.WaterEdge + M(15.2) -- 750: Riverside 소유 끝 너머
	Kit.box(store, CFrame.new(kx, CONN_TOP - 0.4, (z0p + tz0) / 2), Vector3.new(CONN_W, 0.8, tz0 - z0p), PAVE_C, MAT.Pavement, { name = "StorePath", shadow = false })
	markSeg(kx, z0p, kx, tz0, CONN_W / 2 + 1.5, 2)
	markRect(kx - 40, EDGE_Z + EDGE_W / 2 + M(1.8), kx + 40, tz0, 2)
	Kit.reserve(kx - CONN_W / 2, z0p, kx + CONN_W / 2, tz0, "ParkStorePath")

	-- 공공자전거 대여소 (연결로 서쪽, 자전거도로와 강변 산책로 사이 둔치)
	local bpx = kx - CONN_W / 2 - M(5.4)
	local bpz = z0p + 0.5 + M(2.7)
	buildBikeStation(Kit.group(store, "BikeStation"), bpx, bpz, CONN_TOP)
	Kit.reserve(bpx - M(5.4), bpz - M(2.7), bpx + M(5.4), bpz + M(2.7), "ParkBikeStation")
	markRect(bpx - M(5.4), bpz - M(2.7), bpx + M(5.4), bpz + M(2.7), 2)

	-- 피크닉장 (매점 강 쪽 잔디밭): 테이블 세트 + 파라솔 + 돗자리
	local cols = { rgb(196, 54, 46), rgb(236, 230, 214), rgb(44, 112, 168) }
	local sets = { { -550, 852 }, { -533, 880 }, { -467, 883 }, { -447, 852 } }
	for i, s in sets do
		local x, z = s[1], s[2]
		local gy = groundAt(x, z)
		local cf = CFrame.new(x, gy, z) * CFrame.Angles(0, math.rad(rng:NextNumber(-12, 12)), 0)
		picnicSet(parent, cf)
		if z > PICNIC[2] + 40 then
			parasol(parent, x, gy, z, cols[i % 3 + 1])
		end
	end
	local mats = { { -543, 840, rgb(214, 120, 60) }, { -563, 877, rgb(70, 140, 190) }, { -474, 842, rgb(220, 196, 90) } }
	for _, m in mats do
		Kit.box(parent, CFrame.new(m[1] :: number, GROUND + 0.3, m[2] :: number) * CFrame.Angles(0, math.rad(rng:NextNumber(-30, 30)), 0), Vector3.new(M(1.8), 0.3, M(2.4)), m[3] :: Color3, MAT.Fabric, opts("PicnicMat"))
	end
	local pl = lamp(parent, -430, 887)
	lampLight(pl)
	for _, s in sets do
		markSeg(s[1], s[2], s[1], s[2], M(2), 1)
	end
	signStone(parent, tx1 + M(6), pz - MAIN_W / 2 - M(2.5), "한강공원")
end

------------------------------------------------------------------------------------------------------
-- 1b) 전망대 디테일: "잠실 야경" 안내판(데크 앞 난간), 계단 입구 표지 + 10 m 마다 높이 표시(계단탑 안),
--     엘리베이터 호출 버튼 받침 기둥 + 안내 토템(지상) / 계단 안내판(데크)
------------------------------------------------------------------------------------------------------
local function buildDeckDetail(parent: Instance)
	local cx, cz = DC.X, DC.Z + DECK_DZ
	local hw, hd = DECK_W / 2, DECK_D / 2
	local z0, z1 = cz - hd, cz + hd
	local sx, sz = TOWER.X, TOWER.Y
	local NAVY = rgb(24, 30, 44)
	local GOLD = rgb(255, 214, 150)

	-- 1) 잠실 야경 안내판: 1.3 x 0.75 m 판을 35° 기울임(중심 높이 1.0 m). 강(-Z)을 향해 선 사람이 내려다보는 약도
	local bx, bz = cx + M(3.3), z0 + M(0.85)
	local TH = 0.05
	local bcf = CFrame.new(bx, DY + M(1.0), bz) * CFrame.Angles(math.rad(35), 0, 0)
	for _, dx in { -0.5, 0.5 } do
		Kit.vcyl(parent, Vector3.new(bx + M(dx), DY + M(0.47), bz + M(0.05)), M(0.94), M(0.06), STEEL, MAT.Metal, opts("InfoBoardLeg", { collide = true }))
	end
	Kit.box(parent, bcf, Vector3.new(M(1.3), M(TH), M(0.75)), NAVY, MAT.SmoothPlastic, { name = "InfoBoard" })
	-- 판 위 요소: u = 판 가로(m), v = 판 세로(m, + = 보는 사람 쪽 아래), 판 면에서 2 cm 돋움
	local function bp(u0: number, v0: number, u1: number, v1: number, color: Color3, name: string, glow: boolean, yaw: number?): BasePart
		local cf = bcf * CFrame.new(M((u0 + u1) / 2), M(TH / 2 + 0.01), M((v0 + v1) / 2))
		local size = Vector3.new(M(math.abs(u1 - u0)), M(0.02), M(math.abs(v1 - v0)))
		if yaw then -- 비스듬한 막대(다리): 강·글자판보다 1.5 cm 더 돋움
			local du, dv = u1 - u0, v1 - v0
			cf = bcf * CFrame.new(M((u0 + u1) / 2), M(TH / 2 + 0.0175), M((v0 + v1) / 2)) * CFrame.Angles(0, math.atan2(-dv, du), 0)
			size = Vector3.new(M(math.sqrt(du * du + dv * dv)), M(0.035), M(yaw))
		end
		return Kit.box(parent, cf, size, color, if glow then MAT.Neon else MAT.SmoothPlastic, if glow then glowOpts(name, color) else opts(name))
	end
	local function lbl(u0: number, v0: number, u1: number, v1: number, text: string, color: Color3?)
		local p = bp(u0, v0, u1, v1, rgb(18, 22, 32), "InfoLabel", false)
		Kit.label(p, Enum.NormalId.Top, text, { glow = true, color = color or rgb(236, 230, 214), pixelsPerStud = 90 })
	end
	lbl(-0.6, -0.365, 0.6, -0.285, "잠실 야경  ·  JAMSIL NIGHT VIEW", GOLD)
	local river = bp(-0.62, 0.1, 0.62, 0.17, rgb(36, 74, 122), "InfoRiver", false)
	Kit.label(river, Enum.NormalId.Top, "한  강", { glow = true, color = rgb(170, 210, 250), pixelsPerStud = 90 })
	bp(-0.62, 0.085, 0.62, 0.1, rgb(214, 160, 90), "InfoBank", true)
	for _, b in { { -0.58, -0.5, 0.0 }, { -0.48, -0.41, -0.06 }, { -0.39, -0.33, 0.02 }, { 0.06, 0.13, -0.08 }, { 0.15, 0.22, -0.04 }, { 0.25, 0.31, -0.1 }, { 0.34, 0.4, -0.02 } } do
		bp(b[1], b[3], b[2], 0.085, rgb(120, 140, 170), "InfoBuilding", true)
	end
	bp(-0.12, 0.05, -0.02, 0.085, rgb(70, 130, 220), "InfoMall", true)
	bp(-0.2, -0.2, -0.16, 0.085, GOLD, "InfoTower", true)
	bp(-0.187, -0.255, -0.173, -0.2, GOLD, "InfoSpire", true)
	bp(0.62, 0.3, 0.36, 0.1, rgb(214, 160, 90), "InfoBridge", true, 0.012)
	lbl(-0.14, -0.255, 0.16, -0.195, "롯데월드타워 555 m")
	lbl(0.05, -0.165, 0.45, -0.11, "잠실 고층 업무지구")
	lbl(-0.36, 0.2, -0.04, 0.26, "롯데월드몰")
	lbl(0.22, 0.215, 0.46, 0.275, "잠실대교")
	lbl(-0.6, 0.29, 0.6, 0.355, "현재 위치: 한강공원 전망대 (높이 60 m) · 앞쪽 강변 = 올림픽대로", rgb(200, 206, 216))
	local hood = Kit.box(parent, bcf * CFrame.new(0, M(TH / 2 + 0.07), -M(0.39)), Vector3.new(M(1.2), M(0.03), M(0.05)), LAMP_HEAD, MAT.Neon, glowOpts("InfoBoardLamp"))
	tryLight(hood, "PointLight", { color = P.LampWarm, brightness = 0.8, range = M(2.5) })

	-- 2) 계단탑: 첫 단 앞 입구 표지(조명) + 10 m 마다 높이 표시(엘리베이터 샤프트 유리 바깥면)
	local rise = DY - PLAZA_TOP
	local n = math.ceil(rise / RISER)
	local riser = rise / n
	local rc = (STAIR_RIN + STAIR_ROUT) / 2
	local perTurn = math.floor(2 * math.pi * rc / TREAD + 0.5)
	local dTheta = 2 * math.pi / perTurn
	local thLast = -math.pi / 2 - math.asin((LAND_W / 2) / rc) - dTheta * 0.5
	local function theta(k: number): number
		return thLast - (n - 1 - k) * dTheta
	end
	local t1 = theta(1) - math.rad(22)
	local out = Vector3.new(math.cos(t1), 0, math.sin(t1))
	local pp = Vector3.new(sx, PLAZA_TOP, sz) + out * (STAIR_ROUT + M(2.4))
	local pcf = CFrame.lookAt(pp + Vector3.new(0, M(1.1), 0), pp + Vector3.new(0, M(1.1), 0) + out)
	Kit.box(parent, pcf, Vector3.new(M(0.7), M(2.2), M(0.14)), rgb(40, 44, 52), MAT.Metal, { name = "StairPylon" })
	local face = Kit.box(parent, pcf * CFrame.new(0, M(0.2), -M(0.08)), Vector3.new(M(0.6), M(1.3), M(0.02)), rgb(26, 30, 38), MAT.SmoothPlastic, opts("StairPylonFace"))
	Kit.label(face, Enum.NormalId.Front, string.format("전망대 계단\n60 m\n%d계단 · 약 7분\n\n엘리베이터는\n탑 뒤편", n - 1), { glow = true, color = GOLD, pixelsPerStud = 50 })
	local strip = Kit.box(parent, pcf * CFrame.new(0, M(0.95), -M(0.08)), Vector3.new(M(0.6), M(0.06), M(0.02)), LAMP_HEAD, MAT.Neon, glowOpts("StairPylonLed"))
	tryLight(strip, "PointLight", { color = P.LampWarm, brightness = 1.0, range = M(5) })
	for _, hm in { 10, 20, 30, 40, 50 } do
		local k = math.floor(M(hm) / riser + 0.5)
		if k >= 1 and k <= n - 1 then
			local th = theta(k)
			local o2 = Vector3.new(math.cos(th), 0, math.sin(th))
			local p = Vector3.new(sx, PLAZA_TOP + k * riser + M(1.45), sz) + o2 * (SHAFT_R + 0.12)
			local plate = Kit.box(parent, CFrame.lookAt(p, p + o2), Vector3.new(M(0.5), M(0.24), 0.12), rgb(30, 34, 42), MAT.SmoothPlastic, opts("HeightMark"))
			Kit.label(plate, Enum.NormalId.Front, string.format("%d m", hm), { glow = true, color = GOLD, pixelsPerStud = 60 })
		end
	end

	-- 3) 엘리베이터 호출 버튼 받침 기둥(버튼 위치·크기는 buildDeck 그대로) + 지상 안내 토템 + 데크 계단 안내판
	local downAt = Vector3.new(sx, PLAZA_TOP + M(1.1), sz + STAIR_ROUT + M(1.2))
	local upAt = Vector3.new(cx + hw - M(1.6), DY + M(1.1), z1 - M(1.4))
	for _, b in { { downAt, PLAZA_TOP }, { upAt, DY } } do
		local p, base = b[1] :: Vector3, b[2] :: number
		local top = p.Y - M(0.3)
		Kit.box(parent, CFrame.new(p.X, (base + top) / 2, p.Z), Vector3.new(M(0.22), top - base, M(0.22)), SS, MAT.Metal, solid("ElevatorCallPost"))
	end
	local tx, tz = sx + M(1.1), downAt.Z
	Kit.box(parent, CFrame.new(tx, PLAZA_TOP + M(1.05), tz), Vector3.new(M(0.55), M(2.1), M(0.12)), rgb(40, 44, 52), MAT.Metal, { name = "ElevatorTotem" })
	local tf = Kit.box(parent, CFrame.new(tx, PLAZA_TOP + M(1.3), tz + M(0.07)), Vector3.new(M(0.46), M(1.2), M(0.02)), rgb(26, 30, 38), MAT.SmoothPlastic, opts("ElevatorTotemFace"))
	Kit.label(tf, Enum.NormalId.Back, "전망대\n엘리베이터\n\n60 m\n잠실 야경", { glow = true, color = GOLD, pixelsPerStud = 50 })
	local gx, gz = sx - M(1.9), z1 - M(0.7)
	Kit.box(parent, CFrame.new(gx, DY + M(0.55), gz), Vector3.new(M(0.06), M(1.1), M(0.06)), STEEL, MAT.Metal, opts("DeckSignPost", { collide = true }))
	local ds = Kit.box(parent, CFrame.new(gx, DY + M(1.25), gz), Vector3.new(M(0.9), M(0.32), M(0.04)), rgb(26, 30, 38), MAT.SmoothPlastic, opts("DeckSign"))
	Kit.label(ds, Enum.NormalId.Front, "계단으로 내려가기\n엘리베이터는 오른쪽 끝", { glow = true, color = GOLD, pixelsPerStud = 60 })
end

------------------------------------------------------------------------------------------------------
-- 3) 주차장 (제방 아래): 2.5 x 5 m 주차칸 2 열 + 통로 6 m, 승용차 4.6 x 1.85 x 1.5 m
------------------------------------------------------------------------------------------------------
local function buildParking(parent: Instance, rng: Random)
	local x0, z0, x1, z1 = LOT_X0, LOT_Z0, LOT_X1, LOT_Z1
	local top = PLAZA_TOP
	Kit.box(parent, CFrame.new((x0 + x1) / 2, top - 0.6, (z0 + z1) / 2), Vector3.new(x1 - x0, 1.2, z1 - z0), P.Asphalt, MAT.Asphalt, { name = "ParkingLot", shadow = false })
	Kit.box(parent, CFrame.new((x0 + x1) / 2, top - 0.45, z0 - 0.6), Vector3.new(x1 - x0 + 2.4, 1.5, 1.2), BENCH_BASE, MAT.Concrete, { name = "LotCurb", shadow = false })
	local stallW, depth = M(2.5), M(5)
	local rows = { { z0 + M(1), z0 + M(1) + depth, 1 }, { z1 - M(1) - depth, z1 - M(1), -1 } }
	local paint = rgb(200, 200, 192)
	local xs: { number } = {}
	local x = x0 + M(1.5)
	while x <= x1 - M(1.5) do
		table.insert(xs, x)
		x += stallW
	end
	for _, row in rows do
		for _, lx in xs do
			Kit.box(parent, CFrame.new(lx, top + 0.15, (row[1] + row[2]) / 2), Vector3.new(M(0.12), 0.3, depth), paint, MAT.SmoothPlastic, opts("StallLine", { shadow = false }))
		end
		-- 주차된 차 (빈칸 섞임): 차체 + 캐빈(유리)
		for i = 1, #xs - 1 do
			if rng:NextNumber() < 0.55 then
				local cx = (xs[i] + xs[i + 1]) / 2
				local cz = (row[1] + row[2]) / 2 + row[3] * M(0.15)
				local col = CAR_COLORS[rng:NextInteger(1, #CAR_COLORS)]
				local cf = CFrame.new(cx, top, cz) * CFrame.Angles(0, math.rad(rng:NextNumber(-2, 2)), 0)
				local bodyH = M(0.8)
				Kit.box(parent, cf * CFrame.new(0, M(0.15) + bodyH / 2, 0), Vector3.new(M(1.85), bodyH, M(4.6)), col, MAT.SmoothPlastic, { name = "CarBody" })
				Kit.box(parent, cf * CFrame.new(0, M(0.95) + M(0.275) - 0.15, row[3] * M(0.25)), Vector3.new(M(1.6), M(0.55) + 0.3, M(2.4)), rgb(36, 42, 52), MAT.Glass, opts("CarCabin"))
			end
		end
	end
	-- 주차장 조명 2 (8 m 기둥, 연석 위)
	for i, lx in { x0 + M(12), x1 - M(12) } do
		local lz = z0 - 0.6
		Kit.vcyl(parent, Vector3.new(lx, top + M(4), lz), M(8), M(0.2), POLE_C, MAT.Metal, opts("LotPole"))
		local hd = Kit.box(parent, CFrame.new(lx, top + M(8) + 0.3, lz + M(0.6)), Vector3.new(M(0.8), 0.5, M(1.6)), rgb(236, 226, 206), MAT.Neon, glowOpts("LotLight"))
		hashAdd(lamps, lx, lz, 0)
		if i == 1 then
			tryLight(hd, "SpotLight", { face = Enum.NormalId.Bottom, angle = 110, range = 50, brightness = 1.6, color = rgb(255, 232, 196) })
		end
	end
	Kit.reserve(x0, z0 - 1.2, x1, z1, "ParkParking")
	markRect(x0 - M(1), z0 - M(1.5), x1 + M(1), z1 + M(1), 2)
	signStone(parent, x1 + M(8), z0 - M(3), "한강공원 주차장")
end

------------------------------------------------------------------------------------------------------
-- 4) 둔덕 (지형 Ball, 잔디): 반지름 15 ~ 23 m, 높이 1.8 ~ 3.3 m
------------------------------------------------------------------------------------------------------
local function buildMounds(rng: Random)
	local made = 0
	for _ = 1, 80 do
		if made >= 12 then
			break
		end
		local x = rng:NextNumber(-M(650), M(650))
		local z = rng:NextNumber(BELT_Z1 - M(5), N.ParkTo - M(12))
		local r = rng:NextNumber(M(15), M(23))
		local h = rng:NextNumber(M(1.8), M(3.3))
		local fr = math.sqrt(2 * r * h - h * h)
		if inBridge(x, fr + M(3)) or inPicnic(x, z, fr + M(1.2)) then
			continue
		end
		if occupied(x, z, fr + M(1), 1) then
			continue
		end
		if not Kit.isFree(x - fr, z - fr, x + fr, z + fr) then
			continue
		end
		local clash = false
		for _, m in mounds do
			if (Vector2.new(m[1], m[2]) - Vector2.new(x, z)).Magnitude < fr + m[5] + M(2) then
				clash = true
				break
			end
		end
		if clash then
			continue
		end
		local cy = GROUND - r + h
		table.insert(mounds, { x, z, r, cy, fr })
		Kit.terrain("Ball", CFrame.new(x, cy, z), Vector3.new(r * 2, r * 2, r * 2), MAT.Grass)
		made += 1
	end
end

------------------------------------------------------------------------------------------------------
-- 5) 나무 (둥근 활엽수: 줄기 + 수관 타원체). 높이 8 ~ 14 m, 줄기 Ø 0.3 ~ 0.6 m, 수관 Ø 5 ~ 9 m
------------------------------------------------------------------------------------------------------
local function tree(parent: Instance, rng: Random, x: number, z: number, gy: number, D: number, lod: number): number
	local th = rng:NextNumber(M(3.0), M(4.6)) * math.clamp(D / M(7), 0.9, 1.15) -- 수관 아래 줄기 높이
	local hc = D * rng:NextNumber(0.8, 0.94) -- 수관 높이
	local trunkD = math.clamp(D * 0.06, M(0.3), M(0.6))
	local n = 0
	local trunkH = th + hc * 0.35 + 1
	Kit.vcyl(parent, Vector3.new(x, gy - 1 + trunkH / 2, z), trunkH, trunkD, BARK, MAT.Wood, { name = "Trunk", shadow = false, collide = true })
	n += 1
	local c = LEAVES[rng:NextInteger(1, #LEAVES)]
	if lod >= 3 then
		c = c:Lerp(LEAF_LIGHT, rng:NextNumber(0.12, 0.32)) -- 히어로 띠: 위에서 보이는 수관을 조금 밝게
	end
	local mat = if rng:NextNumber() < 0.6 then MAT.Grass else MAT.LeafyGrass
	local cy = gy + th + hc * 0.5
	local yaw = CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	Kit.ellipsoid(parent, CFrame.new(x, cy, z) * yaw, Vector3.new(D, hc, D * rng:NextNumber(0.84, 1.0)), c, mat, opts("Canopy"))
	n += 1
	if lod >= 2 then
		local a = rng:NextNumber(0, math.pi * 2)
		local d2 = D * rng:NextNumber(0.56, 0.72)
		local off = D * rng:NextNumber(0.2, 0.3)
		Kit.ellipsoid(parent, CFrame.new(x + math.cos(a) * off, cy + hc * rng:NextNumber(0.08, 0.24), z + math.sin(a) * off), Vector3.new(d2, d2 * 0.84, d2), c:Lerp(LEAF_LIGHT, rng:NextNumber(0.08, 0.3)), mat, opts("Canopy"))
		n += 1
		if lod >= 3 then
			local a2 = a + math.pi + rng:NextNumber(-0.6, 0.6)
			local d3 = D * rng:NextNumber(0.52, 0.66)
			local off2 = D * rng:NextNumber(0.22, 0.3)
			Kit.ellipsoid(parent, CFrame.new(x + math.cos(a2) * off2, cy - hc * rng:NextNumber(0.0, 0.12), z + math.sin(a2) * off2), Vector3.new(d3, d3 * 0.82, d3), c:Lerp(LEAF_DARK, rng:NextNumber(0.1, 0.3)), mat, opts("Canopy"))
			n += 1
		end
	end
	return n
end

local function densX(x: number): number
	local d = math.abs(x - VIEW_X)
	if d < M(350) then
		return 1
	end
	return math.clamp(1 - (d - M(350)) / M(550), 0.42, 1)
end

local function buildTrees(parent: Instance, rng: Random, budget: number): number
	-- 숲(그로브) 중심: 그 밖은 듬성듬성(잔디 공터)
	local groves: { { number } } = {}
	for _ = 1, 70 do
		local x = math.clamp(VIEW_X + rng:NextNumber(-1, 1) * rng:NextNumber(0.25, 1) * M(850), X0, X1)
		table.insert(groves, { x, rng:NextNumber(Z0 + M(10), Z1 - M(10)), rng:NextNumber(M(20), M(45)) })
	end
	local function groveField(x: number, z: number): number
		local g = 0
		for _, gr in groves do
			local ex, ez = (x - gr[1]) / gr[3], (z - gr[2]) / gr[3]
			if math.abs(ex) < 1 and math.abs(ez) < 1 then
				local d2 = ex * ex + ez * ez
				if d2 < 1 then
					g = math.max(g, 1 - d2)
				end
			end
		end
		return g
	end

	local trees = newHash(HASH_CELL)
	local used, count = 0, 0
	-- pass 1: 히어로 하단 띠(큰 수관, 촘촘) → pass 2: 근경 나머지(그로브) → pass 3: 원경
	local NEAR0, NEAR1 = VIEW_X - M(530), VIEW_X + M(545)
	local passes = {
		{ x0 = BELT_X0, x1 = BELT_X1, z1 = BELT_Z1, tries = 7000, cap = budget * 0.47 },
		{ x0 = NEAR0, x1 = NEAR1, z1 = Z1 - M(3), tries = 9000, cap = budget * 0.85 },
		{ x0 = X0 + M(4), x1 = X1 - M(4), z1 = Z1 - M(3), tries = 10000, cap = budget },
	}
	for pi, pass in passes do
		for _ = 1, pass.tries do
			if used >= pass.cap - 4 then
				break
			end
			local x = rng:NextNumber(pass.x0, pass.x1)
			local z = rng:NextNumber(TREE_Z0, pass.z1)
			local belt = x > BELT_X0 and x < BELT_X1 and z < BELT_Z1
			if (pi == 2 and belt) or (pi == 3 and x > NEAR0 and x < NEAR1) then
				continue
			end
			local p = if belt then 1 else densX(x) * (0.32 + 0.68 * groveField(x, z))
			if rng:NextNumber() > p then
				continue
			end
			local D = if belt then rng:NextNumber(M(6.8), M(9)) else rng:NextNumber(M(5), M(8))
			local r = D / 2
			if z + r * 0.9 > Z1 - 1 then
				continue
			end
			if inBridge(x, r) or inPicnic(x, z, r * 0.5) then
				continue
			end
			if occupied(x, z, M(0.8), 1) or occupied(x, z, r * 0.7, 2) or (belt and occupied(x, z, r * 0.8, 3)) then
				continue
			end
			if hashHit(lamps, x, z, r * 0.85, 1, M(0.6)) then
				continue
			end
			if hashHit(trees, x, z, r, if belt then 0.6 else 0.64, 0) then
				continue
			end
			if not Kit.isFree(x - r * 0.7, z - r * 0.7, x + r * 0.7, z + r * 0.7) then
				continue
			end
			local gy = groundAt(x, z)
			local near = math.abs(x - VIEW_X) < M(475)
			local lod = if belt then 3 elseif near then 2 else 1
			used += tree(parent, rng, x, z, gy, D, lod)
			count += 1
			hashAdd(trees, x, z, r)
		end
	end
	return count
end

------------------------------------------------------------------------------------------------------
-- 빌드
------------------------------------------------------------------------------------------------------
function Park.build(ctx: any)
	local model: Model = ctx.model
	local rng: Random = ctx.rng
	local p0 = Kit.stats.parts
	lightsUsed = 0
	grid = {}
	mounds = {}
	lamps = newHash(HASH_CELL)

	-- 메인 산책로 선형 (구조물 배치 기준; 옛 레이아웃 × 5/3, 다리 아래는 비움)
	local ctrl = {
		Vector2.new(X0, 1075),
		Vector2.new(-2300, 1025),
		Vector2.new(-1917, 1083),
		Vector2.new(-1550, 1008),
		Vector2.new(-1200, 1053),
		Vector2.new(-933, 1017),
		Vector2.new(-667, 1020),
		Vector2.new(-417, 1030),
		Vector2.new(-217, 1080),
		Vector2.new(DC.X, PLAZA.Y - PLAZA_R - M(5)),
		Vector2.new(100, 1083),
		Vector2.new(283, 1043),
		Vector2.new(B.X, 1040),
		Vector2.new(567, 1037),
		Vector2.new(750, 1000),
		Vector2.new(1000, 1047),
		Vector2.new(1300, 1010),
		Vector2.new(1633, 1075),
		Vector2.new(2000, 1020),
		Vector2.new(2367, 1067),
		Vector2.new(X1, 1033),
	}
	local function stepAt(x: number): number
		return if math.abs(x - VIEW_X) < M(475) then M(11) else M(45)
	end
	local mainPts = catmull(ctrl, stepAt)
	local function skipBridge(x: number): boolean
		return inBridge(x, M(1))
	end

	irng = Random.new(Config.SEED + 4242)
	ORG = CFrame.identity
	local interiorParts = 0

	-- 1) 전망대 (+ 안내판·계단 표지·호출 버튼 받침)
	buildDeck(Kit.group(model, "Deck"))
	local q0 = Kit.stats.parts
	buildDeckDetail(Kit.group(model, "DeckDetail", Config.InteriorStreaming))
	interiorParts += Kit.stats.parts - q0

	-- 2) 산책로: 강변 쪽 숲 앞 산책로(직선) → 메인(곡선) → 연결로 → 광장 진입로
	local paths = Kit.group(model, "Paths")
	local edgeSpans = { { -M(500), B.X - BRIDGE_CORR - M(1) }, { B.X + BRIDGE_CORR + M(1), M(550) } }
	for _, s in edgeSpans do
		local a, b = s[1], s[2]
		Kit.box(paths, CFrame.new((a + b) / 2, MAIN_TOP - 0.4, EDGE_Z), Vector3.new(b - a, 0.8, EDGE_W), EDGE_C, MAT.Pavement, { name = "EdgeWalk", shadow = false })
		markSeg(a, EDGE_Z, b, EDGE_Z, EDGE_W / 2 + 1.5, 1)
	end
	drawPath(paths, mainPts, MAIN_W, MAIN_TOP, BRICK_C, MAT.Brick, "MainPath", skipBridge)

	local connectors: { { Vector2 } } = {}
	-- 히어로 하단에 보이는 연결로(-167, 200)는 숲 띠 안에서 수관이 덮지 않는 "빛길"(공원등 줄)
	local connX = { -2067, -1267, -167, 200, 933, 1967 }
	for _, cx in connX do
		local xe = cx + rng:NextNumber(-M(15), M(15))
		local ze = zOnPath(mainPts, xe)
		local c = {
			Vector2.new(cx, EDGE_Z),
			Vector2.new(cx + rng:NextNumber(-M(7), M(7)), EDGE_Z + (ze - EDGE_Z) * 0.35),
			Vector2.new((cx + xe) / 2 + rng:NextNumber(-M(8), M(8)), EDGE_Z + (ze - EDGE_Z) * 0.7),
			Vector2.new(xe, ze),
		}
		local pts = catmull(c, function(_x: number): number
			return M(9)
		end)
		drawPath(paths, pts, CONN_W, CONN_TOP, PAVE_C, MAT.Pavement, "ConnPath")
		table.insert(connectors, pts)
		for i = 1, #pts - 1 do
			local a, b = pts[i], pts[i + 1]
			if (a.Y + b.Y) / 2 < BELT_Z1 + M(5) and a.X > BELT_X0 and a.X < BELT_X1 then
				markSeg(a.X, a.Y, b.X, b.Y, CONN_W / 2 + 1.5, 3)
			end
		end
	end
	-- 광장 진입로 (메인 → 광장 안쪽)
	local spurX = DC.X + M(11)
	local spur = catmull({ Vector2.new(spurX, zOnPath(mainPts, spurX)), Vector2.new(DC.X + M(6), PLAZA.Y - PLAZA_R + M(4)) }, function(_x: number): number
		return M(15)
	end)
	drawPath(paths, spur, M(3), CONN_TOP, PAVE_C, MAT.Pavement, "PlazaSpur")

	-- 3) 편의점·테라스·화장실·자전거 대여소·피크닉 / 주차장
	q0 = Kit.stats.parts
	buildKiosk(Kit.group(model, "Kiosk"), rng, mainPts)
	interiorParts += Kit.stats.parts - q0
	if interiorParts > INTERIOR_BUDGET then
		warn(string.format("[SeoulSkyline] Park 실내 디테일 파트 %d > 예산 %d", interiorParts, INTERIOR_BUDGET))
	end
	buildParking(Kit.group(model, "Parking"), rng)

	-- 4) 공원등(4.5 m) + 벤치 + 휴지통
	local fx = Kit.group(model, "Lamps")
	local function lampOK(x: number, z: number): boolean
		return not inBridge(x, M(2)) and not occupied(x, z, 1.5, 2) and not hashHit(lamps, x, z, 0, 1, M(5))
	end
	-- 강변 쪽 산책로 줄 (숲 앞 가장자리): 히어로 띠는 촘촘 + 광원
	do
		local x = -M(500)
		local cnt = 0
		local lz = EDGE_Z + EDGE_W / 2 + M(0.6)
		while x <= M(550) do
			local nearConn = false
			for _, cx in connX do
				if math.abs(x - cx) < M(3) then
					nearConn = true
				end
			end
			if not nearConn and lampOK(x, lz) then
				local hp = lamp(fx, x, lz)
				cnt += 1
				if x > VIEW_X - M(195) and x < VIEW_X + M(215) and (cnt % 2 == 0 or math.abs(x - VIEW_X) < M(60)) then
					lampLight(hp)
				end
			end
			x += if x > BELT_X0 and x < BELT_X1 then M(15) else M(33)
		end
	end
	-- 메인 산책로: 양쪽 엇갈림
	local side = 1
	for _, st in
		stations(mainPts, function(x: number): number
			return if math.abs(x - VIEW_X) < M(475) then M(20) else M(45)
		end, M(3))
	do
		local p, dir = st[1], st[2]
		local nrm = Vector2.new(-dir.Y, dir.X) * side
		local q = p + nrm * (MAIN_W / 2 + M(0.6))
		if lampOK(q.X, q.Y) then
			local hp = lamp(fx, q.X, q.Y)
			if q.X > DC.X - M(60) and q.X < DC.X + M(80) then
				lampLight(hp)
			end
		end
		side = -side
	end
	-- 연결로
	for ci, pts in connectors do
		local sd = if ci % 2 == 0 then 1 else -1
		for _, st in
			stations(pts, function(x: number): number
				return if math.abs(x - VIEW_X) < M(250) then M(13) elseif math.abs(x - VIEW_X) < M(475) then M(17) else M(35)
			end, M(4))
		do
			local p, dir = st[1], st[2]
			local q = p + Vector2.new(-dir.Y, dir.X) * sd * (CONN_W / 2 + M(0.5))
			if q.Y < zOnPath(mainPts, q.X) - MAIN_W and lampOK(q.X, q.Y) then
				local hp = lamp(fx, q.X, q.Y)
				if q.X > VIEW_X - M(195) and q.X < VIEW_X + M(215) and q.Y < BELT_Z1 then
					lampLight(hp)
				end
			end
			sd = -sd
		end
	end
	-- 벤치: 메인 산책로 근경 (+ 3 개마다 휴지통)
	local bside = 1
	local bcount = 0
	for _, st in
		stations(mainPts, function(_x: number): number
			return M(30)
		end, M(9))
	do
		local p, dir = st[1], st[2]
		if math.abs(p.X - VIEW_X) < M(410) then
			local nrm = Vector2.new(-dir.Y, dir.X) * bside
			local q = p + nrm * (MAIN_W / 2 + M(0.9))
			if not inBridge(q.X, M(3)) and not occupied(q.X, q.Y, M(0.6), 2) and not hashHit(lamps, q.X, q.Y, 0, 1, M(1.2)) then
				bench(fx, q.X, q.Y, -nrm)
				bcount += 1
				if bcount % 3 == 0 then
					local bq = q + dir * M(1.5)
					bin(fx, bq.X, bq.Y, groundAt(bq.X, bq.Y))
				end
			end
		end
		bside = -bside
	end

	-- 5) 둔덕
	buildMounds(rng)

	-- 6) 나무 (남은 파트 예산 전부)
	local treeCount = buildTrees(Kit.group(model, "Trees"), rng, PART_BUDGET - (Kit.stats.parts - p0 - interiorParts))

	-- 공원 띠 전체 예약 (도시 생성기가 둔치를 침범하지 않도록)
	Kit.reserve(X0, Z0, X1, Z1, "Park")
	model:SetAttribute("Lights", lightsUsed)
	model:SetAttribute("Trees", treeCount)
	model:SetAttribute("Parts", Kit.stats.parts - p0)
	model:SetAttribute("InteriorParts", interiorParts)
end

return Park
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000B"><Properties><string name="Name">Riverside</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / Riverside
-- 양쪽 강변(공원 내부·다리 제외): 도시 지면 슬래브 · 올림픽대로/강변북로 · 계단식 호안 · 산책로/자전거도로
-- · 둔치 보안등/가로수 줄 · 수변 난간/벤치/휴지통 · 보안등 수면 반사 · 도시로 들어가는 간선도로(차량 불빛 차선).
--
--   * 실제 스케일(1 stud = 0.3 m). 모든 치수는 Config.m(미터) / Config.Real 로 씀:
--       제방 고속화도로: 왕복 8차로(차로 3.5 m) + 길어깨 + 중앙분리대(폭 0.8 m, 높이 0.9 m) + 강 쪽 방호벽(1.0 m)
--                        + 도시 쪽 방음벽 3.5 m(콘크리트 기단 1 m + 투명 패널) = 단면 32.8 m.
--                        중앙 쌍가로등 11 m, 38 m 간격.  차량 불빛 높이 0.7 m, 전조등 간격 1.45 m.
--       계단식 호안: 단 높이 0.4 m · 디딤 1.1 m × 3단 → 산책로(4 m) → 녹지(보안등 4.5 m·벤치·휴지통) → 자전거도로 3 m.
--       난간 1.1 m(기둥 3 m 간격), 벤치 좌면 0.45 m × 길이 1.8 m, 휴지통 0.9 m, 가로수 8~14 m(수관 5~9 m).
--       간선도로: 다리 축은 다리 폭(36 m: 4+4 차로 3.5 m + 보도 3.5 m), 일반 간선은 6차로(3.25 m) + 보도 3 m.
--         가로등 10 m, 한쪽 40 m 간격(양쪽 엇갈림).
--   * 높이 층(겹치는 면 없음): 도시 지면 윗면 = Config.Level.City / 도로 포장 +0.4 / 노면표시 +0.3 / 보도 +0.5
--                                호안 계단 1.35 · 2.7 · 4.05 / 산책로·자전거도로 = Promenade + 0.4 / 노면표시 +0.3
--   * 8차로는 Config 의 제방 도로 띠(RoadFrom..RoadTo, 27 m)보다 넓어서 도시 쪽(RoadTo..CityFrom 녹지)으로 넘침.
--     다리 입구(Bridge.X ± Width/2)에서는 그 넘친 부분을 비워 다리 토막(Bridge 소유)이 덮게 하고,
--     분리대·방호벽·방음벽·노면표시·차선(차량 불빛)도 끊음.
--   * 간선도로는 앞서 빌드된 랜드마크/고층 발자국을 Kit.isFree 로 피해 꺾어 들어감(직각 jog).
--   * 원거리일수록 단순화(나무 3→2파트→수림 매스, 가로등 간격 확대)로 파트 예산 유지.
--   * 가까운 쪽 소유 범위(Z): 호안~자전거도로 [N.WaterEdge - 7.3, N.WaterEdge + NEAR_OWN] — 그 너머는 Park.

local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)

local Riverside = {}

type Span = { number }

local rgb = Color3.fromRGB
local m = Config.m
local P = Config.Palette
local L = Config.Level
local F, N = Config.FarBank, Config.NearBank
local B = Config.Bridge
local R = Config.River
local Z = Config.Zones
local MAT = Enum.Material

------------------------------------------------------------------------------------------------------
-- 상수 (studs; 실측은 m())
------------------------------------------------------------------------------------------------------
local MAXP = 2000 -- 긴 띠 파트 조각 길이(<= 2048)
local GROUND_BOT = L.Promenade - m(6) -- 도시 지면 슬래브 바닥(제방 사면 끝 지형 아래까지 내려 틈을 가림)
local ROAD_TOP = L.City + 0.4 -- 도로 포장 윗면 (다리 토막·랜드마크 광장과 같은 높이)
local PAINT_UP = 0.3 -- 노면표시가 포장보다 높은 양
local CURB_UP = m(0.15) -- 보도 연석 높이
local CAR_Y = ROAD_TOP + m(0.7) -- 차량 불빛 높이
local CAR_SPACING = m(1.45) -- 전조등 두 개 간격
local PATH_TOP = L.Promenade + 0.4 -- 둔치 산책로 윗면 (지형 잔디 Promenade 보다 0.4 위)

local ROAD_X0, ROAD_X1 = R.XMin, R.XMax -- 먼 쪽 제방 도로 포장 범위(강 길이)
local NEAR_X0, NEAR_X1 = Z.CarpetNear.XMin, Z.CarpetNear.XMax -- 가까운 쪽 도로·도시 지면
local LANE_X = 8500 -- 차선(차량 불빛) 범위 ±
local MARK_X, DIV_X = 6000, 4000 -- 가장자리선 / 차선 구분선 범위 ± (먼 곳은 생략)
local BANK_X0, BANK_X1 = R.XMin, R.XMax -- 호안·산책로 = 강 길이

-- 다리 입구(교차로): 분리대·방호벽·방음벽·차선이 끊기는 X 범위
local BRIDGE_HALF = B.Width / 2
local GAP_MOUTH: Span = { B.X - BRIDGE_HALF, B.X + BRIDGE_HALF }
local GAP_PARK: Span = { B.X - BRIDGE_HALF - m(4), B.X + BRIDGE_HALF + m(4) } -- 둔치: 다리 밑 나무/보안등/난간 비움

-- 제방 고속화도로 단면: 강 쪽 가장자리(RoadFrom)에서 도시 쪽으로 u (m)
local XS = {
	parapet = { 0.0, 0.5 }, -- 강 쪽 콘크리트 방호벽 (높이 1.0 m)
	carA = { 1.5, 15.5 }, -- 강 쪽 차로 4 × 3.5 m (바깥 길어깨 1.0 m)
	median = { 16.0, 16.8 }, -- 중앙분리대 (안쪽 길어깨 0.5 m 씩)
	carB = { 17.3, 31.3 }, -- 도시 쪽 차로 4 × 3.5 m
	wall = { 32.3, 32.8 }, -- 방음벽 (바깥 길어깨 1.0 m)
}
local W_ROAD = m(XS.wall[2]) -- 32.8 m
local LANE_M = 3.5
local PARAPET_H, MEDIAN_H = m(1.0), m(0.9)
local WALL_BASE_H, WALL_H = m(1.0), m(3.5)
local XLAMP_H, XLAMP_ARM = m(11), m(5.0) -- 중앙 쌍가로등 높이 / 양팔 등기구 폭
local XLAMP_PITCH = m(38)
local LAMP_X_FAR, LAMP_X_NEAR = 8500, 5000

-- 강변 단면: 수면 경계에서 육지 쪽으로 u (studs)
local STEP_RISE = m(0.405)
local STEP_TREAD = m(1.1)
local STEP_U0 = -m(2.2) -- 맨 아래 단은 물속에서 시작
local PROM_IN = 3 * STEP_TREAD -- 산책로 시작 (3단 계단 뒤)
local PROM_OUT = PROM_IN + m(4.0) -- 산책로 4 m
local BIKE_IN = PROM_OUT + m(2.8) -- 보안등·벤치 녹지 2.8 m
local BIKE_OUT = BIKE_IN + m(3.0) -- 자전거도로 3 m
local VERGE_U = (PROM_OUT + BIKE_IN) / 2 -- 보안등 줄
local NEAR_OWN = BIKE_OUT + m(1.8) -- 가까운 쪽 소유 끝(그 너머 Park)
local PLAMP_H = Config.Real.ParkLamp -- 보안등 4.5 m
local PLAMP_PITCH_NEAR, PLAMP_PITCH_FAR = m(25), m(30)

-- 근경 디테일 구간(히어로/산책로 구도에 보이는 X)
local NEAR_VIEW0, NEAR_VIEW1 = -2300, 2000
local NEAR_LIGHT0, NEAR_LIGHT1 = -1050, 700 -- 실제 PointLight 를 다는 가까운 쪽 보안등 X 범위
local FAR_VIEW0, FAR_VIEW1 = -2700, 2700 -- 먼 쪽 가로수 줄 본편 구간(히어로 화면 폭)
local MAX_LIGHTS = 28

-- 간선도로
local AVE_Z1 = Z.ApartmentsFar.ZMin -- 도시 카펫(LOD) 시작까지
local AVE_LAMP = m(40) -- 한쪽 가로등 간격(양쪽 엇갈림)
local AVE_LAMP_H = m(10)

-- 색
local GROUND_C = rgb(80, 81, 86)
local ASPHALT = P.Asphalt
local PAINT_W = rgb(160, 160, 152)
local PAINT_Y = rgb(190, 150, 62)
local BARRIER_C = rgb(134, 134, 136)
local WALL_GLASS = rgb(74, 98, 112)
local POLE_C = rgb(56, 60, 68)
local STEP_C = { rgb(92, 92, 90), rgb(106, 105, 101), rgb(118, 116, 111) }
local WALK_C = rgb(124, 116, 106)
local BIKE_C = rgb(122, 58, 50)
local SIDEWALK_C = rgb(118, 110, 102)
local WOOD_C = rgb(116, 84, 58)
local BIN_C = rgb(62, 74, 66)
local LEAVES = { rgb(36, 60, 40), rgb(42, 70, 44), rgb(50, 78, 46), rgb(32, 54, 38), rgb(56, 82, 50), rgb(40, 64, 46) }
local LAMP_PROM = rgb(255, 194, 124) -- 둔치 보안등
local LAMP_ROAD = rgb(255, 168, 86) -- 제방 도로 나트륨 빛
local LAMP_AVE = rgb(226, 178, 120) -- 도시 간선
local LAMP_DAY = rgb(214, 214, 206)
local GLINT_C = rgb(236, 164, 92)

------------------------------------------------------------------------------------------------------
-- 유틸
------------------------------------------------------------------------------------------------------
local function deco(name: string, extra: { [string]: any }?): any
	local o: { [string]: any } = { name = name, collide = false, query = false }
	if extra then
		for k, v in extra do
			o[k] = v
		end
	end
	return o
end

local function glowOpts(name: string): any
	return { name = name, collide = false, query = false, shadow = false, glow = true, dayMaterial = MAT.SmoothPlastic, dayColor = LAMP_DAY }
end

-- [a,b] 에서 gaps 를 빼고 maxLen 이하 조각으로 나눔
local function spans(a: number, b: number, maxLen: number, gaps: { Span }?): { Span }
	local pieces: { Span } = { { a, b } }
	if gaps then
		for _, g in gaps do
			local nextP: { Span } = {}
			for _, p in pieces do
				if g[2] <= p[1] or g[1] >= p[2] then
					table.insert(nextP, p)
				else
					if g[1] > p[1] then
						table.insert(nextP, { p[1], g[1] })
					end
					if g[2] < p[2] then
						table.insert(nextP, { g[2], p[2] })
					end
				end
			end
			pieces = nextP
		end
	end
	local out: { Span } = {}
	for _, p in pieces do
		local len = p[2] - p[1]
		if len > 0.5 then
			local n = math.ceil(len / maxLen)
			for i = 0, n - 1 do
				table.insert(out, { p[1] + len * i / n, p[1] + len * (i + 1) / n })
			end
		end
	end
	return out
end

local function inGaps(x: number, gaps: { Span }, pad: number?): boolean
	local d = pad or 0
	for _, g in gaps do
		if x > g[1] - d and x < g[2] + d then
			return true
		end
	end
	return false
end

-- X 방향 띠: z = 중심, w = Z 폭, yTop = 윗면, h = 높이
local function stripX(parent: Instance, x0: number, x1: number, z: number, w: number, yTop: number, h: number, color: Color3, mat: Enum.Material, opts: any, gaps: { Span }?)
	for _, s in spans(x0, x1, MAXP, gaps) do
		Kit.box(parent, CFrame.new((s[1] + s[2]) / 2, yTop - h / 2, z), Vector3.new(s[2] - s[1], h, w), color, mat, table.clone(opts))
	end
end

-- Z 방향 띠: x = 중심, w = X 폭
local function stripZ(parent: Instance, z0: number, z1: number, x: number, w: number, yTop: number, h: number, color: Color3, mat: Enum.Material, opts: any)
	local a, b = math.min(z0, z1), math.max(z0, z1)
	for _, s in spans(a, b, MAXP, nil) do
		Kit.box(parent, CFrame.new(x, yTop - h / 2, (s[1] + s[2]) / 2), Vector3.new(w, h, s[2] - s[1]), color, mat, table.clone(opts))
	end
end

-- 일정 간격 위치 목록: 근경 구간 [v0,v1] 은 dNear, 바깥(lim 까지)은 dFar
local function stations(lim0: number, lim1: number, v0: number, v1: number, dNear: number, dFar: number): { number }
	local out: { number } = {}
	local x = v0
	while x <= v1 do
		table.insert(out, x)
		x += dNear
	end
	x = v1 + dFar
	while x <= lim1 do
		table.insert(out, x)
		x += dFar
	end
	x = v0 - dFar
	while x >= lim0 do
		table.insert(out, x)
		x -= dFar
	end
	return out
end

local lightsUsed = 0
local function tryLight(p: BasePart, brightness: number, range: number, color: Color3?)
	if lightsUsed >= MAX_LIGHTS then
		return
	end
	if Kit.light(p, "PointLight", { color = color or P.LampWarm, brightness = brightness, range = range }) then
		lightsUsed += 1
	end
end

------------------------------------------------------------------------------------------------------
-- 1) 도시 지면 (윗면 = L.City, 타일 <= 2048)
------------------------------------------------------------------------------------------------------
local function tiles(parent: Instance, x0: number, x1: number, z0: number, z1: number)
	local za, zb = math.min(z0, z1), math.max(z0, z1)
	local nx = math.ceil((x1 - x0) / MAXP)
	local nz = math.ceil((zb - za) / MAXP)
	local dx, dz = (x1 - x0) / nx, (zb - za) / nz
	local h = L.City - GROUND_BOT
	for i = 0, nx - 1 do
		for j = 0, nz - 1 do
			Kit.box(parent, CFrame.new(x0 + dx * (i + 0.5), L.City - h / 2, za + dz * (j + 0.5)), Vector3.new(dx, h, dz), GROUND_C, MAT.Concrete, { name = "CityGround", shadow = false })
		end
	end
end

------------------------------------------------------------------------------------------------------
-- 2) 제방 고속화도로 (X 방향, 왕복 8차로)
--   edge = 강 쪽 가장자리 Z (RoadFrom), inland = 도시 방향 부호(먼 쪽 -1 / 가까운 쪽 +1).
--   우측통행: +X 로 가는 차는 +Z 쪽 차로.
------------------------------------------------------------------------------------------------------
type RoadSpec = {
	name: string,
	edge: number,
	inland: number,
	bandEnd: number, -- Config 의 도로 띠 끝(RoadTo): 그 너머(도시 쪽 넘침)는 다리 입구에서 비움
	x0: number,
	x1: number,
	slabBottom: number,
	cityGaps: { Span }, -- 방음벽을 끊는 곳(간선도로 접속)
	lampX: number,
	lampLights: number, -- 다리 입구 근처 가로등에 다는 PointLight 수
}

local function expressway(parent: Instance, spec: RoadSpec)
	local e, s = spec.edge, spec.inland
	local function zAt(um: number): number -- u(미터) → Z
		return e + s * m(um)
	end
	local function zMid(r: { number }): (number, number)
		return (zAt(r[1]) + zAt(r[2])) / 2, m(r[2] - r[1])
	end
	local mouth = { GAP_MOUTH }
	local x0, x1 = spec.x0, spec.x1
	-- 포장: Config 띠 안쪽은 연속, 도시 쪽 넘친 부분은 다리 입구에서 비움
	local uBand = math.abs(spec.bandEnd - e)
	local zb0, zb1 = e, e + s * uBand
	stripX(parent, x0, x1, (zb0 + zb1) / 2, uBand, ROAD_TOP, ROAD_TOP - spec.slabBottom, ASPHALT, MAT.Asphalt, { name = "Road", shadow = false })
	if W_ROAD > uBand + 0.5 then
		local ze = e + s * W_ROAD
		stripX(parent, x0, x1, (zb1 + ze) / 2, W_ROAD - uBand, ROAD_TOP, ROAD_TOP - spec.slabBottom, ASPHALT, MAT.Asphalt, { name = "Road", shadow = false }, mouth)
	end
	-- 노면표시: 안쪽 노란 실선 + 바깥 흰 실선 + 차로 구분선(흰색, 원거리는 생략)
	local function line(um: number, wm: number, c: Color3, lim: number)
		stripX(parent, math.max(x0, -lim), math.min(x1, lim), zAt(um), m(wm), ROAD_TOP + PAINT_UP, 0.6, c, MAT.SmoothPlastic, deco("Paint", { shadow = false }), mouth)
	end
	for _, cw in { XS.carA, XS.carB } do
		local innerIsHigh = cw == XS.carA -- carA 의 안쪽(분리대 쪽)은 u 가 큰 쪽
		local uIn = if innerIsHigh then cw[2] - 0.15 else cw[1] + 0.15
		local uOut = if innerIsHigh then cw[1] + 0.15 else cw[2] - 0.15
		line(uIn, 0.15, PAINT_Y, MARK_X)
		line(uOut, 0.2, PAINT_W, MARK_X)
		for k = 1, 3 do
			line(cw[1] + LANE_M * k, 0.15, PAINT_W, DIV_X)
		end
	end
	-- 중앙분리대 / 강 쪽 방호벽 (다리 입구에서 끊김)
	local zc, w = zMid(XS.median)
	stripX(parent, x0, x1, zc, w, ROAD_TOP + MEDIAN_H, MEDIAN_H + 0.3, BARRIER_C, MAT.Concrete, { name = "Median" }, mouth)
	zc, w = zMid(XS.parapet)
	stripX(parent, x0, x1, zc, w, ROAD_TOP + PARAPET_H, PARAPET_H + 0.3, BARRIER_C, MAT.Concrete, { name = "Parapet" }, mouth)
	-- 도시 쪽 방음벽 (콘크리트 기단 1 m + 반투명 패널) — 간선도로 접속부·다리 입구에서 끊김
	local cg = table.clone(spec.cityGaps)
	table.insert(cg, GAP_MOUTH)
	zc, w = zMid(XS.wall)
	stripX(parent, x0, x1, zc, w, ROAD_TOP + WALL_BASE_H, WALL_BASE_H + 0.3, BARRIER_C, MAT.Concrete, { name = "SoundWallBase" }, cg)
	stripX(parent, x0, x1, zc, m(0.15), ROAD_TOP + WALL_H, WALL_H - WALL_BASE_H + 0.3, WALL_GLASS, MAT.Glass, { name = "SoundWall", transparency = 0.55, shadow = false }, cg)
	-- 중앙 쌍가로등 (11 m, 38 m 간격): 기둥 + 양팔 LED 등기구(멀리서는 한 점의 불빛)
	local zMed = zMid(XS.median)
	local lit = 0
	local xs = stations(-spec.lampX, spec.lampX, -spec.lampX, spec.lampX, XLAMP_PITCH, XLAMP_PITCH)
	table.sort(xs, function(a: number, b: number)
		return math.abs(a - B.X) < math.abs(b - B.X)
	end)
	for _, x in xs do
		if not inGaps(x, mouth, m(3)) then
			local base = ROAD_TOP + MEDIAN_H - 0.3
			Kit.vcyl(parent, Vector3.new(x, (base + XLAMP_H + ROAD_TOP) / 2, zMed), XLAMP_H + ROAD_TOP - base, m(0.25), POLE_C, MAT.Metal, deco("LampPole"))
			local head = Kit.box(parent, CFrame.new(x, ROAD_TOP + XLAMP_H + m(0.1), zMed), Vector3.new(m(0.5), m(0.3), XLAMP_ARM), LAMP_ROAD, MAT.Neon, glowOpts("LampArm"))
			if lit < spec.lampLights then
				lit += 1
				tryLight(head, 1.6, m(24), P.LampSodium)
			end
		end
	end
	-- 차량 불빛 차선: +X 방향 = 후미등(tail), -X 방향 = 전조등(head). 다리 입구에서 끊김.
	local plusZ = if s > 0 then XS.carB else XS.carA -- +Z 쪽 차로(= +X 로 가는 차)
	local minusZ = if s > 0 then XS.carA else XS.carB
	local segs = { { -LANE_X, GAP_MOUTH[1] }, { GAP_MOUTH[2], LANE_X } }
	for k = 1, 4 do
		-- k = 1 은 안쪽(분리대 쪽, 빠름)
		local function laneU(cw: { number }): number
			local inner = if cw == XS.carA then cw[2] else cw[1]
			local dir = if cw == XS.carA then -1 else 1
			return inner + dir * LANE_M * (k - 0.5)
		end
		local zP, zM = zAt(laneU(plusZ)), zAt(laneU(minusZ))
		local spd = m((90 - (k - 1) * 7) / 3.6) -- 90 → 69 km/h
		for j, sg in segs do
			Kit.lane(string.format("%s_E%d_%d", spec.name, k, j), { Vector3.new(sg[1], CAR_Y, zP), Vector3.new(sg[2], CAR_Y, zP) }, { kind = "tail", speed = spd, density = 0.75, spacing = CAR_SPACING })
			Kit.lane(string.format("%s_W%d_%d", spec.name, k, j), { Vector3.new(sg[2], CAR_Y, zM), Vector3.new(sg[1], CAR_Y, zM) }, { kind = "head", speed = spd * 1.02, density = 0.75, spacing = CAR_SPACING })
		end
	end
	Kit.reserve(x0, e, x1, e + s * W_ROAD, spec.name)
end

------------------------------------------------------------------------------------------------------
-- 3) 강변: 계단식 호안 + 산책로 + 자전거도로 (sign: 육지 방향, 먼 쪽 -1 / 가까운 쪽 +1)
------------------------------------------------------------------------------------------------------
local function bankEdge(parent: Instance, edge: number, sign: number)
	local function zr(a: number, b: number): (number, number)
		local p, q = edge + sign * a, edge + sign * b
		return (p + q) / 2, math.abs(q - p)
	end
	-- 계단 3단 (단 높이 0.4 m, 디딤 1.1 m; 맨 아래 단은 물속에서 시작) — 바닥은 지형 호안 사면 속까지
	local stepBot = L.Water - m(2.4)
	for i = 1, 3 do
		local a = if i == 1 then STEP_U0 else STEP_TREAD * (i - 1)
		local z, w = zr(a, STEP_TREAD * i)
		local top = L.Water + STEP_RISE * i
		stripX(parent, BANK_X0, BANK_X1, z, w, top, top - stepBot, STEP_C[i], MAT.Concrete, { name = "RevetStep", shadow = false })
	end
	-- 산책로 4 m (보도블록) — 아래는 호안 사면(지형) 속까지
	local z, w = zr(PROM_IN, PROM_OUT)
	stripX(parent, BANK_X0, BANK_X1, z, w, PATH_TOP, PATH_TOP - (L.Water - m(1.5)), WALK_C, MAT.Pavement, { name = "Promenade", shadow = false })
	-- 자전거도로 3 m (붉은 포장) + 가운데 노란 실선
	z, w = zr(BIKE_IN, BIKE_OUT)
	stripX(parent, BANK_X0, BANK_X1, z, w, PATH_TOP, m(0.6), BIKE_C, MAT.Asphalt, { name = "BikePath", shadow = false })
	stripX(parent, math.max(BANK_X0, -MARK_X), math.min(BANK_X1, MARK_X), z, m(0.12), PATH_TOP + PAINT_UP, 0.6, PAINT_Y, MAT.SmoothPlastic, deco("BikeLine", { shadow = false }))
end

-- 나무(실측 8~14 m, 수관 5~9 m): lod 3 = 줄기 + 수관 2, lod 2 = 줄기 + 수관 1
local function tree(parent: Instance, rng: Random, x: number, z: number, y0: number, lod: number, scale: number?)
	local t = rng:NextNumber() * (scale or 1)
	local H = m(8 + 6 * t) -- 전체 높이
	local D = m(5 + 4 * t + rng:NextNumber(-0.5, 0.5)) -- 수관 지름
	local clear = m(rng:NextNumber(2.2, 3.2)) -- 수관 아래 줄기 높이
	local ch = H - clear
	local trunkH = clear + ch * 0.35
	Kit.vcyl(parent, Vector3.new(x, y0 + trunkH / 2 - 0.25, z), trunkH + 0.5, m(0.28 + 0.14 * t), P.Bark, MAT.Wood, deco("Trunk"))
	Kit.ellipsoid(parent, CFrame.new(x, y0 + clear + ch / 2, z), Vector3.new(D, ch, D * rng:NextNumber(0.88, 1.04)), LEAVES[rng:NextInteger(1, #LEAVES)], MAT.Grass, deco("Canopy"))
	if lod >= 3 then
		local d2 = D * rng:NextNumber(0.58, 0.7)
		local a = rng:NextNumber(0, math.pi * 2)
		Kit.ellipsoid(parent, CFrame.new(x + math.cos(a) * D * 0.24, y0 + clear + ch * 0.66, z + math.sin(a) * D * 0.24), Vector3.new(d2, d2 * 0.9, d2), LEAVES[rng:NextInteger(1, #LEAVES)], MAT.Grass, deco("Canopy"))
	end
end

-- 둔치 보안등 4.5 m: 기둥 + 등 머리(0.5 m) (+ 갓)
local function parkLamp(parent: Instance, x: number, z: number, cap: boolean): BasePart
	local head = m(0.5)
	local ground = L.Promenade - 0.5
	local poleTop = L.Promenade + PLAMP_H - head - m(0.1)
	Kit.vcyl(parent, Vector3.new(x, (ground + poleTop) / 2, z), poleTop - ground, m(0.12), POLE_C, MAT.Metal, deco("LampPole"))
	local hp = Kit.box(parent, CFrame.new(x, poleTop + head / 2, z), Vector3.new(head, head, head), LAMP_PROM, MAT.Neon, glowOpts("LampHead"))
	if cap then
		Kit.box(parent, CFrame.new(x, poleTop + head + m(0.05), z), Vector3.new(head + m(0.15), m(0.1), head + m(0.15)), POLE_C, MAT.Metal, deco("LampCap"))
	end
	return hp
end

local function farBank(parent: Instance, glints: Instance, rng: Random)
	local e, s = F.WaterEdge, -1
	bankEdge(parent, e, s)
	local gaps = { GAP_PARK }
	-- 난간 1.1 m (원경: 손잡이 + 중간 레일만)
	local rz = e + s * (PROM_IN + m(0.12))
	stripX(parent, -6000, 6000, rz, m(0.1), PATH_TOP + Config.Real.Railing, m(0.08), POLE_C, MAT.Metal, { name = "RailTop", shadow = false }, gaps)
	stripX(parent, -6000, 6000, rz, m(0.05), PATH_TOP + m(0.5), m(0.05), POLE_C, MAT.Metal, deco("RailMid", { shadow = false }), gaps)
	-- 보안등 줄 (산책로-자전거도로 사이 녹지) + 수면 반사(2개에 1개, 히어로 화면 안)
	local lampZ = e + s * VERGE_U
	local n = 0
	for _, x in stations(-6000, 6000, FAR_VIEW0, FAR_VIEW1, PLAMP_PITCH_FAR, PLAMP_PITCH_FAR * 2) do
		if not inGaps(x, gaps) then
			parkLamp(parent, x, lampZ, false)
			n += 1
			if math.abs(x) <= 2200 and n % 3 == 0 then
				Kit.reflection(glints, x + rng:NextNumber(-2, 2), e + 8, m(2.0), m(rng:NextNumber(52, 64)), GLINT_C, 0.5)
			end
		end
	end
	-- 가로수 줄(8~14 m): 근경 3파트 → 2파트 → 원거리 수림 매스 (수관이 서로 닿아 짙은 녹색 띠)
	local function treeZ(): number
		return e + s * rng:NextNumber(BIKE_OUT + m(6), BIKE_OUT + m(16))
	end
	local x = FAR_VIEW0
	while x <= FAR_VIEW1 do
		local lod3 = x >= -900 and x <= 1300
		if not inGaps(x, gaps) then
			tree(parent, rng, x + rng:NextNumber(-3, 3), treeZ(), L.Promenade, if lod3 then 3 else 2)
		end
		x += rng:NextNumber(m(8), m(10.5))
	end
	-- 둘째 줄(뒤쪽, 듬성듬성): 틈 사이로 보이는 깊이감
	x = -1300
	while x <= 1600 do
		if not inGaps(x, gaps) then
			tree(parent, rng, x, e + s * rng:NextNumber(m(36), m(44)), L.Promenade, 2)
		end
		x += rng:NextNumber(m(22), m(28))
	end
	-- 화면 밖: 수림 매스(나무 여러 그루 덩어리, 높이 10~12 m)
	for _, dir in { -1, 1 } do
		local xx = if dir < 0 then FAR_VIEW0 - 40 else FAR_VIEW1 + 40
		while math.abs(xx) <= 6200 do
			local hgt = m(rng:NextNumber(10, 12.5))
			Kit.ellipsoid(parent, CFrame.new(xx, L.Promenade + hgt * 0.47, e + s * rng:NextNumber(m(22), m(30))), Vector3.new(m(rng:NextNumber(22, 30)), hgt, m(rng:NextNumber(9, 13))), LEAVES[rng:NextInteger(1, #LEAVES)], MAT.Grass, deco("TreeMass"))
			xx += dir * m(rng:NextNumber(26, 32))
		end
	end
	-- 사면 발치 관목 띠 (높이 2~3 m): 나무 줄기 사이 틈을 메움
	local hx = -2400
	while hx <= 2600 do
		if not inGaps(hx, gaps) then
			local hh = m(rng:NextNumber(2.2, 3.2))
			Kit.ellipsoid(parent, CFrame.new(hx, L.Promenade + hh * 0.3, e + s * rng:NextNumber(m(45), m(48))), Vector3.new(m(rng:NextNumber(14, 20)), hh, m(rng:NextNumber(4, 5.5))), LEAVES[rng:NextInteger(1, #LEAVES)], MAT.Grass, deco("Shrub"))
		end
		hx += m(rng:NextNumber(24, 30))
	end
	Kit.reserve(BANK_X0, F.ParkTo, BANK_X1, e + m(2.2), "FarRiverbank")
end

local function nearBank(parent: Instance, rng: Random)
	local e, s = N.WaterEdge, 1
	bankEdge(parent, e, s)
	local gaps = { GAP_PARK }
	-- 난간 1.1 m: 산책로 강 쪽 가장자리 (손잡이 + 중간 레일 2 + 기둥 3 m 간격, 원거리는 기둥 생략)
	local rz = e + s * (PROM_IN + m(0.12))
	local rx0, rx1 = math.max(BANK_X0, -6000), math.min(BANK_X1, 6000)
	stripX(parent, rx0, rx1, rz, m(0.1), PATH_TOP + Config.Real.Railing, m(0.08), POLE_C, MAT.Metal, { name = "RailTop", shadow = false }, gaps)
	stripX(parent, rx0, rx1, rz, m(0.05), PATH_TOP + m(0.7), m(0.05), POLE_C, MAT.Metal, deco("RailMid", { shadow = false }), gaps)
	stripX(parent, rx0, rx1, rz, m(0.05), PATH_TOP + m(0.3), m(0.05), POLE_C, MAT.Metal, deco("RailMid", { shadow = false }), gaps)
	local postH = Config.Real.Railing - m(0.08)
	for _, px in stations(NEAR_VIEW0, NEAR_VIEW1, -1000, 200, m(3), m(15)) do
		if not inGaps(px, gaps, 1) then
			Kit.box(parent, CFrame.new(px, PATH_TOP + postH / 2 - 0.15, rz), Vector3.new(m(0.07), postH + 0.3, m(0.07)), POLE_C, MAT.Metal, deco("RailPost"))
		end
	end
	-- 보안등 (산책로-자전거도로 사이 녹지) + 벤치(산책로 안쪽 가장자리, 물을 향함) + 휴지통
	local lampZ = e + s * VERGE_U
	local lampXs = stations(-5000, 5000, NEAR_VIEW0, NEAR_VIEW1, PLAMP_PITCH_NEAR, PLAMP_PITCH_NEAR * 4)
	table.sort(lampXs, function(a: number, b: number) -- 히어로/산책로 구도 중앙부터 광원 배정
		return math.abs(a + 200) < math.abs(b + 200)
	end)
	local seatTop = PATH_TOP + m(0.45)
	local benchU = PROM_OUT - m(0.32) -- 좌면 중심(산책로 안쪽 가장자리)
	for _, x in lampXs do
		if not inGaps(x, gaps) then
			local near = x >= NEAR_VIEW0 and x <= NEAR_VIEW1
			local head = parkLamp(parent, x, lampZ, near)
			if x >= NEAR_LIGHT0 and x <= NEAR_LIGHT1 then
				tryLight(head, 1.2, m(11))
			end
			local slot = math.floor((x - NEAR_VIEW0) / PLAMP_PITCH_NEAR + 0.5)
			if near and x > -1500 and x < 1000 and slot % 2 == 0 then
				-- 벤치 1.8 m: 좌면(0.45 m 높이) + 등받이(땅 쪽) + 받침
				local bx = x + PLAMP_PITCH_NEAR / 2
				if not inGaps(bx, gaps, m(2)) then
					local bz = e + s * benchU
					Kit.box(parent, CFrame.new(bx, PATH_TOP + (m(0.39) + 0.1) / 2, bz), Vector3.new(m(1.2), m(0.39) + 0.1, m(0.3)), BARRIER_C, MAT.Concrete, deco("BenchBase"))
					Kit.box(parent, CFrame.new(bx, seatTop - m(0.03), bz), Vector3.new(m(1.8), m(0.06), m(0.45)), WOOD_C, MAT.WoodPlanks, { name = "BenchSeat", shadow = false })
					Kit.box(parent, CFrame.new(bx, seatTop + m(0.22), bz + s * (m(0.225) + 0.15)), Vector3.new(m(1.8), m(0.4), m(0.05)), WOOD_C, MAT.WoodPlanks, deco("BenchBack"))
				end
			elseif near and x > -1500 and x < 1000 and slot % 4 == 1 then
				-- 휴지통 0.9 m (보안등 옆)
				Kit.vcyl(parent, Vector3.new(x + m(1.2), L.Promenade + m(0.45) - 0.2, lampZ), m(0.9) + 0.4, m(0.5), BIN_C, MAT.Metal, deco("TrashBin"))
			end
		end
	end
	local _ = rng
	Kit.reserve(BANK_X0, e - m(2.2), BANK_X1, e + s * NEAR_OWN, "NearRiverbank")
end

------------------------------------------------------------------------------------------------------
-- 5) 간선도로 (먼 쪽 도시): 막히면 옆으로 꺾어 빈 열을 찾음
------------------------------------------------------------------------------------------------------
local ROUTE_STEP = m(10)
local function routeAvenue(x0: number, zA: number, zB: number, checkFrom: number, hw: number): { Vector2 }
	local pts: { Vector2 } = { Vector2.new(x0, zA) }
	local function reach(cx: number, from: number): number
		local zb = from
		while zb > zB do
			local zn = math.max(zb - ROUTE_STEP, zB)
			if not Kit.isFree(cx - hw, zn, cx + hw, zb) then
				break
			end
			zb = zn
		end
		return zb
	end
	local x, z = x0, checkFrom
	for _ = 1, 6 do
		local zb = reach(x, z)
		if zb <= zB then
			table.insert(pts, Vector2.new(x, zB))
			return pts
		end
		local lastZ = pts[#pts].Y
		local bestX: number? = nil
		local bestZ = zb
		if lastZ - zb >= 2 * hw + m(6) then
			for k = 0, 30 do
				for _, sg in { -1, 1 } do
					local nx = x + sg * (2 * hw + m(4) + k * ROUTE_STEP)
					if Kit.isFree(math.min(x, nx) - hw, zb, math.max(x, nx) + hw, zb + 2 * hw) then
						local r = reach(nx, zb)
						if r < bestZ - 1 then
							bestX, bestZ = nx, r
						end
					end
				end
			end
		end
		if bestX == nil then
			table.insert(pts, Vector2.new(x, zb))
			return pts
		end
		local zc = zb + hw
		table.insert(pts, Vector2.new(x, zc))
		table.insert(pts, Vector2.new(bestX, zc))
		x, z = bestX, zb
	end
	table.insert(pts, Vector2.new(x, z))
	return pts
end

-- 진행 방향 오른쪽으로 d 만큼 평행 이동 (직각 꺾임은 모서리 교점)
local function offsetPolyline(pts: { Vector2 }, d: number): { Vector2 }
	local out: { Vector2 } = {}
	local n = #pts
	for i = 1, n do
		local nIn, nOut = Vector2.zero, Vector2.zero
		if i > 1 then
			local t = (pts[i] - pts[i - 1]).Unit
			nIn = Vector2.new(-t.Y, t.X)
		end
		if i < n then
			local t = (pts[i + 1] - pts[i]).Unit
			nOut = Vector2.new(-t.Y, t.X)
		end
		local off: Vector2
		if i == 1 then
			off = nOut * d
		elseif i == n then
			off = nIn * d
		elseif nIn:Dot(nOut) > 0.99 then
			off = nIn * d
		else
			off = (nIn + nOut) * d
		end
		table.insert(out, pts[i] + off)
	end
	return out
end

-- 간선 단면 (studs): carHalf = 중심 → 연석, walk = 보도 폭, medHalf = 중앙분리 반폭, lines = 차로 구분선 오프셋
type Section = { carHalf: number, walk: number, medHalf: number, lines: { number } }

local function section(medM: number, laneM: number, lanes: number, walkM: number): Section
	local lines: { number } = {}
	for k = 1, lanes - 1 do
		table.insert(lines, m(medM + laneM * k))
	end
	return { carHalf = m(medM + laneM * lanes), walk = m(walkM), medHalf = m(medM), lines = lines }
end

type AveSpec = {
	name: string,
	x: number,
	sec: Section, -- 일반 단면
	wide: Section?, -- 첫 직선 구간(다리 토막과 같은 폭)
	z0: number,
	checkFrom: number,
	lanes: { number }, -- 차량 불빛 차선 오프셋(중심선 기준)
}

-- 세로(Z) 도로 한 토막: 포장 [zTop, zBot], 분리대/노면표시/가로등은 [inTop, inBot]
local function avenuePiece(mdl: Instance, name: string, x: number, zTop: number, zBot: number, inTop: number, inBot: number, sec: Section, lampPhase: number)
	local half = sec.carHalf + sec.walk
	stripZ(mdl, zTop, zBot, x, sec.carHalf * 2, ROAD_TOP, 1.0, ASPHALT, MAT.Asphalt, { name = "Avenue", shadow = false })
	for _, sd in { -1, 1 } do
		stripZ(mdl, zTop, zBot, x + sd * (sec.carHalf + sec.walk / 2), sec.walk, ROAD_TOP + CURB_UP, CURB_UP + 1.0, SIDEWALK_C, MAT.Pavement, { name = "Sidewalk", shadow = false })
	end
	if inTop - inBot > m(8) then
		stripZ(mdl, inTop - m(3), inBot + m(3), x, sec.medHalf * 2, ROAD_TOP + m(0.25), m(0.25) + 0.3, BARRIER_C, MAT.Concrete, { name = "AveMedian" })
		for _, off in sec.lines do
			for _, sd in { -1, 1 } do
				stripZ(mdl, inTop, inBot, x + sd * off, m(0.15), ROAD_TOP + PAINT_UP, 0.6, PAINT_W, MAT.SmoothPlastic, deco("Paint", { shadow = false }))
			end
		end
	end
	-- 가로등 10 m (보도 연석 쪽, 팔 1.6 m 가 차도 쪽으로) — 양쪽 엇갈림
	local baseY = ROAD_TOP + CURB_UP
	for _, sd in { -1, 1 } do
		local zz = inTop - m(8) - (if sd > 0 then AVE_LAMP / 2 else 0) - lampPhase
		while zz > inBot + m(3) do
			local lx = x + sd * (sec.carHalf + m(0.6))
			Kit.vcyl(mdl, Vector3.new(lx, baseY + AVE_LAMP_H / 2 - 0.25, zz), AVE_LAMP_H + 0.5, m(0.2), POLE_C, MAT.Metal, deco("LampPole"))
			Kit.box(mdl, CFrame.new(lx - sd * m(0.9), baseY + AVE_LAMP_H + m(0.08), zz), Vector3.new(m(1.9), m(0.16), m(0.4)), LAMP_AVE, MAT.Neon, glowOpts("LampHead"))
			zz -= AVE_LAMP
		end
	end
	Kit.reserve(x - half - m(2), math.min(zTop, zBot), x + half + m(2), math.max(zTop, zBot), name)
end

local function avenue(parent: Instance, spec: AveSpec)
	local sec = spec.sec
	local hw = sec.carHalf + sec.walk
	local hc = hw + m(1.5) -- 경로/모서리 기준 반폭
	local pts = routeAvenue(spec.x, spec.z0, AVE_Z1, spec.checkFrom, hc)
	local np = #pts
	if np < 2 or math.abs(pts[1].Y - pts[np].Y) < m(20) then
		return
	end
	local mdl = Kit.group(parent, spec.name)
	-- 넓은 단면이 들어가는 첫 직선 구간 끝 (첫 꺾임 모서리 전까지, 비어 있는 만큼)
	local zWide: number? = nil
	local wide = spec.wide
	if wide then
		local wHw = wide.carHalf + wide.walk
		local limit = if np > 2 then pts[2].Y + hc else pts[2].Y
		local zb = spec.checkFrom
		while zb - ROUTE_STEP >= limit and Kit.isFree(spec.x - wHw - m(1), zb - ROUTE_STEP, spec.x + wHw + m(1), zb) do
			zb -= ROUTE_STEP
		end
		if zb < spec.z0 - m(12) then
			zWide = zb
		end
	end
	local phase = 0
	for i = 1, np - 1 do
		local a, b = pts[i], pts[i + 1]
		if math.abs(a.X - b.X) < 0.5 then
			-- 세로(Z) 구간: 꺾임 모서리 정사각형은 세로 구간이 포함
			local x = a.X
			local zTop = if i > 1 then a.Y + hc else a.Y
			local zBot = if i + 1 < np then b.Y - hc else b.Y
			local inTop = if i > 1 then zTop - 2 * hc else zTop - m(1)
			local inBot = if i + 1 < np then zBot + 2 * hc else zBot + m(1)
			local zw = zWide
			if i == 1 and zw and wide then
				avenuePiece(mdl, spec.name, x, zTop, zw, inTop, zw, wide, phase)
				if zw - zBot > 1 then
					avenuePiece(mdl, spec.name, x, zw, zBot, zw, inBot, sec, phase)
				end
			else
				avenuePiece(mdl, spec.name, x, zTop, zBot, inTop, inBot, sec, phase)
			end
			phase = (phase + AVE_LAMP / 3) % AVE_LAMP
		else
			-- 가로(X) 구간: 모서리 정사각형 제외
			local zc = a.Y
			local xa, xb = math.min(a.X, b.X) + hw, math.max(a.X, b.X) - hw
			if xb - xa > 1 then
				Kit.box(mdl, CFrame.new((xa + xb) / 2, ROAD_TOP - 0.5, zc), Vector3.new(xb - xa, 1.0, sec.carHalf * 2), ASPHALT, MAT.Asphalt, { name = "AveJog", shadow = false })
				Kit.box(mdl, CFrame.new((xa + xb) / 2, ROAD_TOP + PAINT_UP - 0.3, zc), Vector3.new(xb - xa, 0.6, m(0.15)), PAINT_Y, MAT.SmoothPlastic, deco("Paint", { shadow = false }))
			end
			Kit.reserve(math.min(a.X, b.X), zc - hw - m(2), math.max(a.X, b.X), zc + hw + m(2), spec.name)
		end
	end
	local route: { string } = {}
	for _, p in pts do
		table.insert(route, string.format("%d,%d", p.X, p.Y))
	end
	mdl:SetAttribute("Route", table.concat(route, " "))
	-- 차량 불빛: 도시로 들어가는 차(-Z) = 후미등, 강 쪽으로 나오는 차(+Z) = 전조등
	local rev: { Vector2 } = {}
	for i = np, 1, -1 do
		table.insert(rev, pts[i])
	end
	for i, off in spec.lanes do
		local outP, inP = offsetPolyline(pts, off), offsetPolyline(rev, off)
		local o3: { Vector3 } = {}
		local i3: { Vector3 } = {}
		for _, p in outP do
			table.insert(o3, Vector3.new(p.X, CAR_Y, p.Y))
		end
		for _, p in inP do
			table.insert(i3, Vector3.new(p.X, CAR_Y, p.Y))
		end
		local spd = m((60 - (i - 1) * 6) / 3.6) -- 60 → 54 km/h
		Kit.lane(string.format("%s_S%d", spec.name, i), o3, { kind = "tail", speed = spd, density = 0.7, spacing = CAR_SPACING })
		Kit.lane(string.format("%s_N%d", spec.name, i), i3, { kind = "head", speed = spd * 1.04, density = 0.7, spacing = CAR_SPACING })
	end
end

------------------------------------------------------------------------------------------------------
function Riverside.build(ctx: any)
	local model: Model = ctx.model
	local rng: Random = ctx.rng
	lightsUsed = 0

	-- 1) 도시 지면 (먼 쪽: 올림픽대로 아래부터 / 가까운 쪽: 강변북로 뒤부터)
	local ground = Kit.group(model, "CityGround")
	tiles(ground, Z.CarpetFarFar.XMin, Z.CarpetFarFar.XMax, F.RoadFrom, F.CityTo)
	tiles(ground, NEAR_X0, NEAR_X1, N.RoadTo, N.CityTo)

	-- 간선도로 단면: 다리 축은 다리 폭(4+4 차로 3.5 m, 분리 1 m, 보도 3.5 m = 36 m), 일반 간선 6차로(3.25 m) + 보도 3 m
	local wideSec = section(0.5, 3.5, 4, B.Width / 2 * Config.METERS_PER_STUD - 14.5)
	local aveSec = section(0.75, 3.25, 3, 3.0)
	local aveXs = { Z.SkylineLeft.XMin - m(140), Z.SkylineRight.XMax + m(295) } -- 서쪽/동쪽 간선 (고층 클러스터 바깥)
	local aveGaps: { Span } = {}
	local aveHalf = aveSec.carHalf + aveSec.walk
	for _, ax in aveXs do
		table.insert(aveGaps, { ax - aveHalf - m(1), ax + aveHalf + m(1) })
	end

	-- 2) 제방 도로 (올림픽대로: 먼 쪽 / 강변북로: 가까운 쪽 — 다리 입구 가로등부터 광원)
	expressway(Kit.group(model, "OlympicDaero"), {
		name = "OlympicDaero",
		edge = F.RoadFrom,
		inland = -1,
		bandEnd = F.RoadTo,
		x0 = ROAD_X0,
		x1 = ROAD_X1,
		slabBottom = L.City - 1.0,
		cityGaps = aveGaps,
		lampX = LAMP_X_FAR,
		lampLights = 4,
	})
	-- 가까운 쪽은 도시 지면이 RoadTo 부터라 도로 슬래브가 제방 사면 끝(지형) 아래까지 깊게 내려감
	expressway(Kit.group(model, "GangbyeonBukro"), {
		name = "GangbyeonBukro",
		edge = N.RoadFrom,
		inland = 1,
		bandEnd = N.RoadTo,
		x0 = NEAR_X0,
		x1 = NEAR_X1,
		slabBottom = GROUND_BOT + 0.5,
		cityGaps = {},
		lampX = LAMP_X_NEAR,
		lampLights = 0,
	})
	Kit.reserve(NEAR_X0, N.RoadFrom + W_ROAD, NEAR_X1, N.CityFrom, "NearRoadVerge")

	-- 3) 강변 (+ 4) 수면 반사)
	local glints = Kit.group(model, "Glints")
	nearBank(Kit.group(model, "NearBank"), rng)
	farBank(Kit.group(model, "FarBank"), glints, rng)

	-- 5) 간선도로: 다리 축(다리 토막 끝 ZFrom 에서 같은 폭으로) + 좌우 2개 (올림픽대로 도시 쪽 가장자리에서 시작)
	local avenues = Kit.group(model, "Avenues")
	local roadCity = F.RoadFrom - W_ROAD
	local aLanes = { m(0.75 + 3.25 * 0.5), m(0.75 + 3.25 * 1.5) }
	local wLanes = { m(0.5 + 3.5 * 0.5), m(0.5 + 3.5 * 1.5), m(0.5 + 3.5 * 2.5) }
	avenue(avenues, { name = "JamsilAve", x = B.X, sec = aveSec, wide = wideSec, z0 = B.ZFrom, checkFrom = B.ZFrom, lanes = wLanes })
	avenue(avenues, { name = "WestAve", x = aveXs[1], sec = aveSec, z0 = roadCity, checkFrom = math.min(roadCity, F.CityFrom), lanes = aLanes })
	avenue(avenues, { name = "EastAve", x = aveXs[2], sec = aveSec, z0 = roadCity, checkFrom = math.min(roadCity, F.CityFrom), lanes = aLanes })

	model:SetAttribute("Lights", lightsUsed)
	model:SetAttribute("NearOwnZ", Vector2.new(N.WaterEdge + STEP_U0, N.WaterEdge + NEAR_OWN))
end

return Riverside
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">ShowHome</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / ShowHome
-- 한강뷰 101동 — 강변북로 바로 뒤(가까운 쪽 도시 지면)에 선 28층 판상형 아파트 1동 + 걸어 들어가 볼 수 있는 실내.
-- 실제 스케일 1 stud = 0.3 m: 이 파일의 모든 치수는 m 로 적고 Config.m(미터) 로 변환합니다.
--
--   * 동: 4호 라인(세대 폭 12.6 m) × 깊이 9.85 m + 뒤로 돌출된 계단실 코어 2개(4.8 m). 1층 4.5 m(필로티 + 로비),
--     2~28층 층고 2.9 m(Config.Real.HomeFloor), 옥상 파라펫까지 84 m. 앞면(-Z, 강 쪽) = 발코니.
--     외관은 Facade "apartment" 언어(층 슬래브 띠 · 세대 벽 핀 · 층 묶음 Neon 조명 코어 · 측벽 동 번호/슈퍼그래픽)에
--     한강변 신축 단지의 유리 난간을 더함. 20층 1호 라인(2001호)만 조명 코어/난간/뒤 띠를 비우고 진짜 실내로 지음.
--   * 1층 로비(1·2호 라인 코어): 자동 유리문(열린 상태) + 공동현관 키패드, 대리석 바닥, 우편함 54칸(201~2802호),
--     엘리베이터 2대(태그 SeoulElevator → 20층 엘리베이터 홀), 관리사무소 공지 게시판, 무인택배함, 비상구 계단 문.
--   * 20층 엘리베이터 홀: 2001호(밖여닫이 현관문 열림) / 2002호, 엘리베이터 2대(SeoulElevator → 1층 로비), 소화전, 비상구.
--   * 2001호(34평형, 전용 84 m²): 현관(0.15 m 단차, 신발장) · 거실(아트월, 65" TV, 소파 좌면 0.43 m) · 식당(4인 식탁
--     0.75 m, 펜던트) · 주방(ㄱ자 0.9 m 상판, 개수대, 인덕션, 후드, 냉장고 1.8 m, 아일랜드) · 안방(퀸 침대 0.45 m, 협탁,
--     붙박이장, 책상) · 욕실(타일, 세면대, 거울, 샤워 유리, 양변기) · 서재(1.8 m 책장) · 유리 난간 발코니(라운지 체어).
--     거실/발코니에서 정면(-Z, 약간 왼쪽)으로 한강 너머 잠실 타워가 보이는 것이 히어로 뷰.
--   * 바닥 슬래브는 외피(Persistent) 모델에 있어 실내(Atomic 스트리밍)가 늦게 로드돼도 엘리베이터 도착 지점에 발판이 있음.
--   * 발자국 Kit.reserveRect(조경 포함) → Apartments 가 이 자리를 비움. 파트 ≤ 3500, 광원 ≤ 40.

local CollectionService = game:GetService("CollectionService")
local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)

local ShowHome = {}

local rgb = Color3.fromRGB
local P = Config.Palette
local R = Config.Real
local M = Config.m
local MAT = Enum.Material
local NID = Enum.NormalId
local MPS = Config.METERS_PER_STUD

local function toM(studs: number): number
	return studs * MPS
end

------------------------------------------------------------------------------------------------------
-- 상수 (m)
------------------------------------------------------------------------------------------------------
local PART_BUDGET = 3500
local MAX_LIGHTS = 40

local FH = toM(R.HomeFloor) -- 층고 2.9
local DOOR_H = toM(R.Door) -- 문 높이 2.1
local CEIL_H = toM(R.HomeCeiling) -- 천장고 2.3
local COUNTER = toM(R.Counter) -- 주방 상판 0.9
local TABLE_H = toM(R.Table) -- 식탁/책상 0.75
local SEAT = toM(R.Seat) -- 좌면 0.43
local DOOR_W = 0.9
local EYE = 1.56 -- 눈높이 5.2 stud

local LINE_W = 12.6 -- 세대(호 라인) 폭
local NLINES = 4
local BL = LINE_W * NLINES -- 50.4
local END_T = 0.35 -- 측벽 두께
local DEPTH = 9.85 -- 앞 난간선(z=0) → 뒤 외벽면
local FIN_T = 0.4 -- 세대 벽(핀) 두께
local FLOORS = 28
local LOBBY_H = 4.5 -- 1층(필로티/로비) 층고
local UNIT_FL = 20 -- 실내를 만든 층
local SLAB_DN, SLAB_UP = 0.1, 0.25 -- 층 기준선 아래/위 슬래브 두께
local CORE_A0, CORE_A1 = 6.0, 19.2 -- 1·2호 라인 코어(로비/엘리베이터 홀) X
local CORE_B0, CORE_B1 = 31.2, 44.4 -- 3·4호 라인 코어
local CORE_SPLIT, CORE_Z1 = 12.25, 14.65 -- 홀 | 승강로·계단 경계, 코어 뒷면
local FRONT_SET = 27 -- 도시 지면 시작(CityFrom) → 건물 앞면 (조경 + 진입로)
local RES_X0, RES_X1, RES_Z0, RES_Z1 = -20, 62, -27, 17 -- 예약(로컬 m): 앞쪽은 넓게(전망 확보)

local function yb(k: number): number -- k 층 기준선(구조 슬래브 중심 위쪽 기준)
	return LOBBY_H + (k - 2) * FH
end
local YB = yb(UNIT_FL) -- 56.7
local SLAB_TOP = YB + SLAB_UP -- 56.95 구조 슬래브 윗면
local HF = SLAB_TOP + 0.05 -- 57.00 엘리베이터 홀·현관 바닥
local UF = HF + 0.15 -- 57.15 세대 마감 바닥(현관 단차 0.15 m)
local CEIL = UF + CEIL_H -- 59.45 세대 천장
local TOPY = yb(UNIT_FL + 1) - SLAB_DN -- 59.50 위층 슬래브 아랫면
local ROOF = yb(FLOORS + 1) + SLAB_UP -- 83.05 옥상 슬래브 윗면
local PARAPET = ROOF + 1.05
local CORE_TOP = ROOF + 3.0 -- 승강기 기계실
local LOBBY_FL = 0.15
local LOBBY_CEIL = 3.9
local LOBBY_TOP = LOBBY_H - SLAB_DN -- 4.4 (2층 슬래브 아랫면)
local PAVE = 0.06
local HALL_CEIL = HF + 2.35

-- 색 / 재질
local WALL_EXT = rgb(226, 220, 208) -- 외벽 크림
local WALL_CORE = rgb(206, 200, 190)
local ACCENT = rgb(58, 104, 158) -- 측벽 슈퍼그래픽
local RAIL_GLASS = rgb(150, 178, 196)
local STEEL = rgb(184, 186, 190)
local STEEL_D = rgb(66, 68, 74)
local BRONZE = rgb(96, 84, 70)
local PLASTER = rgb(238, 234, 226)
local CEIL_C = rgb(244, 242, 238)
local OAK = rgb(172, 134, 96)
local OAK_L = rgb(196, 162, 122)
local WALNUT = rgb(96, 70, 52)
local WHITE_LAC = rgb(236, 234, 230)
local MARBLE_W = rgb(228, 224, 216)
local MARBLE_G = rgb(158, 154, 148)
local MARBLE_D = rgb(66, 64, 62)
local LIMESTONE = rgb(214, 206, 192)
local STONE_L = rgb(222, 214, 200) -- 실내 석재 패널(밝은 웜 대리석)
local TILE_W = rgb(228, 226, 220)
local TILE_D = rgb(104, 102, 100)
local SOFA_C = rgb(176, 170, 160)
local BENCH_WOOD = rgb(118, 88, 62)
local LINEN = rgb(238, 234, 224)
local GLASS_C = rgb(178, 202, 218)
local OFF_C = rgb(44, 46, 54)
local PANEL_WARM = rgb(214, 188, 146) -- 매입등(Neon, 은은한 3000K)
local PANEL_COOL = rgb(206, 214, 226)
local LAMP = rgb(255, 206, 150)
local SCREEN = rgb(64, 112, 160)
local INK = rgb(40, 40, 44)
local LEAVES = { rgb(60, 102, 56), rgb(74, 118, 62), rgb(54, 92, 54), rgb(84, 126, 66), rgb(50, 86, 54) }
local BOOK_COLORS = {
	rgb(150, 52, 44),
	rgb(42, 70, 110),
	rgb(212, 196, 160),
	rgb(60, 92, 70),
	rgb(30, 30, 34),
	rgb(196, 140, 60),
	rgb(110, 84, 120),
	rgb(232, 228, 216),
	rgb(176, 92, 64),
	rgb(84, 110, 130),
}

------------------------------------------------------------------------------------------------------
-- 좌표 / 파트 보조
--   로컬 좌표(m): x = 서쪽 측벽 안쪽면에서 +X, y = 도시 지면에서 위, z = 앞 난간선에서 +Z(뒤, 도시 쪽).
--   건물은 회전 없이 놓이므로 로컬 → 월드 = 평행 이동 + m→stud.
------------------------------------------------------------------------------------------------------
local X0, Z0, GY = 0, 0, 0
local partsAtStart = 0
local lightsUsed = 0

local function V(x: number, y: number, z: number): Vector3
	return Vector3.new(X0 + M(x), GY + M(y), Z0 + M(z))
end
local function LCF(x: number, y: number, z: number): CFrame
	return CFrame.new(V(x, y, z))
end
local function SZ(x: number, y: number, z: number): Vector3
	return Vector3.new(M(x), M(y), M(z))
end
local function mcf(x: number, y: number, z: number): CFrame
	return CFrame.new(M(x), M(y), M(z))
end
-- 로컬 프레임(가구): yaw 0 = 앞(-Z)을 봄, -90 = +X 를 봄, 90 = -X 를 봄, 180 = +Z 를 봄
local function frameAt(x: number, y: number, z: number, yawDeg: number?): CFrame
	return LCF(x, y, z) * CFrame.Angles(0, math.rad(yawDeg or 0), 0)
end

local function used(): number
	return Kit.stats.parts - partsAtStart
end
local function room(n: number): boolean
	return used() + n <= PART_BUDGET
end

-- 축 정렬 박스: 로컬 m 범위
local function bx(parent: Instance, x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, color: Color3, mat: Enum.Material, o: any?): BasePart
	local ax, ax1 = math.min(x0, x1), math.max(x0, x1)
	local ay, ay1 = math.min(y0, y1), math.max(y0, y1)
	local az, az1 = math.min(z0, z1), math.max(z0, z1)
	return Kit.box(parent, LCF((ax + ax1) / 2, (ay + ay1) / 2, (az + az1) / 2), SZ(ax1 - ax, ay1 - ay, az1 - az), color, mat, o or {})
end
-- 프레임 기준 박스: 중심 오프셋/크기 m
local function fb(parent: Instance, F: CFrame, cx: number, cy: number, cz: number, sx: number, sy: number, sz: number, color: Color3, mat: Enum.Material, o: any?): BasePart
	return Kit.box(parent, F * mcf(cx, cy, cz), SZ(sx, sy, sz), color, mat, o or {})
end
-- 세로 원기둥(로컬 m): 바닥 y0 부터 높이 h
local function cyl(parent: Instance, x: number, y0: number, z: number, h: number, d: number, color: Color3, mat: Enum.Material, o: any?): BasePart
	return Kit.vcyl(parent, V(x, y0 + h / 2, z), M(h), M(d), color, mat, o or {})
end

local function solid(name: string): any
	return { name = name }
end
local function deco(name: string): any
	return { name = name, collide = false, query = false, shadow = false }
end
local function glassO(name: string, tr: number?, collide: boolean?): any
	local c = collide ~= false
	return { name = name, transparency = tr or 0.6, collide = c, query = c, shadow = false, reflectance = 0.08 }
end
local function neon(name: string, dayColor: Color3?): any
	return { name = name, collide = false, query = false, shadow = false, glow = true, dayMaterial = MAT.SmoothPlastic, dayColor = dayColor or rgb(232, 232, 228) }
end

local function light(p: BasePart, kind: string, props: any): Light?
	if lightsUsed >= MAX_LIGHTS then
		return nil
	end
	local L = Kit.light(p, kind, props)
	if L then
		lightsUsed += 1
	end
	return L
end

-- 글자 판(얇은 파트 + SurfaceGui)
local function sign(parent: Instance, x0: number, y0: number, z0: number, x1: number, y1: number, z1: number, face: Enum.NormalId, text: string, o: any?): BasePart
	local oo = o or {}
	local p = bx(parent, x0, y0, z0, x1, y1, z1, oo.bg or rgb(250, 250, 248), oo.mat or MAT.SmoothPlastic, {
		name = oo.name or "Sign",
		collide = false,
		query = false,
		shadow = false,
		transparency = if oo.transparent then 1 else nil,
	})
	Kit.label(p, face, text, { color = oo.color or INK, glow = oo.glow, pixelsPerStud = oo.pps or 40, maxDistance = oo.maxd or 140, font = oo.font })
	return p
end

-- 한 면에 여러 칸 글자(우편함·택배함·키패드): rects = { {u0, v0, u1, v1, text, textColor?, bgColor?} } (면 기준 0..1, 왼→오/위→아래)
local function guiRects(part: BasePart, face: Enum.NormalId, rects: { any }, pps: number, maxDist: number, glowing: boolean)
	local g = Instance.new("SurfaceGui")
	g.Name = "Grid"
	g.Face = face
	g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	g.PixelsPerStud = pps
	g.LightInfluence = if glowing then 0 else 1
	g.MaxDistance = maxDist
	for _, r in rects do
		local t = Instance.new("TextLabel")
		t.BorderSizePixel = 0
		if r[7] then
			t.BackgroundColor3 = r[7]
			t.BackgroundTransparency = 0
		else
			t.BackgroundTransparency = 1
		end
		t.Position = UDim2.fromScale(r[1], r[2])
		t.Size = UDim2.fromScale(r[3] - r[1], r[4] - r[2])
		t.Text = r[5] or ""
		t.TextScaled = true
		t.Font = Enum.Font.GothamMedium
		t.TextColor3 = r[6] or INK
		t.Parent = g
	end
	g.Parent = part
	Kit.stats.labels += 1
end

local function jitter(rng: Random, c: Color3, amt: number): Color3
	local k = 1 + (rng:NextNumber() * 2 - 1) * amt
	return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
end

------------------------------------------------------------------------------------------------------
-- 공용 소품
------------------------------------------------------------------------------------------------------
-- 문짝: 경첩(hx, hz)에서 theta(도, +X → +Z 방향 각) 쪽으로 폭 w. 레버 손잡이 양면.
local function doorLeaf(parent: Instance, hx: number, hz: number, y0: number, w: number, h: number, t: number, theta: number, color: Color3, mat: Enum.Material, handle: Color3): CFrame
	local th = math.rad(theta)
	local F = LCF(hx + math.cos(th) * w / 2, y0 + h / 2, hz + math.sin(th) * w / 2) * CFrame.Angles(0, -th, 0)
	Kit.box(parent, F, SZ(w, h, t), color, mat, solid("DoorLeaf"))
	for _, s in { -1, 1 } do
		Kit.box(parent, F * mcf(w / 2 - 0.12, 1.0 - h / 2, s * (t / 2 + 0.035)), SZ(0.14, 0.022, 0.022), handle, MAT.Metal, deco("Lever"))
		Kit.box(parent, F * mcf(w / 2 - 0.06, 1.0 - h / 2, s * (t / 2 + 0.015)), SZ(0.05, 0.05, 0.03), handle, MAT.Metal, deco("Rose"))
	end
	return F
end

-- X 에 수직인 벽(두께 x0..x1)의 문틀: 개구부 z a..b, 바닥 y0 부터 DOOR_H
local function casingX(parent: Instance, x0: number, x1: number, a: number, b: number, y0: number, color: Color3)
	bx(parent, x0 - 0.02, y0, a - 0.06, x1 + 0.02, y0 + DOOR_H + 0.06, a + 0.02, color, MAT.SmoothPlastic, deco("Casing"))
	bx(parent, x0 - 0.02, y0, b - 0.02, x1 + 0.02, y0 + DOOR_H + 0.06, b + 0.06, color, MAT.SmoothPlastic, deco("Casing"))
	bx(parent, x0 - 0.02, y0 + DOOR_H - 0.02, a - 0.06, x1 + 0.02, y0 + DOOR_H + 0.06, b + 0.06, color, MAT.SmoothPlastic, deco("CasingHead"))
end
-- Z 에 수직인 벽(z0..z1)의 문틀: 개구부 x a..b
local function casingZ(parent: Instance, z0: number, z1: number, a: number, b: number, y0: number, color: Color3)
	bx(parent, a - 0.06, y0, z0 - 0.02, a + 0.02, y0 + DOOR_H + 0.06, z1 + 0.02, color, MAT.Metal, deco("Casing"))
	bx(parent, b - 0.02, y0, z0 - 0.02, b + 0.06, y0 + DOOR_H + 0.06, z1 + 0.02, color, MAT.Metal, deco("Casing"))
	bx(parent, a - 0.06, y0 + DOOR_H - 0.02, z0 - 0.02, b + 0.06, y0 + DOOR_H + 0.06, z1 + 0.02, color, MAT.Metal, deco("CasingHead"))
end

-- 스위치 판 (벽면 법선 축 axis "x"/"z", 벽면 좌표 w, 바깥 방향 s = ±1)
local function switchPlate(parent: Instance, axis: string, w: number, s: number, along: number, y: number)
	if axis == "x" then
		bx(parent, w, y, along - 0.04, w + s * 0.012, y + 0.12, along + 0.04, rgb(246, 246, 244), MAT.SmoothPlastic, deco("Switch"))
	else
		bx(parent, along - 0.04, y, w, along + 0.04, y + 0.12, w + s * 0.012, rgb(246, 246, 244), MAT.SmoothPlastic, deco("Switch"))
	end
end

-- 액자 (벽면 법선 축, 벽면 좌표 w, 방향 s): 테두리 + 매트 + 그림
local function picture(parent: Instance, axis: string, w: number, s: number, a0: number, a1: number, y0: number, y1: number, art: Color3, art2: Color3?)
	local function slab(off0: number, off1: number, b0: number, b1: number, c0: number, c1: number, col: Color3, mat: Enum.Material, name: string)
		if axis == "x" then
			bx(parent, w + s * off0, c0, b0, w + s * off1, c1, b1, col, mat, deco(name))
		else
			bx(parent, b0, c0, w + s * off0, b1, c1, w + s * off1, col, mat, deco(name))
		end
	end
	slab(0, 0.03, a0, a1, y0, y1, rgb(34, 32, 30), MAT.Wood, "Frame")
	slab(0.03, 0.036, a0 + 0.03, a1 - 0.03, y0 + 0.03, y1 - 0.03, rgb(244, 242, 236), MAT.SmoothPlastic, "Mat")
	local ma, mb = a0 + (a1 - a0) * 0.2, a1 - (a1 - a0) * 0.2
	local mc, md = y0 + (y1 - y0) * 0.2, y1 - (y1 - y0) * 0.2
	slab(0.036, 0.042, ma, mb, mc, md, art, MAT.SmoothPlastic, "Art")
	if art2 then
		slab(0.042, 0.048, ma, (ma + mb) / 2, mc, (mc + md) / 2, art2, MAT.SmoothPlastic, "Art")
	end
end

-- 화분 식물: 화분 + 흙 + (작은 것) 둥근 잎 덩어리 / (큰 것) 줄기 + 납작한 잎이 나선으로 펼쳐진 관엽식물
local HOUSE_LEAVES = { rgb(38, 82, 46), rgb(52, 98, 54), rgb(30, 70, 40), rgb(62, 110, 58) }
local function plant(parent: Instance, x: number, y0: number, z: number, potD: number, potH: number, leafD: number, leafH: number, rng: Random, potColor: Color3?)
	cyl(parent, x, y0, z, potH, potD, potColor or rgb(232, 228, 220), MAT.SmoothPlastic, { name = "Pot", collide = potD > 0.3, query = potD > 0.3, shadow = false })
	cyl(parent, x, y0 + potH - 0.02, z, 0.03, potD * 0.86, rgb(70, 54, 42), MAT.Ground, deco("Soil"))
	local top = y0 + potH
	if leafD < 0.4 then
		for _ = 1, 3 do
			local s = leafD * rng:NextNumber(0.45, 0.7)
			Kit.ellipsoid(parent, LCF(x + rng:NextNumber(-0.25, 0.25) * leafD, top + leafH * rng:NextNumber(0.3, 0.8), z + rng:NextNumber(-0.25, 0.25) * leafD), SZ(s, s * 0.8, s), HOUSE_LEAVES[rng:NextInteger(1, #HOUSE_LEAVES)], MAT.SmoothPlastic, deco("Leaves"))
		end
		return
	end
	for i = 1, 3 do
		local a = i * 2.1
		cyl(parent, x + math.cos(a) * 0.04, top, z + math.sin(a) * 0.04, leafH * (0.55 + 0.15 * i), 0.025, rgb(70, 92, 52), MAT.SmoothPlastic, deco("Stem"))
	end
	local n = if leafD > 0.9 then 11 else 8
	for i = 1, n do
		local a = i * 2.4 + rng:NextNumber(-0.3, 0.3) -- 황금각 나선
		local t = i / n
		local hh = top + leafH * (0.3 + 0.7 * t)
		local r = leafD * (0.12 + 0.28 * (1 - t) + rng:NextNumber(0, 0.08))
		local len = leafD * rng:NextNumber(0.38, 0.55)
		local droop = rng:NextNumber(10, 38) + 20 * (1 - t)
		local cf = LCF(x + math.cos(a) * r, hh, z + math.sin(a) * r) * CFrame.Angles(0, -a, 0) * CFrame.Angles(0, 0, math.rad(-droop))
		Kit.ellipsoid(parent, cf, SZ(len, 0.03, len * rng:NextNumber(0.55, 0.75)), HOUSE_LEAVES[rng:NextInteger(1, #HOUSE_LEAVES)], MAT.SmoothPlastic, deco("Leaf"))
	end
end

-- 나무(조경): 줄기 + 수관 2~3
local function tree(parent: Instance, x: number, z: number, h: number, cd: number, rng: Random)
	local th = h * 0.5
	cyl(parent, x, 0, z, th, 0.32, P.Bark, MAT.Wood, { name = "Trunk", shadow = false })
	local n = rng:NextInteger(2, 3)
	for _ = 1, n do
		local s = cd * rng:NextNumber(0.7, 1.0)
		Kit.ellipsoid(parent, LCF(x + rng:NextNumber(-0.7, 0.7), h - s * 0.4 + rng:NextNumber(-0.4, 0.3), z + rng:NextNumber(-0.7, 0.7)), SZ(s, s * 0.8, s), LEAVES[rng:NextInteger(1, #LEAVES)], MAT.Grass, { name = "Crown" })
	end
end

------------------------------------------------------------------------------------------------------
-- 엘리베이터 (뒷벽 z = CORE_SPLIT 앞면에 붙음): 문틀 + 중앙 개폐 문 2짝 + 층 표시기 + 호출 버튼(SeoulElevator)
------------------------------------------------------------------------------------------------------
local ELEV_X = { 10.55, 14.65 }

local function elevatorBank(parent: Instance, fl: number, floorLabel: string, target: Vector3, action: string)
	local zf = CORE_SPLIT
	for i, xc in ELEV_X do
		-- 포털(스테인리스)
		bx(parent, xc - 0.68, fl, zf - 0.12, xc - 0.56, fl + 2.32, zf, STEEL, MAT.Metal, solid("ElevJamb"))
		bx(parent, xc + 0.56, fl, zf - 0.12, xc + 0.68, fl + 2.32, zf, STEEL, MAT.Metal, solid("ElevJamb"))
		bx(parent, xc - 0.68, fl + 2.2, zf - 0.12, xc + 0.68, fl + 2.32, zf, STEEL, MAT.Metal, solid("ElevHead"))
		-- 문 2짝(가운데 1 cm 틈 → 뒤 석재가 어둡게 비침)
		bx(parent, xc - 0.56, fl, zf - 0.07, xc - 0.006, fl + 2.2, zf - 0.02, rgb(196, 198, 202), MAT.Metal, solid("ElevDoor"))
		bx(parent, xc + 0.006, fl, zf - 0.07, xc + 0.56, fl + 2.2, zf - 0.02, rgb(196, 198, 202), MAT.Metal, solid("ElevDoor"))
		-- 층 표시기
		sign(parent, xc - 0.22, fl + 2.42, zf - 0.08, xc + 0.22, fl + 2.6, zf - 0.05, NID.Front, floorLabel .. (if i == 1 then " ▲" else " ▼"), {
			bg = rgb(18, 18, 20),
			color = rgb(255, 128, 64),
			glow = true,
			pps = 60,
			maxd = 90,
			name = "ElevIndicator",
		})
		-- 호출 버튼 판 (태그: SeoulSkylineBoot 이 ElevatorTarget 으로 순간이동)
		local plate = bx(parent, xc + 0.82, fl + 1.0, zf - 0.075, xc + 0.94, fl + 1.32, zf - 0.05, STEEL, MAT.Metal, { name = "ElevatorCall", collide = false, query = true, shadow = false })
		for j, dy in { 1.22, 1.1 } do
			Kit.hcyl(parent, LCF(xc + 0.88, fl + dy, zf - 0.08) * CFrame.Angles(0, math.rad(90), 0), M(0.015), M(0.045), if j == 1 then rgb(255, 214, 150) else rgb(120, 120, 124), if j == 1 then MAT.Neon else MAT.Metal, deco("CallButton"))
		end
		plate:SetAttribute("ElevatorTarget", target)
		local pp = Instance.new("ProximityPrompt")
		pp.Name = "ElevatorPrompt"
		pp.ActionText = action
		pp.ObjectText = "엘리베이터"
		pp.HoldDuration = 0.25
		pp.MaxActivationDistance = M(2.6)
		pp.RequiresLineOfSight = false
		pp.Parent = plate
		CollectionService:AddTag(plate, "SeoulElevator")
	end
	-- 석재 피처월(엘리베이터 뒤) + 좌우 라임스톤
	bx(parent, 8.6, fl, zf - 0.05, 16.6, fl + (if fl < 1 then LOBBY_CEIL - LOBBY_FL else 2.35), zf, MARBLE_D, MAT.Marble, solid("ElevWall"))
	-- 안내판
	sign(parent, 12.3, fl + 1.45, zf - 0.07, 12.9, fl + 1.75, zf - 0.05, NID.Front, "101동\n1·2호 라인", { bg = rgb(36, 36, 38), color = rgb(232, 226, 210), pps = 80, maxd = 60 })
end

-- 비상구 계단 문 (뒷벽): 철문 + 문틀 + 푸시바 + 초록 Neon 표시등
local function stairDoor(parent: Instance, fl: number, x0: number)
	local zf = CORE_SPLIT
	local x1 = x0 + DOOR_W
	bx(parent, x0, fl, zf - 0.06, x1, fl + DOOR_H, zf - 0.02, rgb(118, 128, 120), MAT.Metal, solid("StairDoor"))
	bx(parent, x0 - 0.06, fl, zf - 0.08, x0, fl + DOOR_H + 0.06, zf, STEEL_D, MAT.Metal, deco("StairFrame"))
	bx(parent, x1, fl, zf - 0.08, x1 + 0.06, fl + DOOR_H + 0.06, zf, STEEL_D, MAT.Metal, deco("StairFrame"))
	bx(parent, x0 - 0.06, fl + DOOR_H, zf - 0.08, x1 + 0.06, fl + DOOR_H + 0.06, zf, STEEL_D, MAT.Metal, deco("StairFrame"))
	bx(parent, x0 + 0.1, fl + 0.98, zf - 0.11, x1 - 0.08, fl + 1.03, zf - 0.07, STEEL, MAT.Metal, deco("PushBar"))
	local ex = bx(parent, x0 + 0.2, fl + DOOR_H + 0.14, zf - 0.08, x1 - 0.2, fl + DOOR_H + 0.3, zf, rgb(40, 200, 90), MAT.Neon, { name = "ExitSign", collide = false, query = false, shadow = false })
	Kit.label(ex, NID.Front, "비상구", { color = rgb(255, 255, 255), glow = true, pixelsPerStud = 80, maxDistance = 120 })
	-- 소화기
	cyl(parent, x1 + 0.3, fl, zf - 0.15, 0.48, 0.16, rgb(196, 30, 30), MAT.SmoothPlastic, deco("Extinguisher"))
	cyl(parent, x1 + 0.3, fl + 0.48, zf - 0.15, 0.08, 0.06, rgb(40, 40, 40), MAT.Metal, deco("ExtinguisherValve"))
end

------------------------------------------------------------------------------------------------------
-- 1) 외피: 슬래브 띠 · 유리 난간 · 조명 코어 · 핀 · 측벽 · 코어 · 옥상 · 1층 필로티/로비 외피
------------------------------------------------------------------------------------------------------
local function shell(ext: Model, rng: Random, lit: { Color3 })
	-- 층 슬래브(2층~지붕): 앞뒤로 튀어나온 가로 띠 + 실제 바닥
	for k = 2, FLOORS + 1 do
		local y = yb(k)
		bx(ext, -END_T, y - SLAB_DN, -0.25, BL + END_T, y + SLAB_UP, DEPTH + 0.15, WALL_EXT, MAT.Concrete, { name = "Slab" .. k, shadow = k == FLOORS + 1 })
	end
	-- 앞면 유리 난간 + 손스침 / 뒷면 창 아래 띠 (20층 2001호 구간 제외)
	for k = 2, FLOORS do
		local y = yb(k) + SLAB_UP
		local fx0 = if k == UNIT_FL then LINE_W - FIN_T / 2 else 0
		bx(ext, fx0, y, -0.07, BL, y + 1.0, -0.03, RAIL_GLASS, MAT.Glass, glassO("RailGlass", 0.55))
		bx(ext, fx0, y + 1.0, -0.1, BL, y + 1.06, 0.0, STEEL_D, MAT.Metal, { name = "Handrail", shadow = false })
		local bx0 = if k == UNIT_FL then CORE_A1 else -END_T
		bx(ext, bx0, y, DEPTH - 0.25, BL + END_T, y + 0.85, DEPTH + 0.15, WALL_EXT, MAT.Concrete, { name = "BackSpandrel", shadow = false })
	end
	-- 조명 코어: 호 라인별, 1~4개 층 묶음 (켜진 집 / 꺼진 집). 2001호 층은 비움.
	for line = 1, NLINES do
		local cx0 = (line - 1) * LINE_W + (if line == 1 then 0.12 else FIN_T / 2 + 0.05)
		local cx1 = line * LINE_W - (if line == NLINES then 0.12 else FIN_T / 2 + 0.05)
		local k = 2
		while k <= FLOORS do
			if line == 1 and k == UNIT_FL then
				k += 1
				continue
			end
			local k1 = math.min(FLOORS, k + rng:NextInteger(0, 3))
			if line == 1 and k < UNIT_FL and k1 >= UNIT_FL then
				k1 = UNIT_FL - 1
			end
			local on = rng:NextNumber() < 0.64
			local c = if on then jitter(rng, lit[rng:NextInteger(1, #lit)], 0.08) else OFF_C
			bx(ext, cx0, yb(k) + SLAB_UP, 0.6, cx1, yb(k1 + 1) - SLAB_DN, DEPTH - 0.6, c, if on then MAT.Neon else MAT.SmoothPlastic, {
				name = "Core",
				glow = on,
				dayMaterial = MAT.Glass,
				dayColor = P.GlassDeep,
				shadow = false,
			})
			k = k1 + 1
		end
	end
	-- 세대 벽 핀 (관통: 앞뒤로 0.35 m 돌출)
	for i = 1, NLINES - 1 do
		local x = i * LINE_W
		bx(ext, x - FIN_T / 2, yb(2) - SLAB_DN, -0.35, x + FIN_T / 2, ROOF, DEPTH + 0.25, WALL_EXT, MAT.Concrete, solid("Fin"))
	end
	-- 전면 창 멀리언(안방 | 거실 경계, 짝수 라인은 대칭) — 2001호에서는 안방 벽과 같은 자리
	for line = 1, NLINES do
		local base = (line - 1) * LINE_W
		local mx = if line % 2 == 1 then base + 8.075 else base + LINE_W - 8.075
		bx(ext, mx - 0.075, yb(2) + SLAB_UP, -0.14, mx + 0.075, ROOF - SLAB_UP, 0.0, STEEL_D, MAT.Metal, { name = "Mullion", collide = false, query = false, shadow = false })
	end
	-- 측벽(서쪽: 2001호 식당 창 개구부) / 동쪽
	local wy0, wy1, wz0, wz1 = UF + 0.9, UF + 2.1, 2.0, 4.6
	bx(ext, -END_T, 0, -0.35, 0, wy0, DEPTH + 0.25, WALL_EXT, MAT.Concrete, solid("EndWallW"))
	bx(ext, -END_T, wy0, -0.35, 0, wy1, wz0, WALL_EXT, MAT.Concrete, solid("EndWallW"))
	bx(ext, -END_T, wy0, wz1, 0, wy1, DEPTH + 0.25, WALL_EXT, MAT.Concrete, solid("EndWallW"))
	bx(ext, -END_T, wy1, -0.35, 0, PARAPET, DEPTH + 0.25, WALL_EXT, MAT.Concrete, solid("EndWallW"))
	bx(ext, BL, 0, -0.35, BL + END_T, PARAPET, DEPTH + 0.25, WALL_EXT, MAT.Concrete, solid("EndWallE"))
	-- 서쪽 창(식당): 흰 PVC 샷시 + 유리
	bx(ext, -0.24, wy0, wz0, -0.12, wy0 + 0.06, wz1, rgb(240, 240, 238), MAT.SmoothPlastic, deco("WinFrame"))
	bx(ext, -0.24, wy1 - 0.06, wz0, -0.12, wy1, wz1, rgb(240, 240, 238), MAT.SmoothPlastic, deco("WinFrame"))
	bx(ext, -0.24, wy0, wz0, -0.12, wy1, wz0 + 0.06, rgb(240, 240, 238), MAT.SmoothPlastic, deco("WinFrame"))
	bx(ext, -0.24, wy0, wz1 - 0.06, -0.12, wy1, wz1, rgb(240, 240, 238), MAT.SmoothPlastic, deco("WinFrame"))
	bx(ext, -0.24, wy0, (wz0 + wz1) / 2 - 0.03, -0.12, wy1, (wz0 + wz1) / 2 + 0.03, rgb(240, 240, 238), MAT.SmoothPlastic, deco("WinMullion"))
	bx(ext, -0.2, wy0 + 0.06, wz0 + 0.06, -0.16, wy1 - 0.06, wz1 - 0.06, GLASS_C, MAT.Glass, glassO("WinGlass", 0.65))
	-- 측벽 슈퍼그래픽 + 동 번호
	for _, sd in { -1, 1 } do
		local face = if sd < 0 then NID.Left else NID.Right
		local xo = if sd < 0 then -END_T else BL + END_T
		bx(ext, xo + sd * 0.02, 10, 6.3, xo + sd * 0.12, 70, 8.3, ACCENT, MAT.SmoothPlastic, { name = "Accent", collide = false, query = false, shadow = false })
		sign(ext, xo + sd * 0.12, 73, 0.6, xo + sd * 0.16, 80, 8.6, face, "101", { bg = WALL_EXT, mat = MAT.Concrete, color = rgb(250, 244, 230), glow = true, pps = 6, maxd = 3000, name = "DongNumber" })
	end
	-- 옥상: 파라펫 + LED 띠 + 단지명 사인
	bx(ext, -END_T, ROOF, -0.25, BL + END_T, PARAPET, -0.05, WALL_EXT, MAT.Concrete, solid("Parapet"))
	bx(ext, -END_T, ROOF, DEPTH - 0.05, BL + END_T, PARAPET, DEPTH + 0.15, WALL_EXT, MAT.Concrete, solid("Parapet"))
	bx(ext, -END_T, PARAPET, -0.3, BL + END_T, PARAPET + 0.1, 0.0, rgb(150, 112, 60), MAT.Neon, neon("RoofLed", WALL_EXT))
	for _, px in { 18.2, 32.2 } do
		bx(ext, px - 0.1, ROOF, 0.6, px + 0.1, ROOF + 4.0, 0.8, STEEL_D, MAT.Metal, { name = "SignPost", shadow = false })
	end
	sign(ext, 17.6, ROOF + 1.4, 0.45, 32.8, ROOF + 4.0, 0.55, NID.Front, "한강뷰", { bg = rgb(36, 38, 42), mat = MAT.Metal, color = rgb(250, 238, 214), glow = true, pps = 8, maxd = 3500, name = "RoofSign", font = Enum.Font.GothamBlack })
	-- 계단실·승강로 코어 (뒤로 돌출, 기계실까지)
	bx(ext, CORE_A0, 0, CORE_SPLIT, CORE_A1, CORE_TOP, CORE_Z1, WALL_CORE, MAT.Concrete, solid("CoreA"))
	bx(ext, CORE_A0, LOBBY_TOP - 0.05, DEPTH, CORE_A1, SLAB_TOP, CORE_SPLIT, WALL_CORE, MAT.Concrete, solid("CoreAFront"))
	bx(ext, CORE_A0, TOPY, DEPTH, CORE_A1, CORE_TOP, CORE_SPLIT, WALL_CORE, MAT.Concrete, solid("CoreAFront"))
	bx(ext, CORE_B0, 0, CORE_SPLIT, CORE_B1, CORE_TOP, CORE_Z1, WALL_CORE, MAT.Concrete, solid("CoreB"))
	bx(ext, CORE_B0, LOBBY_TOP - 0.05, DEPTH, CORE_B1, CORE_TOP, CORE_SPLIT, WALL_CORE, MAT.Concrete, solid("CoreBFront"))
	for _, cx in { CORE_A1 - 2.0, CORE_B1 - 2.0 } do
		bx(ext, cx - 0.5, LOBBY_H, CORE_Z1 + 0.02, cx + 0.5, ROOF, CORE_Z1 + 0.12, rgb(120, 104, 80), MAT.Neon, neon("StairWindow", GLASS_C))
	end
	-- 1층 필로티 기둥 + 천장(2층 슬래브 밑면) 매입등
	for _, z in { 0.3, 9.0 } do
		bx(ext, 24.95, PAVE, z, 25.45, LOBBY_TOP, z + 0.6, WALL_EXT, MAT.Concrete, solid("Pilotis"))
	end
	for _, x in { 3.0, 22.2, 28.2, 47.4 } do
		for _, z in { 2.5, 7.5 } do
			cyl(ext, x, LOBBY_TOP - 0.03, z, 0.03, 0.22, PANEL_WARM, MAT.Neon, neon("SoffitLight"))
		end
	end
	-- 3·4호 라인 로비(외관만: 불 켜진 유리 상자)
	bx(ext, CORE_B0, PAVE, 1.0, CORE_B0 + 0.25, LOBBY_TOP, CORE_SPLIT, LIMESTONE, MAT.Limestone, solid("LobbyBWall"))
	bx(ext, CORE_B1 - 0.25, PAVE, 1.0, CORE_B1, LOBBY_TOP, CORE_SPLIT, LIMESTONE, MAT.Limestone, solid("LobbyBWall"))
	bx(ext, CORE_B0 + 0.45, PAVE + 0.1, 1.6, CORE_B1 - 0.45, LOBBY_CEIL, CORE_SPLIT - 0.2, rgb(150, 122, 86), MAT.Neon, neon("LobbyBGlow", LIMESTONE))
	bx(ext, CORE_B0 + 0.25, PAVE, 1.0, CORE_B1 - 0.25, LOBBY_CEIL, 1.05, GLASS_C, MAT.Glass, glassO("LobbyBGlass", 0.55))
	bx(ext, CORE_B0, LOBBY_CEIL, 0.95, CORE_B1, LOBBY_TOP, 1.1, STEEL_D, MAT.Metal, solid("LobbyBFascia"))
	for i = 1, 5 do
		local x = CORE_B0 + 0.25 + i * (CORE_B1 - CORE_B0 - 0.5) / 6
		bx(ext, x - 0.03, PAVE, 0.97, x + 0.03, LOBBY_CEIL, 1.08, STEEL_D, MAT.Metal, deco("Mullion"))
	end
	bx(ext, 35.4, 3.2, -2.2, 40.2, 3.45, 0.9, STEEL_D, MAT.Metal, solid("CanopyB"))
	sign(ext, 36.6, 3.22, -2.27, 39.0, 3.43, -2.22, NID.Front, "101동 3·4호", { bg = STEEL_D, mat = MAT.Metal, color = rgb(250, 236, 210), glow = true, pps = 30, maxd = 400 })
	-- 바닥 포장(필로티·앞마당·뒤)
	bx(ext, -6, 0, -9.5, BL + 6, PAVE, CORE_Z1 + 1.5, rgb(150, 144, 136), MAT.Pavement, { name = "Plaza", shadow = false })
end

------------------------------------------------------------------------------------------------------
-- 2) 조경 / 진입로 / 캐노피
------------------------------------------------------------------------------------------------------
local function grounds(gm: Model, rng: Random)
	-- 진입로(강변북로 쪽 → 캐노피), 잔디, 경계석, 생울타리
	bx(gm, 10.6, 0, RES_Z0, 14.6, PAVE + 0.01, -9.5, rgb(176, 168, 156), MAT.Pavement, { name = "Walkway", shadow = false })
	bx(gm, -6, 0, RES_Z0, 10.4, 0.12, -9.5, P.Grass, MAT.Grass, { name = "Lawn", shadow = false })
	bx(gm, 14.8, 0, RES_Z0, BL + 6, 0.12, -9.5, P.Grass, MAT.Grass, { name = "Lawn", shadow = false })
	bx(gm, 10.4, 0, RES_Z0, 10.6, 0.18, -9.5, rgb(132, 130, 126), MAT.Granite, solid("Curb"))
	bx(gm, 14.6, 0, RES_Z0, 14.8, 0.18, -9.5, rgb(132, 130, 126), MAT.Granite, solid("Curb"))
	bx(gm, -6, 0.12, -10.4, 10.2, 0.95, -9.6, rgb(46, 78, 44), MAT.Grass, solid("Hedge"))
	bx(gm, 15.0, 0.12, -10.4, BL + 6, 0.95, -9.6, rgb(46, 78, 44), MAT.Grass, solid("Hedge"))
	-- 나무 (앞 잔디: 저층만 가리고 20층 전망은 막지 않음)
	for _, t in { { -2.5, -14.5 }, { 3.5, -22.5 }, { 7.6, -13.4 }, { 18.2, -13.6 }, { 23.5, -21.5 }, { 30.5, -14.2 }, { 37.5, -22.0 }, { 44.0, -14.0 }, { 51.0, -21.0 }, { -3.5, -24.5 }, { 55.0, -13.5 } } do
		tree(gm, t[1], t[2], rng:NextNumber(8.5, 11.5), rng:NextNumber(4.8, 6.4), rng)
	end
	-- 관목 + 꽃 화단 (캐노피 양옆)
	for _, s in { { 8.0, -1.6 }, { 8.8, -2.6 }, { 16.6, -1.6 }, { 17.4, -2.7 }, { 5.6, -2.2 }, { 19.6, -2.2 } } do
		Kit.ellipsoid(gm, LCF(s[1], 0.45, s[2]), SZ(1.3, 0.9, 1.1), LEAVES[rng:NextInteger(1, #LEAVES)], MAT.Grass, deco("Shrub"))
	end
	for _, f in { { 7.2, -3.6 }, { 18.0, -3.6 } } do
		bx(gm, f[1] - 1.0, PAVE, f[2] - 0.5, f[1] + 1.0, 0.45, f[2] + 0.5, rgb(120, 116, 110), MAT.Granite, solid("Planter"))
		for i = 0, 5 do
			Kit.ball(gm, V(f[1] - 0.75 + i * 0.3, 0.52, f[2] + (if i % 2 == 0 then -0.15 else 0.15)), M(0.26), if i % 2 == 0 then rgb(214, 96, 110) else rgb(236, 206, 120), MAT.SmoothPlastic, deco("Flowers"))
		end
	end
	-- 볼라드 조명 (진입로 양옆)
	for _, z in { -25.0, -21.0, -17.0, -13.0 } do
		for _, x in { 10.1, 15.1 } do
			cyl(gm, x, 0.12, z, 0.75, 0.16, STEEL_D, MAT.Metal, solid("Bollard"))
			cyl(gm, x, 0.87, z, 0.08, 0.17, LAMP, MAT.Neon, neon("BollardLamp"))
		end
	end
	-- 단지 보안등 4.5 m (2개, 실제 광원)
	for _, lp in { { 9.6, -18.5 }, { 15.6, -24.5 } } do
		cyl(gm, lp[1], 0.12, lp[2], toM(R.ParkLamp) - 0.2, 0.12, STEEL_D, MAT.Metal, solid("LampPole"))
		local head = Kit.ball(gm, V(lp[1], toM(R.ParkLamp), lp[2]), M(0.42), LAMP, MAT.Neon, neon("LampGlobe"))
		light(head, "PointLight", { color = P.LampWarm, brightness = 1.1, range = M(7) })
	end
	-- 동 표지석 (진입로 입구, 도로 쪽을 봄)
	bx(gm, 15.4, 0.12, -26.4, 19.6, 0.3, -25.2, rgb(110, 106, 100), MAT.Granite, solid("MonumentBase"))
	bx(gm, 15.6, 0.3, -26.1, 19.4, 1.25, -25.5, rgb(64, 62, 60), MAT.Granite, solid("Monument"))
	sign(gm, 15.8, 0.42, -26.14, 19.2, 1.14, -26.1, NID.Front, "한강뷰 101동", { bg = rgb(64, 62, 60), mat = MAT.Granite, color = rgb(250, 230, 190), glow = true, pps = 30, maxd = 600, name = "MonumentText" })
	-- 벤치 (강 쪽을 봄)
	for _, b in { { 2.5, -6.5 }, { 46.0, -6.5 } } do
		local F = frameAt(b[1], PAVE, b[2], 0)
		fb(gm, F, 0, 0.43, 0, 1.8, 0.05, 0.45, BENCH_WOOD, MAT.Wood, solid("Bench"))
		fb(gm, F, 0, 0.7, 0.22, 1.8, 0.3, 0.04, BENCH_WOOD, MAT.Wood, deco("BenchBack"))
		for _, lx in { -0.75, 0.75 } do
			fb(gm, F, lx, 0.2, 0, 0.06, 0.4, 0.42, STEEL_D, MAT.Metal, deco("BenchLeg"))
		end
	end
	-- 자전거 거치대 + 자전거 2대
	bx(gm, 0.6, PAVE, -3.2, 3.8, PAVE + 0.08, -3.0, STEEL_D, MAT.Metal, deco("BikeRackRail"))
	for i, bxp in { 1.3, 2.6 } do
		local F = frameAt(bxp, PAVE, -3.1, 0)
		for _, wz in { -0.5, 0.5 } do
			Kit.hcyl(gm, F * mcf(0, 0.33, wz) * CFrame.Angles(0, math.rad(90), 0), M(0.04), M(0.66), rgb(30, 30, 32), MAT.Rubber, deco("BikeWheel"))
		end
		fb(gm, F, 0, 0.55, 0, 0.04, 0.04, 0.95, if i == 1 then rgb(40, 96, 150) else rgb(170, 50, 46), MAT.Metal, deco("BikeFrame"))
		fb(gm, F, 0, 0.62, 0.3, 0.12, 0.05, 0.22, rgb(30, 30, 30), MAT.Leather, deco("BikeSaddle"))
		fb(gm, F, 0, 0.8, -0.42, 0.5, 0.03, 0.03, rgb(40, 40, 40), MAT.Metal, deco("BikeBar"))
	end
end

------------------------------------------------------------------------------------------------------
-- 3) 1층 로비
------------------------------------------------------------------------------------------------------
local LX0, LX1 = CORE_A0 + 0.25, CORE_A1 - 0.25 -- 6.25 .. 18.95
local LZ0, LZ1 = 1.05, CORE_SPLIT
local DOOR_X0, DOOR_X1 = 11.7, 13.5 -- 자동문 개구부 1.8 m

local function lobbyEnvelope(ext: Model)
	-- 좌우 벽(외부 쪽은 콘크리트)
	bx(ext, CORE_A0, 0, 1.0, LX0, LOBBY_TOP, LZ1, WALL_CORE, MAT.Concrete, solid("LobbyWallW"))
	bx(ext, LX1, 0, 1.0, CORE_A1, LOBBY_TOP, LZ1, WALL_CORE, MAT.Concrete, solid("LobbyWallE"))
	-- 정면 유리벽 + 멀리언 + 자동문 상부
	bx(ext, LX0, LOBBY_FL, 1.0, DOOR_X0, LOBBY_CEIL, 1.04, GLASS_C, MAT.Glass, glassO("LobbyGlass", 0.62))
	bx(ext, DOOR_X1, LOBBY_FL, 1.0, LX1, LOBBY_CEIL, 1.04, GLASS_C, MAT.Glass, glassO("LobbyGlass", 0.62))
	bx(ext, DOOR_X0, 2.42, 1.0, DOOR_X1, LOBBY_CEIL, 1.04, GLASS_C, MAT.Glass, glassO("LobbyTransom", 0.62))
	for _, x in { 8.1, 9.95, DOOR_X0, DOOR_X1, 15.25, 17.1 } do
		bx(ext, x - 0.04, LOBBY_FL, 0.96, x + 0.04, LOBBY_CEIL, 1.1, STEEL_D, MAT.Metal, solid("LobbyMullion"))
	end
	bx(ext, CORE_A0, LOBBY_CEIL, 0.94, CORE_A1, LOBBY_TOP, 1.12, STEEL_D, MAT.Metal, solid("LobbyFascia"))
	-- 자동문: 문 상부 구동부 + 열린 상태의 두 짝(고정 유리 안쪽으로 겹쳐 밀림)
	bx(ext, DOOR_X0 - 1.05, 2.22, 1.1, DOOR_X1 + 1.05, 2.42, 1.26, rgb(150, 152, 156), MAT.Metal, solid("DoorOperator"))
	cyl(ext, (DOOR_X0 + DOOR_X1) / 2, 2.17, 1.18, 0.05, 0.08, rgb(30, 30, 30), MAT.SmoothPlastic, deco("DoorSensor"))
	for _, s in { -1, 1 } do
		local x0 = if s < 0 then DOOR_X0 - 0.98 else DOOR_X1 - 0.02
		bx(ext, x0, LOBBY_FL, 1.12, x0 + 1.0, 2.2, 1.16, GLASS_C, MAT.Glass, glassO("AutoDoor", 0.6))
		local edge = if s < 0 then x0 + 1.0 - 0.05 else x0
		bx(ext, edge, LOBBY_FL, 1.11, edge + 0.05, 2.2, 1.17, STEEL, MAT.Metal, deco("AutoDoorStile"))
		local back = if s < 0 then x0 else x0 + 1.0 - 0.04
		bx(ext, back, LOBBY_FL, 1.11, back + 0.04, 2.2, 1.17, STEEL, MAT.Metal, deco("AutoDoorStile"))
	end
	bx(ext, DOOR_X0, PAVE, 0.96, DOOR_X1, LOBBY_FL + 0.005, 1.2, STEEL, MAT.Metal, solid("Threshold"))
	-- 캐노피 + 기둥 + 동 번호 사인 + 하부 조명
	local canopy = bx(ext, 9.4, 3.25, -3.2, 15.8, 3.5, 0.9, rgb(58, 60, 66), MAT.Metal, solid("Canopy"))
	for _, x in { 9.65, 15.55 } do
		cyl(ext, x, PAVE, -2.95, 3.25 - PAVE, 0.16, rgb(58, 60, 66), MAT.Metal, solid("CanopyColumn"))
	end
	for _, x in { 10.8, 12.6, 14.4 } do
		for _, z in { -2.2, -0.6 } do
			cyl(ext, x, 3.22, z, 0.03, 0.18, PANEL_WARM, MAT.Neon, neon("CanopyLight"))
		end
	end
	light(canopy, "SurfaceLight", { face = NID.Bottom, color = P.LampWarm, brightness = 1.6, range = M(5), angle = 110 })
	bx(ext, 11.0, 3.5, -3.05, 14.2, 4.15, -2.97, rgb(58, 60, 66), MAT.Metal, deco("CanopySignBack"))
	sign(ext, 11.1, 3.55, -3.12, 14.1, 4.1, -3.07, NID.Front, "101동", { bg = rgb(58, 60, 66), mat = MAT.Metal, color = rgb(255, 236, 200), glow = true, pps = 40, maxd = 800, name = "CanopySign", font = Enum.Font.GothamBold })
end

local function lobbyInterior(g: Model, rng: Random, unitTarget: Vector3)
	-- 대리석 바닥: 어두운 테두리 + 밝은 필드 + 중앙 런너(입구 → 엘리베이터)
	local fy0, fy1 = PAVE, LOBBY_FL
	bx(g, LX0, fy0, LZ0, LX1, fy1, 1.65, MARBLE_D, MAT.Marble, solid("FloorBorder"))
	bx(g, LX0, fy0, 11.65, LX1, fy1, LZ1, MARBLE_D, MAT.Marble, solid("FloorBorder"))
	bx(g, LX0, fy0, 1.65, 6.85, fy1, 11.65, MARBLE_D, MAT.Marble, solid("FloorBorder"))
	bx(g, 18.35, fy0, 1.65, LX1, fy1, 11.65, MARBLE_D, MAT.Marble, solid("FloorBorder"))
	bx(g, 6.85, fy0, 1.65, 11.4, fy1, 11.65, MARBLE_W, MAT.Marble, solid("FloorField"))
	bx(g, 11.4, fy0, 1.65, 13.8, fy1, 11.65, MARBLE_G, MAT.Marble, solid("FloorRunner"))
	bx(g, 13.8, fy0, 1.65, 18.35, fy1, 11.65, MARBLE_W, MAT.Marble, solid("FloorField"))
	bx(g, 11.6, fy1, 1.25, 13.6, fy1 + 0.018, 2.7, rgb(58, 56, 54), MAT.Carpet, deco("EntryMat"))
	-- 벽 마감: 서쪽 월넛 패널, 동쪽 라임스톤, 뒤 라임스톤(엘리베이터 석재 피처월은 elevatorBank)
	bx(g, LX0, LOBBY_FL, LZ0 + 0.05, LX0 + 0.04, LOBBY_CEIL, LZ1 - 0.05, WALNUT, MAT.Wood, solid("WallPanelW"))
	bx(g, LX1 - 0.04, LOBBY_FL, LZ0 + 0.05, LX1, LOBBY_CEIL, LZ1 - 0.05, STONE_L, MAT.Marble, solid("WallPanelE"))
	bx(g, LX0 + 0.04, LOBBY_FL, LZ1 - 0.04, 8.6, LOBBY_CEIL, LZ1, STONE_L, MAT.Marble, solid("WallPanelN"))
	bx(g, 16.6, LOBBY_FL, LZ1 - 0.04, LX1 - 0.04, LOBBY_CEIL, LZ1, STONE_L, MAT.Marble, solid("WallPanelN"))
	bx(g, LX0 + 0.04, LOBBY_FL, LZ0 + 0.1, LX0 + 0.06, LOBBY_FL + 0.1, LZ1 - 0.1, rgb(40, 40, 42), MAT.Metal, deco("Skirting"))
	bx(g, LX1 - 0.06, LOBBY_FL, LZ0 + 0.1, LX1 - 0.04, LOBBY_FL + 0.1, LZ1 - 0.1, rgb(40, 40, 42), MAT.Metal, deco("Skirting"))
	-- 천장 + 런너 위 라인 조명 + 매입등 6
	bx(g, LX0, LOBBY_CEIL, LZ0, LX1, LOBBY_CEIL + 0.05, LZ1, CEIL_C, MAT.SmoothPlastic, solid("Ceiling"))
	bx(g, 12.48, LOBBY_CEIL - 0.03, 2.0, 12.72, LOBBY_CEIL + 0.01, 11.2, PANEL_WARM, MAT.Neon, neon("LineLight"))
	local panels = {}
	for _, x in { 8.7, 16.5 } do
		for _, z in { 3.4, 6.6, 9.8 } do
			table.insert(panels, bx(g, x - 0.3, LOBBY_CEIL - 0.025, z - 0.3, x + 0.3, LOBBY_CEIL + 0.01, z + 0.3, PANEL_WARM, MAT.Neon, neon("CeilPanel")))
		end
	end
	light(panels[2], "PointLight", { color = rgb(255, 222, 180), brightness = 1.1, range = M(8) })
	light(panels[5], "PointLight", { color = rgb(255, 222, 180), brightness = 1.1, range = M(8) })
	Kit.ball(g, V(17.6, LOBBY_CEIL - 0.06, 10.8), M(0.14), rgb(20, 20, 24), MAT.Glass, deco("CCTV"))

	-- 우편함 54칸 (서쪽 벽, 9열 × 6행: 201~2802호)
	local mz0, mz1, my0, my1 = 3.2, 7.0, 0.8, 2.0
	local mx0, mx1 = LX0 + 0.04, LX0 + 0.3
	local housing = bx(g, mx0, my0, mz0, mx1, my1, mz1, rgb(178, 166, 142), MAT.Metal, solid("Mailboxes"))
	for i = 0, 9 do
		local z = mz0 + i * (mz1 - mz0) / 9
		bx(g, mx1, my0, z - 0.012, mx1 + 0.03, my1, z + 0.012, rgb(120, 110, 92), MAT.Metal, deco("MailRib"))
	end
	for j = 0, 6 do
		local y = my0 + j * (my1 - my0) / 6
		bx(g, mx1, y - 0.012, mz0, mx1 + 0.03, y + 0.012, mz1, rgb(120, 110, 92), MAT.Metal, deco("MailRib"))
	end
	local cells = {}
	for r = 0, 5 do
		for c = 0, 8 do
			local idx = r * 9 + c
			local fl, ln = 2 + idx // 2, idx % 2 + 1
			local u0, v0 = c / 9, r / 6
			table.insert(cells, { u0 + 0.008, v0 + 0.02, u0 + 0.075, v0 + 0.085, string.format("%d%02d", fl, ln), rgb(52, 46, 36) })
			table.insert(cells, { u0 + 0.02, v0 + 0.11, u0 + 1 / 9 - 0.02, v0 + 0.125, "", nil, rgb(60, 54, 44) })
		end
	end
	guiRects(housing, NID.Right, cells, 60, 70, false)
	sign(g, mx0, 2.08, 4.3, mx0 + 0.03, 2.3, 5.9, NID.Right, "우 편 함", { bg = rgb(52, 46, 36), color = rgb(236, 226, 200), pps = 60, maxd = 80 })
	sign(g, LX0 + 0.04, 2.7, 3.4, LX0 + 0.07, 3.3, 6.8, NID.Right, "HANGANG VIEW  101", { bg = WALNUT, mat = MAT.Wood, color = rgb(214, 190, 140), pps = 40, maxd = 120, name = "WallLogo", font = Enum.Font.Gotham })

	-- 관리사무소 공지 게시판 (동쪽 벽, -X 를 봄)
	local nx = LX1 - 0.04
	bx(g, nx - 0.04, 1.2, 2.6, nx, 2.1, 4.4, WALNUT, MAT.Wood, solid("NoticeFrame"))
	bx(g, nx - 0.055, 1.25, 2.65, nx - 0.04, 2.05, 4.35, rgb(176, 136, 94), MAT.Fabric, deco("NoticeCork"))
	sign(g, nx - 0.03, 2.13, 2.6, nx, 2.33, 4.4, NID.Left, "관리사무소 공지사항", { bg = rgb(36, 52, 84), color = rgb(255, 255, 255), pps = 70, maxd = 80 })
	local notices = {
		{ 2.72, 3.08, 1.62, 2.0, "[공지]\n엘리베이터 정기점검\n11월 12일(목) 10~12시", rgb(255, 255, 255) },
		{ 3.16, 3.5, 1.68, 2.0, "재활용 분리배출\n매주 화요일\n18:00~24:00", rgb(255, 246, 196) },
		{ 3.58, 3.92, 1.6, 1.98, "지하주차장\n물청소 안내\n11/15(일) 09:00~", rgb(255, 255, 255) },
		{ 4.0, 4.3, 1.66, 2.0, "층간소음\n줄이기\n캠페인", rgb(255, 222, 226) },
		{ 2.8, 3.3, 1.3, 1.56, "택배 수령은\n무인택배함 이용", rgb(214, 236, 255) },
		{ 3.5, 4.2, 1.3, 1.54, "동대표 선거 공고\n입주자대표회의", rgb(255, 255, 255) },
	}
	for _, n in notices do
		sign(g, nx - 0.075, n[3], n[1], nx - 0.06, n[4], n[2], NID.Left, n[5], { bg = n[6], color = rgb(30, 30, 34), pps = 120, maxd = 50, name = "Notice" })
		Kit.ball(g, V(nx - 0.08, n[4] - 0.025, (n[1] + n[2]) / 2), M(0.022), rgb(210, 40, 40), MAT.SmoothPlastic, deco("Pin"))
	end

	-- 무인택배함 (동쪽 벽): 본체 + 문(열별 높이 다양) + 터치스크린 열
	local pz0, pz1, py0, py1 = 5.2, 9.6, LOBBY_FL, 2.15
	local px1 = LX1 - 0.04
	local px0 = px1 - 0.5
	bx(g, px0, py0, pz0, px1, py1, pz1, rgb(70, 74, 80), MAT.Metal, solid("ParcelLocker"))
	local cols = { 4, 3, 0, 5, 4, 3 }
	local cw = (pz1 - pz0 - 0.1) / 6
	local doorLabels = {}
	local num = 1
	for ci, nrows in cols do
		local z0 = pz0 + 0.05 + (ci - 1) * cw
		if nrows == 0 then
			-- 조작부: 화면 + 키패드 + 사인
			local scr = bx(g, px0 - 0.012, 1.25, z0 + 0.1, px0, 1.62, z0 + cw - 0.1, SCREEN, MAT.Neon, { name = "LockerScreen", collide = false, query = false, shadow = false })
			Kit.label(scr, NID.Left, "택배 찾기\n동·호수 입력", { color = rgb(255, 255, 255), glow = true, pixelsPerStud = 80, maxDistance = 60 })
			bx(g, px0 - 0.012, 0.95, z0 + 0.15, px0, 1.18, z0 + cw - 0.15, rgb(40, 42, 46), MAT.Metal, deco("LockerKeypad"))
			bx(g, px0 - 0.006, 0.3, z0 + 0.04, px0, 0.85, z0 + cw - 0.04, rgb(200, 204, 208), MAT.Metal, deco("LockerDoor"))
		else
			local hgt = (py1 - py0 - 0.1) / nrows
			for ri = 0, nrows - 1 do
				local y0 = py0 + 0.05 + ri * hgt
				bx(g, px0 - 0.02, y0 + 0.01, z0 + 0.01, px0, y0 + hgt - 0.01, z0 + cw - 0.01, rgb(204, 208, 212), MAT.Metal, deco("LockerDoor"))
				local u0 = (z0 - pz0) / (pz1 - pz0)
				local v1 = 1 - (y0 + hgt - 0.03 - py0) / (py1 - py0)
				table.insert(doorLabels, { u0 + 0.01, v1, u0 + 0.045, v1 + 0.035, tostring(num), rgb(60, 64, 70) })
				if rng:NextNumber() < 0.35 then
					bx(g, px0 - 0.03, y0 + hgt - 0.08, z0 + cw - 0.07, px0 - 0.02, y0 + hgt - 0.05, z0 + cw - 0.04, rgb(255, 60, 40), MAT.Neon, deco("LockerLed"))
				end
				num += 1
			end
		end
	end
	local overlay = bx(g, px0 - 0.03, py0, pz0, px0 - 0.025, py1, pz1, rgb(0, 0, 0), MAT.SmoothPlastic, { name = "LockerNumbers", transparency = 1, collide = false, query = false, shadow = false })
	guiRects(overlay, NID.Left, doorLabels, 60, 60, false)
	sign(g, px1 - 0.03, 2.2, 6.4, px1, 2.42, 8.4, NID.Left, "무인택배함", { bg = rgb(40, 120, 90), color = rgb(255, 255, 255), pps = 60, maxd = 90 })

	-- 대기 벤치 + 사이드 테이블 + 대형 화분
	local BF = frameAt(8.5, LOBBY_FL, 2.15, 180)
	fb(g, BF, 0, 0.21, 0, 2.2, 0.32, 0.55, rgb(40, 38, 36), MAT.Metal, solid("LobbyBenchBase"))
	fb(g, BF, 0, SEAT - 0.05, 0, 2.16, 0.1, 0.53, rgb(150, 98, 64), MAT.Leather, solid("LobbyBenchSeat"))
	cyl(g, 10.05, LOBBY_FL, 2.2, 0.45, 0.42, MARBLE_W, MAT.Marble, solid("SideTable"))
	plant(g, 10.4, LOBBY_FL, 1.55, 0.5, 0.55, 0.95, 1.2, rng, rgb(60, 58, 56))
	plant(g, 14.8, LOBBY_FL, 1.55, 0.5, 0.55, 0.95, 1.2, rng, rgb(60, 58, 56))
	plant(g, 7.3, LOBBY_FL, 11.5, 0.45, 0.5, 0.8, 1.0, rng, rgb(60, 58, 56))
	-- 엘리베이터 2대 + 비상구
	elevatorBank(g, LOBBY_FL, "1", unitTarget, "20층으로 올라가기")
	stairDoor(g, LOBBY_FL, 17.25)
	-- 공동현관 키패드(문 밖 왼쪽 기둥)
	local kx0, kx1 = 10.55, 10.9
	bx(g, kx0, PAVE, 0.3, kx1, 1.45, 0.5, STEEL, MAT.Metal, solid("KeypadPost"))
	local kscr = bx(g, kx0 + 0.04, 1.15, 0.28, kx1 - 0.04, 1.38, 0.3, SCREEN, MAT.Neon, { name = "KeypadScreen", collide = false, query = false, shadow = false })
	Kit.label(kscr, NID.Front, "101동\n호수 + 호출", { color = rgb(255, 255, 255), glow = true, pixelsPerStud = 100, maxDistance = 50 })
	local pad = bx(g, kx0 + 0.05, 0.82, 0.28, kx1 - 0.05, 1.1, 0.3, rgb(40, 42, 46), MAT.Metal, deco("Keypad"))
	local keys = {}
	local kt = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "*", "0", "#" }
	for i, t in kt do
		local c, r = (i - 1) % 3, (i - 1) // 3
		table.insert(keys, { c / 3 + 0.04, r / 4 + 0.03, (c + 1) / 3 - 0.04, (r + 1) / 4 - 0.03, t, rgb(230, 236, 240), rgb(70, 74, 80) })
	end
	guiRects(pad, NID.Front, keys, 120, 40, true)
	Kit.ball(g, V((kx0 + kx1) / 2, 1.41, 0.29), M(0.03), rgb(20, 20, 24), MAT.Glass, deco("KeypadCam"))
end

------------------------------------------------------------------------------------------------------
-- 4) 20층 엘리베이터 홀 (x 6.25..18.95, z 9.85..12.25)
------------------------------------------------------------------------------------------------------
local HX0, HX1 = CORE_A0 + 0.25, CORE_A1 - 0.25
local HZ0, HZ1 = DEPTH, CORE_SPLIT
local FD_X0, FD_X1 = 6.95, 6.95 + DOOR_W -- 2001호 현관문 개구부
local ND_X0 = 17.45 -- 2002호 문

local function hallEnvelope(ext: Model)
	-- 홀 좌우 벽(서쪽 창), 2002호 쪽 앞벽
	local wy0, wy1, wz0, wz1 = HF + 0.9, HF + 2.05, 10.4, 11.75
	bx(ext, CORE_A0, SLAB_TOP, HZ0, HX0, wy0, HZ1, WALL_CORE, MAT.Concrete, solid("HallWallW"))
	bx(ext, CORE_A0, wy1, HZ0, HX0, TOPY, HZ1, WALL_CORE, MAT.Concrete, solid("HallWallW"))
	bx(ext, CORE_A0, wy0, HZ0, HX0, wy1, wz0, WALL_CORE, MAT.Concrete, solid("HallWallW"))
	bx(ext, CORE_A0, wy0, wz1, HX0, wy1, HZ1, WALL_CORE, MAT.Concrete, solid("HallWallW"))
	bx(ext, CORE_A0 + 0.1, wy0, wz0, CORE_A0 + 0.14, wy1, wz1, GLASS_C, MAT.Glass, glassO("HallWindow", 0.6))
	bx(ext, CORE_A0 + 0.06, wy0, wz0, CORE_A0 + 0.18, wy0 + 0.05, wz1, rgb(240, 240, 238), MAT.SmoothPlastic, deco("HallWinFrame"))
	bx(ext, CORE_A0 + 0.06, wy1 - 0.05, wz0, CORE_A0 + 0.18, wy1, wz1, rgb(240, 240, 238), MAT.SmoothPlastic, deco("HallWinFrame"))
	bx(ext, HX1, SLAB_TOP, HZ0, CORE_A1, TOPY, HZ1, WALL_CORE, MAT.Concrete, solid("HallWallE"))
	bx(ext, LINE_W + FIN_T / 2, SLAB_TOP, DEPTH - 0.25, CORE_A1, TOPY, DEPTH, WALL_EXT, MAT.Concrete, solid("HallWall2002"))
end

local function hallInterior(g: Model, rng: Random, lobbyTarget: Vector3)
	bx(g, HX0, SLAB_TOP, HZ0, HX1, HF, HZ1, rgb(196, 192, 186), MAT.CeramicTiles, solid("HallFloor"))
	bx(g, HX0, HALL_CEIL, HZ0, HX1, HALL_CEIL + 0.05, HZ1, CEIL_C, MAT.SmoothPlastic, solid("HallCeiling"))
	-- 앞벽(세대 현관 쪽) 라임스톤 패널, 문 주위로 나눔
	local fz = HZ0
	bx(g, HX0, HF, fz, FD_X0 - 0.07, HALL_CEIL, fz + 0.03, STONE_L, MAT.Marble, deco("HallPanel"))
	bx(g, FD_X1 + 0.07, HF, fz, LINE_W - FIN_T / 2, HALL_CEIL, fz + 0.03, STONE_L, MAT.Marble, deco("HallPanel"))
	bx(g, FD_X0 - 0.07, HF + DOOR_H + 0.07, fz, FD_X1 + 0.07, HALL_CEIL, fz + 0.03, STONE_L, MAT.Marble, deco("HallPanel"))
	bx(g, LINE_W + FIN_T / 2, HF, fz, HX1, HALL_CEIL, fz + 0.03, STONE_L, MAT.Marble, deco("HallPanel"))
	-- 핀(세대 경계벽) 돌출부 마감
	bx(g, LINE_W - FIN_T / 2 - 0.02, HF, DEPTH + 0.25, LINE_W + FIN_T / 2 + 0.02, HALL_CEIL, DEPTH + 0.28, STONE_L, MAT.Marble, deco("PilasterCap"))
	bx(g, HX0, HF, fz + 0.03, FD_X0 - 0.07, HF + 0.1, fz + 0.045, rgb(60, 58, 56), MAT.Marble, deco("Skirting"))
	bx(g, FD_X1 + 0.07, HF, fz + 0.03, HX1, HF + 0.1, fz + 0.045, rgb(60, 58, 56), MAT.Marble, deco("Skirting"))
	casingZ(g, fz, fz + 0.05, FD_X0, FD_X1, HF, BRONZE)
	-- 뒷벽 라임스톤 + 엘리베이터 + 비상구
	bx(g, HX0, HF, HZ1 - 0.04, 8.6, HALL_CEIL, HZ1, STONE_L, MAT.Marble, deco("HallPanel"))
	bx(g, 16.6, HF, HZ1 - 0.04, HX1, HALL_CEIL, HZ1, STONE_L, MAT.Marble, deco("HallPanel"))
	elevatorBank(g, HF, "20", lobbyTarget, "1층으로 내려가기")
	stairDoor(g, HF, 17.3)
	sign(g, 6.6, HF + 1.3, HZ1 - 0.065, 7.9, HF + 1.85, HZ1 - 0.045, NID.Front, "20F", { bg = STONE_L, mat = MAT.Marble, color = rgb(120, 112, 100), pps = 50, maxd = 80, font = Enum.Font.GothamBlack })
	-- 2002호 (닫힌 문, 벽 앞에 붙은 철문 + 도어록 + 문패) + 택배 상자
	local n0, n1 = ND_X0, ND_X0 + DOOR_W
	bx(g, n0, HF, fz + 0.03, n1, HF + DOOR_H, fz + 0.08, rgb(86, 80, 74), MAT.Metal, solid("Door2002"))
	casingZ(g, fz + 0.03, fz + 0.09, n0, n1, HF, rgb(70, 66, 62))
	bx(g, n0 + 0.08, HF + 0.95, fz + 0.08, n0 + 0.16, HF + 1.3, fz + 0.115, rgb(20, 20, 22), MAT.SmoothPlastic, deco("DoorLock"))
	bx(g, n0 + 0.095, HF + 1.18, fz + 0.115, n0 + 0.145, HF + 1.26, fz + 0.125, rgb(80, 150, 220), MAT.Neon, deco("DoorLockPad"))
	bx(g, n0 + 0.06, HF + 1.0, fz + 0.08, n0 + 0.2, HF + 1.02, fz + 0.12, STEEL, MAT.Metal, deco("DoorPull"))
	sign(g, n1 + 0.15, HF + 1.55, fz + 0.03, n1 + 0.4, HF + 1.67, fz + 0.045, NID.Back, "2002", { bg = rgb(40, 40, 42), color = rgb(230, 220, 200), pps = 100, maxd = 40 })
	bx(g, n0 + 0.1, HF, fz + 0.35, n0 + 0.5, HF + 0.28, fz + 0.65, rgb(176, 136, 92), MAT.Cardboard, solid("Parcel"))
	bx(g, n0 + 0.14, HF + 0.28, fz + 0.4, n0 + 0.4, HF + 0.42, fz + 0.6, rgb(190, 152, 104), MAT.Cardboard, deco("Parcel"))
	-- 2001호 문패 + 초인종(카메라)
	sign(g, FD_X1 + 0.15, HF + 1.55, fz + 0.03, FD_X1 + 0.4, HF + 1.67, fz + 0.045, NID.Back, "2001", { bg = rgb(40, 40, 42), color = rgb(230, 220, 200), pps = 100, maxd = 40 })
	bx(g, FD_X1 + 0.2, HF + 1.25, fz + 0.03, FD_X1 + 0.32, HF + 1.42, fz + 0.06, rgb(30, 30, 32), MAT.SmoothPlastic, deco("DoorBell"))
	-- 소화전함 (동쪽 벽)
	local hb = bx(g, HX1 - 0.16, HF + 0.55, 10.45, HX1, HF + 1.45, 11.25, rgb(196, 34, 30), MAT.Metal, solid("Hydrant"))
	Kit.label(hb, NID.Left, "소화전", { color = rgb(255, 255, 255), pixelsPerStud = 60, maxDistance = 60 })
	Kit.ball(g, V(HX1 - 0.06, HF + 1.6, 10.85), M(0.09), rgb(255, 40, 30), MAT.Neon, deco("HydrantLamp"))
	-- 천장 감지등 2 + 광원
	local l1 = cyl(g, 9.6, HALL_CEIL - 0.02, 11.05, 0.03, 0.3, PANEL_WARM, MAT.Neon, neon("SensorLight"))
	cyl(g, 15.6, HALL_CEIL - 0.02, 11.05, 0.03, 0.3, PANEL_WARM, MAT.Neon, neon("SensorLight"))
	light(l1, "PointLight", { color = rgb(255, 224, 186), brightness = 1.0, range = M(6) })
	plant(g, 6.75, HF, 11.75, 0.34, 0.4, 0.6, 0.8, rng, rgb(70, 68, 64))
end

------------------------------------------------------------------------------------------------------
-- 5) 2001호
--    평면(로컬 m): 세대 x 0..12.4, z 0..9.6 (앞=발코니)
--      발코니 x 0..8.0, z 0..1.5 | 거실 x 3.0..8.0, z 1.62..6.2 | 식당 x 0..3.0 | 주방 x 0..6.25, z 6.2..9.6
--      복도 x 6.4..8.0, z 5.0..8.3 | 현관 x 6.4..8.0, z 8.42..9.6 (현관문 z 9.6 벽, 홀 쪽으로 밖여닫이)
--      안방 x 8.15..12.4, z 0.2..5.0 | 욕실 z 5.12..7.2 | 서재 z 7.32..9.6
------------------------------------------------------------------------------------------------------
local W4X0, W4X1 = 8.0, 8.15 -- 거실/복도 ↔ 안방·욕실·서재 벽

local function unitEnvelope(ext: Model)
	-- 뒷벽(z 9.6..9.85): 주방 창 + 현관문 개구부
	local z0, z1 = 9.6, DEPTH
	local ky0, ky1 = UF + 1.05, UF + 2.1
	bx(ext, 0, SLAB_TOP, z0, 0.8, TOPY, z1, WALL_EXT, MAT.Concrete, solid("BackWall"))
	bx(ext, 0.8, SLAB_TOP, z0, 2.6, ky0, z1, WALL_EXT, MAT.Concrete, solid("BackWall"))
	bx(ext, 0.8, ky1, z0, 2.6, TOPY, z1, WALL_EXT, MAT.Concrete, solid("BackWall"))
	bx(ext, 2.6, SLAB_TOP, z0, FD_X0, TOPY, z1, WALL_EXT, MAT.Concrete, solid("BackWall"))
	bx(ext, FD_X0, HF + DOOR_H, z0, FD_X1, TOPY, z1, WALL_EXT, MAT.Concrete, solid("BackWall"))
	bx(ext, FD_X1, SLAB_TOP, z0, LINE_W - FIN_T / 2, TOPY, z1, WALL_EXT, MAT.Concrete, solid("BackWall"))
	-- 주방 창
	local wf = rgb(240, 240, 238)
	bx(ext, 0.8, ky0, 9.66, 2.6, ky0 + 0.05, 9.8, wf, MAT.SmoothPlastic, deco("WinFrame"))
	bx(ext, 0.8, ky1 - 0.05, 9.66, 2.6, ky1, 9.8, wf, MAT.SmoothPlastic, deco("WinFrame"))
	bx(ext, 0.8, ky0, 9.66, 0.85, ky1, 9.8, wf, MAT.SmoothPlastic, deco("WinFrame"))
	bx(ext, 2.55, ky0, 9.66, 2.6, ky1, 9.8, wf, MAT.SmoothPlastic, deco("WinFrame"))
	bx(ext, 1.67, ky0, 9.66, 1.73, ky1, 9.8, wf, MAT.SmoothPlastic, deco("WinMullion"))
	bx(ext, 0.85, ky0 + 0.05, 9.71, 2.55, ky1 - 0.05, 9.75, GLASS_C, MAT.Glass, glassO("KitchenGlass", 0.62))
	-- 현관문 틀(철제, 개구부 안쪽)
	bx(ext, FD_X0, HF, z0, FD_X0 + 0.05, HF + DOOR_H, z1, BRONZE, MAT.Metal, solid("DoorFrame"))
	bx(ext, FD_X1 - 0.05, HF, z0, FD_X1, HF + DOOR_H, z1, BRONZE, MAT.Metal, solid("DoorFrame"))
	bx(ext, FD_X0, HF + DOOR_H - 0.05, z0, FD_X1, HF + DOOR_H, z1, BRONZE, MAT.Metal, solid("DoorFrame"))
	bx(ext, FD_X0, SLAB_TOP, z0, FD_X1, HF + 0.008, z1, MARBLE_D, MAT.Marble, solid("DoorThreshold"))
	-- 안방 전면 창(확장형: 바닥~천장 유리, 가운데 멀리언, 안전 바)
	local bx0, bx1 = W4X1, LINE_W - FIN_T / 2
	bx(ext, bx0, SLAB_TOP, 0.0, bx1, UF + 0.05, 0.2, rgb(70, 72, 76), MAT.Metal, solid("WinSill"))
	bx(ext, bx0, CEIL, 0.0, bx1, TOPY, 0.2, rgb(70, 72, 76), MAT.Metal, solid("WinHead"))
	bx(ext, (bx0 + bx1) / 2 - 0.03, UF + 0.05, 0.02, (bx0 + bx1) / 2 + 0.03, CEIL, 0.18, rgb(70, 72, 76), MAT.Metal, solid("WinMullion"))
	bx(ext, bx0, UF + 0.05, 0.08, bx1, CEIL, 0.12, GLASS_C, MAT.Glass, glassO("BedroomGlass", 0.68))
	bx(ext, bx0, UF + 0.92, 0.0, bx1, UF + 0.96, 0.05, rgb(70, 72, 76), MAT.Metal, deco("SafetyBar"))
	-- 발코니 유리 난간(바닥 채널 + 강화유리 + 손스침)
	local dk = UF - 0.07
	bx(ext, 0, SLAB_TOP, 0.0, W4X0, dk + 0.1, 0.1, rgb(70, 72, 76), MAT.Metal, solid("RailShoe"))
	bx(ext, 0, dk + 0.1, 0.03, W4X0, dk + 1.12, 0.07, RAIL_GLASS, MAT.Glass, glassO("BalconyGlass", 0.7))
	bx(ext, 0, dk + 1.12, -0.01, W4X0, dk + 1.18, 0.11, OAK, MAT.Wood, solid("BalconyHandrail"))
end

local function unitInterior(g: Model, rng: Random)
	--------------------------------------------------------------------------------------------------
	-- 바닥 / 천장 / 벽
	--------------------------------------------------------------------------------------------------
	bx(g, 0, SLAB_TOP, 1.62, 6.4, UF, 9.6, OAK, MAT.WoodPlanks, solid("FloorWood"))
	bx(g, 6.4, SLAB_TOP, 1.62, W4X0, UF, 8.3, OAK, MAT.WoodPlanks, solid("FloorWood"))
	bx(g, W4X0, SLAB_TOP, 0.2, LINE_W - FIN_T / 2, UF, 5.0, OAK, MAT.WoodPlanks, solid("FloorWood"))
	bx(g, W4X0, SLAB_TOP, 7.2, LINE_W - FIN_T / 2, UF, 9.6, OAK, MAT.WoodPlanks, solid("FloorWood"))
	bx(g, W4X0, SLAB_TOP, 5.0, LINE_W - FIN_T / 2, UF - 0.03, 7.2, TILE_D, MAT.CeramicTiles, solid("FloorBath"))
	bx(g, 6.4, SLAB_TOP, 8.42, W4X0, HF, 9.6, rgb(92, 90, 88), MAT.CeramicTiles, solid("FloorEntry"))
	bx(g, 6.4, SLAB_TOP, 8.3, W4X0, UF + 0.012, 8.42, MARBLE_W, MAT.Marble, solid("EntryStep"))
	bx(g, 0, SLAB_TOP, 0.0, W4X0, UF - 0.07, 1.5, rgb(118, 90, 68), MAT.WoodPlanks, solid("BalconyDeck"))
	bx(g, 0, SLAB_TOP, 1.5, W4X0, UF + 0.025, 1.62, rgb(150, 152, 156), MAT.Metal, solid("SlideTrack"))
	bx(g, 0, CEIL, 0, LINE_W - FIN_T / 2, CEIL + 0.04, 9.6, CEIL_C, MAT.SmoothPlastic, solid("Ceiling"))
	-- 벽 (도배 화이트)
	local WC = PLASTER
	local w0, w1 = W4X0, W4X1
	local dh = UF + DOOR_H
	bx(g, w0, SLAB_TOP, 0.0, w1, TOPY, 3.9, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, w0, dh, 3.9, w1, TOPY, 4.8, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, w0, SLAB_TOP, 4.8, w1, TOPY, 5.5, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, w0, dh, 5.5, w1, TOPY, 6.4, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, w0, SLAB_TOP, 6.4, w1, TOPY, 7.45, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, w0, dh, 7.45, w1, TOPY, 8.35, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, w0, SLAB_TOP, 8.35, w1, TOPY, 9.6, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, w1, SLAB_TOP, 5.0, LINE_W - FIN_T / 2, TOPY, 5.12, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, w1, SLAB_TOP, 7.2, LINE_W - FIN_T / 2, TOPY, 7.32, WC, MAT.SmoothPlastic, solid("Wall"))
	bx(g, 6.25, SLAB_TOP, 7.0, 6.4, TOPY, 9.6, WC, MAT.SmoothPlastic, solid("Wall"))
	-- 콘크리트 외벽/경계벽 실내면 도배
	local exw = LINE_W - FIN_T / 2
	bx(g, exw - 0.02, UF, 0.2, exw, CEIL, 5.0, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, exw - 0.02, UF, 7.32, exw, CEIL, 9.6, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, w1, UF, 9.58, exw - 0.02, CEIL, 9.6, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, 0, UF, 1.62, 0.02, CEIL, 2.0, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, 0, UF, 4.6, 0.02, CEIL, 9.6, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, 0, UF, 2.0, 0.02, UF + 0.86, 4.6, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, 0, UF + 2.1, 2.0, 0.02, CEIL, 4.6, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, 6.8, HF, 9.58, FD_X0, CEIL, 9.6, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, FD_X1, HF, 9.58, w0, CEIL, 9.6, WC, MAT.SmoothPlastic, deco("WallSkin"))
	bx(g, FD_X0, HF + DOOR_H, 9.58, FD_X1, CEIL, 9.6, WC, MAT.SmoothPlastic, deco("WallSkin"))
	casingZ(g, 9.56, 9.6, FD_X0, FD_X1, HF, BRONZE)
	-- 문틀
	casingX(g, w0, w1, 3.9, 4.8, UF, rgb(246, 244, 240))
	casingX(g, w0, w1, 5.5, 6.4, UF, rgb(246, 244, 240))
	casingX(g, w0, w1, 7.45, 8.35, UF, rgb(246, 244, 240))
	-- 걸레받이 (0.08 m)
	local SK = rgb(246, 244, 240)
	local function skirtX(x: number, s: number, za: number, zb: number, y0: number?)
		local yy = y0 or UF
		bx(g, x, yy, za, x + s * 0.018, yy + 0.08, zb, SK, MAT.SmoothPlastic, deco("Skirting"))
	end
	local function skirtZ(z: number, s: number, xa: number, xb: number)
		bx(g, xa, UF, z, xb, UF + 0.08, z + s * 0.018, SK, MAT.SmoothPlastic, deco("Skirting"))
	end
	skirtX(0.02, 1, 1.64, 6.38)
	skirtX(w0, -1, 4.86, 5.44)
	skirtX(w0, -1, 6.46, 7.39)
	skirtX(w1, 1, 0.22, 3.84)
	skirtX(LINE_W - FIN_T / 2 - 0.02, -1, 0.22, 1.1)
	skirtX(LINE_W - FIN_T / 2 - 0.02, -1, 4.1, 4.38)
	skirtX(6.4, 1, 7.02, 8.28)
	skirtZ(5.0, -1, w1, 9.18)

	--------------------------------------------------------------------------------------------------
	-- 문 (안방·욕실 열림, 서재 반쯤 열림) + 현관문(홀 쪽으로 열림)
	--------------------------------------------------------------------------------------------------
	local DL = rgb(240, 238, 234)
	local DH = rgb(150, 136, 110)
	doorLeaf(g, w1, 4.8 - 0.03, UF + 0.005, DOOR_W - 0.08, DOOR_H - 0.02, 0.04, -12, DL, MAT.SmoothPlastic, DH)
	doorLeaf(g, w1, 5.5 + 0.03, UF, DOOR_W - 0.08, DOOR_H - 0.02, 0.04, 14, DL, MAT.SmoothPlastic, DH)
	doorLeaf(g, w1, 8.35 - 0.03, UF + 0.005, DOOR_W - 0.08, DOOR_H - 0.02, 0.04, -45, DL, MAT.SmoothPlastic, DH)
	local FF = doorLeaf(g, FD_X0 + 0.06, DEPTH + 0.04, HF + 0.005, DOOR_W - 0.12, DOOR_H - 0.06, 0.06, 84, rgb(86, 80, 74), MAT.Metal, STEEL)
	local fw, fh = DOOR_W - 0.12, DOOR_H - 0.06
	fb(g, FF, fw / 2 - 0.13, 1.15 - fh / 2, 0.065, 0.075, 0.3, 0.035, rgb(18, 18, 20), MAT.SmoothPlastic, deco("DoorLock"))
	fb(g, FF, fw / 2 - 0.13, 1.22 - fh / 2, 0.088, 0.05, 0.08, 0.012, rgb(80, 150, 220), MAT.Neon, deco("DoorLockPad"))
	fb(g, FF, fw / 2 - 0.13, 1.1 - fh / 2, -0.06, 0.085, 0.32, 0.05, rgb(18, 18, 20), MAT.SmoothPlastic, deco("DoorLockIn"))
	fb(g, FF, 0.25, fh / 2 - 0.08, -0.065, 0.32, 0.06, 0.06, rgb(60, 60, 62), MAT.Metal, deco("DoorCloser"))

	--------------------------------------------------------------------------------------------------
	-- 발코니 / 미닫이 창 / 커튼
	--------------------------------------------------------------------------------------------------
	local frameC = rgb(70, 72, 76)
	local gy0, gy1 = UF + 0.025, CEIL - 0.05
	bx(g, 0, gy1, 1.5, W4X0, CEIL, 1.62, frameC, MAT.Metal, solid("SlideHead"))
	local slides = {
		{ 0.0, 2.05, 1.52, 1.55 }, -- 고정
		{ 1.95, 4.05, 1.57, 1.6 }, -- 닫힌 미닫이
		{ 5.95, W4X0, 1.57, 1.6 }, -- 열린 미닫이(오른쪽 고정창 위로 겹침)
		{ 5.95, W4X0, 1.52, 1.55 }, -- 고정
	}
	for _, s in slides do
		bx(g, s[1] + 0.05, gy0, s[3], s[2] - 0.05, gy1, s[4], GLASS_C, MAT.Glass, glassO("SlideGlass", 0.72))
		bx(g, s[1], gy0, s[3] - 0.005, s[1] + 0.05, gy1, s[4] + 0.005, frameC, MAT.Metal, deco("SlideStile"))
		bx(g, s[2] - 0.05, gy0, s[3] - 0.005, s[2], gy1, s[4] + 0.005, frameC, MAT.Metal, deco("SlideStile"))
	end
	-- 커튼 박스 + 쉬어 커튼(양옆으로 모음)
	bx(g, 0, CEIL - 0.05, 1.64, W4X0, CEIL, 1.8, rgb(220, 220, 218), MAT.Metal, deco("CurtainRail"))
	for _, c in { { 0.05, 0.6 }, { 7.4, 7.95 } } do
		for i = 0, 3 do
			local x0 = c[1] + i * (c[2] - c[1]) / 4
			local zz = 1.68 + (if i % 2 == 0 then 0 else 0.05)
			bx(g, x0, UF + 0.03, zz, x0 + (c[2] - c[1]) / 4 + 0.02, CEIL - 0.05, zz + 0.04, LINEN, MAT.Fabric, { name = "Curtain", collide = false, query = false, shadow = false, transparency = 0.18 })
		end
	end
	-- 발코니 라운지 체어(강을 봄) + 사이드 테이블 + 화분 + 랜턴
	local dk = UF - 0.07
	local CF = frameAt(4.7, dk, 0.78, 0)
	for _, lx in { -0.28, 0.28 } do
		for _, lz in { -0.28, 0.3 } do
			fb(g, CF, lx, 0.16, lz, 0.04, 0.32, 0.04, rgb(110, 80, 58), MAT.Wood, deco("ChairLeg"))
		end
		fb(g, CF, lx + (if lx < 0 then -0.02 else 0.02), 0.56, 0.0, 0.05, 0.04, 0.66, rgb(110, 80, 58), MAT.Wood, deco("ChairArm"))
	end
	fb(g, CF, 0, 0.34, 0.0, 0.62, 0.05, 0.64, rgb(110, 80, 58), MAT.Wood, solid("ChairSeat"))
	fb(g, CF, 0, SEAT - 0.02, -0.02, 0.56, 0.07, 0.56, rgb(236, 230, 216), MAT.Fabric, deco("ChairCushion"))
	Kit.box(g, CF * mcf(0, 0.72, 0.36) * CFrame.Angles(math.rad(22), 0, 0), SZ(0.6, 0.7, 0.05), rgb(110, 80, 58), MAT.Wood, solid("ChairBack"))
	Kit.box(g, CF * mcf(0, 0.74, 0.3) * CFrame.Angles(math.rad(22), 0, 0), SZ(0.52, 0.55, 0.07), rgb(236, 230, 216), MAT.Fabric, deco("ChairBackCushion"))
	Kit.box(g, CF * mcf(0.1, SEAT + 0.03, 0.05) * CFrame.Angles(0, math.rad(12), 0), SZ(0.45, 0.03, 0.35), rgb(150, 92, 70), MAT.Fabric, deco("Throw"))
	cyl(g, 5.4, dk, 0.7, 0.5, 0.06, rgb(40, 40, 42), MAT.Metal, deco("SideTableStem"))
	cyl(g, 5.4, dk, 0.7, 0.02, 0.32, rgb(40, 40, 42), MAT.Metal, deco("SideTableBase"))
	cyl(g, 5.4, dk + 0.5, 0.7, 0.025, 0.45, MARBLE_W, MAT.Marble, solid("SideTableTop"))
	cyl(g, 5.33, dk + 0.525, 0.66, 0.012, 0.13, rgb(250, 250, 248), MAT.SmoothPlastic, deco("Saucer"))
	cyl(g, 5.33, dk + 0.537, 0.66, 0.08, 0.075, rgb(250, 250, 248), MAT.SmoothPlastic, deco("Cup"))
	bx(g, 5.48, dk + 0.525, 0.72, 5.62, dk + 0.555, 0.92, rgb(36, 70, 110), MAT.SmoothPlastic, deco("Book"))
	plant(g, 0.5, dk, 0.55, 0.55, 0.55, 1.1, 1.5, rng, rgb(176, 104, 72))
	plant(g, 7.55, dk, 0.4, 0.32, 0.3, 0.45, 0.4, rng, rgb(176, 104, 72))
	plant(g, 7.15, dk, 0.32, 0.26, 0.24, 0.35, 0.3, rng, rgb(232, 228, 220))
	bx(g, 3.25, dk, 0.25, 3.45, dk + 0.32, 0.45, rgb(30, 30, 32), MAT.Metal, deco("Lantern"))
	local candle = cyl(g, 3.35, dk + 0.04, 0.35, 0.12, 0.07, LAMP, MAT.Neon, neon("LanternCandle"))
	light(candle, "PointLight", { color = rgb(255, 180, 110), brightness = 0.8, range = M(3) })
	cyl(g, 4.0, CEIL - 0.02, 0.75, 0.025, 0.22, PANEL_WARM, MAT.Neon, neon("BalconyLight"))

	--------------------------------------------------------------------------------------------------
	-- 거실: 아트월 + TV 콘솔 + 65" TV + 소파 + 러그 + 커피 테이블 + 스탠드 + 에어컨 + 식물
	--------------------------------------------------------------------------------------------------
	bx(g, w0 - 0.03, UF, 1.64, w0, CEIL, 3.86, MARBLE_W, MAT.Marble, solid("ArtWall"))
	for _, z in { 2.38, 3.12 } do
		bx(g, w0 - 0.045, UF, z - 0.008, w0 - 0.03, CEIL, z + 0.008, rgb(176, 160, 128), MAT.Metal, deco("ArtWallTrim"))
	end
	local tvz = 2.9
	bx(g, 7.5, UF + 0.14, tvz - 0.9, w0 - 0.045, UF + 0.45, tvz + 0.9, WALNUT, MAT.Wood, solid("TVConsole"))
	bx(g, 7.62, UF, tvz - 0.8, 7.9, UF + 0.14, tvz + 0.8, rgb(30, 30, 30), MAT.SmoothPlastic, deco("ConsolePlinth"))
	for _, z in { tvz - 0.3, tvz + 0.3 } do
		bx(g, 7.485, UF + 0.16, z - 0.008, 7.5, UF + 0.43, z + 0.008, rgb(60, 44, 32), MAT.Wood, deco("DrawerSeam"))
	end
	-- 65" (1.44 x 0.81 m) + 스탠드 + 사운드바
	local tvY = UF + 0.45 + 0.09 + 0.405
	bx(g, 7.72, tvY - 0.405, tvz - 0.72, 7.75, tvY + 0.405, tvz + 0.72, rgb(10, 10, 12), MAT.Glass, { name = "TV65", reflectance = 0.15, shadow = false })
	bx(g, 7.75, tvY - 0.3, tvz - 0.45, 7.8, tvY + 0.3, tvz + 0.45, rgb(24, 24, 26), MAT.SmoothPlastic, deco("TVBack"))
	bx(g, 7.75, UF + 0.45, tvz - 0.05, 7.79, tvY - 0.3, tvz + 0.05, rgb(40, 40, 42), MAT.Metal, deco("TVNeck"))
	bx(g, 7.62, UF + 0.45, tvz - 0.22, 7.9, UF + 0.465, tvz + 0.22, rgb(40, 40, 42), MAT.Metal, deco("TVFoot"))
	bx(g, 7.56, UF + 0.45, tvz - 0.55, 7.66, UF + 0.51, tvz + 0.55, rgb(46, 46, 50), MAT.Fabric, deco("Soundbar"))
	bx(g, 7.715, tvY - 0.4, tvz + 0.62, 7.72, tvY - 0.39, tvz + 0.63, rgb(255, 40, 30), MAT.Neon, deco("StandbyLed"))
	plant(g, 7.72, UF + 0.45, tvz + 0.82, 0.12, 0.12, 0.22, 0.2, rng, rgb(232, 228, 220))
	Kit.box(g, LCF(7.7, UF + 0.53, tvz - 0.8) * CFrame.Angles(0, 0, math.rad(-10)), SZ(0.02, 0.16, 0.13), rgb(34, 32, 30), MAT.Wood, deco("PhotoFrame"))
	Kit.box(g, LCF(7.688, UF + 0.531, tvz - 0.8) * CFrame.Angles(0, 0, math.rad(-10)), SZ(0.008, 0.12, 0.09), rgb(200, 176, 150), MAT.SmoothPlastic, deco("Photo"))
	-- 소파 (3인, 좌면 0.43 m, +X 를 봄)
	local SF = frameAt(3.68, UF, tvz, -90)
	for _, lx in { -1.0, 1.0 } do
		for _, lz in { -0.4, 0.4 } do
			fb(g, SF, lx, 0.05, lz, 0.04, 0.1, 0.04, rgb(40, 32, 26), MAT.Wood, deco("SofaLeg"))
		end
	end
	fb(g, SF, 0, 0.215, 0, 2.2, 0.23, 0.95, SOFA_C, MAT.Fabric, solid("SofaBase"))
	for _, ax in { -1.015, 1.015 } do
		fb(g, SF, ax, 0.36, 0, 0.17, 0.52, 0.95, SOFA_C, MAT.Fabric, solid("SofaArm"))
	end
	fb(g, SF, 0, 0.565, 0.3875, 1.86, 0.47, 0.175, SOFA_C, MAT.Fabric, solid("SofaBack"))
	for _, cx in { -0.62, 0, 0.62 } do
		fb(g, SF, cx, SEAT - 0.05, -0.15, 0.6, 0.1, 0.64, rgb(184, 178, 168), MAT.Fabric, deco("SeatCushion"))
		Kit.box(g, SF * mcf(cx, 0.6, 0.215) * CFrame.Angles(math.rad(8), 0, 0), SZ(0.6, 0.42, 0.16), rgb(184, 178, 168), MAT.Fabric, deco("BackCushion"))
	end
	Kit.box(g, SF * mcf(-0.8, 0.62, 0.05) * CFrame.Angles(math.rad(18), math.rad(12), math.rad(8)), SZ(0.45, 0.45, 0.13), rgb(198, 150, 64), MAT.Fabric, deco("Pillow"))
	Kit.box(g, SF * mcf(-0.42, 0.6, 0.08) * CFrame.Angles(math.rad(16), math.rad(-6), math.rad(-5)), SZ(0.42, 0.42, 0.12), rgb(232, 226, 210), MAT.Fabric, deco("Pillow"))
	Kit.box(g, SF * mcf(0.78, 0.62, 0.05) * CFrame.Angles(math.rad(18), math.rad(-10), math.rad(-9)), SZ(0.45, 0.45, 0.13), rgb(170, 96, 70), MAT.Fabric, deco("Pillow"))
	fb(g, SF, 1.015, 0.63, 0.05, 0.22, 0.02, 0.5, rgb(132, 140, 150), MAT.Fabric, deco("Throw"))
	fb(g, SF, 1.11, 0.42, 0.05, 0.02, 0.42, 0.5, rgb(132, 140, 150), MAT.Fabric, deco("ThrowHang"))
	-- 러그 + 커피 테이블 + 소품
	bx(g, 4.3, UF, 1.95, 7.2, UF + 0.015, 3.85, rgb(210, 200, 182), MAT.Carpet, deco("Rug"))
	bx(g, 4.42, UF + 0.015, 2.07, 7.08, UF + 0.022, 3.73, rgb(188, 176, 156), MAT.Carpet, deco("RugInner"))
	bx(g, 4.8, UF + 0.36, 2.3, 5.4, UF + 0.4, 3.5, OAK_L, MAT.Wood, solid("CoffeeTable"))
	for _, z in { 2.36, 3.44 } do
		bx(g, 4.85, UF + 0.022, z - 0.025, 5.35, UF + 0.36, z + 0.025, OAK_L, MAT.Wood, solid("CoffeeLeg"))
	end
	bx(g, 4.85, UF + 0.1, 2.39, 5.35, UF + 0.12, 3.41, OAK_L, MAT.Wood, deco("CoffeeShelf"))
	local by = UF + 0.4
	for i, b in { { 0.3, 0.22, rgb(42, 70, 110) }, { 0.27, 0.2, rgb(232, 228, 216) }, { 0.24, 0.17, rgb(150, 52, 44) } } do
		Kit.box(g, LCF(4.98, by + 0.015, 2.62) * CFrame.Angles(0, math.rad(i * 7), 0), SZ(b[2], 0.03, b[1]), b[3], MAT.SmoothPlastic, deco("Book"))
		by += 0.03
	end
	cyl(g, 5.2, UF + 0.4, 3.12, 0.09, 0.08, rgb(240, 238, 232), MAT.SmoothPlastic, deco("Mug"))
	bx(g, 5.235, UF + 0.42, 3.115, 5.26, UF + 0.47, 3.125, rgb(240, 238, 232), MAT.SmoothPlastic, deco("MugHandle"))
	cyl(g, 5.05, UF + 0.4, 3.3, 0.18, 0.1, GLASS_C, MAT.Glass, { name = "Vase", collide = false, query = false, shadow = false, transparency = 0.4 })
	for i = 0, 2 do
		Kit.ball(g, V(5.05 + (i - 1) * 0.05, UF + 0.64 + (i % 2) * 0.04, 3.3 + (i - 1) * 0.03), M(0.07), if i == 1 then rgb(236, 220, 200) else rgb(214, 110, 120), MAT.SmoothPlastic, deco("Flower"))
	end
	bx(g, 5.2, UF + 0.4, 2.45, 5.24, UF + 0.42, 2.62, rgb(30, 30, 32), MAT.SmoothPlastic, deco("Remote"))
	-- 플로어 스탠드
	cyl(g, 3.45, UF, 4.3, 0.025, 0.3, rgb(40, 40, 42), MAT.Metal, deco("LampBase"))
	cyl(g, 3.45, UF + 0.025, 4.3, 1.4, 0.03, rgb(40, 40, 42), MAT.Metal, deco("LampPole"))
	cyl(g, 3.45, UF + 1.36, 4.3, 0.32, 0.42, rgb(240, 230, 210), MAT.Fabric, { name = "LampShade", collide = false, query = false, shadow = false, transparency = 0.1 })
	local bulb = Kit.ball(g, V(3.45, UF + 1.42, 4.3), M(0.1), LAMP, MAT.Neon, neon("LampBulb"))
	light(bulb, "PointLight", { color = rgb(255, 196, 130), brightness = 1.2, range = M(3.6) })
	-- 스탠드형 에어컨 (복도 입구)
	bx(g, 7.6, UF, 4.95, 7.96, UF + 1.8, 5.32, rgb(246, 246, 244), MAT.SmoothPlastic, solid("AirCon"))
	bx(g, 7.585, UF + 1.25, 5.0, 7.6, UF + 1.7, 5.27, rgb(214, 216, 220), MAT.SmoothPlastic, deco("AirConGrille"))
	bx(g, 7.58, UF + 1.1, 5.1, 7.6, UF + 1.15, 5.17, rgb(80, 170, 255), MAT.Neon, deco("AirConDisplay"))
	-- 대형 화분(몬스테라)
	plant(g, 2.85, UF, 1.95, 0.42, 0.45, 0.85, 1.1, rng, rgb(240, 238, 232))
	-- 거실 천장: 매입 다운라이트 4 + 간접 조명 띠
	local dls = {}
	for _, p in { { 4.6, 2.3 }, { 4.6, 3.5 }, { 6.8, 2.3 }, { 6.8, 3.5 } } do
		table.insert(dls, cyl(g, p[1], CEIL - 0.015, p[2], 0.03, 0.12, PANEL_WARM, MAT.Neon, neon("DownLight")))
	end
	light(dls[3], "PointLight", { color = rgb(255, 214, 168), brightness = 0.9, range = M(5) })
	switchPlate(g, "x", w0, -1, 4.95, UF + 1.15)

	--------------------------------------------------------------------------------------------------
	-- 식당: 4인 식탁(0.75 m) + 의자 4 + 펜던트 2 + 서쪽 창 블라인드 + 액자 + 시계
	--------------------------------------------------------------------------------------------------
	local tx, tz = 1.5, 3.4
	bx(g, tx - 0.45, UF + TABLE_H - 0.04, tz - 0.8, tx + 0.45, UF + TABLE_H, tz + 0.8, OAK_L, MAT.Wood, solid("DiningTable"))
	for _, lx in { -0.38, 0.38 } do
		for _, lz in { -0.72, 0.72 } do
			bx(g, tx + lx - 0.025, UF, tz + lz - 0.025, tx + lx + 0.025, UF + TABLE_H - 0.04, tz + lz + 0.025, OAK_L, MAT.Wood, solid("TableLeg"))
		end
	end
	for _, c in { { 0.72, 3.0, -90 }, { 0.72, 3.8, -90 }, { 2.28, 3.0, 90 }, { 2.28, 3.8, 90 } } do
		local F = frameAt(c[1], UF, c[2], c[3])
		for _, lx in { -0.19, 0.19 } do
			for _, lz in { -0.17, 0.17 } do
				fb(g, F, lx, (SEAT - 0.05) / 2, lz, 0.03, SEAT - 0.05, 0.03, WALNUT, MAT.Wood, deco("ChairLeg"))
			end
		end
		fb(g, F, 0, SEAT - 0.035, 0, 0.44, 0.03, 0.42, WALNUT, MAT.Wood, solid("ChairSeat"))
		fb(g, F, 0, SEAT - 0.005, -0.01, 0.4, 0.03, 0.38, rgb(214, 204, 186), MAT.Fabric, deco("ChairPad"))
		fb(g, F, 0, SEAT + 0.24, 0.19, 0.42, 0.34, 0.03, WALNUT, MAT.Wood, deco("ChairBack"))
		-- 식기 (매트 + 접시 + 컵)
		local pl = frameAt(c[1] + (if c[3] < 0 then 0.55 else -0.55), UF + TABLE_H, c[2], 0)
		fb(g, pl, 0, 0.004, 0, 0.32, 0.008, 0.42, rgb(196, 186, 168), MAT.Fabric, deco("Placemat"))
		Kit.vcyl(g, (pl * mcf(0, 0.016, 0)).Position, M(0.015), M(0.24), rgb(250, 250, 248), MAT.SmoothPlastic, deco("Plate"))
		Kit.vcyl(g, (pl * mcf(0.1, 0.06, -0.15)).Position, M(0.1), M(0.07), GLASS_C, MAT.Glass, { name = "Glass", collide = false, query = false, shadow = false, transparency = 0.45 })
	end
	cyl(g, tx, UF + TABLE_H, tz, 0.07, 0.28, rgb(244, 242, 236), MAT.SmoothPlastic, deco("FruitBowl"))
	for i = 0, 3 do
		Kit.ball(g, V(tx + (i % 2 - 0.5) * 0.09, UF + TABLE_H + 0.1, tz + (i // 2 - 0.5) * 0.09), M(0.08), if i % 2 == 0 then rgb(236, 140, 40) else rgb(190, 40, 40), MAT.SmoothPlastic, deco("Fruit"))
	end
	for i, z in { 3.0, 3.8 } do
		cyl(g, tx, CEIL - 0.02, z, 0.02, 0.1, rgb(30, 30, 32), MAT.Metal, deco("PendantCanopy"))
		cyl(g, tx, UF + 1.65, z, CEIL - UF - 1.67, 0.015, rgb(30, 30, 32), MAT.SmoothPlastic, deco("PendantCord"))
		cyl(g, tx, UF + 1.45, z, 0.2, 0.3, rgb(36, 38, 40), MAT.Metal, deco("PendantShade"))
		local pb = cyl(g, tx, UF + 1.44, z, 0.012, 0.24, LAMP, MAT.Neon, neon("PendantBulb"))
		if i == 1 then
			light(pb, "PointLight", { color = rgb(255, 200, 140), brightness = 1.0, range = M(3.2) })
		end
	end
	-- 서쪽 창: 대리석 창대 + 롤 블라인드(절반)
	bx(g, -0.15, UF + 0.86, 1.95, 0.05, UF + 0.9, 4.65, MARBLE_W, MAT.Marble, deco("WinSill"))
	bx(g, 0.03, UF + 1.5, 2.0, 0.06, UF + 2.08, 4.6, LINEN, MAT.Fabric, deco("RollerBlind"))
	bx(g, 0.03, UF + 1.48, 2.0, 0.07, UF + 1.51, 4.6, rgb(200, 200, 198), MAT.Metal, deco("BlindBar"))
	picture(g, "x", 0.02, 1, 4.85, 5.65, UF + 1.3, UF + 1.95, rgb(64, 110, 150), rgb(214, 170, 90))
	-- 벽시계 (주방/복도 칸막이, 18:05)
	local ck = V(6.25 - 0.03, UF + 1.95, 7.65)
	Kit.hcyl(g, CFrame.new(ck), M(0.03), M(0.36), rgb(30, 30, 32), MAT.Metal, deco("ClockRim"))
	Kit.hcyl(g, CFrame.new(ck - Vector3.new(M(0.01), 0, 0)), M(0.02), M(0.32), rgb(248, 246, 240), MAT.SmoothPlastic, deco("ClockFace"))
	for _, hnd in { { 182, 0.08, 0.016 }, { 30, 0.13, 0.012 } } do
		local phi = math.rad(hnd[1])
		local L = hnd[2]
		Kit.box(g, CFrame.new(ck - Vector3.new(M(0.025), 0, 0)) * CFrame.Angles(phi, 0, 0) * mcf(0, L / 2, 0), SZ(0.012, L, hnd[3]), rgb(20, 20, 22), MAT.SmoothPlastic, deco("ClockHand"))
	end

	--------------------------------------------------------------------------------------------------
