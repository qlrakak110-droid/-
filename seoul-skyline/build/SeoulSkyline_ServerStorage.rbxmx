-- m/층수 → stud 해석 (w, d, h, floorH 채움)
local function resolve(e: Entry): Entry
	local fh = if e.home then HOME_FLOOR else OFFICE_FLOOR
	e.floorH = fh
	if e.wm then
		e.w = M(e.wm :: number)
	end
	if e.dm then
		e.d = M(e.dm :: number)
	end
	if e.floors then
		e.h = (e.floors :: number) * fh
	end
	if (e.style or "curtain") == "round" or e.d == nil then
		e.d = e.w
	end
	return e
end

type FillOpts = {
	zone: { XMin: number, XMax: number, ZMin: number, ZMax: number },
	group: Instance,
	count: number,
	cx: number,
	cz: number,
	floorsMin: number,
	floorsMax: number,
	homeBias: number, -- 주거(따뜻한 조명, 2.9 m 층고) 비율
	midChance: number, -- 뒷줄 건물을 저파트 "mid" 매스로 만들 확률
}

------------------------------------------------------------------------------------------------------
-- 타워 시야 보호: 카메라 기준 화면 가로 구간(ndc = tan 각도) 비교
------------------------------------------------------------------------------------------------------
type Cam = { pos: Vector3, f: Vector3, r: Vector3, lo: number, hi: number }

local function ndcX(cam: Cam, p: Vector3): number
	local d = p - cam.pos
	local zc = d:Dot(cam.f)
	if zc < 1 then
		return if d:Dot(cam.r) < 0 then -1e6 else 1e6
	end
	return d:Dot(cam.r) / zc
end

local function rectCorners(cx: number, cz: number, w: number, d: number, yawDeg: number): { Vector3 }
	local cf = CFrame.new(cx, 0, cz) * CFrame.Angles(0, math.rad(yawDeg), 0)
	local out = {}
	for _, s in { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } } do
		table.insert(out, cf * Vector3.new(s[1] * w / 2, 0, s[2] * d / 2))
	end
	return out
end

local function spanOf(cam: Cam, corners: { Vector3 }, y0: number, y1: number): (number, number)
	local lo, hi = math.huge, -math.huge
	for _, c in corners do
		for _, y in { y0, y1 } do
			local v = ndcX(cam, Vector3.new(c.X, y, c.Z))
			lo = math.min(lo, v)
			hi = math.max(hi, v)
		end
	end
	return lo, hi
end

local function makeCams(): { Cam }
	local VP, T = Config.Viewpoint, Config.Landmark.Tower
	local views = {
		{ VP.HeroCamPos, VP.HeroCamLook },
		{ Vector3.new(VP.DeckCenter.X, VP.DeckHeight + R.Railing * 1.5, VP.DeckCenter.Z), VP.HeroCamLook }, -- 전망대 눈높이
	}
	local cams: { Cam } = {}
	local tc = rectCorners(T.Center.X, T.Center.Z, T.BaseWidth, T.BaseWidth, T.Yaw)
	local top = T.Center.Y + T.Height + T.CrownHeight + T.SpireHeight
	for _, v in views do
		local f = (v[2] - v[1]).Unit
		local r = f:Cross(Vector3.yAxis).Unit
		local cam: Cam = { pos = v[1], f = f, r = r, lo = 0, hi = 0 }
		local lo, hi = spanOf(cam, tc, T.Center.Y, top)
		cam.lo, cam.hi = lo - GUARD_PAD, hi + GUARD_PAD
		table.insert(cams, cam)
	end
	return cams
end

local function blocksTower(cams: { Cam }, x: number, z: number, w: number, d: number, yaw: number, h: number): boolean
	local corners = rectCorners(x, z, w, d, yaw)
	for _, cam in cams do
		local lo, hi = spanOf(cam, corners, CITY_Y, CITY_Y + h + M(20))
		if lo < cam.hi and hi > cam.lo then
			return true
		end
	end
	return false
end

------------------------------------------------------------------------------------------------------
-- Facade 커튼월 단(tier) 구간 재현 (Facade.curtain 과 같은 식) → { y0, y1, w, d }
------------------------------------------------------------------------------------------------------
local function tierBlocks(w0: number, d0: number, h: number, tierCount: number?): { { number } }
	local y = lobbyHeight(h) + 1.6
	local remaining = h - y
	local w, d = w0, d0
	local tiers = math.clamp(tierCount or 1, 1, 3)
	local out = {}
	for t = 1, tiers do
		local frac = if t == tiers then 1 else (if tiers == 2 then 0.62 else (if t == 1 then 0.5 else 0.6))
		local th = if t == tiers then h - y else math.floor(remaining * frac)
		table.insert(out, { y, y + th, w, d })
		y += th
		remaining = h - y
		if t < tiers then
			w *= 0.78
			d *= 0.78
		end
	end
	return out
end

------------------------------------------------------------------------------------------------------
-- 빌드
------------------------------------------------------------------------------------------------------
function Skyline.build(ctx: any)
	local Kit = ctx.Kit
	local Facade = ctx.Facade
	local rng: Random = ctx.rng
	local cams = makeCams()
	local lightsLeft = MAX_LIGHTS
	local placed = 0
	-- 수면 반사 띠 X 구간 (같은 높이 Y=Water+0.3 이라 겹치면 z-fighting). 다리 반사 구간은 미리 점유.
	local bridgeHalf = Config.Bridge.Width / 2 + M(15)
	local glints: { { number } } = { { BRIDGE_X - bridgeHalf, BRIDGE_X + bridgeHalf } }

	local function claimGlint(x: number, width: number): boolean
		local x0, x1 = x - width / 2 - 2, x + width / 2 + 2
		for _, g in glints do
			if x0 < g[2] and x1 > g[1] then
				return false
			end
		end
		table.insert(glints, { x0, x1 })
		return true
	end

	local function glowOpts(name: string, dayColor: Color3): any
		return { name = name, collide = false, query = false, shadow = false, glow = true, dayMaterial = Enum.Material.Glass, dayColor = dayColor }
	end

	-- 원거리 매스: 코어보다 0.4 안쪽, 각 단 위/아래 0.4~0.5 안쪽 → 어떤 면과도 겹치지 않음
	local function addMass(m: Model, e: Entry, w: number, d: number, h: number, cf: CFrame, style: string)
		if h < MASS_MIN_H or style == "mid" or style == "far" then
			return
		end
		local lit = e.lit or LIT_COOL
		local lc = e.litChance or 0.55
		local function litColor(): Color3
			local c = lit[rng:NextInteger(1, #lit)]
			return c:Lerp(BLACK, 0.18 + (1 - lc) * 0.5 + rng:NextNumber(0, 0.12))
		end
		local glass = e.glass or G_DEEP
		if style == "round" then
			local y0, y1 = lobbyHeight(h) + 0.5, h - 0.4
			local c = if e.gold then CROWN_GOLD:Lerp(BLACK, 0.12) else litColor()
			Kit.cylAlongY(m, cf * CFrame.new(0, (y0 + y1) / 2, 0), y1 - y0, w - MASS_INSET_ROUND * 2, c, Enum.Material.Neon, glowOpts("Mass", glass))
			return
		end
		local blocks = tierBlocks(w, d, h, e.tiers)
		local top = blocks[#blocks]
		local tw, td = top[3] - MASS_INSET * 2, top[4] - MASS_INSET * 2
		-- 척추(spine): 최상단 단의 평면으로 전체 높이 → 상층 실루엣이 원거리에서도 유지됨
		local y0, y1 = blocks[1][1] + 0.5, h - 0.4
		local spineC = if e.gold then CROWN_GOLD else litColor()
		Kit.box(m, cf * CFrame.new(0, (y0 + y1) / 2, 0), Vector3.new(tw, y1 - y0, td), spineC, Enum.Material.Neon, glowOpts("Mass", glass))
		-- 아래 단(더 넓은 평면): 금빛 크라운 건물은 어두운 유리 몸체, 나머지는 은은한 불빛
		for i = 1, #blocks - 1 do
			local b = blocks[i]
			local by0, by1 = b[1] + 0.4, b[2] - 0.4
			local size = Vector3.new(b[3] - MASS_INSET * 2, by1 - by0, b[4] - MASS_INSET * 2)
			local bcf = cf * CFrame.new(0, (by0 + by1) / 2, 0)
			if e.gold then
				Kit.box(m, bcf, size, glass:Lerp(BLACK, 0.25), Enum.Material.Glass, { name = "Mass", collide = false, query = false, shadow = false, reflectance = 0.12 })
			else
				Kit.box(m, bcf, size, litColor(), Enum.Material.Neon, glowOpts("Mass", glass))
			end
		end
	end

	local function addExtras(m: Model, e: Entry, w: number, d: number, h: number, cf: CFrame)
		-- 포디움(상가 3층): 타워 뒤·양옆을 감싸는 별동. 앞면은 타워 앞면보다 안쪽(로비가 그대로 보임)
		if e.podium then
			local front, back = d * 0.1, -d / 2 - PODIUM_OUT
			local pw = w + PODIUM_OUT * 2
			local zc = (front + back) / 2
			Kit.box(m, cf * CFrame.new(0, PODIUM_H / 2, zc), Vector3.new(pw, PODIUM_H, front - back), PODIUM, Enum.Material.Concrete, { name = "Podium" })
			-- 상가 간판 띠(높이 2.4~3.6 m): 앞면에서 0.5 튀어나오고 옆면보다 0.4 바깥
			Kit.box(m, cf * CFrame.new(0, M(3), front - 0.1), Vector3.new(pw + 0.8, M(1.2), 1.2), SHOPS, Enum.Material.Neon, glowOpts("PodiumShops", G_DEEP))
		end
		local lightPart: BasePart? = nil
		-- frame 크라운 안의 금빛 랜턴 — Facade.crown "frame" 치수(파라펫 ph, 프레임 fh, 기둥 3.2, LED 1.6, 상부 보 3.2)와 0.5 이상 이격
		if e.lantern and e.crown == "frame" and (e.style or "curtain") == "curtain" then
			local blocks = tierBlocks(w, d, h, e.tiers)
			local top = blocks[#blocks]
			local ph = math.clamp(h * 0.03, 7, 27)
			local fh = math.clamp(h * 0.07, 17, 56)
			local y0, y1 = h + ph + 1.6 + 0.5, h + ph + fh - 1.6 - 0.5
			lightPart = Kit.box(m, cf * CFrame.new(0, (y0 + y1) / 2, 0), Vector3.new(top[3] - 3.2 * 2 - 1.0, y1 - y0, top[4] * 0.6), LANTERN_GOLD, Enum.Material.Neon, glowOpts("Lantern", NAVY))
		end
		-- 실제 광원: 크라운을 금빛으로 적시는 PointLight (예산 MAX_LIGHTS)
		if e.light and lightsLeft > 0 then
			local part = lightPart or m:FindFirstChild("Roof") :: BasePart?
			if part then
				if Kit.light(part, "PointLight", { color = e.led or P.LedGold, brightness = 2.4, range = 60 }) then
					lightsLeft -= 1
				end
			end
		end
	end

	local function place(group: Instance, e: Entry, curated: boolean): Model?
		resolve(e)
		local w, d, h = e.w :: number, e.d :: number, e.h :: number
		local yaw = e.yaw or 0
		local style = e.style or "curtain"
		local pad = STREET_PAD + (if e.podium then PODIUM_OUT else 0)
		if blocksTower(cams, e.x, e.z, w + pad, d + pad, yaw, h) then
			if curated then
				warn("[Skyline] 타워 시야를 가려 생략: " .. e.name)
			end
			return nil
		end
		local ext = (pad - STREET_PAD) * 2 -- 포디움까지 포함한 실제 발자국
		if curated and not Kit.isFreeRect(e.x, e.z, w + ext, d + ext, yaw, 0) then
			warn("[Skyline] 예약과 겹침: " .. e.name)
		end
		Kit.reserveRect(e.x, e.z, w + pad * 2, d + pad * 2, yaw, "Skyline")
		local cf = CFrame.new(e.x, CITY_Y, e.z) * CFrame.Angles(0, math.rad(yaw), 0)
		local wantGlint = if e.glint ~= nil then e.glint else (e.z > GLINT_Z and math.abs(e.x - BRIDGE_X) > BRIDGE_CLEAR)
		local glint = wantGlint and style ~= "mid" and claimGlint(e.x, math.min(w, d) * 0.35) -- Facade 반사 폭과 동일
		local warm = (e.lit or LIT_COOL) ~= LIT_COOL
		local m = Facade.tower(group, {
			name = e.name,
			cf = cf,
			w = w,
			d = d,
			h = h,
			style = style,
			rng = rng,
			floorH = e.floorH,
			glass = e.glass,
			frame = e.frame,
			lit = e.lit,
			litChance = e.litChance,
			crown = e.crown,
			ledColor = e.led,
			tiers = e.tiers,
			glint = glint,
			lobbyColor = if warm then LOBBY_WARM else LOBBY_COOL,
			terraceLed = e.terrace or e.gold or false,
		})
		m:SetAttribute("Floors", e.floors or math.floor(h / (e.floorH :: number)))
		m:SetAttribute("HeightMeters", math.floor(h * Config.METERS_PER_STUD + 0.5))
		addMass(m, e, w, d, h, cf, style)
		addExtras(m, e, w, d, h, cf)
		placed += 1
		return m
	end

	-- 1) 손으로 배치한 주요 실루엣 (먼저 예약)
	local gRight = Kit.group(ctx.model, "SkylineRight")
	local gLeft = Kit.group(ctx.model, "SkylineLeft")
	local gMid = Kit.group(ctx.model, "SkylineMid")
	for _, e in HERO_RIGHT do
		place(gRight, e, true)
	end
	for _, e in HERO_LEFT do
		place(gLeft, e, true)
	end
	for _, e in HERO_MID do
		place(gMid, e, true)
	end

	-- 2) 절차적 필(25~45층): 클러스터 중심에 가까울수록 높게, 강 쪽 앞줄은 반사, 뒷줄 일부는 저파트 매스
	local GLASSES = { G_DEEP, G_BLUE, G_TEAL, INK, G_SILVER, G_BRONZE, NAVY }
	local CROWNS = { "box", "led", "led", "flat", "helipad", "frame", "slant", "box" }
	local LEDS = { P.LedGold, P.LedGold, P.LedCyan, P.LedBlue, P.LedGold }
	local MARGIN = M(9)

	local function fill(o: FillOpts)
		local zn = o.zone
		local n, tries = 0, 0
		local maxR = math.max(zn.XMax - zn.XMin, zn.ZMax - zn.ZMin) * 0.6
		while n < o.count and tries < o.count * 40 do
			tries += 1
			local w = M(rng:NextInteger(30, 45))
			local d = M(rng:NextInteger(28, 40))
			local r = rng:NextNumber()
			local yaw = if r < 0.6 then 0 elseif r < 0.86 then 90 else (rng:NextInteger(15, 30) * (if rng:NextNumber() < 0.5 then -1 else 1))
			local x = rng:NextNumber(zn.XMin + MARGIN, zn.XMax - MARGIN)
			local z = rng:NextNumber(zn.ZMin + MARGIN, zn.ZMax - MARGIN)
			local front = z > GLINT_Z
			if math.abs(x - BRIDGE_X) < BRIDGE_CLEAR + w / 2 then
				continue
			end
			if not Kit.isFreeRect(x, z, w + STREET_PAD * 2, d + STREET_PAD * 2, yaw, FILL_GAP) then
				continue
			end
			local t = math.clamp(math.sqrt((x - o.cx) ^ 2 + (z - o.cz) ^ 2) / maxR, 0, 1)
			local floors = math.floor((o.floorsMax + (o.floorsMin - o.floorsMax) * t) * rng:NextNumber(0.85, 1.06) + 0.5)
			floors = math.clamp(floors, 25, 45)
			local home = rng:NextNumber() < o.homeBias
			local styleR = rng:NextNumber()
			local style = if styleR < 0.2 then "round" elseif (not front and styleR > 1 - o.midChance) then "mid" else "curtain"
			local e: Entry = {
				name = string.format("Fill_%d", placed + 1),
				x = x,
				z = z,
				w = w,
				d = d,
				floors = floors,
				home = home,
				yaw = yaw,
				style = style,
				crown = CROWNS[rng:NextInteger(1, #CROWNS)],
				glass = GLASSES[rng:NextInteger(1, #GLASSES)],
				lit = if home then LIT_HOME else LIT_COOL,
				litChance = rng:NextNumber(0.36, 0.56),
				led = LEDS[rng:NextInteger(1, #LEDS)],
				tiers = if floors > 38 and rng:NextNumber() < 0.4 then 2 else 1,
			}
			if style == "round" then
				e.w = math.min(w, d) + M(2)
				e.d = e.w
				e.crown = if e.crown == "led" or e.crown == "box" then e.crown else "led"
			end
			if place(o.group, e, false) then
				n += 1
			end
		end
	end

	fill({ zone = Z.SkylineRight, group = gRight, count = 11, cx = 1167, cz = -1833, floorsMin = 28, floorsMax = 45, homeBias = 0.35, midChance = 0.5 })
	fill({ zone = Z.SkylineLeft, group = gLeft, count = 9, cx = -1833, cz = -1833, floorsMin = 25, floorsMax = 42, homeBias = 0.6, midChance = 0.5 })
	fill({ zone = Z.SkylineMid, group = gMid, count = 5, cx = -67, cz = -2417, floorsMin = 30, floorsMax = 42, homeBias = 0.4, midChance = 0.5 })

	ctx.model:SetAttribute("Buildings", placed)
	ctx.model:SetAttribute("Lights", MAX_LIGHTS - lightsLeft)
end

return Skyline
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000C"><Properties><string name="Name">TerrainPlan</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / TerrainPlan
-- 지형: 한강 수면 + 강바닥 + 호안(돌 사면) + 양쪽 둔치 잔디 + 제방 사면.
-- 도시 지면/도로/산책로 포장은 Riverside/Park 모듈이 파트로 덮습니다.

local Config = require(script.Parent.Config)
local Kit = require(script.Parent.Kit)

local TerrainPlan = {}

function TerrainPlan.build(_ctx: any)
	local L, R, F, N = Config.Level, Config.River, Config.FarBank, Config.NearBank
	local x0, x1 = R.XMin, R.XMax
	local chunk = 2000
	-- 1) 강물 (청크로 나눠 채움)
	local zw0, zw1 = F.WaterEdge - 8, N.WaterEdge + 8
	local x = x0
	while x < x1 do
		local xe = math.min(x + chunk, x1)
		local cx = (x + xe) / 2
		Kit.terrain("Block", CFrame.new(cx, (L.RiverBed + L.Water) / 2, (zw0 + zw1) / 2), Vector3.new(xe - x, L.Water - L.RiverBed, zw1 - zw0), Enum.Material.Water)
		-- 강바닥
		Kit.terrain("Block", CFrame.new(cx, L.RiverBed - 4, (zw0 + zw1) / 2), Vector3.new(xe - x, 8, zw1 - zw0), Enum.Material.Mud)
		x = xe
	end
	-- 2) 양쪽 둔치: 수면 가장자리 돌 사면(웨지) + 잔디 둔치 + 제방 사면
	local function bank(sign: number, B: any)
		-- sign = -1: 먼 쪽(물 → -Z), +1: 가까운 쪽(물 → +Z)
		local edge = B.WaterEdge
		local revW = 14 -- 호안 폭
		local x = x0
		while x < x1 do
			local xe = math.min(x + chunk, x1)
			local cx, w = (x + xe) / 2, xe - x
			-- 호안: 물속 바닥(-10)에서 둔치 높이까지 비스듬히. WedgePart 규약: 높은 면이 +Z.
			local hRev = L.Promenade + 10
			local zc = edge + sign * revW / 2
			local wedgeCF = CFrame.new(cx, -10 + hRev / 2, zc) * (if sign > 0 then CFrame.new() else CFrame.Angles(0, math.pi, 0))
			Kit.terrain("Wedge", wedgeCF, Vector3.new(w, hRev, revW), Enum.Material.Slate)
			-- 둔치 (잔디) : Promenade 높이까지, 두께 18
			local pz0, pz1 = edge + sign * revW, B.ParkTo
			Kit.terrain("Block", CFrame.new(cx, L.Promenade - 9, (pz0 + pz1) / 2), Vector3.new(w, 18, math.abs(pz1 - pz0)), Enum.Material.Grass)
			-- 제방 사면 (Promenade → Levee)
			local sh = L.Levee - L.Promenade
			local sz0, sz1 = B.ParkTo, B.SlopeTo
			local slopeCF = CFrame.new(cx, L.Promenade + sh / 2, (sz0 + sz1) / 2) * (if sign > 0 then CFrame.new() else CFrame.Angles(0, math.pi, 0))
			Kit.terrain("Wedge", slopeCF, Vector3.new(w, sh, math.abs(sz1 - sz0)), Enum.Material.Grass)
			-- 제방/도시 아래 흙 (사면 아래 + 도로 아래)
			Kit.terrain("Block", CFrame.new(cx, L.Promenade - 9, (sz0 + sz1) / 2), Vector3.new(w, 18, math.abs(sz1 - sz0)), Enum.Material.Ground)
			x = xe
		end
	end
	bank(-1, F)
	bank(1, N)
end

return TerrainPlan
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000000000000000000000000000D"><Properties><string name="Name">WaterFx</string><ProtectedString name="Source"><![CDATA[--!strict
-- SeoulSkyline / WaterFx
-- 한강 유람선(움직임은 클라이언트 Boats 가 담당) + 먼 쪽 강변 앞 수면의 은은한 빛 반짝임.
--
--   * 유람선 3척: 실측 55 m / 50 m / 42 m, 폭 9~11 m, 흘수 1.3 m, 건현 1.5 m, 2층 선실(층고 2.7 / 2.5 m),
--     창 띠 1.4 m(창 2.8 m + 기둥 0.5 m), 유리 난간 1.1 m, 마스트 4 m(백색 마스트등), 좌현 빨강 / 우현 초록 현등,
--     선미등, 장식 전구줄(마스트 → 선수/선미), 선실 LED 라인.
--     각 배 = Model "Boat" (태그 SeoulBoat), 피벗 = 수선면 중심, LookVector = 선수 방향.
--     속성 PathA / PathB (Vector3, 수면 위 X 방향 직선 구간), Speed (stud/s, 약 9~10 노트), TurnRadius, Phase(0~1, A→B 구간 위 시작점).
--     모든 파트 Anchored + CanCollide false(클라이언트가 PivotTo 로 움직임 — 서버 사본은 Phase 위치에 정지).
--     경로는 다리 띠(Config.Bridge.X ± 80)와 Kit 예약 영역을 피하고, U턴 반경까지 포함해 수면 안에 머뭅니다.
--   * 수면 반짝임: 먼 쪽 호안 앞(Z = FarBank.WaterEdge + 30 ~ +170)에 짧고 옅은 Kit.reflection 몇 개.
--     다른 모듈의 반사(WaterGlint)와 겹치지 않는 자리만 사용.
--   * 클라이언트용 색 정보(Config.Palette 차량 불빛)를 루트 속성으로 내보냅니다(클라이언트는 ServerStorage 를 못 읽음).
--   예산: 300 파트.

local CollectionService = game:GetService("CollectionService")

local WaterFx = {}

local BUDGET = 300
local BOAT_TAG = "SeoulBoat"

type BoatSpec = {
	length: number, -- m
	beam: number, -- m
	z: number, -- 항로 Z (River.HalfWidth 비율)
	xFar: number, -- A 끝 X (stud)
	xNear: number, -- B 끝 X (stud, 다리 쪽)
	phase: number,
	knots: number,
	hull: Color3,
	accent: Color3,
	led: Color3,
}

function WaterFx.build(ctx: any)
	local Config = ctx.Config
	local Kit = ctx.Kit
	local rng: Random = ctx.rng
	local model: Model = ctx.model
	local root: Model = ctx.root
	local P = Config.Palette
	local m = Config.m
	local MAT = Enum.Material
	local rgb = Color3.fromRGB
	local p0 = Kit.stats.parts

	-- 클라이언트용 팔레트/스케일 (Traffic/Beacons 가 읽음)
	root:SetAttribute("HeadlightColor", P.Headlight)
	root:SetAttribute("TaillightColor", P.Taillight)
	root:SetAttribute("BeaconColor", P.Beacon)
	root:SetAttribute("MetersPerStud", Config.METERS_PER_STUD)

	local function used(): number
		return Kit.stats.parts - p0
	end

	local function deco(name: string, extra: { [string]: any }?): any
		local o: { [string]: any } = { name = name, collide = false, query = false }
		if extra then
			for k, v in extra do
				o[k] = v
			end
		end
		return o
	end

	local function glowOpts(name: string, dayColor: Color3?, extra: { [string]: any }?): any
		local o = deco(name, { shadow = false, glow = true, dayMaterial = MAT.Glass, dayColor = dayColor or P.GlassDeep })
		if extra then
			for k, v in extra do
				o[k] = v
			end
		end
		return o
	end

	--------------------------------------------------------------------------------------------------
	-- 유람선
	--------------------------------------------------------------------------------------------------
	local HW = Config.River.HalfWidth
	local BX = Config.Bridge.X
	local BRIDGE_CLEAR = 80 -- 다리 띠 반폭(stud)
	local TURN_R = m(30) -- U턴 반경 30 m

	local WINDOW_COLORS = { P.WindowWarm, P.WindowWarm, P.WindowWarm, P.WindowGold, P.WindowWarmDim, P.WindowWarm }

	-- 선체 + 2층 선실. cf0: 수선면 중심, LookVector = 선수.
	local function buildBoat(parent: Model, cf0: CFrame, s: BoatSpec)
		local L, B = m(s.length), m(s.beam)
		local bowLen = m(s.beam * 0.95)
		local yB, yT = -m(1.3), m(1.5) -- 선저 / 주갑판
		local hh = yT - yB
		local zBowRoot = -L / 2 + bowLen
		local function at(x: number, y: number, z: number): CFrame
			return cf0 * CFrame.new(x, y, z)
		end

		-- 선체 본체(선미 쪽 사각) + 뾰족한 선수(웨지 2)
		Kit.box(parent, at(0, (yB + yT) / 2, (zBowRoot + L / 2) / 2), Vector3.new(B, hh, L / 2 - zBowRoot), s.hull, MAT.SmoothPlastic, deco("Hull", { shadow = false }))
		local bowRotS = CFrame.fromMatrix(Vector3.zero, Vector3.new(0, -1, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1))
		local bowRotP = CFrame.fromMatrix(Vector3.zero, Vector3.new(0, 1, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1))
		Kit.wedge(parent, at(B / 4, (yB + yT) / 2, zBowRoot - bowLen / 2) * bowRotS, Vector3.new(hh, B / 2, bowLen), s.hull, MAT.SmoothPlastic, deco("Bow"))
		Kit.wedge(parent, at(-B / 4, (yB + yT) / 2, zBowRoot - bowLen / 2) * bowRotP, Vector3.new(hh, B / 2, bowLen), s.hull, MAT.SmoothPlastic, deco("Bow"))

		-- 선체 색 띠(현측 + 선수 사면), 선체 면에서 0.4 stud 돌출
		local bandY, bandH = m(0.55), m(0.45)
		local mainLen = L / 2 - zBowRoot - m(0.6)
		for _, sx in { -1, 1 } do
			Kit.box(parent, at(sx * (B / 2 + 0.1), bandY, (zBowRoot + L / 2) / 2 + m(0.3)), Vector3.new(0.6, bandH, mainLen), s.accent, MAT.SmoothPlastic, deco("HullBand"))
			-- 선수 사면: (sx*B/2, zBowRoot) → (0, -L/2)
			local a = Vector3.new(sx * B / 2, 0, zBowRoot)
			local b = Vector3.new(0, 0, -L / 2)
			local mid = (a + b) / 2
			local along = (b - a).Unit
			local out = Vector3.new(along.Z, 0, -along.X)
			if out.X * sx < 0 then
				out = -out
			end
			local cfBand = CFrame.lookAt(mid, mid + along) + out * 0.1
			Kit.box(parent, cf0 * (cfBand + Vector3.new(0, bandY, 0)), Vector3.new(0.6, bandH, (b - a).Magnitude * 0.9), s.accent, MAT.SmoothPlastic, deco("HullBand"))
		end

		-- 수선부 짙은 띠(boot-top, 수면 -0.1 ~ +0.4 m)
		for _, sx in { -1, 1 } do
			Kit.box(parent, at(sx * (B / 2 + 0.1), m(0.15), (zBowRoot + L / 2) / 2 + m(0.2)), Vector3.new(0.6, m(0.5), mainLen + m(0.2)), rgb(26, 32, 48), MAT.SmoothPlastic, deco("BootTop"))
		end

		-- 주갑판 유리 난간(선체 가장자리, 1.1 m)
		local railH = Config.Real.Railing
		local GLASS_RAIL = rgb(150, 176, 196)
		for _, sx in { -1, 1 } do
			Kit.box(parent, at(sx * (B / 2 - 0.4), yT + railH / 2, (zBowRoot + L / 2) / 2), Vector3.new(0.3, railH, L / 2 - zBowRoot - 0.8), GLASS_RAIL, MAT.Glass, deco("Rail", { transparency = 0.55 }))
		end

		-- 1층 선실
		local w1 = B - m(1.6)
		local h1 = m(2.7)
		local z1a, z1b = zBowRoot + m(1.0), L / 2 - m(4.0)
		local cab1 = Kit.box(parent, at(0, yT + h1 / 2, (z1a + z1b) / 2), Vector3.new(w1, h1, z1b - z1a), rgb(236, 236, 232), MAT.SmoothPlastic, deco("Cabin1", { shadow = false }))
		-- 창 띠: 2.8 m 창 + 0.5 m 기둥, 선실 벽에서 0.3 stud 돌출
		local function windowRow(w: number, y0: number, wh: number, za: number, zb: number)
			local pw, gap = m(2.8), m(0.5)
			local n = math.max(1, math.floor((zb - za + gap) / (pw + gap)))
			local span = n * pw + (n - 1) * gap
			local zs = (za + zb) / 2 - span / 2
			for _, sx in { -1, 1 } do
				for i = 0, n - 1 do
					local c = WINDOW_COLORS[rng:NextInteger(1, #WINDOW_COLORS)]
					Kit.box(parent, at(sx * (w / 2 + 0.05), y0 + wh / 2, zs + pw / 2 + i * (pw + gap)), Vector3.new(0.5, wh, pw), c, MAT.Neon, glowOpts("Window"))
				end
			end
		end
		windowRow(w1, yT + m(0.9), m(1.4), z1a + m(0.8), z1b - m(0.8))
		-- 전면 파노라마 창 / 후면 유리문
		Kit.box(parent, at(0, yT + m(1.6), z1a - 0.05), Vector3.new(w1 - m(1.2), m(1.4), 0.5), P.WindowWarm, MAT.Neon, glowOpts("WindowFront"))
		Kit.box(parent, at(0, yT + m(1.25), z1b + 0.05), Vector3.new(w1 * 0.55, m(2.1), 0.5), P.WindowGold, MAT.Neon, glowOpts("WindowAft"))

		-- 1층 지붕 = 2층 바닥(0.3 m, 0.4 m 차양)
		local slabT = m(0.3)
		local slabW, slabL = w1 + m(0.8), z1b - z1a + m(1.0)
		local y2 = yT + h1 + slabT
		Kit.box(parent, at(0, yT + h1 + slabT / 2, (z1a + z1b) / 2), Vector3.new(slabW, slabT, slabL), rgb(240, 240, 236), MAT.SmoothPlastic, deco("Deck2Slab", { shadow = false }))
		-- 차양 옆면 LED 라인
		for _, sx in { -1, 1 } do
			Kit.box(parent, at(sx * (slabW / 2 + 0.05), yT + h1 + slabT * 0.45, (z1a + z1b) / 2), Vector3.new(0.4, 0.35, slabL - 1), s.led, MAT.Neon, glowOpts("LedLine"))
		end
		-- 2층 유리 난간(옆 2 + 앞 + 뒤)
		for _, sx in { -1, 1 } do
			Kit.box(parent, at(sx * (slabW / 2 - 0.45), y2 + railH / 2, (z1a + z1b) / 2), Vector3.new(0.3, railH, slabL - 1.2), GLASS_RAIL, MAT.Glass, deco("Rail", { transparency = 0.55 }))
		end
		for _, zz in { z1a - m(0.5) + 0.45, z1b + m(0.5) - 0.45 } do
			Kit.box(parent, at(0, y2 + railH / 2, zz), Vector3.new(slabW - 1.6, railH, 0.3), GLASS_RAIL, MAT.Glass, deco("Rail", { transparency = 0.55 }))
		end

		-- 2층 선실(앞쪽 = 조타실), 뒤쪽은 개방 갑판
		local w2 = w1 - m(1.4)
		local h2 = m(2.5)
		local z2a, z2b = z1a + m(4.5), z1b - math.max(m(7), (z1b - z1a) * 0.3)
		Kit.box(parent, at(0, y2 + h2 / 2, (z2a + z2b) / 2), Vector3.new(w2, h2, z2b - z2a), rgb(238, 238, 234), MAT.SmoothPlastic, deco("Cabin2", { shadow = false }))
		windowRow(w2, y2 + m(0.8), m(1.3), z2a + m(4.0), z2b - m(0.6))
		-- 조타실 창(어두운 유리) — 측면 앞부분 + 전면
		for _, sx in { -1, 1 } do
			Kit.box(parent, at(sx * (w2 / 2 + 0.05), y2 + m(1.55), z2a + m(1.8)), Vector3.new(0.5, m(1.0), m(2.8)), rgb(30, 44, 56), MAT.Glass, deco("BridgeWindow"))
		end
		Kit.box(parent, at(0, y2 + m(1.55), z2a - 0.05), Vector3.new(w2 - m(0.8), m(1.0), 0.5), rgb(30, 44, 56), MAT.Glass, deco("BridgeWindow"))
		-- 2층 지붕
		local y3 = y2 + h2
		Kit.box(parent, at(0, y3 + m(0.25) / 2, (z2a + z2b) / 2), Vector3.new(w2 + m(0.6), m(0.25), z2b - z2a + m(0.6)), rgb(244, 244, 240), MAT.SmoothPlastic, deco("Roof", { shadow = false }))

		-- 마스트 + 항해등
		local mastH = m(4.0)
		local mz = z2a + m(2.0)
		local yRoof = y3 + m(0.25)
		Kit.vcyl(parent, (at(0, yRoof + mastH / 2, mz)).Position, mastH, 0.6, rgb(220, 222, 226), MAT.Metal, deco("Mast"))
		local mastTop = at(0, yRoof + mastH + 0.4, mz).Position
		Kit.ball(parent, mastTop, 1.1, P.LampWhite, MAT.Neon, glowOpts("MastheadLight"))
		-- 현등: 좌현(-X) 빨강, 우현(+X) 초록 — 조타실 양옆
		Kit.box(parent, at(-(w2 / 2 + 0.6), y3 - m(0.4), z2a + m(0.6)), Vector3.new(0.6, 0.9, 1.4), rgb(255, 40, 32), MAT.Neon, glowOpts("PortLight"))
		Kit.box(parent, at(w2 / 2 + 0.6, y3 - m(0.4), z2a + m(0.6)), Vector3.new(0.6, 0.9, 1.4), rgb(40, 255, 110), MAT.Neon, glowOpts("StarboardLight"))
		-- 선미등(백색)
		Kit.box(parent, at(0, yT + railH + 0.6, L / 2 - 0.8), Vector3.new(1.0, 0.9, 0.6), P.LampWhite, MAT.Neon, glowOpts("SternLight"))
		-- 장식 전구줄: 마스트 꼭대기 → 선수 끝 / 선미 (원기둥 축 = 로컬 X)
		local bowTip = at(0, yT + railH, -L / 2 + 1.0).Position
		local sternTop = at(0, yT + railH + 1.2, L / 2 - 1.5).Position
		for _, b in { bowTip, sternTop } do
			local mid = (mastTop + b) / 2
			Kit.part(parent, CFrame.lookAt(mid, b) * CFrame.Angles(0, math.rad(90), 0), Vector3.new((b - mastTop).Magnitude, 0.35, 0.35), glowOpts("LightString", nil, { shape = "Cylinder", material = MAT.Neon, color = P.LampWarm }))
		end

		-- 수면에 번진 창 불빛(배와 함께 이동) + 선미 항적
		for _, sx in { -1, 1 } do
			Kit.box(parent, at(sx * (B / 2 + m(2.2)), 0.3, (z1a + z1b) / 2), Vector3.new(m(3.2), 0.12, (z1b - z1a) * 0.9), P.WindowWarmDim, MAT.Neon, glowOpts("BoatGlow", rgb(40, 60, 80), { transparency = 0.84 }))
			local wa = at(sx * B * 0.32, 0.22, L / 2 + m(9))
			Kit.box(parent, wa * CFrame.Angles(0, math.rad(sx * 7), 0), Vector3.new(m(1.6), 0.12, m(18)), rgb(214, 226, 236), MAT.SmoothPlastic, deco("Wake", { transparency = 0.72, shadow = false }))
		end

		-- 선실 실내광(물 위를 비춤) — 광원 예산 안에서만
		Kit.light(cab1, "PointLight", { color = P.WindowWarm, brightness = 1.4, range = 48 })
	end

	local SPECS: { BoatSpec } = {
		-- 가장 큰 배: 먼 쪽 절반, 다리 왼쪽(대표 구도 중앙)
		{ length = 55, beam = 11, z = -0.47, xFar = -2200, xNear = BX - BRIDGE_CLEAR - m(60), phase = 0.66, knots = 9.5, hull = rgb(242, 242, 238), accent = rgb(28, 74, 150), led = P.LedGold },
		-- 다리 오른쪽(동쪽) 구간
		{ length = 50, beam = 10.5, z = 0.33, xFar = 2700, xNear = BX + BRIDGE_CLEAR + m(60), phase = 0.8, knots = 9, hull = rgb(236, 238, 240), accent = rgb(186, 40, 48), led = P.LedCyan },
		-- 작은 배: 가까운 쪽 절반, 왼쪽
		{ length = 42, beam = 9, z = 0.5, xFar = -3000, xNear = -480, phase = 0.82, knots = 10, hull = rgb(244, 242, 236), accent = rgb(24, 120, 128), led = P.LedMagenta },
	}

	local KNOT = 0.5144 -- m/s
	local boats = 0
	for idx, s in SPECS do
		local L = m(s.length)
		local z = s.z * HW
		local zSide = if z < 0 then 1 else -1 -- U턴은 강 중심 쪽으로
		local xA, xB = s.xFar, s.xNear
		local reach = math.max(TURN_R + m(s.beam), L / 2) + m(8)
		-- 다리 띠 / 예약 영역 / 수면 경계를 피하도록 B 끝을 A 쪽으로 당김
		local ok = false
		for _ = 1, 20 do
			local x0, x1 = math.min(xA, xB) - reach, math.max(xA, xB) + reach
			local z0 = math.min(z - m(s.beam), z + zSide * (2 * TURN_R + m(s.beam)))
			local z1 = math.max(z + m(s.beam), z + zSide * (2 * TURN_R + m(s.beam)))
			local clearBridge = x1 < BX - BRIDGE_CLEAR or x0 > BX + BRIDGE_CLEAR
			local inWater = z0 > -HW + m(20) and z1 < HW - m(20) and x0 > Config.River.XMin and x1 < Config.River.XMax
			if clearBridge and inWater and Kit.isFree(x0, z0, x1, z1, m(5)) then
				ok = true
				break
			end
			xB += if xA < xB then -m(30) else m(30)
			if math.abs(xB - xA) < L * 4 then
				break
			end
		end
		if not ok or used() > BUDGET - 80 then
			continue
		end
		local A = Vector3.new(xA, Config.Level.Water, z)
		local Bp = Vector3.new(xB, Config.Level.Water, z)
		local pos = A:Lerp(Bp, s.phase)
		local cf0 = CFrame.lookAt(pos, pos + (Bp - A).Unit)
		local boat = Kit.group(model, "Boat")
		buildBoat(boat, cf0, s)
		boat.WorldPivot = cf0
		boat:SetAttribute("PathA", A)
		boat:SetAttribute("PathB", Bp)
		boat:SetAttribute("Speed", math.floor(m(s.knots * KNOT) * 10 + 0.5) / 10)
		boat:SetAttribute("TurnRadius", TURN_R)
		boat:SetAttribute("Phase", s.phase)
		boat:SetAttribute("Length", L)
		boat:SetAttribute("Index", idx)
		CollectionService:AddTag(boat, BOAT_TAG)
		boats += 1
	end

	--------------------------------------------------------------------------------------------------
	-- 먼 쪽 호안 앞 수면 반짝임 (옅고 짧은 스트릭, 기존 반사와 겹치지 않게)
	--------------------------------------------------------------------------------------------------
	local F = Config.FarBank
	local zNear, zFar = F.WaterEdge + 30, F.WaterEdge + 170
	local existing: { { any } } = {} -- { 위치, 반경 }
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "WaterGlint" and d.Position.Z < zFar + 400 then
			table.insert(existing, { d.Position, (d.Size.X + d.Size.Z) / 2 })
		end
	end
	local cam = Config.Viewpoint.ReflectionEye
	local function clear(x: number, z: number, len: number, w: number): boolean
		local a = Vector3.new(x, 0, z)
		local dir = Vector3.new(cam.X - x, 0, cam.Z - z).Unit
		local b = a + dir * len
		local ab = b - a
		for _, e in existing do
			local q: Vector3 = e[1]
			local qa = Vector3.new(q.X, 0, q.Z) - a
			local t = math.clamp(qa:Dot(ab) / ab:Dot(ab), 0, 1)
			local d = (Vector3.new(q.X, 0, q.Z) - (a + ab * t)).Magnitude
			if d < w + e[2] + 6 then
				return false
			end
		end
		return true
	end
	local GLINT_COLORS = { P.WindowWarm, P.LampSodium, P.WindowCool, P.WindowGold, P.LedBlue }
	local placed = 0
	for _ = 1, 160 do
		if used() > BUDGET - 6 or placed >= 24 then
			break
		end
		local x = rng:NextNumber(-2600, 2600)
		local z = rng:NextNumber(zNear, zFar)
		local len = rng:NextNumber(m(10), m(26))
		local w = rng:NextNumber(m(0.6), m(1.2))
		if math.abs(x - BX) < BRIDGE_CLEAR + m(15) or not clear(x, z, len, w) then
			continue
		end
		local c = GLINT_COLORS[rng:NextInteger(1, #GLINT_COLORS)]:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0.3, 0.5))
		local first = Kit.reflection(model, x, z, w, len, c, rng:NextNumber(0.86, 0.91))
		if first then
			placed += 1
			local dir = Vector3.new(cam.X - x, 0, cam.Z - z).Unit
			for k = 0, 3 do
				table.insert(existing, { Vector3.new(x, 0, z) + dir * (len * k / 3), len / 6 + w })
			end
		end
	end

	model:SetAttribute("Boats", boats)
	model:SetAttribute("Glints", placed)
end

return WaterFx
]]></ProtectedString></Properties></Item></Item></roblox>