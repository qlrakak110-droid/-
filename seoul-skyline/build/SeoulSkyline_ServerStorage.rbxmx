	light(bp, "PointLight", { color = rgb(236, 240, 255), brightness = 0.8, range = M(2.8) })
	bx(g, 11.0, CEIL - 0.012, 5.45, 11.2, CEIL, 5.65, rgb(200, 200, 198), MAT.SmoothPlastic, deco("ExhaustFan"))
