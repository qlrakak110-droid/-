------------------------------------------------------------------------------------------------------
-- 손으로 배치한 실루엣. x,z = 발자국 중심(stud, 실측 레이아웃), wm/dm = 발자국 m (wm = 로컬 X 폭),
--   floors = 층수, home = 주거 층고(2.9 m; 기본은 오피스 4.0 m)
--   crown: led/spire/helipad/slant/frame/box,  lantern: frame 크라운 안의 금빛 발광 볼륨
--   gold: 원거리에서 어두운 유리 몸체 + 금빛 상층부(사진 오른쪽 군의 금빛 크라운)
------------------------------------------------------------------------------------------------------
type Entry = {
	name: string,
	x: number,
	z: number,
	wm: number?,
	dm: number?,
	floors: number?,
	home: boolean?,
	-- 해석 결과(stud)
	w: number?,
	d: number?,
	h: number?,
	floorH: number?,
	yaw: number?,
	style: string?,
	crown: string?,
	tiers: number?,
	glass: Color3?,
	frame: Color3?,
	lit: { Color3 }?,
	litChance: number?,
	led: Color3?,
	podium: boolean?,
	lantern: boolean?,
	light: boolean?,
	glint: boolean?,
	gold: boolean?,
	terrace: boolean?,
}

